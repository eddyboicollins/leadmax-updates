/**
 * Local preview: turns a stored component into a standalone HTML page that the
 * studio renders in a sandboxed iframe — no Vercel build involved.
 *
 * - JSX/TS is transpiled here with sucrase (fast, pure JS).
 * - Every host element carries data-lm-src="<source offset>" so the visual
 *   editor can map clicks back to the exact place in the code.
 * - Runtime mirrors the deployed site: React 19, lucide-react, Tailwind v4,
 *   Font Awesome, the same globals.css.
 */
import { transform } from 'sucrase';
import { instrumentJsx, LOC_ATTR } from './jsx';

const REACT_VERSION = '19.2.4';
const LUCIDE_VERSION = '0.511.0';

function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/** `</script` inside inline JS would end the tag early. */
function inlineScriptSafe(js: string): string {
  return js.replace(/<\/(script)/gi, '<\\/$1').replace(/<!--/g, '<\\!--');
}

function dataModule(src: string): string {
  return `data:text/javascript;charset=utf-8,${encodeURIComponent(src)}`;
}

const NEXT_SHIMS: Record<string, string> = {
  'next/link': `import React from 'react';
export default function Link({ href, children, prefetch, replace, scroll, shallow, passHref, legacyBehavior, ...rest }) {
  return React.createElement('a', { href: typeof href === 'string' ? href : (href && href.pathname) || '#', ...rest }, children);
}`,
  'next/image': `import React from 'react';
export default function Image({ src, fill, priority, quality, placeholder, blurDataURL, loader, unoptimized, style, ...rest }) {
  const s = fill ? { position: 'absolute', inset: 0, width: '100%', height: '100%', ...(style || {}) } : style;
  return React.createElement('img', { src: typeof src === 'string' ? src : (src && src.src), style: s, ...rest });
