import { promises as fs } from 'fs';
import path from 'path';
import { v4 as uuidv4 } from 'uuid';
import { sortLeadsByRating } from './leads';
import type { Campaign, Lead, BusinessData, LeadStatus, LeadLandingPage, LeadImage, LeadDeployment, DeploymentEntry, LeadGeneration, GlobalSettings, CampaignRegion } from './types';
