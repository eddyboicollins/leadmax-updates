import { NextRequest, NextResponse } from 'next/server';
import { getSettings } from '@/lib/store';
import sharp from 'sharp';
import { uploadToImgbb } from '@/lib/imgbb';

export async function POST(request: NextRequest) {
  try {
    const settings = await getSettings();
    const imgbbKey = settings.imgbbKey;
    if (!imgbbKey) {
      return NextResponse.json({ error: 'ImgBB API key not configured. Set it in Settings.' }, { status: 400 });
    }

    const formData = await request.formData();
    const file = formData.get('file') as File | null;
    if (!file) return NextResponse.json({ error: 'No file provided' }, { status: 400 });

    const arrayBuffer = await file.arrayBuffer();
    const webpBuffer = await sharp(Buffer.from(arrayBuffer)).webp({ quality: 85 }).toBuffer();

    const b64 = webpBuffer.toString('base64');
    const { url } = await uploadToImgbb(b64, imgbbKey);

    return NextResponse.json({ url });
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Logo upload failed';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
