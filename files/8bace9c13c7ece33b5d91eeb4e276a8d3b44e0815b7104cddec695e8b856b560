export function formatRating(rating: number): string {
  return rating.toFixed(1).replace('.', ',');
}

export function profileTitle(profile: BusinessProfile): string {
  return `${profile.name} (${formatRating(profile.rating)} | ${profile.ratingCount})`;
}

