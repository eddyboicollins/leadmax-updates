import path from 'path';
import fs from 'fs';
import { v4 as uuidv4 } from 'uuid';
import { BusinessData } from './types';
import { cleanAddress } from './address';
import { SCRAPED_DIR } from './store';
import { scrapeLog } from './scrapeLog';

type PuppeteerModule = typeof import('puppeteer');

const SCROLL_STEP_PX = 3000;
const SCROLL_SETTLE_MS = 350;
const SCROLL_IDLE_BEFORE_STOP = 10;
const PHONE_POLL_ATTEMPTS = 6;
const PHONE_POLL_INTERVAL_MS = 250;

function scrollPanelJS(): void {
  const main = document.querySelector<HTMLElement>('div[role="main"][aria-label]');
  if (!main) return;
  const scrollables: HTMLElement[] = [];
  let el: HTMLElement | null = main;
  for (let d = 0; d < 12 && el; d++) {
    if (el.scrollHeight > el.clientHeight + 24) scrollables.push(el);
    el = el.parentElement;
  }
  for (const s of scrollables) s.scrollTop = s.scrollHeight;
  try { main.scrollIntoView({ block: 'end', inline: 'nearest' }); } catch { /* ignore */ }
}

function extractFieldsJS(fallbackTitle: string) {
  function toHighResPhotoUrl(url: string): string {
    // Google photo URLs carry a size token like =w310-h310-n-k-no.
    // Re-request the same photo at high resolution.
    return url.replace(/=w\d+-h\d+[^&]*/, '=w2000-h2000-k-no');
  }

  function extractPhotosJS(): { id: string; url: string; width?: number; height?: number }[] {
    const photos: { id: string; url: string; width?: number; height?: number }[] = [];
    try {
      const seen = new Set<string>();
      const push = (src: string, w?: number, h?: number) => {
        // Accept current Google Place photo paths (gps-cs-s / grass-cs / p / pb ...)
        // and exclude user avatars (anchored under /a or /a-).
        if (!src) return;
        if (!/lh\d+\.googleusercontent\.com\/(gps-cs|grass-cs|gps-cs-s|pb|p|photo|ph)\//.test(src)) return;
        const hiRes = toHighResPhotoUrl(src);
        const base = hiRes.split('=')[0];
        if (seen.has(base)) return;
        seen.add(base);
        photos.push({
          id: typeof crypto.randomUUID === 'function' ? crypto.randomUUID() : 'img-' + photos.length + '-' + Date.now(),
          url: hiRes,
          width: w && w > 0 ? w : undefined,
          height: h && h > 0 ? h : undefined,
        });
      };

      // "People also search for" / "Personnes ayant..." / "بحث الأشخاص..." strips
      // show OTHER businesses' photos with the same googleusercontent URL pattern.
      // Any region whose label suggests "other people also searched" must be excluded
      // so we never mix unrelated leads' photos into the target lead's gallery.
      const EXCLUDED_LABELS =
        '[aria-label*="People also search"], [aria-label*="personnes ayant"], [aria-label*="ont aussi cherch"], [aria-label*="Les gens cherchent"], [aria-label*="بحث الأشخاص"], [aria-label*="أشخاص يبحثون"], [aria-label*="similar places"], [aria-label*="liens similaires"]';

      // The strip often has no aria-label (only a heading), so also match heading
      // text and re-scan on every pass to catch lazily-rendered sections.
      const excludedRoots = (): Element[] => {
        const roots: Element[] = Array.from(document.querySelectorAll<Element>(EXCLUDED_LABELS));
        document.querySelectorAll<HTMLElement>('h1,h2,h3,h4').forEach((h) => {
          const txt = (h.textContent || '').trim();
          if (!txt || txt.length > 60) return;
          if (!/(people also search|personnes ayant|ont aussi cherch|les gens cherchent|similar places|liens similaires|أشخاص يبحثون|بحث الأشخاص)/i.test(txt)) return;
          roots.push(h);
          let p = h.parentElement;
          for (let d = 0; p && d < 4; d++) {
            if (p.querySelectorAll('img[src*="googleusercontent"]').length > 0) { roots.push(p); break; }
            p = p.parentElement;
          }
        });
        return roots;
      };

      const collectIn = (root: Element | Document) => {
        const roots = excludedRoots();
        const isExcluded = (el: Element): boolean => {
          let node: Element | null = el;
          while (node && node !== document.body) {
            if (roots.indexOf(node) !== -1) return true;
            node = node.parentElement;
          }
          return false;
        };
        root.querySelectorAll<HTMLImageElement>('img[src*="googleusercontent"]').forEach((img) => {
          if (isExcluded(img as Element)) return;
          push(img.src, img.naturalWidth, img.naturalHeight);
        });

        // The photos strip uses CSS background-image divs.
        root.querySelectorAll<HTMLElement>('[style*="googleusercontent"]').forEach((el) => {
          if (isExcluded(el as Element)) return;
          const match = el.getAttribute('style')?.match(/url\(['"]?([^'")]+)['"]?\)/);
          if (match) push(match[1].replace(/\\\//g, '/'));
        });
      };

      // Prefer the current business's own photo gallery ("Photos" / "Photos & videos").
      const photoRegion =
        document.querySelector<HTMLElement>('[role="region"][aria-label="Photos"]') ||
        document.querySelector<HTMLElement>('[role="region"][aria-label="Photos & videos"]') ||
        document.querySelector<HTMLElement>('[role="region"][aria-label^="Photos"]') ||
        document.querySelector<HTMLElement>('[role="region"][aria-label*="Photos"]');

      if (photoRegion) {
        collectIn(photoRegion);
      } else {
        // Fallback: whole page, but never from "People also search for"-style strips.
        collectIn(document);
      }
    } catch { /* photos non-critical */ }
    return photos.slice(0, 10);
  }

  let title =
    document.querySelector<HTMLElement>('h1.DUwDvf')?.innerText ||
    document.querySelector<HTMLElement>('h1')?.innerText ||
    fallbackTitle;
  if (title === 'Results' || title === 'النتائج') title = fallbackTitle;

  let rating = '';
  let ratingCount = 0;
  let phone = '';
  let website = '';
  let category = '';
  let address = '';

  const panel =
    document.querySelector<HTMLElement>('[role="main"][aria-label]') ||
    document.querySelector<HTMLElement>('div[role="main"]') ||
    document.body;

  const ratingEl = panel.querySelector<HTMLElement>('div.F7nice');
  if (ratingEl) {
    rating = (ratingEl.querySelector<HTMLElement>('span[aria-hidden="true"]')?.innerText || '').replace(',', '.');
  }

  const allText = document.body.innerText;
  let countMatch = allText.match(/(\d[\d,]*)\s*reviews?/i);
  if (countMatch) {
    ratingCount = parseInt(countMatch[1].replace(/,/g, ''));
  } else {
    // Modern panels render the count as "(1,234)" next to the stars instead
    // of "N reviews". Walk up from the rating block to find it.
    let node: HTMLElement | null = ratingEl;
    for (let d = 0; d < 4 && node; d++) {
      const paren = node.innerText.match(/\((\d[\d,]+)\)/);
      if (paren) {
        ratingCount = parseInt(paren[1].replace(/,/g, ''));
        break;
      }
      const line = node.innerText.match(/(\d[\d,]+)\s*(?:reviews?|ratings?)/i);
      if (line) {
        ratingCount = parseInt(line[1].replace(/,/g, ''));
        break;
      }
      node = node.parentElement;
    }
  }

  const catBtn =
    panel.querySelector<HTMLElement>('button[jsaction*="category"]') ||
    panel.querySelector<HTMLElement>('button.DkEaL[jsaction*="category"]');
  if (catBtn) category = catBtn.innerText.trim();

  const addrBtn = panel.querySelector<HTMLElement>('button[data-item-id*="address"]');
  if (addrBtn) address = addrBtn.innerText.replace(/^Address:\s*/i, '').trim();

  const phoneSelectors = [
    'button[data-item-id^="phone:"]',
    'a[data-item-id^="phone:"]',
  ];
  for (const sel of phoneSelectors) {
    const el = panel.querySelector<HTMLElement>(sel);
    if (el) {
      const id = el.getAttribute('data-item-id') || '';
      const digits = id.replace(/^phone:tel:/i, '').replace(/^phone:/i, '').replace(/[^\d+]/g, '');
      if (digits) { phone = digits; break; }
    }
  }
  if (!phone) {
    panel.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((a) => {
      if (phone) return;
      const digits = a.href.replace(/^tel:/i, '').split(';')[0].trim().replace(/[^\d+]/g, '');
      if (digits.length >= 6) phone = digits;
    });
  }
  if (!phone) {
    const candidates = panel.querySelectorAll<HTMLElement>(
      'button[aria-label*="hone"], a[aria-label*="hone"], button[aria-label*="éléphone"], a[aria-label*="éléphone"]'
    );
    for (const el of Array.from(candidates)) {
      const al = el.getAttribute('aria-label') || '';
      const m = al.match(/(?:Phone|Téléphone|Telefon|Tel\.?|موبايل|هاتف)\s*:\s*(.+)/i);
      if (m) {
        const digits = m[1].trim().replace(/[^\d+]/g, '');
        if (digits.length >= 6) { phone = digits; break; }
      }
    }
  }

  panel.querySelectorAll<HTMLElement>('a[href]').forEach((a) => {
    const dataItemId = a.getAttribute('data-item-id') || '';
    const aria = (a.getAttribute('aria-label') || '').toLowerCase();
    const href = (a as HTMLAnchorElement).href || '';
    if (dataItemId === 'authority' || aria.includes('website') || aria.includes('site web')) {
      if (!website && href && !href.includes('google.com/search') && href.startsWith('http')) {
        website = href;
      }
    }
  });

  const reviews: { author: string; text: string; rating: number; date: string; avatar?: string }[] = [];
  try {
    const reviewCards = panel.querySelectorAll<HTMLElement>('.jJc9Ad .MyEned, .jftg4e .w8nwRe, [role*="review"]');
    const maxReviews = Math.min(reviewCards.length, 8);
    for (let i = 0; i < maxReviews; i++) {
      const card = reviewCards[i];
      const author = card.querySelector<HTMLElement>('.d4r55')?.innerText?.trim() || '';
      const text = card.querySelector<HTMLElement>('.wiI7pd')?.innerText?.trim() || '';
      const avatar = card.querySelector<HTMLImageElement>('img[src*="googleusercontent"]')?.src || '';
      let rating = 0;
      const starsEl = card.querySelector<HTMLElement>('[role="img"][aria-label*="star"], .kvMYJc');
      if (starsEl) {
        const ariaLabel = starsEl.getAttribute('aria-label') || '';
        const starMatch = ariaLabel.match(/(\d+(?:\.\d+)?)\s*star/i);
        if (starMatch) rating = parseInt(starMatch[1]);
      }
      if (text) reviews.push({ author, text, rating, date: '', avatar: avatar || undefined });
    }
    if (reviews.length === 0) {
      const reviewTexts = document.querySelectorAll<HTMLElement>('.wiI7pd, .MyEned > div > div:last-child');
      for (let i = 0; i < Math.min(reviewTexts.length, 8); i++) {
        const t = reviewTexts[i]?.innerText?.trim();
        if (t) reviews.push({ author: '', text: t, rating: 0, date: '' });
      }
    }
  } catch { /* reviews non-critical */ }
  reviews.sort((a, b) => (b.rating || 0) - (a.rating || 0));

  const hours: string[] = [];
  try {
    const hoursEl = panel.querySelector<HTMLElement>('div[aria-label*="hours"], div[data-hours], .t39EBf');
    if (hoursEl) {
      const hourLines = hoursEl.querySelectorAll<HTMLElement>('tr, .ylH6F');
      hourLines.forEach(h => hours.push(h.innerText.trim()));
    }
  } catch { /* hours non-critical */ }

  let latitude = 0, longitude = 0;
  const coordMatch = window.location.href.match(/@(-?\d+\.\d+),(-?\d+\.\d+)/);
  if (coordMatch) {
    latitude = parseFloat(coordMatch[1]);
    longitude = parseFloat(coordMatch[2]);
  } else {
    // Place URLs also carry !3dLAT!4dLNG tokens in the /data= path.
    const d3d4 = window.location.href.match(/!3d(-?\d+\.\d+)!4d(-?\d+\.\d+)/);
    if (d3d4) {
      latitude = parseFloat(d3d4[1]);
      longitude = parseFloat(d3d4[2]);
    }
  }
  if (!latitude || !longitude) {
    const latMeta = document.querySelector<HTMLMetaElement>('meta[itemprop="latitude"]')?.content;
    const lngMeta = document.querySelector<HTMLMetaElement>('meta[itemprop="longitude"]')?.content;
    if (latMeta && lngMeta) {
      const lat = parseFloat(latMeta.replace(',', '.'));
      const lng = parseFloat(lngMeta.replace(',', '.'));
      if (!Number.isNaN(lat) && !Number.isNaN(lng)) {
        latitude = lat;
        longitude = lng;
      }
    }
  }

  let placeId = '';
  const htmlMatch = document.body?.innerHTML?.match(/ChI[A-Za-z0-9_-]{20,}/);
  if (htmlMatch) placeId = htmlMatch[0];
  if (!placeId) {
    const pidMatch = window.location.href.match(/!1s([^!]+)!/);
    if (pidMatch && pidMatch[1].startsWith('ChI')) placeId = pidMatch[1];
  }

  const scrapedImages = extractPhotosJS();

  return {
    title,
    rating,
    ratingCount,
    phone,
    website,
    category,
    address,
    reviews,
    hours,
    latitude,
    longitude,
    placeId,
    scrapedImages,
    googleUrl: window.location.href,
  };
}

function detectImageExt(buf: Buffer): string {
  if (buf.length > 2 && buf[0] === 0xff && buf[1] === 0xd8) return 'jpg';
  if (buf.length > 8 && buf[0] === 0x89 && buf[1] === 0x50 && buf[2] === 0x4e && buf[3] === 0x47) return 'png';
  if (buf.length > 12 && buf.toString('ascii', 8, 12) === 'WEBP') return 'webp';
  return 'jpg';
}

// Google's new gps-cs-s photo URLs are session-gated and rate-limited (HTTP 429)
// when hotlinked. Download them while puppeteer still holds the Google session,
// store them locally, and return stable local URLs.
async function persistScrapedImages(page: any, images: { id: string; url: string; width?: number; height?: number }[], max = 10): Promise<{ id: string; url: string; width?: number; height?: number }[]> {
  const kept: { id: string; url: string; width?: number; height?: number }[] = [];
  await fs.promises.mkdir(SCRAPED_DIR, { recursive: true }).catch(() => {});
  for (const img of images.slice(0, max)) {
    try {
      const b64 = await page.evaluate(async (src: string) => {
        try {
          const res = await fetch(src, { credentials: 'include' });
          if (!res.ok) return '';
          const buf = await res.arrayBuffer();
          const bytes = new Uint8Array(buf);
          let bin = '';
          const chunk = 0x8000;
          for (let i = 0; i < bytes.length; i += chunk) {
            bin += String.fromCharCode.apply(null, Array.from(bytes.subarray(i, i + chunk)));
          }
          return btoa(bin);
        } catch { return ''; }
      }, img.url);
      if (!b64) continue;
      const buffer = Buffer.from(b64, 'base64');
      const ext = detectImageExt(buffer);
      const file = (img.id || 'img') + '.' + ext;
      await fs.promises.writeFile(path.join(SCRAPED_DIR, file), buffer);
      kept.push({ id: img.id, url: '/api/scraped-images/' + file, width: img.width, height: img.height });
    } catch { /* skip image */ }
  }
  return kept;
}

async function resolvePuppeteerExecutablePath() {
  const candidates: string[] = [];

  if (process.env.PUPPETEER_EXECUTABLE_PATH) {
    candidates.push(process.env.PUPPETEER_EXECUTABLE_PATH);
  }

  const isWin = process.platform === 'win32';
  const isMac = process.platform === 'darwin';
  const isLinux = process.platform === 'linux';
  const localAppData = process.env.LOCALAPPDATA || '';
  const programFiles = process.env['ProgramFiles'] || 'C:\\Program Files';
  const programFilesX86 = process.env['ProgramFiles(x86)'] || 'C:\\Program Files (x86)';

  if (isWin) {
    candidates.push(
      path.join(programFilesX86, 'Microsoft\\Edge\\Application\\msedge.exe'),
      path.join(programFiles, 'Microsoft\\Edge\\Application\\msedge.exe'),
      path.join(localAppData, 'Microsoft\\Edge\\Application\\msedge.exe'),
      path.join(programFiles, 'Google\\Chrome\\Application\\chrome.exe'),
      path.join(programFilesX86, 'Google\\Chrome\\Application\\chrome.exe'),
      path.join(localAppData, 'Google\\Chrome\\Application\\chrome.exe'),
    );
  } else if (isMac) {
    candidates.push(
      '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
      '/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge',
    );
  } else if (isLinux) {
    candidates.push(
      '/usr/bin/google-chrome',
      '/usr/bin/google-chrome-stable',
      '/usr/bin/microsoft-edge',
      '/usr/bin/chromium',
      '/usr/bin/chromium-browser',
    );
  }

  for (const candidate of candidates) {
    if (candidate && fs.existsSync(candidate)) return candidate;
  }

  throw new Error('No Chrome or Edge browser found. Install Google Chrome or Microsoft Edge to use scraping.');
}

async function launchScrapeBrowser(log: (msg: string) => void) {
  scrapeLog('[scrape] launching browser');

  // Puppeteer is loaded lazily: in the packaged Electron app the module load can
  // intermittently fail (e.g. when its browser cache/network probe trips up), and a
  // top-level import would turn that into a blank HTTP 500 before the route's own
  // error handling runs. Loading it here lets us surface the real reason instead.
  let puppeteer: PuppeteerModule;
  try {
    puppeteer = await import('puppeteer');
    if ('default' in puppeteer && puppeteer.default && typeof (puppeteer.default as any).launch === 'function') {
      puppeteer = puppeteer.default as unknown as PuppeteerModule;
    }
  } catch (err) {
    const msg = 'Failed to load puppeteer: ' + (err instanceof Error ? err.message : String(err));
    log(msg);
    throw new Error(msg);
  }

  let executablePath: string;
  try {
    executablePath = await resolvePuppeteerExecutablePath();
  } catch (err) {
    log('Browser detection failed: ' + (err instanceof Error ? err.message : String(err)));
    throw err;
  }
  log(`Launching browser from ${executablePath}`);
  scrapeLog('[scrape] browser executable', executablePath);
  const launchOptions: Parameters<typeof puppeteer.launch>[0] = {
    headless: true,
    executablePath,
    args: [
      '--no-sandbox',
      '--disable-setuid-sandbox',
      '--disable-dev-shm-usage',
      '--disable-accelerated-2d-canvas',
      '--disable-gpu',
      // Playwright's documented workaround for Chrome M138+ exiting with code 0
      // (empty stderr) when it relaunches itself unelevated before DevTools is up.
      '--disable-features=AutoDeElevate',
      '--window-size=1920,1080',
    ],
  };

  // Windows can make the very first launch after app start fail with "Code: 0"
  // (browser process exits cleanly before exposing the DevTools endpoint), while a
  // restart fixes it. Retry briefly instead of failing the scrape.
  let browser: Awaited<ReturnType<typeof puppeteer.launch>> | undefined;
  let lastError: Error | null = null;
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      browser = await puppeteer.launch(launchOptions);
      lastError = null;
      break;
    } catch (err) {
      lastError = err instanceof Error ? err : new Error(String(err));
      log(`Failed to launch browser (${executablePath}) attempt ${attempt}/3: ${lastError.message}`);
      scrapeLog('[scrape] browser launch failed', attempt, lastError.message);
      if (attempt < 3) {
        await new Promise((resolve) => setTimeout(resolve, 2000));
      }
    }
  }
  if (!browser) {
    throw lastError ?? new Error('Failed to launch browser');
  }

  const page = await browser.newPage();
  await page.setViewport({ width: 1920, height: 1080 });
  await page.setUserAgent(
    'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
  );

  const interceptedPlaceId = { current: '' };

  page.on('response', async (response) => {
    try {
      const url = response.url();
      if (url.includes('/maps/preview/') || url.includes('/maps/api/')) {
        const text = await response.text();
        const matches = text.match(/ChI[A-Za-z0-9_-]{20,}/g);
        if (matches && matches.length && !interceptedPlaceId.current) {
          interceptedPlaceId.current = matches[0];
        }
      }
    } catch {}
  });

  // Warm-up: the very first navigation in a fresh headless browser gets a
  // "limited view of Google Maps" panel (no review count, no photo grid).
  // Visiting google.com first establishes cookies/session so place pages
  // render in full.
  await page.goto('https://www.google.com/', { waitUntil: 'domcontentloaded', timeout: 30000 }).catch(() => {});
  await new Promise((r) => setTimeout(r, 800));

  return { browser, page, interceptedPlaceId };
}

// Processes a single Google Maps place URL: opens it, extracts the panel data,
// persists scraped images, and returns a full BusinessData object. Falls back
// to a name-only lead when the panel cannot be opened.
async function scrapePlacePage(
  page: any,
  interceptedPlaceId: { current: string },
  href: string,
  title: string,
  onLog: (msg: string) => void,
  onProgress?: (processed: number, total: number, current?: BusinessData | null) => void,
  index?: number,
  total?: number,
): Promise<BusinessData> {
  interceptedPlaceId.current = '';

  try {
    await page.goto(resolvePlaceUrl(href, title), { waitUntil: 'domcontentloaded', timeout: 30000 });
    await page.waitForSelector('h1', { timeout: 8000 }).catch(() => {});
    await new Promise((r) => setTimeout(r, 1200));

    const early = await page.evaluate(() => {
      const panel =
        document.querySelector<HTMLElement>('[role="main"][aria-label]') ||
        document.querySelector<HTMLElement>('div[role="main"]') ||
        document.body;
      let rating = '';
      const ratingEl = panel.querySelector<HTMLElement>('div.F7nice');
      if (ratingEl) {
        rating = (ratingEl.querySelector<HTMLElement>('span[aria-hidden="true"]')?.innerText || '').replace(',', '.');
      }
      const countMatch = document.body.innerText.match(/(\d[\d,]*)\s*reviews?/i);
      return { rating, ratingCount: countMatch ? parseInt(countMatch[1].replace(/,/g, '')) : 0 };
    });
    if (onProgress && index !== undefined && total !== undefined) {
      onProgress(index, total, {
        name: title,
        rating: parseFloat(early.rating) || 0,
        ratingCount: early.ratingCount || 0,
      } as BusinessData);
    }

    await page.evaluate(scrollPanelJS);
    for (let poll = 0; poll < PHONE_POLL_ATTEMPTS; poll++) {
      const hasPhone = await page.evaluate(() => {
        const main = document.querySelector('div[role="main"][aria-label]');
        return !!(main?.querySelector('button[data-item-id^="phone:"], a[data-item-id^="phone:"]'));
      });
      if (hasPhone) break;
      await page.evaluate(scrollPanelJS);
      await new Promise((r) => setTimeout(r, PHONE_POLL_INTERVAL_MS));
    }

    // Scroll the photo carousel horizontally so lazy thumbnails actually load
    // before we snapshot them. Without this the gallery often yields a single
    // 32x32 placeholder image.
    await page.evaluate(() => {
      const region =
        document.querySelector('[role="region"][aria-label*="Photos"]') ||
        document.querySelector('[role="region"][aria-label^="Photos"]');
      if (!region) return;
      const scroller = (region as HTMLElement).querySelector('div[role="listitem"], .m6QErb, div[style*="overflow"]') ||
        (region as HTMLElement);
      const el = scroller as HTMLElement;
      for (let i = 0; i < 8; i++) {
        el.scrollLeft += 600;
      }
    });
    await new Promise((r) => setTimeout(r, 700));

    await page.evaluate(() => {
      const main = document.querySelector('div[role="main"][aria-label]') || document.querySelector('div[role="main"]');
      if (main) main.scrollTop = 0;
    });
    await new Promise((r) => setTimeout(r, 400));

    const details = await page.evaluate(extractFieldsJS, title) as any;

    const rating = parseFloat(details.rating) || 0;
    let ratingCount = details.ratingCount || 0;

    // Cold first page load: the title/stars paint but "N reviews" lags behind.
    // Poll a few times before giving up on the count.
    if (ratingCount === 0) {
      for (let attempt = 0; attempt < 8; attempt++) {
        await new Promise((r) => setTimeout(r, 500));
        ratingCount = (await page.evaluate(extractRatingCountJS)) || 0;
        if (ratingCount > 0) break;
      }
    }

    const pid = details.placeId || interceptedPlaceId.current || '';
    if (pid && !interceptedPlaceId.current) interceptedPlaceId.current = pid;

    const scrapedImages = await persistScrapedImages(page, details.scrapedImages || []);

    return {
      name: details.title || title,
      rating,
      ratingCount,
      address: cleanAddress(details.address || ''),
      phone: details.phone || '',
      website: details.website || '',
      category: details.category || '',
      reviews: details.reviews || [],
      latitude: details.latitude || 0,
      longitude: details.longitude || 0,
      placeId: pid,
      googleUrl: href,
      hours: details.hours || [],
      scrapedImages,
      id: uuidv4(),
      scrapedAt: new Date().toISOString(),
    };
  } catch {
    onLog(`Could not open panel for ${title}, saving with name only`);
    return {
      name: title,
      rating: 0, ratingCount: 0, address: '', phone: '',
      website: '', category: '', reviews: [],
      latitude: 0, longitude: 0, placeId: '', googleUrl: href,
      hours: [], scrapedImages: [], id: uuidv4(), scrapedAt: new Date().toISOString(),
    };
  }
}

// Returns only the review count, used to poll until the panel fully renders.
// On a cold first page load Google draws the title/stars immediately but the
// "N reviews" text can arrive a second or two later, so a single synchronous
// read reliably returns 0. Self-contained so it can run via page.evaluate.
function extractRatingCountJS() {
  try {
    const allText = document.body.innerText;
    let m = allText.match(/(\d[\d,]*)\s*reviews?/i);
    if (m) return parseInt(m[1].replace(/,/g, ''));
    const panel =
      document.querySelector<HTMLElement>('[role="main"][aria-label]') ||
      document.querySelector<HTMLElement>('div[role="main"]') ||
      document.body;
    const ratingEl = panel.querySelector<HTMLElement>('div.F7nice');
    let node: HTMLElement | null = ratingEl;
    for (let d = 0; d < 4 && node; d++) {
      const paren = node.innerText.match(/\((\d[\d,]+)\)/);
      if (paren) return parseInt(paren[1].replace(/,/g, ''));
      const line = node.innerText.match(/(\d[\d,]+)\s*(?:reviews?|ratings?)/i);
      if (line) return parseInt(line[1].replace(/,/g, ''));
      node = node.parentElement;
    }
  } catch { /* return 0 */ }
  return 0;
}

function forceEnglishUrl(raw: string): string {
  try {
    const u = new URL(raw);
    u.searchParams.set('hl', 'en');
    return u.toString();
  } catch {
    return raw.includes('?') ? raw + '&hl=en' : raw + '?hl=en';
  }
}

// Pasting a Google Maps "Share > Copy link" produces a lightweight URL like
// https://www.google.com/maps/place/Name/data=!4m2!3m1!1s0x0:0xHEXCID...
// which renders only a compact panel (no review count, no photo grid). The
// full rich place page needs the canonical ?q=<real name>&cid=<decimal> form.
//
// Full canonical URLs already carry coordinates and render fine on their own,
// BUT using the user-provided keyword as the q= still trips Google into a thin
// layout. So we always rebuild ?q= from the real place name embedded in the
// URL (!2s<Name> or the /place/<Name>/ path segment) and the CID from the
// first !1s...0xSIDE:0xHEX token.
function resolvePlaceUrl(raw: string, fallbackName?: string): string {
  let name = fallbackName || '';
  try {
    const two = raw.match(/!2s([^!&?/"]+)/);
    if (two && two[1]) {
      name = decodeURIComponent(two[1]).replace(/\+/g, ' ');
    } else {
      const p = raw.match(/\/maps\/place\/([^/@?]+)/);
      if (p && p[1]) name = decodeURIComponent(p[1]).replace(/\+/g, ' ');
    }
  } catch { /* keep fallback */ }

  let cidHex: string | null = null;
  try {
    const tokens = raw.match(/!1s([^!&?/"]+)/g) || [];
    for (const t of tokens) {
      const m = t.match(/0x[0-9a-fA-F]{6,}:0x([0-9a-fA-F]{6,})/);
      if (m) { cidHex = m[1]; break; }
    }
  } catch { /* no cid */ }

  if (cidHex) {
    const dec = BigInt('0x' + cidHex).toString(10);
    try {
      const u = new URL('https://www.google.com/maps/place/');
      u.searchParams.set('q', name);
      u.searchParams.set('cid', dec);
      u.searchParams.set('hl', 'en');
      return u.toString();
    } catch { /* fall through */ }
  }

  return forceEnglishUrl(raw);
}

function isDuplicateLead(results: BusinessData[], lead: BusinessData): boolean {
  const normName = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
  return results.some(r =>
    (r.placeId && r.placeId === lead.placeId) ||
    (r.phone && r.phone === lead.phone) ||
    (normName(r.name) === normName(lead.name))
  );
}

export async function scrapeGoogleMaps(
  query: string,
  onLog?: (msg: string) => void,
  onLead?: (data: BusinessData) => void | Promise<void>,
  onTotal?: (total: number) => void,
  options?: {
    onProgress?: (processed: number, total: number, current?: BusinessData | null) => void;
  },
): Promise<BusinessData[]> {
  const onProgress = options?.onProgress;
  const log = (msg: string) => onLog?.(msg);

  scrapeLog('===== SCRAPE SESSION START =====', JSON.stringify({ query, at: new Date().toISOString() }));

  const { browser, page, interceptedPlaceId } = await launchScrapeBrowser(log);

  const results: BusinessData[] = [];

  try {
    log(`Opening Google Maps: "${query}"`);
    await page.goto(`https://www.google.com/maps/search/${encodeURIComponent(query)}?hl=en`, {
      waitUntil: 'domcontentloaded',
      timeout: 60000,
    });

    // Handle consent popup
    try {
      await page.waitForSelector('form[action*="consent"] button', { timeout: 2500 });
      await page.evaluate(() => {
        const buttons = Array.from(document.querySelectorAll('form[action*="consent"] button'));
        const acceptButton = buttons.find(
          (b) =>
            (b as HTMLElement).innerText.includes('Accept') ||
            (b as HTMLElement).innerText.includes('Agree') ||
            (b as HTMLElement).innerText.includes('Tout accepter')
        );
        if (acceptButton) (acceptButton as HTMLElement).click();
      });
      await new Promise((r) => setTimeout(r, 600));
    } catch { /* no consent needed */ }

    // Wait for the feed to load
    try {
      await page.waitForSelector('div[role="feed"] a[href*="/maps/place/"]', { timeout: 20000 });
    } catch {
      await browser.close();
      throw new Error('No results found or timed out. Try a different keyword/location.');
    }

    // --- PHASE 1: Load ALL results and collect listing URLs ---
    log('Loading all results...');
    let allFeedUrls: { href: string; title: string }[] = [];
    let consecutiveNoNewLinks = 0;

    while (true) {
      const links = await page.$$('div[role="feed"] a[href*="/maps/place/"]');

      // Extract href + title from all visible links
      const batch: { href: string; title: string }[] = [];
      for (const link of links) {
        const href = await page.evaluate((el) => el.href, link).catch(() => '');
        const title = await page.evaluate((el) => el.getAttribute('aria-label') || '', link).catch(() => '');
        if (href && title) batch.push({ href, title });
      }

      // Merge into allFeedUrls, dedup by href
      const seen = new Set(allFeedUrls.map(u => u.href));
      for (const item of batch) {
        if (!seen.has(item.href)) {
          seen.add(item.href);
          allFeedUrls.push(item);
        }
      }

      // Scroll for more
      const prevCount = links.length;
      const scrolled = await page.evaluate((step) => {
        const feed =
          document.querySelector<HTMLElement>('div[role="feed"]') ||
          document.querySelector<HTMLElement>('.m6QErb.DxyBCb.kA9KIf.dS8AEf.ecceSd') ||
          document.querySelector<HTMLElement>('div[aria-label^="Results"]');
        if (!feed) return { ok: false as const, atBottom: true };
        const before = feed.scrollTop;
        feed.scrollBy(0, step);
        const maxScroll = feed.scrollHeight - feed.clientHeight;
        const atBottom = feed.scrollTop >= maxScroll - 4 && before >= maxScroll - 4;
        if (atBottom) feed.scrollTop = feed.scrollHeight;
        return { ok: true as const, atBottom };
      }, SCROLL_STEP_PX);

      await new Promise((r) => setTimeout(r, SCROLL_SETTLE_MS));

      const newLinks = await page.$$('div[role="feed"] a[href*="/maps/place/"]');
      if (newLinks.length === prevCount) {
        consecutiveNoNewLinks++;
        if (!scrolled.ok || consecutiveNoNewLinks >= SCROLL_IDLE_BEFORE_STOP) {
          log(`Found ${allFeedUrls.length} total results.`);
          scrapeLog('[scrape] phase1 total results =', allFeedUrls.length);
          onTotal?.(allFeedUrls.length);
          break;
        }
      } else {
        consecutiveNoNewLinks = 0;
      }
    }

    if (allFeedUrls.length === 0) {
      await browser.close();
      throw new Error('No listings found on Google Maps.');
    }

    // --- PHASE 2: Process each listing URL ---
    log(`Processing ${allFeedUrls.length} listings...`);

    for (let i = 0; i < allFeedUrls.length; i++) {
      const { href, title } = allFeedUrls[i];
      log(`[${i + 1}] ${title}`);
      onProgress?.(i, allFeedUrls.length, { name: title } as BusinessData);

      const lead = await scrapePlacePage(page, interceptedPlaceId, href, title, log, onProgress, i, allFeedUrls.length);

      if (lead) {
        if (!isDuplicateLead(results, lead)) {
          results.push(lead);
          onLead?.(lead);
          log(`${lead.rating || '?'}★ ${lead.website ? 'has website' : 'no website'} ${lead.phone ? 'has phone' : 'no phone'} — ${lead.name}`);
          scrapeLog('[scrape] FOUND lead', JSON.stringify({
            name: lead.name,
            rating: lead.rating,
            ratingCount: lead.ratingCount,
            phone: lead.phone,
            website: lead.website,
            address: lead.address,
            placeId: lead.placeId,
            category: lead.category,
          }));
        } else {
          scrapeLog('[scrape] SKIP duplicate', JSON.stringify({
            name: lead.name,
            placeId: lead.placeId,
            phone: lead.phone,
          }));
        }
      }
      onProgress?.(i + 1, allFeedUrls.length, lead);
    }

    log(`Done. ${results.length} leads found.`);
    scrapeLog('[scrape] phase2 done, leads returned =', results.length);
    scrapeLog('===== SCRAPE SESSION END (success) =====');
    return results;
  } catch (err: unknown) {
    scrapeLog('[scrape] ERROR in scrapeGoogleMaps', err instanceof Error ? (err.stack || err.message) : String(err));
    scrapeLog('===== SCRAPE SESSION END (error) =====');
    throw err;
  } finally {
    try {
      await browser.close();
      scrapeLog('[scrape] browser closed OK');
    } catch (closeErr: unknown) {
      // Windows can throw EBUSY while puppeteer deletes its temp profile
      // (e.g. first_party_sets.db-journal still locked). All leads were already
      // streamed by this point, so this must not turn a finished scrape into an error.
      scrapeLog('[scrape] browser.close() threw', closeErr instanceof Error ? (closeErr.stack || closeErr.message) : String(closeErr));
    }
  }
}

export interface ManualClientScrapeInput {
  name: string;
  url: string;
}

export async function scrapeGoogleMapsUrls(
  clients: ManualClientScrapeInput[],
  onLog?: (msg: string) => void,
  onLead?: (data: BusinessData) => void | Promise<void>,
  onTotal?: (total: number) => void,
  options?: {
    onProgress?: (processed: number, total: number, current?: BusinessData | null) => void;
  },
): Promise<BusinessData[]> {
  const onProgress = options?.onProgress;
  const log = (msg: string) => onLog?.(msg);

  scrapeLog('===== SCRAPE URLS SESSION START =====', JSON.stringify({
    clients: clients.map(c => ({ name: c.name, url: c.url })),
    at: new Date().toISOString(),
  }));

  const { browser, page, interceptedPlaceId } = await launchScrapeBrowser(log);

  const results: BusinessData[] = [];

  try {
    const total = clients.length;
    onTotal?.(total);
    log(`Processing ${total} client URL${total === 1 ? '' : 's'}...`);

    for (let i = 0; i < clients.length; i++) {
      const { name, url } = clients[i];
      log(`[${i + 1}] ${name || url}`);
      onProgress?.(i, total, { name: name || url } as BusinessData);

      const lead = await scrapePlacePage(page, interceptedPlaceId, url, name || url, log, onProgress, i, total);

      if (lead) {
        if (!isDuplicateLead(results, lead)) {
          results.push(lead);
          onLead?.(lead);
          log(`${lead.rating || '?'}★ ${lead.website ? 'has website' : 'no website'} ${lead.phone ? 'has phone' : 'no phone'} — ${lead.name}`);
          scrapeLog('[scrape] FOUND manual client', JSON.stringify({
            name: lead.name,
            rating: lead.rating,
            ratingCount: lead.ratingCount,
            phone: lead.phone,
            website: lead.website,
            address: lead.address,
            placeId: lead.placeId,
            category: lead.category,
          }));
        } else {
          scrapeLog('[scrape] SKIP duplicate manual client', JSON.stringify({
            name: lead.name,
            placeId: lead.placeId,
            phone: lead.phone,
          }));
        }
      }
      onProgress?.(i + 1, total, lead);
    }

    log(`Done. ${results.length} leads found.`);
    scrapeLog('===== SCRAPE URLS SESSION END (success) =====');
    return results;
  } catch (err: unknown) {
    scrapeLog('[scrape] ERROR in scrapeGoogleMapsUrls', err instanceof Error ? (err.stack || err.message) : String(err));
    scrapeLog('===== SCRAPE URLS SESSION END (error) =====');
    throw err;
  } finally {
    try {
      await browser.close();
      scrapeLog('[scrape] urls browser closed OK');
    } catch (closeErr: unknown) {
      scrapeLog('[scrape] urls browser.close() threw', closeErr instanceof Error ? (closeErr.stack || closeErr.message) : String(closeErr));
    }
  }
}

// ── Deep photo search ───────────────────────────────────────────────────────
//
// The normal scrape keeps only the photos that are visible in the place page's
// photo carousel (extractPhotosJS caps at 10). "Deep search" re-opens the place
// page and does a much broader sweep:
//   * scrolls the whole page panel (loads review photos and more carousel rows),
//   * opens the full photo gallery overlay and scrolls its lazy-loaded grid,
//   * collects every unique googleusercontent photo it can find,
//   * replaces the =w<h> size token with a high-res request for each new photo,
//   * caps the count per horizontal album block (maxPerAlbum) and the total
//     (maxTotal) so a big business can't make the run last forever.
function deepCollectJS() {
  return async (maxTotal: number, maxPerAlbum: number) => {
    const picked: { id: string; url: string; width?: number; height?: number }[] = [];
    const seen = new Set<string>();
    const toHiRes = (u: string) => u.replace(/=w\d+-h\d+[^&]*/, '=w2000-h2000-k-no');

    const EXCLUDED_LABELS =
      '[aria-label*="People also search"], [aria-label*="personnes ayant"], [aria-label*="ont aussi cherch"], [aria-label*="Les gens cherchent"], [aria-label*="بحث الأشخاص"], [aria-label*="أشخاص يبحثون"], [aria-label*="similar places"], [aria-label*="liens similaires"]';

    // The "People also search for" / "Similar places" strip is dedicated to
    // OTHER businesses and must never leak into this lead's photo set. Its
    // section often carries no aria-label (only a heading), and it lazy-loads
    // as we scroll, so we re-scan the DOM on every collection pass instead of
    // snapshotting once.
    const excludedRoots = (): Element[] => {
      const roots: Element[] = Array.from(document.querySelectorAll<Element>(EXCLUDED_LABELS));
      document.querySelectorAll<HTMLElement>('h1,h2,h3,h4').forEach((h) => {
        const txt = (h.textContent || '').trim();
        if (!txt || txt.length > 60) return;
        if (!/(people also search|personnes ayant|ont aussi cherch|les gens cherchent|similar places|liens similaires|أشخاص يبحثون|بحث الأشخاص)/i.test(txt)) return;
        roots.push(h);
        // Walk up from the heading to the strip container that holds the photos.
        let p = h.parentElement;
        for (let d = 0; p && d < 4; d++) {
          if (p.querySelectorAll('img[src*="googleusercontent"]').length > 0) { roots.push(p); break; }
          p = p.parentElement;
        }
      });
      return roots;
    };

    const tryPush = (src: string, w?: number, h?: number) => {
      if (!src || picked.length >= maxTotal) return;
      if (!/lh\d+\.googleusercontent\.com\/(gps-cs|grass-cs|gps-cs-s|pb|p|photo|ph)\//.test(src)) return;
      const hi = toHiRes(src);
      const base = hi.split('=')[0];
      if (seen.has(base)) return;
      seen.add(base);
      picked.push({
        id: typeof crypto.randomUUID === 'function' ? crypto.randomUUID() : 'deep-' + picked.length + '-' + Date.now(),
        url: hi,
        width: w && w > 0 ? w : undefined,
        height: h && h > 0 ? h : undefined,
      });
    };

    // Walk each horizontally-scrollable album block, capping each block so one
    // giant album can't crowd out the rest. Falls back to the whole document.
    const collect = (root: Element | Document) => {
      const roots = excludedRoots();
      const isExcluded = (el: Element) => {
        let node: Element | null = el;
        while (node && node !== document.body) {
          if (roots.indexOf(node) !== -1) return true;
          node = node.parentElement;
        }
        return false;
      };
      root.querySelectorAll<HTMLImageElement>('img[src*="googleusercontent"]').forEach((img) => {
        if (isExcluded(img as Element)) return;
        tryPush(img.src, img.naturalWidth, img.naturalHeight);
      });
      root.querySelectorAll<HTMLElement>('[style*="googleusercontent"]').forEach((el) => {
        if (isExcluded(el as Element)) return;
        const m = el.getAttribute('style')?.match(/url\(['"]?([^'")]+)['"]?\)/);
        if (m) tryPush(m[1].replace(/\\\//g, '/'));
      });
    };

    collect(document);

    const albums: HTMLElement[] = [];
    document.querySelectorAll<HTMLElement>('div').forEach((d) => {
      const imgs = d.querySelectorAll('img[src*="googleusercontent"]').length;
      const scrollable = d.scrollWidth - d.clientWidth > 100 || d.scrollHeight - d.clientHeight > 100;
      if (imgs > 0 && scrollable) albums.push(d);
    });
    // Sort by number of photos so distinctive (smaller) albums get priority,
    // then drain each one's horizontal scroller to load its lazy thumbnails.
    albums.sort((a, b) => a.querySelectorAll('img[src*="googleusercontent"]').length - b.querySelectorAll('img[src*="googleusercontent"]').length);
    for (const alb of albums) {
      if (picked.length >= maxTotal) break;
      let counted = 0;
      let idle = 0;
      for (let i = 0; i < 12 && picked.length < maxTotal && counted < maxPerAlbum; i++) {
        const before = picked.length;
        alb.scrollLeft += 800;
        await new Promise((r) => setTimeout(r, 350));
        collect(alb);
        const gained = picked.length - before;
        counted += gained;
        if (gained === 0) { idle++; if (idle >= 2) break; } else idle = 0;
      }
    }

    // The gallery/big grid scrolls vertically; keep scrolling it to trigger
    // lazy loading until photos stop changing.
    let gridIdle = 0;
    for (let i = 0; i < 20 && picked.length < maxTotal; i++) {
      const before = picked.length;
      const beforeScroll = document.scrollingElement?.scrollTop ?? 0;
      collect(document);
      if (picked.length === before) {
        gridIdle++;
        if (gridIdle >= 3) break;
      } else {
        gridIdle = 0;
      }
      if (beforeScroll === (document.scrollingElement?.scrollTop ?? 0)) {
        document.querySelectorAll<HTMLElement>('[style*="overflow"]').forEach((el) => {
          if (el.scrollHeight - el.clientHeight > 200) el.scrollTop = el.scrollHeight;
        });
        window.scrollBy(0, 2500);
      }
      await new Promise((r) => setTimeout(r, 500));
    }

    return picked.slice(0, maxTotal);
  };
}

function deepOpenGalleryJS() {
  const selectors = [
    'a[aria-label*="See all photos"]',
    'button[aria-label*="See all photos"]',
    '[role="button"][aria-label*="See all photos"]',
    'a[aria-label^="Photos"]',
    'button[aria-label^="Photos"]',
  ];
  for (const sel of selectors) {
    const el = document.querySelector<HTMLElement>(sel);
    if (el) {
      try { el.click(); return true; } catch { /* try next */ }
    }
  }
  return false;
}

// Re-opens a place and sweeps every discoverable photo (owner carousel,
// all gallery albums, and reviewer-uploaded photos) up to maxTotal.
export async function deepSearchPlaceImages(
  googleUrl: string,
  name: string,
  options?: {
    maxTotal?: number;
    maxPerAlbum?: number;
    onLog?: (msg: string) => void;
  },
): Promise<{ id: string; url: string; width?: number; height?: number }[]> {
  const maxTotal = options?.maxTotal ?? 30;
  const maxPerAlbum = options?.maxPerAlbum ?? 6;
  const onLog = options?.onLog;
  const log = (msg: string) => onLog?.(msg);

  scrapeLog('===== DEEP PHOTO SEARCH START =====', JSON.stringify({ name, googleUrl, at: new Date().toISOString() }));

  const { browser, page } = await launchScrapeBrowser(log);

  try {
    log(`Opening ${name} for deep photo search...`);
    await page.goto(resolvePlaceUrl(googleUrl, name), { waitUntil: 'domcontentloaded', timeout: 30000 });
    await page.waitForSelector('h1', { timeout: 8000 }).catch(() => {});
    await new Promise((r) => setTimeout(r, 1500));

    // Scroll the info panel to bottom so reviews + more carousel rows load.
    await page.evaluate(scrollPanelJS);
    await new Promise((r) => setTimeout(r, 800));
    await page.evaluate(scrollPanelJS);

    const opened = await page.evaluate(deepOpenGalleryJS);
    if (opened) await new Promise((r) => setTimeout(r, 1200));

    const found = await page.evaluate(deepCollectJS(), maxTotal, maxPerAlbum);
    log(`Deep search found ${found.length} photos`);

    const kept = await persistScrapedImages(page, found, maxTotal);
    scrapeLog('[deep-search] persisted', JSON.stringify({ name, kept: kept.length }));
    scrapeLog('===== DEEP PHOTO SEARCH END (success) =====');
    return kept;
  } catch (err: unknown) {
    scrapeLog('[deep-search] ERROR', err instanceof Error ? (err.stack || err.message) : String(err));
    scrapeLog('===== DEEP PHOTO SEARCH END (error) =====');
    throw err;
  } finally {
    try {
      await browser.close();
    } catch (closeErr: unknown) {
      scrapeLog('[deep-search] browser.close() threw', closeErr instanceof Error ? (closeErr.stack || closeErr.message) : String(closeErr));
    }
  }
}
