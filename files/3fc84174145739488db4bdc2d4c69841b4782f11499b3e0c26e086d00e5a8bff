  const head = (body: string) => `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>${escapeHtml(opts.title || 'Preview')}</title>
${body}`;

  let compiled: string;
  try {
    compiled = compileForPreview(opts.tsx);
  } catch (err) {
    const message = err instanceof Error ? err.message : String(err);
    return head(`<style>body{margin:0;font:14px ui-sans-serif,system-ui;background:#18181b;color:#e4e4e7;padding:24px}pre{white-space:pre-wrap}</style>
</head><body><h3 style="color:#fff">This version can't be rendered</h3><pre>${escapeHtml(message)}</pre>
<script>parent.postMessage({ lm: true, type: 'error', message: ${JSON.stringify(message).replace(/</g, '\\u003c')} }, '*');</script>
</body></html>`);
  }

  const icons = lucideImports(opts.tsx);
  const importMap = {
    imports: {
      react: `https://esm.sh/react@${REACT_VERSION}`,
      'react/': `https://esm.sh/react@${REACT_VERSION}/`,
      'react-dom': `https://esm.sh/react-dom@${REACT_VERSION}?external=react`,
      'react-dom/client': `https://esm.sh/react-dom@${REACT_VERSION}/client?external=react,react-dom`,
      'lucide-react': `https://esm.sh/lucide-react@${LUCIDE_VERSION}?external=react${icons.length ? `&exports=${icons.join(',')}` : ''}`,
      ...Object.fromEntries(Object.entries(NEXT_SHIMS).map(([k, v]) => [k, dataModule(v)])),
    },
  };

  const bootstrap = `import * as __LM_React from 'react';
