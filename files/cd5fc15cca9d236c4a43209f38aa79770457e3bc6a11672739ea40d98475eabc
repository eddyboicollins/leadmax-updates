/** Token the AI appends to its last message when it decides the call is over. */
export const END_CALL_TOKEN = '[END CALL]';

/** Removes the end-call token from a raw AI reply and reports whether the call ended. */
export function cleanReply(raw: string): { content: string; ended: boolean } {
  const ended = /\[\s*END\s*CALL\s*\]/i.test(raw);
  const content = raw.replace(/\[\s*END\s*CALL\s*\]/gi, '').trim();
  return { content, ended };
}

/** Derives a natural starting attitude from the business profile (NOT a fixed fate). */
function profileDisposition(profile: BusinessProfile): string {
  const parts: string[] = [];
  if (profile.rating >= 4.6) parts.push('You are proud of your reputation and you care about what people think of you');
  else if (profile.rating >= 4.2) parts.push('You are doing okay and you are fairly satisfied with your business');
  else parts.push('You know you have a few problems and you are a bit defensive about them');
  if (profile.ratingCount >= 200) parts.push('you are an established, busy business and your time is precious');
  else if (profile.ratingCount >= 40) parts.push('you are a known local business with a normal flow of clients');
  else parts.push('you are a small business that does not get many reviews');
  if (!profile.website) parts.push('you have NO website and you are genuinely open to the idea, but careful about spending money');
  else if (profile.websiteInsight && !/no website/i.test(profile.websiteInsight))
    parts.push(`your website is not great (${profile.websiteInsight}) and you know it needs fixing, but you never got around to it`);
  else parts.push('your website is fine and you are not convinced you need another one');
  return parts.join('. ') + '.';
}

