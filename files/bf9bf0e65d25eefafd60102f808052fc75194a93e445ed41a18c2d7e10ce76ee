'use client';

import { useEffect, useState } from 'react';
import { useTranslation } from 'react-i18next';
import { useLockBodyScroll } from '@/lib/useLockBodyScroll';
import { useToast } from '@/components/Toast';
import {
  buildInvoiceHtml,
  defaultLeadInvoice,
  emptyInvoiceSettings,
  freshInvoiceForLead,
  invoiceCopyFor,
  invoiceTotals,
  newInvoiceLine,
  printInvoiceHtml,
} from '@/lib/invoice';
import type { InvoiceSettings, Lead, LeadInvoice } from '@/lib/types';

interface Props {
  open: boolean;
  lead: Lead | null;
  campaignId: string;
  onClose: () => void;
  onSaved: (invoice: LeadInvoice) => void;
  onReset: () => void;
}

function migrateInvoiceSettings(raw: Record<string, unknown>): InvoiceSettings {
  return { ...emptyInvoiceSettings(), ...(raw as unknown as InvoiceSettings) };
}

export default function InvoiceModal({ open, lead, campaignId, onClose, onSaved, onReset }: Props) {
  const { t } = useTranslation();
  const { toast } = useToast();
  useLockBodyScroll(open);

  const [invoice, setInvoice] = useState<LeadInvoice | null>(() => (lead ? defaultLeadInvoice(lead) : null));
  const [prevLead, setPrevLead] = useState(lead);
  const [settings, setSettings] = useState<InvoiceSettings>(emptyInvoiceSettings());
  const [saving, setSaving] = useState(false);
  const [tab, setTab] = useState<'general' | 'settings'>('general');

  if (lead && lead !== prevLead) {
    setPrevLead(lead);
    setInvoice(defaultLeadInvoice(lead));
  }

  useEffect(() => {
    if (!open || !lead) return;
    let mounted = true;
    fetch('/api/settings')
      .then(r => r.json())
      .then(data => {
        if (!mounted) return;
        if (data?.invoice) setSettings(migrateInvoiceSettings(data.invoice));
      })
      .catch(() => {});
    return () => { mounted = false; };
  }, [open, lead]);

  const copy = invoiceCopyFor(settings.lang);

  if (!open || !lead || !invoice) return null;

  const { subtotal } = invoiceTotals(invoice);
  const inputCls = 'w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500';
  const labelCls = 'block text-[10px] font-medium text-zinc-500 dark:text-zinc-400 mb-1 uppercase tracking-wider';

  function patch(partial: Partial<LeadInvoice>) {
    setInvoice(prev => prev ? { ...prev, ...partial } : prev);
  }

  function patchLine(id: string, partial: Partial<LeadInvoice['lines'][number]>) {
    setInvoice(prev => {
      if (!prev) return prev;
      return { ...prev, lines: prev.lines.map(l => l.id === id ? { ...l, ...partial } : l) };
    });
  }

  function patchSettings(partial: Partial<InvoiceSettings>) {
    setSettings(prev => ({ ...prev, ...partial }));
  }

  async function onLogoSelected(file: File | null) {
    if (!file) { patchSettings({ logoDataUrl: '' }); return; }
    try {
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch('/api/settings/logo', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Logo upload failed');
      patchSettings({ logoDataUrl: data.url });
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    }
  }

  async function persistSettings() {
    try {
      await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ invoice: settings }),
      });
    } catch { /* non-fatal: setting is per-generation and saved next time */ }
  }

  async function persist(): Promise<LeadInvoice | null> {
    if (!invoice) return null;
    const payload: LeadInvoice = { ...invoice, updatedAt: new Date().toISOString() };
    const res = await fetch(`/api/campaigns/${campaignId}/leads/${lead!.id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ invoice: payload }),
    });
    if (!res.ok) throw new Error((await res.json()).error || t('invoice.saveFailed'));
    return payload;
  }

  async function resetInvoice() {
    setSaving(true);
    try {
      const res = await fetch(`/api/campaigns/${campaignId}/leads/${lead!.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ invoice: null }),
      });
      if (!res.ok) throw new Error((await res.json()).error || t('invoice.saveFailed'));
      setInvoice(freshInvoiceForLead(lead!));
      onReset();
      toast(t('invoice.resetDone'), 'success');
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(false);
    }
  }

  async function saveOnly() {
    setSaving(true);
    try {
      const saved = await persist();
      if (saved) {
        await persistSettings();
        onSaved(saved);
        toast(t('invoice.saved'), 'success');
      }
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(false);
    }
  }

  async function savePdf() {
    setSaving(true);
    try {
      const saved = await persist();
      if (saved) {
        await persistSettings();
        onSaved(saved);
        printInvoiceHtml(buildInvoiceHtml(saved, settings, copy));
      }
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(false);
    }
  }

  return (
    <div className="fixed inset-0 z-[110] bg-black/70 flex items-center justify-center p-4">
      <div className="bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl max-h-[90vh] flex flex-col" onClick={e => e.stopPropagation()}>
        <div className="flex items-center justify-between px-5 py-4 border-b border-zinc-200 dark:border-zinc-700 shrink-0">
          <div>
            <h3 className="text-sm font-semibold text-zinc-900 dark:text-white">{t('invoice.modalTitle')}</h3>
            <p className="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{lead.business.name}</p>
          </div>
          <button onClick={onClose} className="p-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-700 rounded-lg transition-all">
            <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <div className="flex gap-1 bg-zinc-200 dark:bg-zinc-700/60 rounded-xl p-1 mx-5 mt-4 w-fit shrink-0">
          <button onClick={() => setTab('general')} className={`px-4 py-1.5 text-xs font-medium rounded-lg transition-all ${tab === 'general' ? 'bg-white dark:bg-zinc-600 text-zinc-900 dark:text-white shadow-sm' : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white'}`}>{t('invoice.modalTabGeneral')}</button>
          <button onClick={() => setTab('settings')} className={`px-4 py-1.5 text-xs font-medium rounded-lg transition-all ${tab === 'settings' ? 'bg-white dark:bg-zinc-600 text-zinc-900 dark:text-white shadow-sm' : 'text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white'}`}>{t('invoice.modalTabSettings')}</button>
        </div>

        <div className="p-5 overflow-y-auto space-y-4">
          {tab === 'general' && (
          <div className="space-y-4">
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div className="col-span-2">
              <label className={labelCls}>{t('invoice.number')}</label>
              <input value={invoice.number} onChange={e => patch({ number: e.target.value })} className={inputCls} />
            </div>
            <div>
              <label className={labelCls}>{t('invoice.issueDate')}</label>
              <input type="date" value={invoice.issueDate} onChange={e => patch({ issueDate: e.target.value })} className={inputCls} />
            </div>
            <div>
              <label className={labelCls}>{t('invoice.currency')}</label>
              <input value={invoice.currency} onChange={e => patch({ currency: e.target.value.toUpperCase() })} className={inputCls} />
            </div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div className="sm:col-span-2">
              <label className={labelCls}>{t('invoice.clientName')}</label>
              <input value={invoice.clientName} onChange={e => patch({ clientName: e.target.value })} className={inputCls} />
            </div>
            <div>
              <label className={labelCls}>{t('invoice.clientAddress')}</label>
              <input value={invoice.clientAddress} onChange={e => patch({ clientAddress: e.target.value })} className={inputCls} />
            </div>
            <div>
              <label className={labelCls}>{t('invoice.clientPhone')}</label>
              <input value={invoice.clientPhone} onChange={e => patch({ clientPhone: e.target.value })} className={inputCls} />
            </div>
          </div>

          <div>
            <label className={labelCls + ' mb-2'}>{t('invoice.lines')}</label>
            <div className="grid grid-cols-12 gap-2 mb-1.5 px-1">
              <span className="col-span-12 sm:col-span-9 text-[10px] font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">{t('invoice.item')}</span>
              <span className="col-span-6 sm:col-span-2 text-[10px] font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">{t('invoice.price')}</span>
              <span className="col-span-6 sm:col-span-1"></span>
            </div>
            <div className="space-y-2">
              {invoice.lines.map(line => (
                <div key={line.id} className="grid grid-cols-12 gap-2 items-start">
                  <input
                    value={line.description}
                    onChange={e => patchLine(line.id, { description: e.target.value })}
                    placeholder={t('invoice.description')}
                    className={`${inputCls} col-span-12 sm:col-span-9`}
                  />
                  <input
                    type="number" min={0} step={0.01}
                    value={line.unitPrice}
                    onChange={e => patchLine(line.id, { unitPrice: Number(e.target.value) })}
                    placeholder={t('invoice.amount')}
                    className={`${inputCls} col-span-6 sm:col-span-2`}
                  />
                  <button
                    type="button"
                    disabled={invoice.lines.length <= 1}
                    onClick={() => patch({ lines: invoice.lines.filter(l => l.id !== line.id) })}
                    className="col-span-6 sm:col-span-1 h-10 text-zinc-400 hover:text-red-500 disabled:opacity-30"
                    title={t('invoice.removeLine')}
                  >
                    ×
                  </button>
                </div>
              ))}
            </div>
            <div className="flex justify-center mt-3">
              <button type="button" onClick={() => patch({ lines: [...invoice.lines, newInvoiceLine()] })} className="px-4 py-1.5 text-xs font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 dark:bg-emerald-500/10 border border-emerald-500/40 rounded-lg hover:bg-emerald-500/20 transition-all">
                + {t('invoice.addItem')}
              </button>
            </div>
            <p className="mt-2 text-sm font-medium text-zinc-900 dark:text-white text-end">
              {t('invoice.total')}: {subtotal.toFixed(2)} {invoice.currency}
            </p>
          </div>
          </div>
          )}

          {tab === 'settings' && (
          <div className="space-y-4">
            <div className="space-y-2.5">
              <div className="flex flex-wrap items-center justify-between gap-2">
                <span className="text-[10px] font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">{t('invoice.invoiceLang')}</span>
                <div className="flex gap-1.5">
                  <button type="button" onClick={() => patchSettings({ lang: 'en' })} className={`px-3 py-1.5 text-xs font-medium rounded-lg border transition-all ${settings.lang !== 'fr' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/50' : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700'}`}>English</button>
                  <button type="button" onClick={() => patchSettings({ lang: 'fr' })} className={`px-3 py-1.5 text-xs font-medium rounded-lg border transition-all ${settings.lang === 'fr' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/50' : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700'}`}>Français</button>
                </div>
              </div>
              <p className="text-[11px] text-zinc-500 dark:text-zinc-400 -mt-1">{t('invoice.invoiceLangHint')}</p>
            </div>

            <div>
              <label className={labelCls}>{t('invoice.identity')}</label>
              <div className="flex gap-2">
                <button type="button" onClick={() => patchSettings({ identityKind: 'freelancer' })} className={`flex-1 px-3 py-2.5 text-xs font-medium rounded-xl border transition-all ${settings.identityKind === 'freelancer' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/50' : 'bg-zinc-50 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700'}`}>{t('invoice.freelancer')}</button>
                <button type="button" onClick={() => patchSettings({ identityKind: 'company' })} className={`flex-1 px-3 py-2.5 text-xs font-medium rounded-xl border transition-all ${settings.identityKind === 'company' ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/50' : 'bg-zinc-50 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border-zinc-200 dark:border-zinc-700'}`}>{t('invoice.company')}</button>
              </div>
            </div>

            {settings.identityKind === 'company' && (
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div className="sm:col-span-2">
                  <label className={labelCls}>{t('invoice.logo')}</label>
                  <div className="flex items-center gap-4">
                    {settings.logoDataUrl ? (
                      <img src={settings.logoDataUrl} alt="" className="h-12 w-12 object-contain shrink-0" />
                    ) : (
                      <div className="h-12 w-12 shrink-0 flex items-center justify-center text-zinc-400">
                        <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                      </div>
                    )}
                    <div className="min-w-0 flex flex-col gap-1">
                      <div className="flex items-center gap-3">
                        <label className="text-xs font-medium text-emerald-600 dark:text-emerald-400 hover:underline cursor-pointer transition-all shrink-0">
                          {t('invoice.uploadLogo')}
                          <input type="file" accept="image/*" className="hidden" onChange={e => onLogoSelected(e.target.files?.[0] ?? null)} />
                        </label>
                        {settings.logoDataUrl && (
                          <button type="button" onClick={() => patchSettings({ logoDataUrl: '' })} className="text-xs text-zinc-500 dark:text-zinc-400 hover:text-red-500 transition-colors shrink-0">{t('invoice.removeLogo')}</button>
                        )}
                      </div>
                      <p className="text-[11px] text-zinc-500 dark:text-zinc-400 min-w-0">{t('invoice.logoHint')}</p>
                    </div>
                  </div>
                </div>
                <div>
                  <label className={labelCls}>{t('invoice.companyName')}</label>
                  <input value={settings.companyName} onChange={e => patchSettings({ companyName: e.target.value })} placeholder={t('invoice.companyNamePh')} className={inputCls} />
                </div>
                <div>
                  <label className={labelCls}>{t('invoice.website')}</label>
                  <input value={settings.website} onChange={e => patchSettings({ website: e.target.value })} placeholder={t('invoice.websitePh')} className={inputCls} />
                </div>
              </div>
            )}

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label className={labelCls}>{t('invoice.legalName')}</label>
                <input value={settings.legalName} onChange={e => patchSettings({ legalName: e.target.value })} placeholder={t('invoice.legalNamePh')} className={inputCls} />
              </div>
              <div>
                <label className={labelCls}>{t('invoice.address')}</label>
                <input value={settings.address} onChange={e => patchSettings({ address: e.target.value })} placeholder={t('invoice.addressPh')} className={inputCls} />
              </div>
              <div>
                <label className={labelCls}>{t('invoice.contactEmail')}</label>
                <input type="email" value={settings.contactEmail} onChange={e => patchSettings({ contactEmail: e.target.value })} placeholder={t('invoice.contactEmailPh')} className={inputCls} />
              </div>
              <div>
                <label className={labelCls}>{t('invoice.phone')}</label>
                <input value={settings.phone} onChange={e => patchSettings({ phone: e.target.value })} placeholder={t('invoice.phonePh')} className={inputCls} />
              </div>
            </div>

          </div>
          )}
        </div>

        <div className="flex items-center justify-end gap-2 px-5 py-4 border-t border-zinc-200 dark:border-zinc-700 bg-zinc-100/50 dark:bg-zinc-800/50 shrink-0">
          <button onClick={onClose} className="px-4 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white bg-zinc-200 dark:bg-zinc-700 rounded-lg hover:bg-zinc-300 dark:hover:bg-zinc-600 transition-all">{t('campaign.cancel')}</button>
          <button onClick={resetInvoice} disabled={saving} className="px-4 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white bg-zinc-200 dark:bg-zinc-700 rounded-lg hover:bg-zinc-300 dark:hover:bg-zinc-600 transition-all disabled:opacity-40">{t('invoice.reset')}</button>
          <div className="flex items-center gap-2">
            <button onClick={saveOnly} disabled={saving} className="px-4 py-2 text-xs font-medium bg-zinc-200 dark:bg-zinc-700 text-zinc-800 dark:text-zinc-100 rounded-lg hover:bg-zinc-300 dark:hover:bg-zinc-600 transition-all disabled:opacity-40">{t('invoice.save')}</button>
            <button onClick={savePdf} disabled={saving} className="px-4 py-2 text-xs font-medium bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-lg hover:from-emerald-400 hover:to-teal-500 transition-all shadow-sm shadow-emerald-500/20 disabled:opacity-40">{t('invoice.savePdf')}</button>
          </div>
        </div>
      </div>
    </div>
  );
}
