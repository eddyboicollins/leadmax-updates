  async function unpublishWebsite(lead: Lead) {
    if (!(await confirm({ message: t('campaign.unpublishConfirm') }))) return;
    generation.startJob({
      campaignId: id,
      leadId: lead.id,
      leadName: lead.business.name,
      kind: 'unpublish',
      hasDeployment: true,
    });
  }
  function slugifyDomain(input: string): string {
    return (input || '')
      .toLowerCase()
      .replace(/[^a-z0-9]/g, '-')
      .replace(/-+/g, '-')
      .slice(0, 30)
      .replace(/^-|-$/g, '');
  }

  function defaultDomain(lead: Lead): string {
    return `lp-${slugifyDomain(lead.business.name || 'lead')}` || 'lp-lead';
  }

  function effectiveDomain(lead: Lead): string {
    return lead.deploymentName || defaultDomain(lead);
  }

  // "View website" must open the stable main domain (<project>.vercel.app),
  // never the per-build deployment URL. deploymentName is the exact project
  // name sent to the Vercel API; stored deployment.url can be a unique build
  // URL when alias assignment failed or for entries written by older builds.
  function mainSiteUrl(lead: Lead): string {
    const project = lead.deploymentName || lead.deployment?.projectName || defaultDomain(lead);
    return `https://${project}.vercel.app`;
  }

  async function checkDomainAvailability(leadId: string, name: string) {
    if (!name) {
      setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, error: 'Enter a domain name' } }));
      return;
    }
    setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: true } }));
    try {
      const res = await fetch(`/api/check-name?name=${encodeURIComponent(name)}`);
      const data = await res.json();
      if (!res.ok) {
        setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, error: data.error || 'Could not check availability' } }));
        return;
      }
      setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, available: data.available } }));
    } catch {
      setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, error: 'Availability check failed' } }));
    }
  }

  function onDomainDraftChange(leadId: string, raw: string) {
    // Clean as-you-type so the field can only ever contain what will actually
    // be checked and saved — no "garbage shown, slug checked" mismatch.
    const cleaned = raw
      .toLowerCase()
      .replace(/[^a-z0-9-]/g, '-')
      .replace(/-{2,}/g, '-')
      .slice(0, 30);
    setDomainDraft(prev => ({ ...prev, [leadId]: cleaned }));
    const slug = slugifyDomain(cleaned);
    if (domainCheckTimers.current[leadId]) clearTimeout(domainCheckTimers.current[leadId]);
    if (!slug) {
      setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, error: 'Enter a domain name' } }));
      return;
    }
    setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: true } }));
    domainCheckTimers.current[leadId] = setTimeout(() => {
      checkDomainAvailability(leadId, slug);
    }, 500);
  }

  async function saveDomain(lead: Lead) {
    const draft = (domainDraft[lead.id] || '').trim();
    const next = slugifyDomain(draft);
    if (!next) { setDomainEditLeadId(null); return; }
    try {
      const res = await fetch(`/api/check-name?name=${encodeURIComponent(next)}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to check domain availability');
      if (!data.available) {
        setDomainAvailability(prev => ({ ...prev, [lead.id]: { checking: false, available: false } }));
        toast(`"${next}.vercel.app" is already taken. Please choose a different name.`, 'error');
        return;
      }

      const patchRes = await fetch(`/api/campaigns/${id}/leads/${lead.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ deploymentName: next }),
      });
      if (!patchRes.ok) throw new Error((await patchRes.json()).error || 'Failed to save domain');
      setDomainEditLeadId(null);
      await loadCampaign();
      queryClient.invalidateQueries({ queryKey: ['campaign'] });
      queryClient.invalidateQueries({ queryKey: ['campaigns'] });
      if (pendingGenerateLeadId === lead.id) {
        setPendingGenerateLeadId(null);
        setGenerateLeadId(lead.id);
        setGeneratePrompt('');
        setShowGenerateModal(true);
      }
    } catch (err: any) {
      toast(err.message, 'error');
    }
  }

  function openGenerateModal(leadId: string) {
    if (!leadId) {
      setShowGenerateModal(true);
      return;
    }
    const lead = allLeads.find((l: any) => l.id === leadId);
    setPendingGenerateLeadId(leadId);
    if (lead && !lead.landingPage) {
      setDomainEditLeadId(lead.id);
      setDomainDraft(prev => ({ ...prev, [lead.id]: effectiveDomain(lead) }));
      setDomainAvailability(prev => ({ ...prev, [lead.id]: { checking: false } }));
      return;
    }
    setPendingGenerateLeadId(null);
    setGenerateLeadId(leadId);
    setGeneratePrompt('');
    setShowGenerateModal(true);
  }

  function submitGenerate() {
    if (!generateLeadId) return;
    const extra = generatePrompt.trim() || undefined;
    setShowGenerateModal(false);
    doGenerate(generateLeadId, extra);
  }

  function openModifyModal(lead: Lead) {
    setStudioLeadId(lead.id);
  }

  function closeStudio() {
    const closedId = studioLeadId;
    setStudioLeadId(null);
    // Flash the lead card green so the user lands back on the site just previewed.
    if (closedId) router.replace(`/campaign/${id}?lead=${encodeURIComponent(closedId)}&focus=${Date.now()}`, { scroll: false });
  }

  function updateManualRow(i: number, patch: Partial<{ name: string; mapsUrl: string }>) {
    setManualRows(prev => prev.map((r, idx) => idx === i ? { ...r, ...patch } : r));
  }

  async function submitAddClients() {
    const valid = manualRows.filter(r => r.name.trim() && r.mapsUrl.trim());
    if (valid.length === 0) return;
    setResolvingClients(true);
    try {
      const res = await fetch(`/api/campaigns/${id}/leads/manual`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entries: valid.map(r => ({ name: r.name.trim(), mapsUrl: r.mapsUrl.trim() })) }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Failed to add clients');
      if (data.failed > 0) {
        toast(t('campaign.manualAdded', { ok: data.added, failed: data.failed }), 'error');
      } else {
        toast(t('campaign.manualAdded', { ok: data.added, failed: 0 }), 'success');
      }
      setShowAddClients(false);
      setManualRows([{ name: '', mapsUrl: '' }]);
      await loadCampaign();
      queryClient.invalidateQueries({ queryKey: ['campaign'] });
      queryClient.invalidateQueries({ queryKey: ['campaigns'] });
    } catch (err: any) {
      toast(err.message, 'error');
    } finally {
      setResolvingClients(false);
    }
  }

  function sendStudioPrompt(userPrompt: string, baseVersionId: string | null, notes: StudioNote[] = []): boolean {
    const studioLead = allLeads.find((l: any) => l.id === studioLeadId);
    if (!studioLead || (!userPrompt.trim() && notes.length === 0)) return false;
    // Clear any lingering error from a previous attempt so it doesn't linger next to the new one.
    for (const j of generation.jobs) {
      if (j.leadId === studioLead.id && (j.kind === 'modify' || j.kind === 'generate') && j.phase === 'error') generation.dismissJob(j.id);
    }
    return generation.startJob({
      campaignId: id,
      leadId: studioLead.id,
      leadName: studioLead.business.name,
      kind: 'modify',
      userPrompt: userPrompt.trim(),
      displayPrompt: formatRequestForDisplay(userPrompt, notes),
      notes,
      versionId: baseVersionId || undefined,
      hasDeployment: true,
    });
  }

  /** Put one local version online (Vercel). Only ever triggered by the user. */
  function publishStudioVersion(versionId: string) {
    const studioLead = allLeads.find((l: any) => l.id === studioLeadId);
    if (!studioLead) return;
    for (const j of generation.jobs) {
      if (j.leadId === studioLead.id && j.kind === 'publish' && j.phase === 'error') generation.dismissJob(j.id);
    }
    generation.startJob({
      campaignId: id,
      leadId: studioLead.id,
      leadName: studioLead.business.name,
      kind: 'publish',
      versionId,
      domain: effectiveDomain(studioLead),
      hasDeployment: !!studioLead.deployment?.url || (studioLead.deploymentHistory?.length || 0) > 0,
    });
  }

  const allLeads = sortLeadsByRating([...new Map([...(scraping ? scrape.streamedLeads as any : []), ...(campaign?.leads || [])].map(l => [l.id, l])).values()] as any);
  const leadParam = searchParams.get('lead');
  const focusParam = searchParams.get('focus');
  const [consumedFocus, setConsumedFocus] = useState<string | null>(null);
  const highlightedLead = leadParam && focusParam && focusParam !== consumedFocus ? leadParam : null;
  const effectiveFilter = highlightedLead ? 'all' : filterStatus;
  const [seenHighlight, setSeenHighlight] = useState<string | null>(null);
  if (highlightedLead && highlightedLead !== seenHighlight) {
    setSeenHighlight(highlightedLead);
    setSelectedLeadId(highlightedLead);
  }
  const filteredLeads = allLeads.filter(l => {
    if (effectiveFilter === 'deleted') return !!l.deleted;
    if (l.deleted) return false;
    if (effectiveFilter === 'all') return true;
    if (effectiveFilter === 'has_site') return !!l.deployment?.url;
    if (effectiveFilter === 'no_website') return !(l.business.website || '').trim();
    return l.status === effectiveFilter;
  });

  // Soft-deleted photos are hidden everywhere; only active ones count for slots.
  const modalActiveImages = activeImages(imagesLead?.images);
  const modalDeletedImages = (imagesLead?.images || []).filter(i => !!i.deleted);

  useEffect(() => {
    if (!focusParam) return;
    const t = setTimeout(() => setConsumedFocus(focusParam), 4000);
    return () => clearTimeout(t);
  }, [focusParam]);

  useEffect(() => {
    if (!highlightedLead) return;
    let cancelled = false;
    let attempts = 0;
    const scroll = () => {
      if (cancelled) return;
      const el = document.getElementById(`lead-card-${highlightedLead}`);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else if (attempts < 50) {
        attempts++;
        setTimeout(scroll, 100);
      }
    };
    scroll();
    return () => { cancelled = true; };
  }, [highlightedLead, focusParam]);

  if (isLoading) return (
    <div className="flex-1 bg-gray-100 dark:bg-zinc-950 flex items-center justify-center transition-colors">
      <div className="animate-spin w-8 h-8 border-2 border-emerald-500 border-t-transparent rounded-full" />
    </div>
  );

  if (!campaign) return null;

  // ── 3-pane layout helpers (list · map · detail) ─────────────────────
  const statusLabel = (lead: Lead) =>
    lead.deleted ? t('campaign.deleted') : (STATUSES.find(s => s.key === lead.status)?.label ?? STATUSES[0].label);
  const filterCount = (key: string) => allLeads.filter(l => {
    if (key === 'deleted') return !!l.deleted;
    if (l.deleted) return false;
    if (key === 'all') return true;
    if (key === 'has_site') return !!l.deployment?.url;
    if (key === 'no_website') return !(l.business.website || '').trim();
    return l.status === key;
  }).length;
  /** Discovered photos first (skipping session-gated Google URLs), then uploaded ones. */
  const leadPhotos = (lead: Lead): string[] => {
    const discovered = (lead.business.scrapedImages || []).map(s => s.url).filter(u => !/googleusercontent|\.google\.com/.test(u));
    const uploaded = activeImages(lead.images).map(i => i.url);
    return [...new Set([...discovered, ...uploaded])];
  };
  const mapTone = (lead: Lead): MapLead['tone'] =>
    lead.deleted || lead.status === 'not_interested' ? 'muted'
      : lead.landingPage || lead.deployment ? 'site'
        : lead.status === 'pending' ? (hasOwnWebsite(lead.business.name, lead.business.website) ? 'new' : 'nosite') : 'worked';

  const selectedLead = filteredLeads.find(l => l.id === selectedLeadId) ?? filteredLeads[0] ?? null;
  const selectedIndex = selectedLead ? filteredLeads.findIndex(l => l.id === selectedLead.id) : -1;
  const selectLead = (leadId: string, openOnMobile = true) => {
    setSelectedLeadId(leadId);
    if (openOnMobile) { setMobileDetailOpen(true); setDetailHidden(false); }
  };

  const detailFor = (lead: Lead) => {
    const job = genJobForLead(lead.id);
    return (
      <LeadDetail
        key={lead.id}
        lead={lead}
        statuses={STATUSES}
        photos={leadPhotos(lead)}
        uploadedCount={activeImages(lead.images).length}
        siteUrl={lead.deployment && !isComingSoonActive(lead) ? mainSiteUrl(lead) : null}
        canUnpublish={!!lead.deployment && !isComingSoonActive(lead)}
        jobText={job ? resolveJobMessage(job, t, 'campaign.aiGenerating') : null}
        onOpenJob={() => setStudioLeadId(lead.id)}
        onStatus={(s) => updateLeadStatus(lead.id, s)}
        onGenerate={() => openGenerateModal(lead.id)}
        onOpenStudio={() => openModifyModal(lead)}
        onRegenerate={() => openGenerateModal(lead.id)}
        onImages={() => openImagesModal(lead)}
        onUnpublish={() => unpublishWebsite(lead)}
        onDelete={() => deleteLead(lead.id)}
        onRestore={() => restoreLead(lead.id)}
        onViewImage={(url) => setViewImage(url)}
        onPrev={selectedIndex > 0 ? () => selectLead(filteredLeads[selectedIndex - 1].id) : undefined}
        onNext={selectedIndex >= 0 && selectedIndex < filteredLeads.length - 1 ? () => selectLead(filteredLeads[selectedIndex + 1].id) : undefined}
        onClose={() => { setMobileDetailOpen(false); setDetailHidden(true); }}
      />
    );
  };

  return (
    <div className="flex-1 min-h-0 bg-white dark:bg-zinc-950 transition-colors flex flex-col">
      <SetNavbar
        title={campaign.keyword}
        subtitle={campaign.location}
      />

      <div className="flex-1 min-h-0 flex lg:h-[calc(100dvh-var(--lm-navbar-h))] lg:max-h-[calc(100dvh-var(--lm-navbar-h))] lg:overflow-hidden">
        {/* ── Left: leads ── */}
        <aside className="w-full lg:w-[380px] xl:w-[400px] shrink-0 flex flex-col min-h-0 border-e border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950">
          <div className="px-5 pt-5 pb-3 shrink-0">
            <p className="text-[11px] font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">{t('campaign.leadsFromCampaign')}</p>
            <h1 className="mt-1 text-[22px] leading-tight font-semibold text-zinc-900 dark:text-white truncate">{campaign.displayName || campaign.keyword}</h1>
            <p className="mt-0.5 text-[13px] text-zinc-500 dark:text-zinc-400 truncate">
              {t('campaign.leadsCount', { count: filterCount('all') })}{campaign.location ? ` · ${campaign.location}` : ''}
            </p>
            <div className="mt-4 flex items-center gap-1.5 overflow-x-auto pb-1 -mx-1 px-1">
              {['all', ...STATUSES.map(s => s.key), ...SITE_FILTERS.map(s => s.key), 'deleted'].map(s => {
                const label = s === 'all' ? t('campaign.all') : s === 'deleted' ? t('campaign.deleted') : filterLabel(s);
                const active = filterStatus === s;
                const dot = s === 'pending' ? 'bg-emerald-400' : s === 'has_site' ? 'bg-zinc-900 dark:bg-white' : s === 'contacted' || s === 'negotiating' ? 'bg-zinc-400' : null;
                return (
                  <button
                    key={s}
                    onClick={() => setFilterStatus(s)}
                    className={`shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-[12px] font-medium border transition-all whitespace-nowrap ${active ? 'border-emerald-500/50 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300' : 'border-zinc-200 dark:border-zinc-700/50 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:border-zinc-300 dark:hover:border-zinc-700'}`}
                  >
                    {dot && <span className={`w-1.5 h-1.5 rounded-full ${dot}`} />}
                    {label}
                    <span className="text-[11px] text-zinc-400 dark:text-zinc-500">{filterCount(s)}</span>
                  </button>
                );
              })}
            </div>
          </div>

          {/* Scrape progress (mobile: above the list; desktop: right panel) */}
          {scraping && <div className="lg:hidden px-5 pb-4"><ScrapeProgressPanel campaignId={id} /></div>}

          <div className="flex-1 min-h-0 overflow-y-auto border-t border-zinc-200 dark:border-zinc-700/50">
            {filteredLeads.length === 0 && !scraping ? (
              <div className="h-full min-h-[40vh] flex flex-col items-center justify-center text-center px-6">
                <svg className="w-10 h-10 mb-3 text-zinc-400 dark:text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}><path strokeLinecap="round" strokeLinejoin="round" d="M21 21l-4.35-4.35m1.1-4.15a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" /></svg>
                <p className="text-sm text-zinc-500 dark:text-zinc-400">
                  {filterStatus === 'all'
                    ? t('campaign.noLeadsAll')
                    : filterStatus === 'deleted'
                      ? t('campaign.noDeletedLeads')
                      : t('campaign.noLeadsStatus', { status: filterLabel(filterStatus) })}
                </p>
                {filterStatus === 'all' && campaign.source !== 'manual' && (
                  scrape.running ? (
                    <button disabled title={t('scrape.oneAtATime')} className="mt-5 px-4 py-2 bg-zinc-200 dark:bg-zinc-700 text-zinc-500 font-medium rounded-xl cursor-not-allowed text-sm">{t('scrape.inProgress')}</button>
                  ) : (
                    <button onClick={startScrape} className="mt-5 px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold rounded-xl transition-all shadow-sm shadow-emerald-600/20 text-sm inline-flex items-center gap-1.5">
                      <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                      {t('campaign.findClients')}
                    </button>
                  )
                )}
              </div>
            ) : (
              <ul>
                {filteredLeads.map(lead => {
                  const active = selectedLead?.id === lead.id;
                  const job = genJobForLead(lead.id);
                  return (
                    <li key={lead.id}>
                      <button
                        id={`lead-card-${lead.id}`}
                        onClick={() => selectLead(lead.id)}
                        className={`w-full flex items-center gap-3 px-5 py-3.5 text-start border-b border-zinc-100 dark:border-zinc-800 transition-all ${active ? 'bg-emerald-500/[0.07] dark:bg-emerald-500/[0.08] shadow-[inset_3px_0_0_#10b981]' : 'hover:bg-zinc-50 dark:hover:bg-zinc-900/60'} ${highlightedLead === lead.id ? 'ring-2 ring-inset ring-emerald-400/60' : ''}`}
                      >
                        <SafeImg
                          src={leadFeaturedImage(lead)}
                          alt={lead.business.name}
                          className="block w-14 h-14 rounded-xl overflow-hidden shrink-0 bg-zinc-200 dark:bg-zinc-700"
                          imgClassName="w-14 h-14 object-cover"
                          fallback={<span className="w-14 h-14 rounded-xl flex items-center justify-center bg-zinc-200 dark:bg-zinc-700 text-lg font-semibold text-zinc-400 dark:text-zinc-600">{(lead.business.name || '?').slice(0, 1)}</span>}
                        />
                        <span className="flex-1 min-w-0">
                          <span className={`block text-[15px] font-semibold truncate ${lead.deleted ? 'text-zinc-400 line-through' : 'text-zinc-900 dark:text-white'}`}>{lead.business.name}</span>
                          <span className="block text-[12px] text-zinc-500 dark:text-zinc-400 truncate">{lead.business.category || cleanAddress(lead.business.address || '')}</span>
                          <span className="mt-0.5 flex items-center gap-1 text-[12px] text-zinc-500 dark:text-zinc-400">
                            <svg className="w-3 h-3 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                            <span className="font-mono">{lead.business.rating}</span>
                            <span className="font-mono text-zinc-400 dark:text-zinc-500">({lead.business.ratingCount})</span>
                          </span>
                        </span>
                        <span className="shrink-0 flex flex-col items-end gap-1.5">
                          {job ? (
                            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wide bg-emerald-500/15 text-emerald-700 dark:text-emerald-300">
                              <span className="animate-spin w-2.5 h-2.5 rounded-full border-2 border-emerald-500 border-t-transparent" />AI
                            </span>
                          ) : (lead.landingPage || lead.deployment) && !lead.deleted ? (
                            <span className="px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wide bg-zinc-900 text-white dark:bg-white dark:text-zinc-900">{lead.deployment ? t('campaign.live') : t('campaign.siteDraft')}</span>
                          ) : null}
                          <span className={`px-2 py-0.5 rounded-md text-[10px] font-semibold uppercase tracking-wide ${lead.deleted ? 'bg-zinc-200 text-zinc-500 dark:bg-zinc-700 dark:text-zinc-400' : lead.status === 'pending' ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300' : 'bg-zinc-100 text-zinc-600 dark:bg-zinc-700 dark:text-zinc-300'}`}>
                            {statusLabel(lead)}
                          </span>
                        </span>
                      </button>
                    </li>
                  );
                })}
              </ul>
            )}
          </div>

          {campaign.source === 'manual' && (
            <div className="shrink-0 p-3 border-t border-zinc-200 dark:border-zinc-700/50">
              <button
                onClick={() => { setManualRows([{ name: '', mapsUrl: '' }]); setShowAddClients(true); }}
                className="w-full h-10 inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 text-sm font-semibold transition-all"
              >
                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 4v16m8-8H4" /></svg>
                {t('campaign.addClients')}
              </button>
            </div>
          )}
        </aside>

        {/* ── Center: map ── */}
        <section className="hidden lg:block flex-1 min-w-0 relative bg-zinc-100 dark:bg-zinc-950">
          <CampaignMap
            dark={theme === 'dark'}
            selectedId={selectedLead?.id ?? null}
            onSelect={(leadId) => selectLead(leadId, false)}
            leads={filteredLeads.map(l => ({
              id: l.id,
              name: l.business.name,
              rating: l.business.rating,
              lat: l.business.latitude,
              lng: l.business.longitude,
              tone: mapTone(l),
            }))}
          />
          {detailHidden && !scraping && (
            <button
              onClick={() => setDetailHidden(false)}
              title={t('campaign.showDetails')}
              className="absolute top-3 end-3 z-10 max-w-[260px] inline-flex items-center gap-2 h-9 ps-3 pe-3.5 rounded-xl bg-white/95 dark:bg-zinc-900/95 border border-zinc-200 dark:border-zinc-700/60 shadow-lg backdrop-blur-sm text-sm font-medium text-zinc-700 dark:text-zinc-200 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
            >
              <svg className="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 5v14M5 12h14" /></svg>
              <span className="truncate">{selectedLead?.business.name || t('campaign.showDetails')}</span>
            </button>
          )}
        </section>

        {/* ── Right: lead details (desktop) ── */}
        <aside className={`hidden ${detailHidden && !scraping ? '' : 'lg:flex'} w-[400px] xl:w-[420px] shrink-0 flex-col min-h-0 border-s border-zinc-200 dark:border-zinc-700/50`}>
          {scraping ? (
            <div className="flex-1 min-h-0 overflow-y-auto flex flex-col p-5"><ScrapeProgressPanel campaignId={id} /></div>
          ) : selectedLead ? (
            detailFor(selectedLead)
          ) : (
            <div className="flex-1 flex items-center justify-center p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">{t('campaign.selectLead')}</div>
          )}
        </aside>
      </div>

      {/* Lead details (mobile sheet) */}
      {mobileDetailOpen && selectedLead && (
        <div className="lg:hidden fixed inset-0 z-[105] bg-white dark:bg-zinc-950">
          {detailFor(selectedLead)}
        </div>
      )}

      {/* Full-size photo from the lead panel */}
      {viewImage && !showImagesModal && (
        <div className="lm-fade-in fixed inset-0 z-[220] bg-zinc-950/90 backdrop-blur-sm flex items-center justify-center p-6" onClick={() => setViewImage(null)}>
          <SafeImg
            src={viewImage}
            className="block max-w-full max-h-full"
            imgClassName="lm-pop-in max-w-full max-h-[90vh] rounded-2xl shadow-2xl shadow-black/50 select-none"
            fallback={<div className="text-zinc-400 p-12">{t('campaign.imageUnavailable')}</div>}
          />
          <button onClick={(e) => { e.stopPropagation(); setViewImage(null); }} className="absolute top-4 end-4 w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white backdrop-blur flex items-center justify-center transition-colors" title={t('campaign.close')}>
            <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
      )}

      {/* Modify Studio: fullscreen chat + live preview */}
      {studioLeadId && (() => {
        const sl = allLeads.find((l: any) => l.id === studioLeadId);
        if (!sl) return null;
        const liveJob = generation.jobs.find(j => j.leadId === sl.id && (j.kind === 'modify' || j.kind === 'generate') && j.phase !== 'done' && j.phase !== 'error') || null;
        const publishJob = generation.jobs.find(j => j.leadId === sl.id && (j.kind === 'publish' || j.kind === 'unpublish') && j.phase !== 'done' && j.phase !== 'error') || null;
        const errorJob = !liveJob ? (generation.jobs.find(j => j.leadId === sl.id && (j.kind === 'modify' || j.kind === 'generate' || j.kind === 'publish') && j.phase === 'error') || null) : null;
        const lastJobVersionId = generation.jobs.find(j => j.leadId === sl.id && j.phase === 'done' && j.versionId)?.versionId ?? null;
        const studioHistory = sl.deploymentHistory || [];
        const studioMainUrl = mainSiteUrl(sl);
        return (
          <ModifyStudio
            campaignId={id}
            leadId={sl.id}
            businessName={sl.business.name}
            mainUrl={studioMainUrl}
            deployments={studioHistory}
            images={activeImages(sl.images)}
            uploading={uploading}
            liveJob={liveJob}
            publishJob={publishJob}
            lastJobVersionId={lastJobVersionId}
            error={errorJob ? (resolveJobMessage(errorJob, t) || null) : null}
            onDismissError={errorJob ? () => generation.dismissJob(errorJob.id) : undefined}
            failedRequest={errorJob?.input && errorJob.kind !== 'publish' ? {
              // Only a modify's text/notes can go back into the composer; a regenerate's
              // instructions are just shown (Retry re-runs the regenerate itself).
              prompt: errorJob.kind === 'modify' ? errorJob.input.userPrompt || '' : '',
              display: errorJob.userPrompt || '',
              notes: errorJob.kind === 'modify' ? errorJob.input.notes || [] : [],
              cancelled: errorJob.messageKey === 'campaign.cancelled',
            } : null}
            onRetry={errorJob?.input ? () => generation.retryJob(errorJob.id) : undefined}
            onCancelJob={liveJob ? () => generation.cancelJob(liveJob.id) : undefined}
            onSend={sendStudioPrompt}
            onPublish={publishStudioVersion}
            onUploadImages={(files) => uploadFilesForLead(sl, files)}
            onDeleteImage={(imageId) => deleteLeadImage(sl.id, imageId)}
            onSetMain={(entryId) => setMainDeployment(sl.id, entryId)}
            onClose={closeStudio}
          />
        );
      })()}

      {/* Add Clients Modal (manual campaigns) */}
      <Modal open={showAddClients} onClose={() => setShowAddClients(false)} dismissible={!resolvingClients} size="lg" z="z-[110]">
        <ModalHeader
          icon="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
          title={t('campaign.addClients')}
          description={t('home.ownClientsDesc')}
          onClose={resolvingClients ? undefined : () => setShowAddClients(false)}
        />
        <ModalBody className="space-y-2">
          {manualRows.map((r, i) => (
            <div key={i} className="flex gap-2 items-end rounded-xl border border-zinc-200 dark:border-zinc-800 p-3">
              <span className="mb-2.5 w-5 shrink-0 text-center text-[11px] font-semibold text-zinc-400">{i + 1}</span>
              <div className="flex-1 min-w-0 grid gap-3 grid-cols-1 sm:grid-cols-2">
                <div>
                  <label className={field.label}>{t('home.businessName')}</label>
                  <input value={r.name} onChange={e => updateManualRow(i, { name: e.target.value })} placeholder={t('home.businessNamePlaceholder')} disabled={resolvingClients} className={`${field.input} disabled:opacity-50`} />
                </div>
                <div>
                  <label className={field.label}>{t('home.mapsLink')}</label>
                  <input value={r.mapsUrl} onChange={e => updateManualRow(i, { mapsUrl: e.target.value })} placeholder={t('home.mapsLinkPlaceholder')} disabled={resolvingClients} className={`${field.input} disabled:opacity-50`} />
                </div>
              </div>
              <button onClick={() => setManualRows(prev => (prev.length <= 1 ? prev : prev.filter((_, idx) => idx !== i)))} disabled={resolvingClients || manualRows.length === 1} className="mb-1 p-2 rounded-lg text-zinc-400 hover:text-red-500 hover:bg-red-500/10 transition-colors disabled:opacity-30 disabled:cursor-not-allowed shrink-0" title={t('home.removeBusiness')}>
                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
          ))}
          <button onClick={() => setManualRows(prev => [...prev, { name: '', mapsUrl: '' }])} disabled={resolvingClients} className="w-full h-10 rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors disabled:opacity-40 inline-flex items-center justify-center gap-2">
            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 4v16m8-8H4" /></svg>
            {t('home.addBusiness')}
          </button>
        </ModalBody>
        <ModalFooter>
          <button onClick={() => setShowAddClients(false)} disabled={resolvingClients} className={btn.secondary}>{t('campaign.generateCancel')}</button>
          <button onClick={submitAddClients} disabled={resolvingClients || !manualRows.some(r => r.name.trim() && r.mapsUrl.trim())} className={btn.primary}>
            {resolvingClients && <span className="animate-spin w-4 h-4 rounded-full border-2 border-white border-t-transparent" />}
            {resolvingClients ? t('home.resolvingClients') : t('campaign.addClients')}
          </button>
        </ModalFooter>
      </Modal>

      {/* Generate Modal */}
      <Modal open={!!(showGenerateModal && generateLeadId)} onClose={() => setShowGenerateModal(false)} size="md" z="z-[110]">
        <ModalHeader
          icon="M13 10V3L4 14h7v7l9-11h-7z"
          title={t('campaign.generateTitle')}
          description={t('campaign.generateDesc')}
          onClose={() => setShowGenerateModal(false)}
        />
        <ModalBody>
          <label className={field.label}>{t('campaign.generateLabel')}</label>
          <textarea value={generatePrompt} onChange={e => setGeneratePrompt(e.target.value)} placeholder={t('campaign.generatePlaceholder')} className={`${field.textarea} h-36 resize-y`} autoFocus />
        </ModalBody>
        <ModalFooter>
          <button onClick={() => setShowGenerateModal(false)} className={btn.secondary}>{t('campaign.generateCancel')}</button>
          <button onClick={submitGenerate} className={btn.primary}>
            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            {t('campaign.generateConfirm')}
          </button>
        </ModalFooter>
      </Modal>

      {/* Images Modal */}
      {showImagesModal && imagesLead && (
        <>
        <Modal open onClose={() => setShowImagesModal(false)} size="lg" z="z-[110]">
          <ModalHeader
            icon="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            title={t('campaign.imagesTitle', { name: imagesLead.business.name })}
            description={t('campaign.imagesDesc', { max: MAX_LEAD_IMAGES })}
            onClose={() => setShowImagesModal(false)}
          >
            <div className="mt-4 flex gap-1 p-1 rounded-xl bg-zinc-100 dark:bg-zinc-800/70 w-fit max-w-full overflow-x-auto">
              {([
                ['uploaded', t('campaign.imagesTabUploaded'), modalActiveImages.length],
                ['discovered', t('campaign.imagesTabDiscovered'), (imagesLead.business.scrapedImages || []).length],
                ['deleted', t('campaign.imagesTabDeleted'), modalDeletedImages.length],
              ] as const).map(([tab, label, count]) => (
                <button key={tab} onClick={() => setImagesTab(tab)} className={`shrink-0 inline-flex items-center gap-1.5 h-8 px-3 rounded-[10px] text-xs font-medium transition-all ${imagesTab === tab ? 'bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white shadow-sm' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200'}`}>
                  {label}<span className="tabular-nums text-zinc-400">{count}</span>
                </button>
              ))}
            </div>
          </ModalHeader>
          <ModalBody>

              {imagesTab === 'uploaded' ? (
                <>
                  {modalActiveImages.length > 0 && (
                    <div className="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
                      {modalActiveImages.map((img) => (
                        <div key={img.id} className="relative group bg-zinc-100 dark:bg-zinc-950 rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-800 [content-visibility:auto] [contain-intrinsic-size:180px]">
                          <SafeImg
                            src={img.url}
                            alt={img.alt}
                            className="block w-full h-32"
                            imgClassName="w-full h-32 object-cover"
                            fallback={
                              <div className="w-full h-32 flex items-center justify-center text-zinc-400 dark:text-zinc-600">
                                <svg className="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                              </div>
                            }
                          />
                          <div className="p-2">
                            <input value={img.alt} onChange={(e) => { const newAlt = e.target.value; setImagesLead((prev) => { if (!prev) return prev; return { ...prev, images: prev.images?.map(i => i.id === img.id ? { ...i, alt: newAlt } : i) }; });                         fetch(`/api/campaigns/${id}/leads/${imagesLead.id}/images`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageId: img.id, alt: newAlt }) }); }} placeholder={t('campaign.altTextPlaceholder')} className="w-full text-[11px] bg-transparent text-zinc-500 dark:text-zinc-400 placeholder-zinc-400 dark:placeholder-zinc-600 border-b border-zinc-200 dark:border-zinc-700 focus:border-emerald-500 focus:outline-none py-1" />
                          </div>
                          <button onClick={() => deleteLeadImage(imagesLead.id, img.id)} className="absolute top-1.5 end-1.5 w-7 h-7 rounded-lg bg-zinc-950/70 backdrop-blur text-white opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-600 flex items-center justify-center" title={t('campaign.delete')}><svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg></button>
                        </div>
                      ))}
                    </div>
                  )}
                  {modalActiveImages.length < MAX_LEAD_IMAGES && (
                    <div className="border-2 border-dashed border-zinc-300 dark:border-zinc-700 rounded-xl p-6 text-center hover:border-emerald-500/50 transition-colors">
                      <input type="file" accept="image/*" multiple onChange={async (e) => { const files = Array.from(e.target.files || []); e.target.value = ''; await handleFileUpload(files); }} className="hidden" id="image-upload" />
                      <label htmlFor="image-upload" className="cursor-pointer flex flex-col items-center gap-2">
                        <svg className="w-8 h-8 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        <span className="text-sm text-zinc-500 dark:text-zinc-400">{uploading ? t('campaign.uploading') : t('campaign.uploadLabel')}</span>
                        <span className="text-[11px] text-zinc-400 dark:text-zinc-600">{t('campaign.slotsRemaining', { count: MAX_LEAD_IMAGES - modalActiveImages.length })}</span>
                      </label>
                    </div>
                  )}
                </>
              ) : imagesTab === 'deleted' ? (
                <>
                  {modalDeletedImages.length === 0 ? (
                    <p className="text-sm text-zinc-500 dark:text-zinc-400 text-center py-8">{t('campaign.noDeletedImages')}</p>
                  ) : (
                    <div className="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-3 gap-3">
                      {modalDeletedImages.map((img) => (
                        <div key={img.id} className="relative group bg-zinc-100 dark:bg-zinc-950 rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-800 opacity-80 [content-visibility:auto] [contain-intrinsic-size:180px]">
                          <SafeImg
                            src={img.url}
                            alt={img.alt}
                            className="block w-full h-32"
                            imgClassName="w-full h-32 object-cover grayscale"
                            fallback={
                              <div className="w-full h-32 flex items-center justify-center text-zinc-400 dark:text-zinc-600">
                                <svg className="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                              </div>
                            }
                          />
                          <div className="p-2">
                            <p className="text-[11px] text-zinc-500 dark:text-zinc-400 truncate" title={img.alt}>{img.alt}</p>
                            <button
                              onClick={() => restoreLeadImage(imagesLead.id, img.id)}
                              disabled={modalActiveImages.length >= MAX_LEAD_IMAGES}
                              className="mt-1.5 w-full px-2 py-1 text-[11px] font-medium bg-emerald-600/15 text-emerald-600 dark:text-emerald-400 rounded-lg hover:bg-emerald-600/25 transition-all disabled:opacity-40 disabled:cursor-not-allowed"
                            >
                              {t('campaign.restore')}
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </>
              ) : (
                (() => {
                  const scrapedImages = imagesLead.business.scrapedImages || [];
                  const remaining = MAX_LEAD_IMAGES - activeImages(imagesLead.images).length;
                  const allSelected = scrapedImages.length > 0 && scrapedImages.every(s => selectedScraped.has(s.id));
                  if (scrapedImages.length === 0) {
                    return <p className="text-sm text-zinc-500 dark:text-zinc-400 text-center py-8">{t('campaign.noDiscovered')}</p>;
                  }
                  return (
                    <>
                      <p className="text-xs text-zinc-500 dark:text-zinc-400 mb-3">{t('campaign.discoveredDesc', { count: remaining })}</p>
                      <div className="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
                        {scrapedImages.map((img) => {
                          const selected = selectedScraped.has(img.id);
                          const done = importedScrapedIds.has(img.id);
                          return (
                            <div key={img.id} className={`relative group bg-zinc-100 dark:bg-zinc-900 rounded-xl overflow-hidden border transition-all [content-visibility:auto] [contain-intrinsic-size:180px] ${selected ? 'border-emerald-500 ring-2 ring-emerald-500/40' : 'border-zinc-200 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500'}`}>
                              <div className="block w-full">
                                <button
                                  type="button"
                                  onClick={() => { if (!done) { setSelectedScraped(prev => { const next = new Set(prev); if (next.has(img.id)) next.delete(img.id); else if (next.size < remaining) next.add(img.id); return next; }); } }}
                                  className="block w-full cursor-pointer"
                                  title={t('campaign.toggleSelect')}
                                >
                                  <SafeImg
                                    src={img.url}
                                    className="block w-full h-32"
                                    imgClassName="w-full h-32 object-cover"
                                    fallback={
                                      <div className="w-full h-32 flex items-center justify-center text-zinc-400 dark:text-zinc-600">
                                        <svg className="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                      </div>
                                    }
                                  />
                                </button>
                                {selected && !done && (
                                  <div className="absolute inset-0 ring-2 ring-inset ring-emerald-500/70 bg-emerald-500/10 pointer-events-none" />
                                )}
                              </div>
                              <button type="button" onClick={() => setViewImage(img.url)} title={t('campaign.viewFullSize')} className="absolute top-1 right-1 w-6 h-6 bg-black/60 hover:bg-black/80 text-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                              </button>
                              {done && <div className="absolute bottom-0 inset-x-0 bg-emerald-600/90 text-white text-[10px] text-center py-0.5">{t('campaign.alreadyUploaded')}</div>}
                            </div>
                          );
                        })}
                      </div>
                      <div className="flex items-center justify-between gap-2 flex-wrap">
                        <button onClick={() => { if (allSelected) { setSelectedScraped(new Set()); } else { setSelectedScraped(new Set(scrapedImages.filter(s => !importedScrapedIds.has(s.id)).slice(0, remaining).map(s => s.id))); } }} className={btn.secondary}>
                          {allSelected ? t('campaign.deselectAll') : t('campaign.selectAll')}
                        </button>
                        <button onClick={importSelectedImages} disabled={importing || selectedScraped.size === 0 || remaining <= 0} className={btn.primary}>
                          {importing ? t('campaign.importing') : t('campaign.uploadSelected', { count: selectedScraped.size })}
                        </button>
                      </div>
                    </>
                  );
                })()
              )}
          </ModalBody>
          <ModalFooter>
            <button onClick={() => setShowImagesModal(false)} className={btn.primary}>{t('campaign.done')}</button>
          </ModalFooter>
        </Modal>

          {viewImage && (
            <div className="lm-fade-in fixed inset-0 z-[220] bg-zinc-950/90 backdrop-blur-sm flex items-center justify-center p-6" onClick={() => setViewImage(null)}>
              <SafeImg
                src={viewImage}
                className="block max-w-full max-h-full"
                imgClassName="lm-pop-in max-w-full max-h-[90vh] rounded-2xl shadow-2xl shadow-black/50 select-none"
                fallback={<div className="text-zinc-400 p-12">{t('campaign.imageUnavailable')}</div>}
              />
              <button onClick={(e) => { e.stopPropagation(); setViewImage(null); }} className="absolute top-4 end-4 w-10 h-10 rounded-xl bg-white/10 hover:bg-white/20 text-white backdrop-blur flex items-center justify-center transition-colors" title={t('campaign.close')}>
                <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
          )}
        </>
      )}

      {domainEditLeadId && (() => {
        const dl = allLeads.find((l: any) => l.id === domainEditLeadId);
        if (!dl) return null;
        const av = domainAvailability[domainEditLeadId];
        const closeDomain = () => { setDomainEditLeadId(null); setPendingGenerateLeadId(null); };
        return (
          <Modal open onClose={closeDomain} size="sm" z="z-[130]">
            <ModalHeader
              icon="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
              title={t('campaign.changeSubDomain')}
              description={dl.business.name}
              onClose={closeDomain}
            />
            <ModalBody>
              <div className="flex items-center gap-1.5 h-10 px-3.5 rounded-xl border border-zinc-200 dark:border-zinc-700/80 bg-white dark:bg-zinc-950/60 focus-within:ring-2 focus-within:ring-emerald-500/40 focus-within:border-emerald-500 transition-all">
                <span className="text-xs text-zinc-400 shrink-0">https://</span>
                <input
                  value={domainDraft[domainEditLeadId] || ''}
                  onChange={e => onDomainDraftChange(domainEditLeadId, e.target.value)}
                  onKeyDown={e => { if (e.key === 'Enter') saveDomain(dl); }}
                  autoFocus
                  placeholder="my-domain"
                  className="flex-1 min-w-0 bg-transparent text-sm text-zinc-900 dark:text-white focus:outline-none placeholder-zinc-400 dark:placeholder-zinc-600"
                />
                <span className="text-xs text-zinc-400 shrink-0">.vercel.app</span>
              </div>
              <div className="mt-2 h-4 text-[11px] font-medium">
                {av?.checking ? (
                  <span className="text-zinc-500 dark:text-zinc-400 animate-pulse">Checking…</span>
                ) : av?.available ? (
                  <span className="text-emerald-600 dark:text-emerald-400">Available</span>
                ) : av?.available === false ? (
                  <span className="text-red-600 dark:text-red-400">Taken</span>
                ) : av?.error ? (
                  <span className="text-zinc-600 dark:text-zinc-300">{av.error}</span>
                ) : null}
              </div>
              <div className="mt-3 flex items-start gap-2 text-[11px] text-zinc-600 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800/60 rounded-lg px-3 py-2">
                <svg className="w-3.5 h-3.5 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                <span>{t('campaign.subDomainLockWarning')}</span>
              </div>
            </ModalBody>
            <ModalFooter>
              <button onClick={closeDomain} className={btn.secondary}>{t('campaign.cancel')}</button>
              <button onClick={() => saveDomain(dl)} disabled={av?.checking} className={btn.primary}>{t('campaign.confirm')}</button>
            </ModalFooter>
          </Modal>
        );
      })()}

      {/* Floating actions — above ScrollToTop (bottom-5): + for manual, then map */}
      {(campaign as any)?.source === 'manual' && (
        <button
          onClick={() => { setManualRows([{ name: '', mapsUrl: '' }]); setShowAddClients(true); }}
          aria-label={t('campaign.addClients')}
          title={t('campaign.addClients')}
          className="lg:hidden fixed bottom-[132px] end-5 z-[120] w-10 h-10 rounded-full bg-emerald-500 text-white shadow-lg shadow-emerald-500/30 flex items-center justify-center hover:bg-emerald-400 hover:scale-110 transition-all"
        >
          <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 4v16m8-8H4" /></svg>
        </button>
      )}
      <button
        onClick={() => {
          if (Array.isArray((campaign as any)?.regions) && (campaign as any).regions.length > 1) {
            toast('Interactive map is not available for multi-regional campaigns', 'error');
            return;
          }
          setInteractiveMapOpen(true);
        }}
        aria-label="Interactive map"
        title={Array.isArray((campaign as any)?.regions) && (campaign as any).regions.length > 1 ? 'Interactive map not available for multi-regional' : 'Interactive map'}
        className={`lg:hidden fixed bottom-[76px] end-5 z-[120] w-10 h-10 rounded-full shadow-lg flex items-center justify-center transition-all duration-300 hover:scale-110 ${Array.isArray((campaign as any)?.regions) && (campaign as any).regions.length > 1 ? 'bg-zinc-400 text-white opacity-60' : 'bg-emerald-500 text-white shadow-emerald-500/30 hover:bg-emerald-400 hover:scale-110'}`}
      >
        <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
      </button>
      <InteractiveMap open={interactiveMapOpen} onClose={() => setInteractiveMapOpen(false)} campaign={campaign} />
    </div>
  );
}
