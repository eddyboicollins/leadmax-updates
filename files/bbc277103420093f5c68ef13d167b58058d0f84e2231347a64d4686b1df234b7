import { NextRequest } from 'next/server';
import { getCampaign, getLead, getSettings, updateLeadLandingPage, addDeploymentEntry, createLeadGeneration } from '@/lib/store';
import { deployLandingPageWithAutoFix, type DeployProgressEvent } from '@/lib/deploy-with-fix';
import { parseChunks } from '@/lib/chunks';
import { slugifyProjectName, resolveDeploymentUrl } from '@/lib/vercel-deploy';
import type { GeminiModel } from '@/lib/gemini';
import { v4 as uuidv4 } from 'uuid';

export const maxDuration = 300;

function sseEncode(event: DeployProgressEvent | Record<string, unknown>): string {
  return `data: ${JSON.stringify(event)}\n\n`;
}

export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  const { id, leadId } = await params;
  const body = await request.json().catch(() => ({}));
  const userPrompt: string | undefined = body.userPrompt || undefined;
  const campaign = await getCampaign(id);

  const lead = await getLead(leadId);
  if (!lead) {
    return new Response(sseEncode({ step: 'error', message: 'Lead not found' }), { status: 404 });
  }

  const page = lead.landingPage;
  if (!page) {
    return new Response(sseEncode({ step: 'error', message: 'No landing page to deploy. Generate one first.' }), { status: 400 });
  }

  const rawTsx = page.tsx || (page as { html?: string }).html;
  if (!rawTsx) {
    return new Response(sseEncode({ step: 'error', message: 'No component code found.' }), { status: 400 });
  }

  const settings = await getSettings();
  const vercelToken = settings.vercelToken || '';
  if (!vercelToken) {
    return new Response(sseEncode({ step: 'error', message: 'No Vercel token configured. Go to Settings to add your token.' }), { status: 400 });
  }

  const projectName = (lead.deploymentName || slugifyProjectName(lead.business.name));
  const encoder = new TextEncoder();

  const stream = new ReadableStream({
    async start(controller) {
      const send = (event: DeployProgressEvent | Record<string, unknown>) => {
        try { controller.enqueue(encoder.encode(sseEncode(event))); } catch { /* client disconnected */ }
      };

      try {
        const result = await deployLandingPageWithAutoFix({
          vercelToken,
          geminiApiKey: settings.geminiApiKey || '',
          geminiModel: settings.geminiModel as GeminiModel,
          geminiSource: settings.geminiSource || 'proxy',
          projectName,
          tsx: rawTsx,
          onProgress: send,
        });

        const updatedLp = {
          tsx: result.tsx,
          generatedAt: page.generatedAt,
          version: (page.version || 0) + (result.tsx !== rawTsx ? 1 : 0),
          sections: page.sections || [],
          chunked: parseChunks(result.tsx) !== null,
        };

        await updateLeadLandingPage(leadId, updatedLp);

        if (result.success && result.url) {
          const aliasUrl = result.url;
          await addDeploymentEntry(leadId, {
            id: uuidv4(),
            vercelDeploymentId: result.deploymentId || '',
            url: result.deploymentUrl || result.url,
            aliasUrl,
            deployedAt: new Date().toISOString(),
            userPrompt,
            isMain: true,
            tsx: result.tsx,
          });
          await createLeadGeneration({
            leadId,
            campaignId: id,
            landingPageCode: result.tsx,
            deploymentUrl: result.url,
            projectName,
          });
        }

        send({
          step: 'complete',
          message: result.success ? 'Your website is online!' : (result.error || 'Could not put the website online'),
          success: result.success,
          url: result.url,
          attempts: result.attempts,
          error: result.error,
          lastLogs: result.lastLogs,
        });
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : 'Deployment failed';
        send({ step: 'error', message, error: message });
        send({ step: 'complete', message, success: false, error: message });
      } finally {
        try { controller.close(); } catch { /* client disconnected */ }
      }
    },
  });

  return new Response(stream, {
    headers: {
      'Content-Type': 'text/event-stream; charset=utf-8',
      'Cache-Control': 'no-cache, no-transform',
      Connection: 'keep-alive',
    },
  });
}
