      max-width: 100%;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 4px 0;
      color: #52525b;
      font-size: 10.5px;
    }

    .summary-value {
      text-align: right;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .total-row {
      margin-top: 3px;
      padding-top: 8px;
      border-top: 2px solid #18181b;
      color: #18181b;
      font-size: 15px;
      font-weight: 800;
    }

    /* =================================
       FOOTER
       ================================= */

    .footer {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      margin-top: auto;
      padding-top: 13px;
      border-top: 1px solid #d4d4d8;
      text-align: center;
    }

    .footer-main {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      width: 100%;
    }

    .footer-seller {
      display: none;
    }

    .footer-title {
      margin-bottom: 3px;
      color: #71717a;
      font-size: 8px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      text-align: center;
    }

    .footer-text {
      color: #52525b;
      font-size: 9px;
      line-height: 1.45;
      text-align: center;
      max-width: 520px;
    }

    .footer-text strong {
      color: #27272a;
    }

    .thank-you {
      text-align: center;
      color: #18181b;
      font-size: 9.5px;
      font-weight: 600;
    }

    /* =================================
       SCREEN RESPONSIVE
       ================================= */

    @media screen and (max-width: 900px) {
      html,
      body {
        background: #ffffff;
      }

      .invoice {
        width: 100%;
        min-height: 100vh;
        margin: 0;
        padding: 25px 20px;
        box-shadow: none;
      }
    }

    @media screen and (max-width: 650px) {
      .header {
        flex-direction: column;
        gap: 20px;
      }

      .seller,
      .invoice-info {
        max-width: 100%;
        width: 100%;
      }

      .invoice-info {
        flex-basis: auto;
        text-align: left;
      }

      .invoice-date {
        justify-content: flex-start;
      }

      .billing {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .items thead th,
      .items tbody td {
        padding: 8px 6px;
      }

      .items tbody td {
        font-size: 10px;
      }

      .summary {
        justify-content: stretch;
      }

      .summary-box {
        width: 100%;
      }
    }

    /* =================================
       PRINT
       ================================= */

    @media print {
      html,
      body {
        width: 210mm;
        min-height: 297mm;
        margin: 0;
        padding: 0;
        background: #ffffff;
      }

      body {
        font-size: 12px;
      }

      .invoice {
        width: 100%;
        min-height: 273mm;
        margin: 0;
        padding: 0;
        box-shadow: none;
        display: flex;
        flex-direction: column;
      }

      a {
        text-decoration: none !important;
      }

      .items thead th {
        background: #18181b !important;
        color: #ffffff !important;
      }

      .items tbody tr,
      .footer,
      .summary,
      .billing {
        page-break-inside: avoid;
      }
    }

    @page {
      size: A4;
      margin: 12mm 14mm;
    }

  </style>

