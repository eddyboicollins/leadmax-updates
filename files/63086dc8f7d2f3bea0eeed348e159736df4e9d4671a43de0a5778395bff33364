import { sanitizeGeneratedTsx, buildDeployFixPrompt, askGeminiAndValidate, TruncatedCodeError } from '@/lib/prompts';
import { getSettings, ensureFreshVisionCreds } from '@/lib/store';
import {
  createVercelDeployment,
  waitForVercelDeployment,
  getVercelBuildLogs,
  disableVercelProjectProtection,
  resolveDeploymentUrl,
  assignVercelAlias,
} from '@/lib/vercel-deploy';

export interface DeployWithFixResult {
  success: boolean;
  url?: string;
  deploymentUrl?: string;
  deploymentId?: string;
  projectName: string;
  attempts: number;
  tsx: string;
  error?: string;
  lastLogs?: string;
}

export type DeployProgressEvent = {
  step: 'deploying' | 'build_failed' | 'fixing' | 'gemini_retry' | 'success' | 'complete' | 'error';
  message: string;
  attempt?: number;
  maxAttempts?: number;
  url?: string;
  error?: string;
};

const DEFAULT_MAX_ATTEMPTS = 4;

export async function deployLandingPageWithAutoFix(opts: {
  vercelToken: string;
  projectName: string;
  tsx: string;
  maxAttempts?: number;
  onProgress?: (event: DeployProgressEvent) => void;
}): Promise<DeployWithFixResult> {
  const maxAttempts = opts.maxAttempts ?? DEFAULT_MAX_ATTEMPTS;
  let currentTsx: string;
  try {
    currentTsx = sanitizeGeneratedTsx(opts.tsx);
  } catch (err) {
    if (err instanceof TruncatedCodeError) {
      return {
        success: false,
        projectName: opts.projectName,
        attempts: 1,
        tsx: opts.tsx,
        error: 'The generated code is incomplete (truncated by AI). Please try generating again.',
        lastLogs: '',
      };
    }
    throw err;
  }
  let lastLogs = '';

  const progress = (event: DeployProgressEvent) => opts.onProgress?.(event);

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    let componentCode: string;
    try {
      componentCode = sanitizeGeneratedTsx(currentTsx);
    } catch (err) {
      if (err instanceof TruncatedCodeError) {
        return {
          success: false,
          projectName: opts.projectName,
          attempts: attempt,
          tsx: currentTsx,
          error: 'AI response was truncated. Please try generating again.',
          lastLogs,
        };
      }
      throw err;
    }

    progress({
      step: 'deploying',
      message: attempt === 1 ? 'Putting your website online' : 'Trying to put the website online again',
      attempt,
      maxAttempts,
    });

    let deployment;
    try {
      deployment = await createVercelDeployment(opts.vercelToken, opts.projectName, componentCode);
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : String(err);
      progress({ step: 'error', message: msg, attempt, maxAttempts, error: msg });
      return {
        success: false,
        projectName: opts.projectName,
        attempts: attempt,
        tsx: currentTsx,
        error: msg,
        lastLogs,
      };
    }

    const finished = await waitForVercelDeployment(opts.vercelToken, deployment.id);

    if (finished.readyState === 'READY') {
      await disableVercelProjectProtection(opts.vercelToken, opts.projectName);
      // Assign the clean alias (<projectName>.vercel.app) to this deployment so
      // the main URL is the stable subdomain, not the unique build URL.
      let aliasAssigned = false;
      try {
        await assignVercelAlias(opts.vercelToken, opts.projectName, deployment.id);
        aliasAssigned = true;
      } catch {
        // Best-effort: if the alias is taken or assignment fails, fall back.
      }
      const deploymentUrl = resolveDeploymentUrl(finished, opts.projectName);
      const url = aliasAssigned
        ? `https://${opts.projectName}.vercel.app`
        : deploymentUrl;
      progress({
        step: 'success',
        message: 'Your website is online!',
        attempt,
        maxAttempts,
        url,
      });
      return {
        success: true,
        url,
        deploymentUrl,
        deploymentId: deployment.id,
        projectName: opts.projectName,
        attempts: attempt,
        tsx: componentCode,
      };
    }

    lastLogs = await getVercelBuildLogs(opts.vercelToken, deployment.id);

    progress({
      step: 'build_failed',
      message: 'Something went wrong, fixing it',
      attempt,
      maxAttempts,
    });

    if (attempt >= maxAttempts) {
      const errMsg = finished.errorMessage || 'Vercel build failed after maximum fix attempts';
      progress({ step: 'error', message: errMsg, attempt, maxAttempts, error: errMsg });
      return {
        success: false,
        projectName: opts.projectName,
        attempts: attempt,
        tsx: componentCode,
        error: errMsg,
        lastLogs,
      };
    }

    progress({
      step: 'fixing',
      message: 'Fixing your website',
      attempt,
      maxAttempts,
    });

    const fixPrompt = buildDeployFixPrompt(componentCode, lastLogs);
    try {
      await getSettings();
      const creds = await ensureFreshVisionCreds();
      if (!creds) throw new Error('Gemini session expired and could not be renewed. Paste fresh cookie values in Settings → AI Vision.');
      currentTsx = await askGeminiAndValidate(
        fixPrompt,
        4,
        (retry, maxRetry, err) => {
          progress({
            step: 'gemini_retry',
            message: `Gemini retry ${retry}/${maxRetry}: ${err}`,
            attempt,
            maxAttempts,
          });
        },
        [],
        creds,
      );
    } catch (err: unknown) {
      const msg = err instanceof Error ? err.message : 'Gemini fix failed';
      progress({ step: 'error', message: `Fix attempt failed: ${msg}`, attempt, maxAttempts, error: msg });
      currentTsx = componentCode;
    }
  }

  progress({ step: 'error', message: 'Could not put the website online', attempt: maxAttempts, maxAttempts });
  return {
    success: false,
    projectName: opts.projectName,
    attempts: maxAttempts,
    tsx: currentTsx,
    error: 'Deployment failed',
    lastLogs,
  };
}
