/** Named imports from lucide-react, so the CDN only ships those icons. */
function lucideImports(code: string): string[] {
  const names = new Set<string>();
  for (const m of code.matchAll(/import\s*\{([^}]*)\}\s*from\s*['"]lucide-react['"]/g)) {
    for (const part of m[1].split(',')) {
      const name = part.trim().split(/\s+as\s+/)[0]?.trim();
      if (name && /^[A-Za-z_$][\w$]*$/.test(name)) names.add(name);
    }
  }
  return [...names];
}

/** Rewrite the module's default export into a known binding. */
function captureDefaultExport(js: string): string {
  let out = js;
  let tail = '';
  const fn = out.match(/export\s+default\s+(async\s+)?function\s*\*?\s*([A-Za-z_$][\w$]*)?\s*\(/);
  if (fn) {
    if (fn[2]) {
      out = out.replace(fn[0], fn[0].replace(/^export\s+default\s+/, ''));
      tail = `\nconst __LM_Default = ${fn[2]};`;
    } else {
      out = out.replace(/export\s+default\s+/, 'const __LM_Default = ');
    }
  } else if (/export\s+default\s+class\s+([A-Za-z_$][\w$]*)/.test(out)) {
    const name = out.match(/export\s+default\s+class\s+([A-Za-z_$][\w$]*)/)![1];
    out = out.replace(/export\s+default\s+class/, 'class');
    tail = `\nconst __LM_Default = ${name};`;
  } else if (/export\s+default\s+/.test(out)) {
    out = out.replace(/export\s+default\s+/, 'const __LM_Default = ');
  } else {
    const named = out.match(/export\s*\{\s*([A-Za-z_$][\w$]*)\s+as\s+default\s*\}\s*;?/);
    if (named) {
      out = out.replace(named[0], '');
      tail = `\nconst __LM_Default = ${named[1]};`;
    } else {
      throw new Error('The component has no default export.');
    }
  }
  // Other named exports (e.g. `export const metadata`) are irrelevant here.
  out = out.replace(/^(\s*)export\s+(?=(const|let|var|function|class|async)\b)/gm, '$1');
  return out + tail;
}

export function compileForPreview(tsx: string): string {
  let source = tsx;
  try {
    source = instrumentJsx(tsx);
  } catch {
    // Syntax errors surface from the transform below with a clearer message.
  }
  const js = transform(source, {
    transforms: ['jsx', 'typescript'],
    jsxPragma: '__lmH',
    jsxFragmentPragma: '__lmF',
    production: true,
    filePath: 'page.tsx',
  }).code;
  return captureDefaultExport(js);
}

