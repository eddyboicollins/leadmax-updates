/**
 * "Hand over to client": turns a lead's generated landing page into a v0 chat
 * whose first message asks v0 to rebuild it as a full-stack site the client
 * owns: every static text/image editable from an /admin panel, contact form
 * submissions stored as leads in Neon instead of opening a mailto: link.
 *
 * With a v0 API key the chat is created through the v0 Platform API (code
 * imported as files, prompt already sent). Without one, the same prompt with
 * the code inlined is copied to the clipboard and pasted into v0 by hand.
 */
import type { Lead, V0Handover } from '@/lib/types';
import { buildLandingPageFiles, slugifyProjectName } from '@/lib/vercel-deploy';
import { getVersion } from '@/lib/site/versions';

// API v2: chats made with v1 open in v0.app as legacy chats that can't be
// continued ("Start a new chat to continue"), so the handover must use v2.
const V0_API = 'https://api.v0.dev/v2';

/** The code the user last worked on: latest local version, else the original generation. */
export async function handoverSourceCode(lead: Lead): Promise<string | null> {
  const version = await getVersion(lead);
  return version?.tsx || lead.landingPage?.tsx || null;
}

export function buildHandoverPrompt(lead: Lead, opts: { inlineFiles?: { name: string; content: string }[] } = {}): string {
  const name = lead.business.name;
  const where = opts.inlineFiles
    ? 'The code of the current site is below (Next.js App Router, Tailwind CSS v4). Recreate these files first, exactly as given, then do the work.'
    : 'The project files are already in this chat (Next.js App Router, Tailwind CSS v4). `app/page.tsx` is the whole site: one client component with every text, image and contact detail hardcoded.';

  const prompt = `Turn this landing page for "${name}" into a full-stack website that the business owner fully controls from an admin panel.

${where}

## 1. Keep the design exactly as it is
- The public site must look and behave pixel-for-pixel the same: same layout, colors, fonts, icons, animations, sections, and the same language.
- Do not redesign, rename sections, or "improve" the copy. Only the data source changes.

## 2. Database: Neon Postgres
- Use Neon Postgres through the \`DATABASE_URL\` environment variable (Neon integration) with \`@neondatabase/serverless\`. Do not use any other database, ORM-managed SQLite, local JSON files or in-memory storage.
- The Neon database already exists: do not try to provision one. Add a SQL script in \`scripts/\` that creates the tables and seeds them with ALL the content currently hardcoded in the page, so the site looks identical right after the script runs.

## 3. All static content editable
- Move every piece of static content into the database: texts (headings, paragraphs, buttons), lists (services, testimonials, FAQ, gallery, opening hours…), image URLs, contact details (phone, WhatsApp, email, address, map embed), social links, footer, and SEO title/description.
- The public page reads this content on the server and passes it to the existing components. Saving in the admin must update the live site immediately (revalidate the page).

## 4. Admin panel at /admin
- Protected by a single owner password from the \`ADMIN_PASSWORD\` environment variable. Session in an httpOnly, signed cookie (secret from \`ADMIN_SESSION_SECRET\`). No sign-up, no third-party auth, no user accounts.
- One clear screen per section with simple forms: edit texts, add/remove/reorder list items, change images (URL field with live preview), edit contact details and SEO.
- Built for a non-technical business owner: clean, mobile-friendly, written in the same language as the website, with a visible "Save" and a "View site" link.

## 5. Contact form sends leads to the admin
- Remove the mailto: behavior completely. The contact form must submit to a server action that stores the submission in a \`leads\` table (all form fields, created_at, status: new / contacted / closed).
- Show proper loading, success and error states in the form. Add a hidden honeypot field against spam and basic server-side validation.
- In the admin, add a "Leads" inbox: newest first, count of new leads, open a lead to see every field, change its status, delete it, and export all leads to CSV.

## 6. Finish
- Keep the floating WhatsApp button, phone links and map working, using the values from the database.
- List the environment variables the owner must set: \`DATABASE_URL\`, \`ADMIN_PASSWORD\`, \`ADMIN_SESSION_SECRET\`.`;

  if (!opts.inlineFiles) return prompt;
  const files = opts.inlineFiles.map(f => `### ${f.name}\n\`\`\`${f.name.split('.').pop()}\n${f.content.trim()}\n\`\`\``).join('\n\n');
  return `${prompt}\n\n## Current site code\n\n${files}\n`;
}

/** The files v0 needs to rebuild the site as-is (same scaffolding as a Vercel publish). */
export function handoverFiles(lead: Lead, tsx: string) {
  const projectName = lead.deploymentName || slugifyProjectName(lead.business.name);
  return buildLandingPageFiles(projectName, tsx).map(f => ({ name: f.file, content: f.data }));
}

/** Files worth pasting by hand: the page plus what it relies on (fonts/icons/CSS). */
export function inlineHandoverFiles(lead: Lead, tsx: string) {
  return handoverFiles(lead, tsx).filter(f => ['app/page.tsx', 'app/layout.tsx', 'app/globals.css'].includes(f.name));
}

async function v0Fetch<T>(apiKey: string, path: string, body: unknown): Promise<T> {
  const res = await fetch(`${V0_API}${path}`, {
    method: 'POST',
    headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) {
    const msg = data?.error?.message || data?.message || `v0 request failed (${res.status})`;
    throw new Error(res.status === 401 || res.status === 403 ? `v0 rejected the API key: ${msg}` : msg);
  }
  return data as T;
}

const handoverTitle = (lead: Lead) => `${lead.business.name} — client handover`;
const chatUrl = (id: string) => `https://v0.app/chat/${id}`;

/**
 * Finds a handover chat made before LeadMax recorded them on the lead (tagged
 * with the lead id, or matching the handover title). Newest wins; null when
 * there is none or v0 can't be reached.
 */
export async function findExistingV0Handover(apiKey: string, lead: Lead): Promise<V0Handover | null> {
  try {
    const res = await fetch(`${V0_API}/chats?limit=100`, { headers: { Authorization: `Bearer ${apiKey}` } });
    if (!res.ok) return null;
    const { chats = [] } = await res.json() as { chats?: { id: string; title?: string; createdAt: string; metadata?: Record<string, string> }[] };
    const match = chats
      .filter(c => c.metadata?.leadmaxLeadId === lead.id || c.title === handoverTitle(lead))
      .sort((a, b) => b.createdAt.localeCompare(a.createdAt))[0];
    return match ? { chatId: match.id, url: chatUrl(match.id), createdAt: match.createdAt } : null;
  } catch {
    return null;
  }
}

/** Imports the site into a new private v0 chat and sends the handover prompt. */
export async function createV0HandoverChat(apiKey: string, lead: Lead, tsx: string): Promise<V0Handover> {
  const { chat } = await v0Fetch<{ chat: { id: string } }>(apiKey, '/chats/from-files', {
    title: handoverTitle(lead),
    privacy: 'private',
    metadata: { leadmaxLeadId: lead.id },
    files: handoverFiles(lead, tsx),
  });
  // async: v0 starts generating right away; the user watches it in the chat.
  await v0Fetch(apiKey, `/chats/${chat.id}/messages/async`, {
    message: buildHandoverPrompt(lead),
  });
  // v2 returns no web URL; v0.app resolves a bare chat id to the chat page.
  return { chatId: chat.id, url: chatUrl(chat.id), createdAt: new Date().toISOString() };
}
