            {p.jobText ? (
              <button onClick={p.onOpenJob} className="mt-2 text-[13px] text-zinc-700 dark:text-zinc-200 hover:text-emerald-600 dark:hover:text-emerald-400 inline-flex items-center gap-1 text-start">
                <span className="status-flash">{p.jobText}</span>
                <span className="status-dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span>
              </button>
            ) : p.siteUrl ? (
              <div className="mt-2 space-y-2">
                <a href={p.siteUrl} target="_blank" rel="noopener noreferrer" className="block text-[13px] font-medium text-zinc-900 dark:text-white hover:text-emerald-600 dark:hover:text-emerald-400 truncate">
                  {p.siteUrl.replace(/^https?:\/\//, '')} ↗
                </a>
                {p.canUnpublish && (
                  <button onClick={p.onUnpublish} className="text-[12px] text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white underline-offset-2 hover:underline">
                    {t('campaign.unpublish')}
                  </button>
                )}
              </div>
            ) : (
              <p className="mt-2 text-[13px] leading-relaxed text-zinc-600 dark:text-zinc-300">
                {hasSite ? t('campaign.detailSiteDraft') : t('campaign.detailNoSite')}
              </p>
            )}
          </div>
        )}
      </div>

      {/* Actions */}
      {!lead.deleted && (
        <div className="shrink-0 p-4 border-t border-zinc-200 dark:border-zinc-700/50 space-y-2">
          <button
            onClick={hasSite ? p.onOpenStudio : p.onGenerate}
            className="w-full h-12 inline-flex items-center justify-center gap-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold text-[15px] shadow-sm shadow-emerald-600/20 transition-all"
          >
            <span className="w-5 h-5">{I.sparkle}</span>
            {hasSite ? t('campaign.openStudio') : t('campaign.createWebsite')}
          </button>
          <div className="grid grid-cols-3 gap-2">
            <button onClick={p.onImages} className="h-10 inline-flex items-center justify-center gap-1.5 rounded-xl border border-zinc-200 dark:border-zinc-700/50 text-[12px] font-medium text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all">
              <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.8}><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg>
              {p.uploadedCount > 0 ? t('campaign.imgCount', { count: p.uploadedCount }) : t('campaign.images')}
            </button>
            {hasSite ? (
              <button onClick={p.onRegenerate} className="h-10 inline-flex items-center justify-center gap-1.5 rounded-xl border border-zinc-200 dark:border-zinc-700/50 text-[12px] font-medium text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all">
                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.8}><path d="M4 4v5h.58m15.36 2A8 8 0 004.58 9m0 0H9m11 11v-5h-.58m0 0a8 8 0 01-15.36-2m15.36 2H15" /></svg>
                {t('campaign.regen')}
              </button>
            ) : (
              <a href={isWebUrl(b.googleUrl) ? b.googleUrl : undefined} target="_blank" rel="noopener noreferrer" aria-disabled={!isWebUrl(b.googleUrl)} className={`h-10 inline-flex items-center justify-center gap-1.5 rounded-xl border border-zinc-200 dark:border-zinc-700/50 text-[12px] font-medium text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all ${isWebUrl(b.googleUrl) ? '' : 'opacity-40 pointer-events-none'}`}>
                <span className="w-4 h-4">{I.pin}</span>
                {t('campaign.mapsShort')}
              </a>
            )}
            <a href={b.placeId ? `https://search.google.com/local/writereview?placeid=${b.placeId}` : undefined} target="_blank" rel="noopener noreferrer" aria-disabled={!b.placeId} className={`h-10 inline-flex items-center justify-center gap-1.5 rounded-xl border border-zinc-200 dark:border-zinc-700/50 text-[12px] font-medium text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all ${b.placeId ? '' : 'opacity-40 pointer-events-none'}`}>
              <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.8}><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
              {t('campaign.reviewShort')}
