export interface PromptData {
  businessName: string;
  category: string;
  rating: string;
  ratingCount: string;
  address: string;
  phone: string;
  cleanPhone: string;
  website: string;
  email: string;
  socialsBlock: string;
  placeId: string;
  coordinates: string;
  googleUrl: string;
  mapEmbedUrl: string;
  reviewsBlock: string;
  imagesBlock: string;
  formJs: string;
  formModeInstruction: string;
  encodedBusinessAddress: string;
  reviewUrl: string;
}

export interface LeadImageSource {
  url: string;
  alt: string;
  width?: number;
  height?: number;
}

/**
 * Returns only user-uploaded, non-deleted images.
 * Strips any legacy ", best usage area: ..." suffix left in alt text by the old
 * vision behavior, so stale placement hints are never fed to the site generator.
 */
export function getLeadImageSources(lead: {
  images?: { url: string; alt?: string; width?: number; height?: number; deleted?: boolean }[];
}): LeadImageSource[] {
  return (lead.images || []).filter((img) => !img.deleted).map((img) => ({
    url: img.url,
    alt: (img.alt || 'Business photo').replace(/,?\s*best usage area:.*$/i, '').trim() || 'Business photo',
    width: img.width,
    height: img.height,
  }));
}

export function buildImagesBlock(lead: {
  images?: { url: string; alt?: string; width?: number; height?: number; deleted?: boolean }[];
}): string {
  const sources = getLeadImageSources(lead);
  if (sources.length === 0) return '';

  const header = 'BUSINESS IMAGES (uploaded — use these URLs in the design)';

  const imagesText = sources
    .map((img, i) => {
      const dims = img.width && img.height ? ` (${img.width}x${img.height})` : '';
      return `Image ${i + 1}: ${img.url}${dims}\nAlt text: ${img.alt}`;
    })
    .join('\n\n');

  return `==================================================\n${header}\n==================================================\n\n${imagesText}\n`;
}

export function formatModifyImagesBlock(lead: {
  images?: { url: string; alt?: string; width?: number; height?: number; deleted?: boolean }[];
}): string {
  const sources = getLeadImageSources(lead);
  if (sources.length === 0) return '';
  const lines = sources.map((img) => {
    const dims = img.width && img.height ? ` [${img.width}x${img.height}]` : '';
    return `${img.url}${dims}${img.alt ? ` (${img.alt})` : ''}`;
  }).join('\n');
  return 'Available images:\n' + lines;
}

/** Formats enriched social handles into a compact prompt block (empty string if none found). */
export function buildSocialsBlock(socials?: {
  instagram?: string;
  linkedin?: string;
  facebook?: string;
  twitter?: string;
  tiktok?: string;
  youtube?: string;
}): string {
  const s = socials || {};
  const lines: string[] = [];
  if (s.instagram) lines.push(`Instagram: @${s.instagram}`);
  if (s.linkedin) lines.push(`LinkedIn: ${s.linkedin}`);
  if (s.facebook) lines.push(`Facebook: ${s.facebook}`);
  if (s.twitter) lines.push(`X/Twitter: @${s.twitter}`);
  if (s.tiktok) lines.push(`TikTok: @${s.tiktok}`);
  if (s.youtube) lines.push(`YouTube: @${s.youtube}`);
  return lines.join('\n');
}

export function buildPromptData(lead: any): PromptData {
  const b = lead.business;
  const cleanPhone = b.phone?.replace(/[^0-9]/g, '') || '';
  const sorted = [...(b.reviews || [])].sort((a: any, b: any) => (b.rating || 0) - (a.rating || 0));
  const reviewsText = sorted
    .slice(0, 8)
    .map((r: any) => {
      let line = `- "${r.text?.slice(0, 250) || ''}"`;
      if (r.author) line += ` — ${r.author}`;
      if (r.rating) line += ` (${r.rating}★)`;
      if (r.avatar) line += ` avatar: ${r.avatar}`;
      return line;
    })
    .join('\n');

  const businessName = b.name || 'Business Name';
  const cleanBusinessName = businessName.toLowerCase().replace(/[^a-z0-9]/g, '') || 'company';
  const fakeEmail = 'contact@' + cleanBusinessName + '.com';

  const formJs = `
  document.querySelector('.contact-form')?.addEventListener('submit', function(e) {
    e.preventDefault();
    const data = new FormData(this);
    const pick = (names) => {
      for (const n of names) { const v = data.get(n); if (v && String(v).trim()) return String(v).trim(); }
      return '';
    };
    const name = pick(['name', 'fullname', 'full_name', 'your-name', 'yourname']);
    const lines = [];
    data.forEach((value, key) => {
      const v = String(value).trim();
      if (!v) return;
      const label = key.replace(/[_-]+/g, ' ');
      lines.push(label.charAt(0).toUpperCase() + label.slice(1) + ': ' + v);
    });
    const body = (lines.length ? lines.join('\\n') : 'New website inquiry') + '\\n\\n— Sent from the ${businessName} website contact form';
    const subject = name ? 'New inquiry from ' + name + ' — ${businessName}' : 'New website inquiry — ${businessName}';
    window.location.href = 'mailto:${fakeEmail}?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
  });`;

  const formModeInstruction = 'THE FORM MUST OPEN THE VISITOR\'S EMAIL APP (mailto:) — NOT WhatsApp, NOT a server submit. Pre-fill the email TO the business email (' + fakeEmail + ') and build a meaningful subject plus a detailed body from every field the visitor filled in.';

  const imagesBlock = buildImagesBlock(lead);
  const reviewUrl = b.placeId ? `https://search.google.com/local/writereview?placeid=${b.placeId}` : '';

  return {
    businessName: b.name || 'Business Name',
    category: b.category || 'General Business',
    rating: (b.rating || 0).toString(),
    ratingCount: (b.ratingCount || 0).toString(),
    address: b.address || 'N/A',
    phone: b.phone || '',
    cleanPhone,
    website: b.website || '',
    email: b.enrichedEmail || '',
    socialsBlock: buildSocialsBlock(b.enrichedSocials),
    placeId: b.placeId || '',
    coordinates: b.latitude && b.longitude ? `COORDINATES: ${b.latitude}, ${b.longitude}` : '',
    googleUrl: b.googleUrl ? `GOOGLE MAPS URL: ${b.googleUrl}` : '',
    mapEmbedUrl: b.latitude && b.longitude
      ? `https://maps.google.com/maps?q=${b.latitude},${b.longitude}&z=16&output=embed&hl=en`
      : `https://maps.google.com/maps?q=${encodeURIComponent((b.name || '') + ' ' + (b.address || ''))}&z=16&output=embed&hl=en`,
    reviewsBlock: reviewsText || 'No reviews available',
    imagesBlock,
    formJs,
    formModeInstruction,
    encodedBusinessAddress: encodeURIComponent((b.name || '') + ' ' + (b.address || '')),
    reviewUrl,
  };
}

export function renderPrompt(template: string, data: PromptData): string {
  return template
    .replace(/\{\{FORM_JS\}\}/g, data.formJs)
    .replace(/\{\{FORM_MODE_INSTRUCTION\}\}/g, data.formModeInstruction)
    .replace(/\{\{REVIEWS_BLOCK\}\}/g, data.reviewsBlock)
    .replace(/\{\{IMAGES_BLOCK\}\}/g, data.imagesBlock)
    .replace(/\{\{BUSINESS_NAME\}\}/g, data.businessName)
    .replace(/\{\{CATEGORY\}\}/g, data.category)
    .replace(/\{\{RATING\}\}/g, data.rating)
    .replace(/\{\{RATING_COUNT\}\}/g, data.ratingCount)
    .replace(/\{\{ADDRESS\}\}/g, data.address)
    .replace(/\{\{PHONE\}\}/g, data.phone)
    .replace(/\{\{CLEAN_PHONE\}\}/g, data.cleanPhone)
    .replace(/\{\{WEBSITE\}\}/g, data.website)
    .replace(/\{\{EMAIL\}\}/g, data.email)
    .replace(/\{\{SOCIALS_BLOCK\}\}/g, data.socialsBlock)
    .replace(/\{\{PLACE_ID\}\}/g, data.placeId)
    .replace(/\{\{COORDINATES\}\}/g, data.coordinates)
    .replace(/\{\{GOOGLE_URL\}\}/g, data.googleUrl)
    .replace(/\{\{MAP_EMBED_URL\}\}/g, data.mapEmbedUrl)
    .replace(/\{\{ENCODED_BUSINESS_ADDRESS\}\}/g, data.encodedBusinessAddress)
    .replace(/\{\{REVIEW_URL\}\}/g, data.reviewUrl);
}

