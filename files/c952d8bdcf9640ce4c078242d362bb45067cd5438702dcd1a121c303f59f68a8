            <button onClick={p.onRestore} className="shrink-0 w-9 h-9 flex items-center justify-center rounded-lg border border-zinc-200 dark:border-zinc-700/50 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/10 transition-all" title={t('campaign.restore')}>
