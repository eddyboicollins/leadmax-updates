import { NextRequest, NextResponse } from 'next/server';
import { getSettings, saveSettings } from '@/lib/store';
import { DEFAULT_GEMINI_MODEL, normalizeAiSource } from '@/lib/gemini';
import { hasDeepSeekAuth } from '@/lib/deepseekProxy';

export async function GET() {
  const settings = await getSettings();
  return NextResponse.json({
    vercelToken: settings.vercelToken || '',
    filebaseAccessKey: settings.filebaseAccessKey || '',
    filebaseSecretKey: settings.filebaseSecretKey || '',
    filebaseBucket: settings.filebaseBucket || '',
    geminiApiKey: settings.geminiApiKey || '',
    hasVercelToken: !!settings.vercelToken,
    hasFilebaseKeys: !!(settings.filebaseAccessKey && settings.filebaseSecretKey && settings.filebaseBucket),
    hasGeminiApiKey: !!settings.geminiApiKey,
    hasDeepseekAuth: await hasDeepSeekAuth(),
    geminiModel: settings.geminiModel || DEFAULT_GEMINI_MODEL,
    aiSource: normalizeAiSource(settings.aiSource),
    generationInstructions: settings.generationInstructions || '',
    wizardCompleted: !!settings.wizardCompleted,
    defaultMinRating: settings.defaultMinRating ?? 0,
    defaultMaxRating: settings.defaultMaxRating ?? 5,
    defaultMinReviews: settings.defaultMinReviews ?? 0,
  });
}

export async function PUT(request: NextRequest) {
  try {
    const body = await request.json();
    const { vercelToken, filebaseAccessKey, filebaseSecretKey, filebaseBucket, geminiApiKey, geminiModel, aiSource, generationInstructions, wizardCompleted, defaultMinRating, defaultMaxRating, defaultMinReviews } = body;

    await saveSettings({
      vercelToken: vercelToken !== undefined ? vercelToken.trim() : undefined,
      filebaseAccessKey: filebaseAccessKey !== undefined ? filebaseAccessKey.trim() : undefined,
      filebaseSecretKey: filebaseSecretKey !== undefined ? filebaseSecretKey.trim() : undefined,
      filebaseBucket: filebaseBucket !== undefined ? filebaseBucket.trim() : undefined,
      geminiApiKey: geminiApiKey !== undefined ? geminiApiKey.trim() : undefined,
      geminiModel: geminiModel !== undefined ? geminiModel.trim() : undefined,
      aiSource: aiSource !== undefined ? normalizeAiSource(aiSource) : undefined,
      generationInstructions: generationInstructions !== undefined ? generationInstructions.trim() : undefined,
      wizardCompleted: wizardCompleted !== undefined ? wizardCompleted : undefined,
      defaultMinRating: defaultMinRating !== undefined ? Number(defaultMinRating) : undefined,
      defaultMaxRating: defaultMaxRating !== undefined ? Number(defaultMaxRating) : undefined,
      defaultMinReviews: defaultMinReviews !== undefined ? Number(defaultMinReviews) : undefined,
    });

    return NextResponse.json({ success: true });
  } catch (err) {
    return NextResponse.json({ error: err instanceof Error ? err.message : 'Failed to save settings' }, { status: 500 });
  }
}
