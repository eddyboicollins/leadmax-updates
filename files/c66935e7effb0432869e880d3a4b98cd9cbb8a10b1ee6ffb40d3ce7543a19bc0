                      <button onClick={() => openGenerateModal(lead.id)} disabled={genLocked} className="flex-1 basis-full justify-center inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 sm:py-1.5 text-[11px] sm:text-xs font-medium bg-zinc-100 dark:bg-zinc-700/50 text-zinc-600 dark:text-zinc-400 rounded-lg hover:bg-emerald-500/15 hover:text-emerald-400 hover:ring-1 hover:ring-emerald-500/40 transition-all disabled:opacity-40 disabled:cursor-not-allowed">
