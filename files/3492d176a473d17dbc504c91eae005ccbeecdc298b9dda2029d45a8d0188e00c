'use client';

import { useEffect, useMemo, useRef, useState } from 'react';
import { useRouter, usePathname } from 'next/navigation';
import { useTranslation } from 'react-i18next';
import { useAllCampaigns, useGenerations } from '@/lib/query/useCampaigns';
import { useLockBodyScroll } from '@/lib/useLockBodyScroll';
import { requestGenerationFocus } from '@/lib/generationFocus';
import SafeImg from './SafeImg';

export function openGlobalSearch() {
  window.dispatchEvent(new CustomEvent('lm-open-search'));
}

export function onGlobalSearchOpen(handler: () => void): () => void {
  const h = () => handler();
  window.addEventListener('lm-open-search', h);
  return () => window.removeEventListener('lm-open-search', h);
}

function leadThumbnail(lead: any): string | null {
  const uploaded = (lead.images || []).find((i: any) => !i.deleted)?.url;
  if (uploaded) return uploaded;
  const discovered = (lead.business?.scrapedImages || []).find((s: any) => s?.url && !/googleusercontent|\.google\.com/.test(s.url))?.url;
  return discovered || null;
}

function campaignThumbnail(campaign: any): string | null {
  for (const l of campaign.leads || []) {
    if (l.deleted) continue;
    const img = leadThumbnail(l);
    if (img) return img;
  }
  return null;
}

function Thumb({ src, label, rounded }: { src: string | null; label: string; rounded?: string }) {
  const cls = rounded || 'rounded-lg';
  const fallback = (
    <span className={`w-10 h-10 ${cls} shrink-0 flex items-center justify-center text-sm font-bold bg-emerald-500/10 text-emerald-500`}>
      {(label || '?').trim().charAt(0).toUpperCase()}
    </span>
  );
  if (!src) return fallback;
  return (
    <SafeImg
      src={src}
      alt=""
      className={`w-10 h-10 ${cls} shrink-0 overflow-hidden bg-zinc-100 dark:bg-zinc-800 block`}
      imgClassName={`w-10 h-10 ${cls} object-cover block`}
      fallback={fallback}
    />
  );
}

export default function GlobalSearchModal() {
  const router = useRouter();
  const pathname = usePathname();
  const { t } = useTranslation();
  const [open, setOpen] = useState(false);
  const [query, setQuery] = useState('');
  const [debounced, setDebounced] = useState('');
  const [showCampaigns, setShowCampaigns] = useState(true);
  const [showLeads, setShowLeads] = useState(false);
  const [showSites, setShowSites] = useState(false);
  const inputRef = useRef<HTMLInputElement>(null);
  useLockBodyScroll(open);

  const { data: campaignsData } = useAllCampaigns();
  const { data: generationsData } = useGenerations();

  useEffect(() => onGlobalSearchOpen(() => setOpen(true)), []);
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        setOpen(true);
      }
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, []);
  useEffect(() => {
    const t = setTimeout(() => setDebounced(query.trim().toLowerCase()), 200);
    return () => clearTimeout(t);
  }, [query]);
  useEffect(() => {
    if (open) {
      setQuery('');
      setDebounced('');
      setTimeout(() => inputRef.current?.focus(), 50);
    }
  }, [open ]);
  useEffect(() => {
    if (!open) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape') setOpen(false);
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [open ]);

  const campaigns = campaignsData?.campaigns || [];
  const generations = generationsData || [];

  const campaignResults = useMemo(() => {
    if (!showCampaigns || !debounced) return [];
    return campaigns
      .filter((c: any) =>
        [c.keyword, c.location, c.displayName].some(v => String(v || '').toLowerCase().includes(debounced)),
      )
      .slice(0, 40);
  }, [campaigns, debounced, showCampaigns]);

  const leadResults = useMemo(() => {
    if (!showLeads || !debounced) return [];
    const out: { campaign: any; lead: any }[] = [];
    for (const c of campaigns) {
      for (const l of c.leads || []) {
        if (l.deleted) continue;
        const hay = [l.business?.name, l.business?.address, l.business?.phone, l.business?.category, l.status, l.notes]
          .map(v => String(v || '').toLowerCase());
        if (hay.some(h => h.includes(debounced))) {
          out.push({ campaign: c, lead: l });
          if (out.length >= 40) return out;
        }
      }
    }
    return out;
  }, [campaigns, debounced, showLeads]);

  const siteResults = useMemo(() => {
    if (!showSites || !debounced) return [];
    return generations
      .filter((g: any) =>
        [g.businessName, g.campaignName, g.projectName].some(v => String(v || '').toLowerCase().includes(debounced)),
      )
      .slice(0, 40);
  }, [generations, debounced, showSites]);

  const [activeIdx, setActiveIdx] = useState(0);

  // Flat keyboard-navigable list across all groups (campaigns → leads → sites)
  const flat = useMemo(() => ([
    ...campaignResults.map((c: any) => ({ key: `c-${c.id}`, run: () => goCampaign(c.id) })),
    ...leadResults.map(({ campaign, lead }: any) => ({ key: `l-${lead.id}`, run: () => goLead(campaign.id, lead.id) })),
    ...siteResults.map((g: any) => ({ key: `g-${g.id}`, run: () => goSite(g.id) })),
    // eslint-disable-next-line react-hooks/exhaustive-deps
  ]), [campaignResults, leadResults, siteResults]);

  useEffect(() => { setActiveIdx(0); }, [debounced, showCampaigns, showLeads, showSites]);
  useEffect(() => {
    if (!open) return;
    document.getElementById(`gsr-${activeIdx}`)?.scrollIntoView({ block: 'nearest' });
  }, [activeIdx, open ]);

  if (!open) return null;

  const total = flat.length;

  function goCampaign(id: string) {
    setOpen(false);
    router.push(`/campaign/${id}`);
  }

  function goLead(campaignId: string, leadId: string) {
    setOpen(false);
    router.push(`/campaign/${campaignId}?lead=${encodeURIComponent(leadId)}&focus=${Date.now()}`);
  }

  function goSite(genId: string) {
    setOpen(false);
    requestGenerationFocus(genId);
    if (pathname !== '/') router.push('/');
  }

  function onInputKey(e: React.KeyboardEvent<HTMLInputElement>) {
    if (e.key === 'ArrowDown') { e.preventDefault(); setActiveIdx(i => Math.min(i + 1, total - 1)); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActiveIdx(i => Math.max(i - 1, 0)); }
    else if (e.key === 'Enter') { const item = flat[activeIdx]; if (item) { e.preventDefault(); item.run(); } }
  }

  const rowCls = (idx: number) =>
    `w-full flex items-center gap-3 px-2.5 py-2.5 rounded-xl transition-all text-start ${idx === activeIdx ? 'bg-gray-100 dark:bg-zinc-700/70 ring-1 ring-emerald-500/40' : 'hover:bg-gray-100 dark:hover:bg-zinc-700/60'}`;

  return (
    <div className="fixed inset-0 z-[150] bg-black/80 backdrop-blur-xl flex items-center justify-center p-4" onClick={() => setOpen(false)}>
      <div className="bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl flex flex-col max-h-[80vh]" onClick={e => e.stopPropagation()}>
        <div className="px-5 pt-5 pb-3 border-b border-gray-200 dark:border-zinc-700 shrink-0">
          <div className="flex items-center gap-3">
            <svg className="w-5 h-5 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
            <input
              ref={inputRef}
              value={query}
              onChange={e => setQuery(e.target.value)}
              onKeyDown={onInputKey}
              placeholder={t('search.placeholder')}
              className="flex-1 min-w-0 bg-transparent text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none text-base"
              autoComplete="off"
              spellCheck={false}
            />
            <button onClick={() => setOpen(false)} className="p-1.5 text-zinc-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-zinc-700 rounded-lg transition-all shrink-0">
              <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
          <div className="flex items-center gap-4 mt-3">
            <label className="flex items-center gap-1.5 cursor-pointer select-none text-xs text-gray-600 dark:text-zinc-300">
              <input type="checkbox" checked={showCampaigns} onChange={e => setShowCampaigns(e.target.checked)} className="w-3.5 h-3.5 accent-emerald-500" />
              {t('search.campaigns')}
            </label>
            <label className="flex items-center gap-1.5 cursor-pointer select-none text-xs text-gray-600 dark:text-zinc-300">
              <input type="checkbox" checked={showLeads} onChange={e => setShowLeads(e.target.checked)} className="w-3.5 h-3.5 accent-emerald-500" />
              {t('search.leads')}
            </label>
            <label className="flex items-center gap-1.5 cursor-pointer select-none text-xs text-gray-600 dark:text-zinc-300">
              <input type="checkbox" checked={showSites} onChange={e => setShowSites(e.target.checked)} className="w-3.5 h-3.5 accent-emerald-500" />
              {t('search.sites')}
            </label>
          </div>
        </div>

        <div className="overflow-y-auto p-3">
          {!debounced ? (
            <p className="text-center text-xs text-zinc-400 dark:text-zinc-500 py-8">{t('search.hint')}</p>
          ) : total === 0 ? (
            <p className="text-center text-xs text-zinc-400 dark:text-zinc-500 py-8">{t('search.noResults')}</p>
          ) : (
            <>
              {campaignResults.length > 0 && (
                <div className="mb-3">
                  <p className="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 flex items-center gap-2">{t('search.campaigns')} · {campaignResults.length}<span className="flex-1 h-px bg-gray-100 dark:bg-zinc-700/60" /></p>
                  {campaignResults.map((c: any, i: number) => {
                    const idx = i;
                    const leadCount = (c.leads || []).filter((l: any) => !l.deleted).length;
                    return (
                      <button key={c.id} id={`gsr-${idx}`} onClick={() => goCampaign(c.id)} onMouseEnter={() => setActiveIdx(idx)} className={rowCls(idx)}>
                        <Thumb src={campaignThumbnail(c)} label={c.displayName || c.keyword} />
                        <span className="flex-1 min-w-0">
                          <span className="flex items-center gap-2 min-w-0">
                            <span className="text-sm font-medium text-gray-900 dark:text-white truncate">{c.displayName || c.keyword}</span>
                            <span className="text-[10px] text-zinc-400 shrink-0">{leadCount} · {t('search.leads').toLowerCase()}</span>
                          </span>
                          <span className="block text-xs text-zinc-400 truncate mt-0.5">{c.location}</span>
                        </span>
                        <span className="px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide rounded-md bg-emerald-500/15 text-emerald-500 shrink-0">{t('search.typeCampaign')}</span>
                      </button>
                    );
                  })}
                </div>
              )}
              {leadResults.length > 0 && (
                <div className="mb-3">
                  <p className="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 flex items-center gap-2">{t('search.leads')} · {leadResults.length}<span className="flex-1 h-px bg-gray-100 dark:bg-zinc-700/60" /></p>
                  {leadResults.map(({ campaign, lead }: any, i: number) => {
                    const idx = campaignResults.length + i;
                    const rating = Number(lead.business?.rating) || 0;
                    return (
                      <button key={lead.id} id={`gsr-${idx}`} onClick={() => goLead(campaign.id, lead.id)} onMouseEnter={() => setActiveIdx(idx)} className={rowCls(idx)}>
                        <Thumb src={leadThumbnail(lead)} label={lead.business?.name} />
                        <span className="flex-1 min-w-0">
                          <span className="flex items-center gap-2 min-w-0">
                            <span className="text-sm font-medium text-gray-900 dark:text-white truncate">{lead.business?.name}</span>
                            {rating > 0 && (
                              <span className="inline-flex items-center gap-0.5 text-[10px] font-semibold text-emerald-500 shrink-0">
                                <svg className="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M12 2l2.9 6.26 6.6.57-5 4.36 1.5 6.45L12 16.9 5.99 19.64l1.5-6.45-5-4.36 6.6-.57L12 2z" /></svg>
                                {rating.toFixed(1)}
                              </span>
                            )}
                            {lead.status && <span className="text-[10px] text-zinc-400 shrink-0 truncate">{lead.status}</span>}
                          </span>
                          <span className="block text-xs text-zinc-400 truncate mt-0.5">{campaign.displayName || campaign.keyword} · {lead.business?.address}</span>
                        </span>
                        <span className="px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide rounded-md bg-zinc-500/15 text-zinc-400 shrink-0">{t('search.typeLead')}</span>
                      </button>
                    );
                  })}
                </div>
              )}
              {siteResults.length > 0 && (
                <div className="mb-1">
                  <p className="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 flex items-center gap-2">{t('search.sites')} · {siteResults.length}<span className="flex-1 h-px bg-gray-100 dark:bg-zinc-700/60" /></p>
                  {siteResults.map((g: any, i: number) => {
                    const idx = campaignResults.length + leadResults.length + i;
                    return (
                      <button key={g.id} id={`gsr-${idx}`} onClick={() => goSite(g.id)} onMouseEnter={() => setActiveIdx(idx)} className={rowCls(idx)}>
                        <Thumb src={null} label={g.businessName} />
                        <span className="flex-1 min-w-0">
                          <span className="block text-sm font-medium text-gray-900 dark:text-white truncate">{g.businessName}</span>
                          <span className="block text-xs text-zinc-400 truncate mt-0.5">{g.campaignName}{g.projectName ? ` · ${g.projectName}` : ''}</span>
                        </span>
                        <span className="px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-wide rounded-md bg-zinc-500/15 text-zinc-400 shrink-0">{t('search.typeSite')}</span>
                      </button>
                    );
                  })}
                </div>
              )}
            </>
          )}
        </div>
      </div>
    </div>
  );
}
