'use client';

import { useRouter, usePathname } from 'next/navigation';
import { useState, useMemo, useEffect, useRef } from 'react';
import { useTranslation } from 'react-i18next';
import { useTheme } from './ThemeProvider';
import AboutModal from './AboutModal';
import { useCampaigns, useGenerations } from '@/lib/query/useCampaigns';
import { useScrape } from '@/lib/scrape/ScrapeProvider';
import { useGeneration, resolveJobMessage } from '@/lib/generate/GenerationProvider';
import { requestGenerationsScroll, requestCampaignsScroll } from '@/lib/generationFocus';
import { openGlobalSearch } from './GlobalSearchModal';
import { useLocalStoragePref } from '@/lib/useLocalStoragePref';
import { useLastVisitedCampaign } from '@/lib/lastVisitedCampaign';
import i18n from '@/lib/i18n';

interface SidebarProps {
  expanded: boolean;
  onToggleExpanded: () => void;
  mobileOpen: boolean;
  onCloseMobile: () => void;
}

const I = {
  home: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  campaigns: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
  sites: 'M13 10V3L4 14h7v7l9-11h-7z',
  search: 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z',
  settings: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065zM15 12a3 3 0 11-6 0 3 3 0 016 0z',
  sun: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z',
  moon: 'M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z',
  info: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  globe: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  collapse: 'M11 19l-7-7 7-7m8 14l-7-7 7-7',
  close: 'M6 18L18 6M6 6l12 12',
  chevron: 'M9 5l7 7-7 7',
};

/** A lead in its campaign (`focus` re-triggers the scroll-to even on the same URL). */
function leadHref(campaignId: string, leadId: string): string {
  return `/campaign/${campaignId}?lead=${encodeURIComponent(leadId)}&focus=${Date.now()}`;
}

function Icon({ d, className = 'w-[18px] h-[18px]' }: { d: string; className?: string }) {
  return (
    <svg className={`${className} shrink-0`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.8}>
      <path strokeLinecap="round" strokeLinejoin="round" d={d} />
    </svg>
  );
}

export default function Sidebar({ expanded, onToggleExpanded, mobileOpen, onCloseMobile }: SidebarProps) {
  const router = useRouter();
  const pathname = usePathname();
  const { t } = useTranslation();
  const { theme, toggle: toggleTheme } = useTheme();
  const [aboutOpen, setAboutOpen] = useState(false);
  const [langOpen, setLangOpen] = useState(false);
  const langRef = useRef<HTMLDivElement>(null);
  const [campaignsOpen, setCampaignsOpen] = useLocalStoragePref('lm_campaigns_open');
  const [generationsOpen, setGenerationsOpen] = useLocalStoragePref('lm_generations_open');
  const { data: campaignsData } = useCampaigns();
  const { data: generationsData } = useGenerations();
  const scrape = useScrape();
  const { activeJobs } = useGeneration();
  const liveGenJobs = activeJobs.filter(j => j.kind !== 'unpublish');
  const lastVisitedCampaignId = useLastVisitedCampaign();
  const currentLang = i18n.language?.toLowerCase().startsWith('ar') ? 'ar' : i18n.language?.startsWith('en') ? 'en' : 'fr';
  const [homeSection, setHomeSection] = useState<'campaigns' | 'generations' | null>(null);

  // The drawer (below md) always shows the full sidebar.
  const full = expanded || mobileOpen;

  // Navigating closes the mobile drawer.
  useEffect(() => { onCloseMobile(); }, [pathname]); // eslint-disable-line react-hooks/exhaustive-deps

  useEffect(() => {
    if (!langOpen) return;
    const onDown = (e: MouseEvent) => { if (!langRef.current?.contains(e.target as Node)) setLangOpen(false); };
    window.addEventListener('mousedown', onDown);
    return () => window.removeEventListener('mousedown', onDown);
  }, [langOpen]);

  // Which dashboard section is on screen (highlights its sidebar entry).
  useEffect(() => {
    if (pathname !== '/') return;
    let raf = 0;
    const update = () => {
      const generationsEl = document.getElementById('home-section-generations');
      const genTop = generationsEl ? generationsEl.getBoundingClientRect().top : Infinity;
      setHomeSection(generationsEl && genTop <= window.innerHeight * 0.45 ? 'generations' : 'campaigns');
    };
    const onScroll = () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };
  }, [pathname, campaignsData, generationsData]);

  const recentCampaigns = useMemo(
    () => (campaignsData?.campaigns ?? []).slice().sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt))).slice(0, 8),
    [campaignsData],
  );
  const recentGenerations = useMemo(
    () => (generationsData ?? []).slice().sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt))).slice(0, 8),
    [generationsData],
  );

  function switchLang(lng: string) {
    i18n.changeLanguage(lng);
    localStorage.setItem('i18nextLng', lng);
    setLangOpen(false);
  }

  const go = (href: string) => router.push(href);
  const goToCampaigns = () => { if (pathname !== '/') go('/'); requestCampaignsScroll(); };
  const goToGenerations = () => { if (pathname !== '/') go('/'); requestGenerationsScroll(); };
  const openLead = (campaignId: string, leadId: string) => go(leadHref(campaignId, leadId));

  const inCampaign = !!pathname?.startsWith('/campaign');
  const dashboardActive = pathname === '/' && homeSection !== 'generations';
  const campaignsActive = inCampaign;
  const generationsActive = pathname === '/' && homeSection === 'generations';

  const item = (active: boolean) =>
    `group/item relative w-full flex items-center gap-3 rounded-xl text-[13px] font-medium transition-colors ${full ? 'px-3 h-9' : 'justify-center h-10'} ${active
      ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400'
      : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/70 hover:text-zinc-900 dark:hover:text-white'}`;

  const navItem = ({ icon, label, active = false, onClick, extra }: { icon: string; label: string; active?: boolean; onClick: () => void; extra?: React.ReactNode }) => (
    <button onClick={onClick} className={item(active)} title={full ? undefined : label}>
      {active && <span className="absolute start-0 top-2 bottom-2 w-[3px] rounded-full bg-emerald-500" />}
      <Icon d={icon} />
      {full && <span className="truncate flex-1 text-start">{label}</span>}
      {full && extra}
    </button>
  );

  const sectionHeader = ({ label, open, onToggle, onClick, active, icon, count }: { label: string; open: boolean; onToggle: () => void; onClick: () => void; active: boolean; icon: string; count?: number }) => (
    <div className={`flex items-center rounded-xl ${active ? 'bg-emerald-500/10' : ''}`}>
      <button onClick={onClick} className={`${item(active)} !bg-transparent flex-1 min-w-0`} title={full ? undefined : label}>
        {active && <span className="absolute start-0 top-2 bottom-2 w-[3px] rounded-full bg-emerald-500" />}
        <Icon d={icon} />
        {full && <span className="truncate flex-1 text-start">{label}</span>}
        {full && count !== undefined && count > 0 && <span className="text-[11px] font-medium text-zinc-400 tabular-nums">{count}</span>}
      </button>
      {full && (
        <button onClick={onToggle} className="p-1.5 me-1 text-zinc-400 hover:text-zinc-900 dark:hover:text-white rounded-lg transition-colors" title={open ? t('nav.collapse') : t('nav.expand')}>
          <Icon d={I.chevron} className={`w-3.5 h-3.5 transition-transform duration-200 ${open ? 'rotate-90' : 'rtl:rotate-180'}`} />
        </button>
      )}
    </div>
  );

  const subItem = (active: boolean) =>
    `w-full flex items-center gap-2.5 ps-3 pe-2 h-8 rounded-lg text-[13px] transition-colors ${active
      ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-white'
      : 'text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/70 hover:text-zinc-900 dark:hover:text-white'}`;

  const footerBtn = 'p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors';

  return (
    <>
      <AboutModal open={aboutOpen} onClose={() => setAboutOpen(false)} />

      {/* Mobile backdrop */}
      <div
        onClick={onCloseMobile}
        className={`md:hidden fixed inset-0 z-[104] bg-black/50 backdrop-blur-[2px] transition-opacity ${mobileOpen ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
      />

      <aside
        className={`fixed start-0 top-0 h-full z-[105] flex flex-col bg-zinc-50 dark:bg-zinc-950 border-e border-zinc-200 dark:border-zinc-800/80 transition-[width,transform] duration-250 ease-out
          ${full ? 'w-64' : 'w-[68px]'}
          ${mobileOpen ? 'translate-x-0' : '-translate-x-full rtl:translate-x-full md:translate-x-0 md:rtl:translate-x-0'}`}
      >
        {/* Brand */}
        <div className={`flex items-center h-14 sm:h-[60px] shrink-0 ${full ? 'px-4 justify-between' : 'justify-center'}`}>
          <button onClick={() => go('/')} className="flex items-center gap-2.5 min-w-0 cursor-pointer" title="LeadMax">
            <img src="/leadmax-icon.png" alt="LeadMax" className="w-8 h-8 rounded-lg object-cover shrink-0" />
            {full && <span className="font-semibold text-[15px] text-zinc-900 dark:text-white tracking-tight">LeadMax</span>}
          </button>
          {full && (
            <button
              onClick={mobileOpen ? onCloseMobile : onToggleExpanded}
              className="p-1.5 text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-200/70 dark:hover:bg-zinc-800 rounded-lg transition-colors"
              title={mobileOpen ? t('nav.close') : t('nav.collapse')}
            >
              <Icon d={mobileOpen ? I.close : I.collapse} className={`w-4 h-4 ${mobileOpen ? '' : 'rtl:rotate-180'}`} />
            </button>
          )}
        </div>

        {/* Rail: expand back to the full sidebar, right under the logo. */}
        {!full && (
          <div className="flex justify-center pb-2 -mt-1">
            <button onClick={onToggleExpanded} className={footerBtn} title={t('nav.expand')}>
              <Icon d={I.collapse} className="w-4 h-4 rotate-180 rtl:rotate-0" />
            </button>
          </div>
        )}

        <nav className={`flex-1 overflow-y-auto overflow-x-hidden ${full ? 'px-3' : 'px-3.5'} space-y-0.5`}>
          {navItem({ icon: I.home, label: t('nav.home'), active: dashboardActive, onClick: () => { if (pathname === '/') window.scrollTo({ top: 0, behavior: 'smooth' }); else go('/'); } })}
          {navItem({ icon: I.search, label: t('search.title'), onClick: () => { onCloseMobile(); openGlobalSearch(); }, extra: <kbd className="text-[10px] text-zinc-400 font-sans">Ctrl K</kbd> })}

          {/* Campaigns */}
          <div className="pt-4">
            {full && <p className="px-3 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">{t('nav.workspace')}</p>}
            {sectionHeader({ label: t('home.myCampaigns'), icon: I.campaigns, active: campaignsActive, open: campaignsOpen, onToggle: () => setCampaignsOpen(!campaignsOpen), onClick: goToCampaigns, count: campaignsData?.campaigns?.length })}
            {full && campaignsOpen && (
              <div className="mt-0.5 mb-2 ms-[18px] ps-2 border-s border-zinc-200 dark:border-zinc-800 space-y-px">
                {recentCampaigns.length === 0 ? (
                  <p className="px-3 py-1.5 text-xs text-zinc-400">{t('home.noCampaigns')}</p>
                ) : recentCampaigns.map(c => {
                  const active = pathname === `/campaign/${c.id}`;
                  const scraping = scrape.running && scrape.campaignId === c.id;
                  return (
                    <button key={c.id} onClick={() => go(`/campaign/${c.id}`)} className={subItem(active)} title={`${c.displayName || c.keyword} — ${c.location || ''}`}>
                      {scraping
                        ? <span className="animate-spin w-3 h-3 rounded-full border-2 border-emerald-500 border-t-transparent shrink-0" />
                        : <span className={`w-1.5 h-1.5 rounded-full shrink-0 ${lastVisitedCampaignId === c.id ? 'bg-emerald-500' : 'bg-zinc-300 dark:bg-zinc-600'}`} />}
                      <span className="truncate flex-1 text-start">{c.displayName || c.keyword}</span>
                      {lastVisitedCampaignId === c.id ? (
                        <span className="shrink-0 text-[9px] font-semibold uppercase tracking-wide text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 rounded px-1.5 py-0.5">{t('home.lastVisited')}</span>
                      ) : (
                        <span className="text-[11px] text-zinc-400 tabular-nums">{c.leads?.filter((l: { deleted?: boolean }) => !l.deleted)?.length ?? 0}</span>
                      )}
                    </button>
                  );
                })}
              </div>
            )}
          </div>

          {/* Sites */}
          <div className="pt-1">
            {sectionHeader({ label: t('home.myGenerations'), icon: I.sites, active: generationsActive, open: generationsOpen, onToggle: () => setGenerationsOpen(!generationsOpen), onClick: goToGenerations, count: (generationsData?.length ?? 0) + liveGenJobs.length })}
            {full && generationsOpen && (
              <div className="mt-0.5 mb-2 ms-[18px] ps-2 border-s border-zinc-200 dark:border-zinc-800 space-y-px">
                {recentGenerations.length === 0 && liveGenJobs.length === 0 ? (
                  <p className="px-3 py-1.5 text-xs text-zinc-400">{t('home.noGenerations')}</p>
                ) : (
                  <>
                    {liveGenJobs.map(job => (
                      <button key={`live-${job.id}`} onClick={() => openLead(job.campaignId, job.leadId)} title={resolveJobMessage(job, t, 'generations.inProgress')} className={subItem(false)}>
                        <span className="animate-spin w-3 h-3 rounded-full border-2 border-emerald-500 border-t-transparent shrink-0" />
                        <span className="truncate flex-1 text-start">{job.leadName}</span>
                      </button>
                    ))}
                    {recentGenerations.map(g => (
                      <button key={g.id} onClick={() => openLead(g.campaignId, g.leadId)} className={subItem(false)} title={g.deploymentUrl ? t('generations.liveSite') : undefined}>
                        <span className={`w-1.5 h-1.5 rounded-full shrink-0 ${g.deploymentUrl ? 'bg-emerald-500' : 'bg-zinc-300 dark:bg-zinc-600'}`} />
                        <span className="truncate flex-1 text-start">{g.businessName || g.campaignName}</span>
                      </button>
                    ))}
                  </>
                )}
              </div>
            )}
          </div>
        </nav>

        {/* Footer */}
        <div className={`shrink-0 border-t border-zinc-200 dark:border-zinc-800/80 p-3 ${full ? 'space-y-1' : 'space-y-1 px-3.5'}`}>
          {navItem({ icon: I.settings, label: t('settings.title'), active: pathname === '/settings', onClick: () => go('/settings') })}
          <div className={`flex ${full ? 'items-center justify-between pt-1' : 'flex-col items-center gap-1'}`}>
            <div className={`flex ${full ? 'items-center gap-0.5' : 'flex-col items-center gap-1'}`}>
              <button onClick={toggleTheme} className={footerBtn} title={t('settings.theme')}>
                <Icon d={theme === 'dark' ? I.sun : I.moon} className="w-4 h-4" />
              </button>
              <div ref={langRef} className="relative">
                <button onClick={() => setLangOpen(o => !o)} className={`${footerBtn} flex items-center gap-1`} title={t('lang.' + currentLang)}>
                  <Icon d={I.globe} className="w-4 h-4" />
                  {full && <span className="text-[11px] font-semibold">{currentLang === 'ar' ? 'ع' : currentLang.toUpperCase()}</span>}
                </button>
                {langOpen && (
                  <div className={`absolute bottom-full mb-1.5 ${full ? 'start-0' : 'start-full ms-2 bottom-0 mb-0'} min-w-[140px] p-1 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-xl z-10`}>
                    {(['en', 'fr', 'ar'] as const).map(l => (
                      <button key={l} onClick={() => switchLang(l)} className={`w-full px-2.5 py-1.5 rounded-lg text-xs text-start transition-colors ${currentLang === l ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium' : 'text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800'}`}>
                        {t(`lang.${l}`)}
                      </button>
                    ))}
                  </div>
                )}
              </div>
              <button onClick={() => setAboutOpen(true)} className={footerBtn} title={t('about.title')}>
                <Icon d={I.info} className="w-4 h-4" />
              </button>
            </div>
          </div>
        </div>
      </aside>
    </>
  );
}
