              <div>
                <h3 className="text-sm font-semibold text-zinc-900 dark:text-white">{t('campaign.generateTitle')}</h3>
                <p className="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{t('campaign.generateDesc')}</p>
              </div>
              <button onClick={() => setShowGenerateModal(false)} className="p-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-700 rounded-lg transition-all">
                <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
            <div className="p-5">
              <label className="block text-xs font-medium text-zinc-500 dark:text-zinc-400 mb-2">{t('campaign.generateLabel')}</label>
              <textarea value={generatePrompt} onChange={e => setGeneratePrompt(e.target.value)} placeholder={t('campaign.generatePlaceholder')} className="w-full h-32 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-white text-sm p-3 resize-y focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all placeholder-zinc-400 dark:placeholder-zinc-500" />
            </div>
            <div className="flex items-center justify-end gap-2 px-5 py-4 border-t border-zinc-200 dark:border-zinc-700 bg-zinc-100/50 dark:bg-zinc-800/50">
              <button onClick={() => setShowGenerateModal(false)} className="px-4 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white bg-zinc-200 dark:bg-zinc-700 rounded-lg hover:bg-zinc-300 dark:hover:bg-zinc-600 transition-all">{t('campaign.generateCancel')}</button>
              <button onClick={submitGenerate} className="px-4 py-2 text-xs font-medium bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-lg hover:from-emerald-400 hover:to-teal-500 transition-all shadow-sm shadow-emerald-500/20">{t('campaign.generateConfirm')}</button>
            </div>
          </div>
        </div>
      )}

      {/* Images Modal */}
      {showImagesModal && imagesLead && (
        <div className="fixed inset-0 z-[110] bg-black/70 flex items-center justify-center p-4">
          <div className="bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl">
            <div className="flex items-center justify-between px-5 py-4 border-b border-zinc-200 dark:border-zinc-700">
              <div>
                <h3 className="text-sm font-semibold text-zinc-900 dark:text-white">{t('campaign.imagesTitle', { name: imagesLead.business.name })}</h3>
                <p className="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{t('campaign.imagesDesc')}</p>
              </div>
              <button onClick={() => setShowImagesModal(false)} className="p-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-700 rounded-lg transition-all">
                <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
            <div className="p-5 max-h-[70vh] overflow-y-auto">
              <div className="flex gap-1 mb-3 border-b border-zinc-200 dark:border-zinc-700">
                <button onClick={() => setImagesTab('uploaded')} className={`px-4 py-2 text-xs font-medium rounded-t-lg transition-all ${imagesTab === 'uploaded' ? 'text-zinc-900 dark:text-white border-b-2 border-emerald-500' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white'}`}>
                  {t('campaign.imagesTabUploaded')} ({(imagesLead.images || []).length})
                </button>
                <button onClick={() => setImagesTab('discovered')} className={`px-4 py-2 text-xs font-medium rounded-t-lg transition-all ${imagesTab === 'discovered' ? 'text-zinc-900 dark:text-white border-b-2 border-emerald-500' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white'}`}>
                  {t('campaign.imagesTabDiscovered')} ({(imagesLead.business.scrapedImages || []).length})
                </button>
              </div>

              <div className="mb-4 rounded-xl border border-red-200 bg-red-50 px-3 py-2 text-center text-[11px] font-medium text-red-700 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-300">
                {t('campaign.imageAiWarning')}
              </div>

              {imagesTab === 'uploaded' ? (
                <>
                  {imagesLead.images && imagesLead.images.length > 0 && (
                    <div className="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-3 gap-3 mb-5">
                      {imagesLead.images.map((img) => (
                        <div key={img.id} className="relative group bg-zinc-100 dark:bg-zinc-900 rounded-xl overflow-hidden border border-zinc-200 dark:border-zinc-700">
                          <img src={img.url} alt={img.alt} loading="lazy" className="w-full h-32 object-cover" />
                          <div className="p-2">
                            <input value={img.alt} onChange={(e) => { const newAlt = e.target.value; setImagesLead((prev) => { if (!prev) return prev; return { ...prev, images: prev.images?.map(i => i.id === img.id ? { ...i, alt: newAlt } : i) }; });                         fetch(`/api/campaigns/${id}/leads/${imagesLead.id}/images`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageId: img.id, alt: newAlt }) }); }} placeholder={t('campaign.altTextPlaceholder')} className="w-full text-[11px] bg-transparent text-zinc-500 dark:text-zinc-400 placeholder-zinc-400 dark:placeholder-zinc-600 border-b border-zinc-200 dark:border-zinc-700 focus:border-emerald-500 focus:outline-none py-1" />
                          </div>
                          <button onClick={async () => { await fetch(`/api/campaigns/${id}/leads/${imagesLead.id}/images`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageId: img.id }) }); const fresh = await loadCampaign(); const updated = fresh?.leads.find((l: any) => l.id === imagesLead.id); if (updated) setImagesLead(updated as Lead); }} className="absolute top-1 right-1 w-6 h-6 bg-red-600/80 text-white rounded-full text-xs opacity-0 group-hover:opacity-100 transition-opacity hover:bg-red-500 flex items-center justify-center">✕</button>
                        </div>
                      ))}
                    </div>
                  )}
                  {(imagesLead.images?.length || 0) < 10 && (
                    <div className="border-2 border-dashed border-zinc-300 dark:border-zinc-700 rounded-xl p-6 text-center hover:border-emerald-500/50 transition-colors">
                      <input type="file" accept="image/*" multiple onChange={async (e) => { const files = Array.from(e.target.files || []); if (files.length === 0) return; const remaining = 10 - (imagesLead.images?.length || 0); if (files.length > remaining) { toast(t('campaign.maxImages', { count: remaining }), 'error'); return; } setUploading(true); try { for (const file of files) { const formData = new FormData(); formData.append('file', file); formData.append('alt', file.name.replace(/\.[^/.]+$/, '')); const res = await fetch(`/api/campaigns/${id}/leads/${imagesLead.id}/images`, { method: 'POST', body: formData }); if (!res.ok) { const err = await res.json().catch(() => ({ error: 'Upload failed' })); throw new Error(err.error || t('campaign.uploadFailed', { status: res.status })); } } queryClient.invalidateQueries({ queryKey: ['campaign', id] }); const fresh = await loadCampaign(); const updated = fresh?.leads.find((l: any) => l.id === imagesLead.id); if (updated) setImagesLead(updated as Lead); } catch (err: any) { toast(err.message, 'error'); } finally { setUploading(false); e.target.value = ''; } }} className="hidden" id="image-upload" />
                      <label htmlFor="image-upload" className="cursor-pointer flex flex-col items-center gap-2">
                        <svg className="w-8 h-8 text-zinc-400 dark:text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        <span className="text-sm text-zinc-500 dark:text-zinc-400">{uploading ? t('campaign.uploading') : t('campaign.uploadLabel')}</span>
                        <span className="text-[11px] text-zinc-400 dark:text-zinc-600">{t('campaign.slotsRemaining', { count: 10 - (imagesLead.images?.length || 0) })}</span>
                      </label>
                    </div>
                  )}
                </>
              ) : (
                (() => {
                  const scrapedImages = imagesLead.business.scrapedImages || [];
                  const remaining = 10 - (imagesLead.images?.length || 0);
                  const allSelected = scrapedImages.length > 0 && scrapedImages.every(s => selectedScraped.has(s.id));
                  if (scrapedImages.length === 0) {
                    return <p className="text-sm text-zinc-500 dark:text-zinc-400 text-center py-8">{t('campaign.noDiscovered')}</p>;
                  }
                  return (
                    <>
                      <p className="text-xs text-zinc-500 dark:text-zinc-400 mb-3">{t('campaign.discoveredDesc', { count: remaining })}</p>
                      <div className="grid grid-cols-1 xs:grid-cols-2 sm:grid-cols-3 gap-3 mb-4">
                        {scrapedImages.map((img) => {
                          const selected = selectedScraped.has(img.id);
                          const done = importedScrapedIds.has(img.id);
                          return (
                            <div key={img.id} className={`relative group bg-zinc-100 dark:bg-zinc-900 rounded-xl overflow-hidden border transition-all ${selected ? 'border-emerald-500 ring-2 ring-emerald-500/40' : 'border-zinc-200 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500'}`}>
                              <div className="block w-full">
                                <button
                                  type="button"
                                  onClick={() => { if (!done) { setSelectedScraped(prev => { const next = new Set(prev); if (next.has(img.id)) next.delete(img.id); else if (next.size < remaining) next.add(img.id); return next; }); } }}
                                  className="block w-full cursor-pointer"
                                  title={t('campaign.toggleSelect')}
                                >
                                  <img src={img.url} alt="" loading="lazy" className="w-full h-32 object-cover" />
                                </button>
                                {selected && !done && (
                                  <div className="absolute inset-0 ring-2 ring-inset ring-emerald-500/70 bg-emerald-500/10 pointer-events-none" />
                                )}
                              </div>
                              <button type="button" onClick={() => setViewImage(img.url)} title={t('campaign.viewFullSize')} className="absolute top-1 right-1 w-6 h-6 bg-black/60 hover:bg-black/80 text-white rounded-full opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" /></svg>
                              </button>
                              {done && <div className="absolute bottom-0 inset-x-0 bg-emerald-600/90 text-white text-[10px] text-center py-0.5">{t('campaign.alreadyUploaded')}</div>}
                            </div>
                          );
                        })}
                      </div>
                      <div className="flex items-center justify-between gap-2 flex-wrap">
                        <button onClick={() => { if (allSelected) { setSelectedScraped(new Set()); } else { setSelectedScraped(new Set(scrapedImages.filter(s => !importedScrapedIds.has(s.id)).slice(0, remaining).map(s => s.id))); } }} className="px-3 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-300 bg-zinc-200 dark:bg-zinc-700/50 rounded-lg hover:bg-zinc-300 dark:hover:bg-zinc-700 hover:text-zinc-900 dark:hover:text-white transition-all">
                          {allSelected ? t('campaign.deselectAll') : t('campaign.selectAll')}
                        </button>
                        <button onClick={importSelectedImages} disabled={importing || selectedScraped.size === 0 || remaining <= 0} className="px-4 py-2 text-xs font-medium bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-lg hover:from-emerald-400 hover:to-teal-500 transition-all shadow-sm shadow-emerald-500/20 disabled:opacity-40 disabled:cursor-not-allowed">
                          {importing ? t('campaign.importing') : t('campaign.uploadSelected', { count: selectedScraped.size })}
                        </button>
                      </div>
                    </>
                  );
                })()
              )}
            </div>
            <div className="flex items-center justify-end gap-2 px-5 py-4 border-t border-zinc-200 dark:border-zinc-700 bg-zinc-100/50 dark:bg-zinc-800/50">
              <button onClick={() => setShowImagesModal(false)} className="px-4 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white bg-zinc-200 dark:bg-zinc-700 rounded-lg hover:bg-zinc-300 dark:hover:bg-zinc-600 transition-all">{t('campaign.done')}</button>
            </div>
          </div>

          {viewImage && (
            <div className="fixed inset-0 z-[120] bg-black/90 flex items-center justify-center p-6" onClick={() => setViewImage(null)}>
              <img src={viewImage} alt="" loading="lazy" className="max-w-full max-h-full rounded-lg shadow-2xl select-none" />
              <button onClick={(e) => { e.stopPropagation(); setViewImage(null); }} className="absolute top-4 right-4 w-10 h-10 bg-black/60 hover:bg-black/80 text-white rounded-full flex items-center justify-center transition-colors" title={t('campaign.close')}>
                <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
          )}
        </div>
      )}

      {domainEditLeadId && (() => {
        const dl = allLeads.find((l: any) => l.id === domainEditLeadId);
        if (!dl) return null;
        const av = domainAvailability[domainEditLeadId];
        return (
          <div className="fixed inset-0 z-[130] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm" onClick={() => { setDomainEditLeadId(null); setPendingGenerateLeadId(null); }}>
            <div className="w-full max-w-sm bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-2xl p-5 shadow-2xl" onClick={e => e.stopPropagation()}>
              <div className="flex items-center justify-between mb-4">
                <h3 className="text-sm font-semibold text-zinc-900 dark:text-white">{t('campaign.changeSubDomain')}</h3>
                <button onClick={() => { setDomainEditLeadId(null); setPendingGenerateLeadId(null); }} className="p-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-700 rounded-lg transition-all">
                  <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
              </div>
              <div className="text-[11px] text-zinc-400 dark:text-zinc-500 mb-2 truncate">{dl.business.name}</div>
              <div className="flex items-center gap-1.5 bg-zinc-100 dark:bg-zinc-900 rounded-lg px-3 py-2 border border-zinc-200 dark:border-zinc-700 focus-within:border-emerald-500/50">
                <span className="text-[11px] text-zinc-400 dark:text-zinc-500 shrink-0">https://</span>
                <input
                  value={domainDraft[domainEditLeadId] || ''}
                  onChange={e => onDomainDraftChange(domainEditLeadId, e.target.value)}
                  onKeyDown={e => { if (e.key === 'Enter') saveDomain(dl); if (e.key === 'Escape') { setDomainEditLeadId(null); setPendingGenerateLeadId(null); } }}
                  autoFocus
                  placeholder="my-domain"
                  className="flex-1 min-w-0 bg-transparent text-sm text-zinc-900 dark:text-white focus:outline-none placeholder-zinc-400 dark:placeholder-zinc-600"
                />
                <span className="text-[11px] text-zinc-400 dark:text-zinc-500 shrink-0">.vercel.app</span>
              </div>
              <div className="mt-2 text-[11px]">
                {av?.checking ? (
                  <span className="text-zinc-500 dark:text-zinc-400 animate-pulse">Checking...</span>
                ) : av?.available ? (
                  <span className="text-emerald-600 dark:text-emerald-400">Available</span>
                ) : av?.available === false ? (
                  <span className="text-red-600 dark:text-red-400">Taken</span>
                ) : av?.error ? (
                  <span className="text-amber-600 dark:text-amber-400">{av.error}</span>
                ) : null}
              </div>
              <div className="mt-3 flex items-start gap-1.5 text-[10px] text-amber-600 dark:text-amber-400/90 bg-amber-100/60 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 rounded-lg px-2.5 py-2">
                <svg className="w-3 h-3 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                <span>{t('campaign.subDomainLockWarning')}</span>
              </div>
              <div className="flex justify-end gap-2 mt-5">
                <button onClick={() => { setDomainEditLeadId(null); setPendingGenerateLeadId(null); }} className="px-4 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-300 bg-zinc-200 dark:bg-zinc-700 rounded-lg hover:bg-zinc-300 dark:hover:bg-zinc-600 transition-all">{t('campaign.cancel')}</button>
                <button onClick={() => saveDomain(dl)} disabled={av?.checking} className="px-4 py-2 text-xs font-medium bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 transition-all disabled:opacity-40">{t('campaign.confirm')}</button>
              </div>
            </div>
          </div>
        );
      })()}

      {/* Modification History Modal */}
      {historyLeadId && (() => {
        const hl = allLeads.find((l: any) => l.id === historyLeadId);
        if (!hl) return null;
        const history = hl.deploymentHistory || [];
        return (
          <div className="fixed inset-0 z-[130] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm" onClick={() => setHistoryLeadId(null)}>
            <div className="w-full max-w-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-2xl p-5 shadow-2xl max-h-[80vh] flex flex-col" onClick={e => e.stopPropagation()}>
              <div className="flex items-center justify-between mb-4 shrink-0">
                <h3 className="text-sm font-semibold text-zinc-900 dark:text-white">{t('campaign.viewModificationHistory')}</h3>
                <button onClick={() => setHistoryLeadId(null)} className="p-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-700 rounded-lg transition-all">
                  <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
              </div>
              <div className="text-[11px] text-zinc-400 dark:text-zinc-500 mb-3 shrink-0 truncate">{hl.business.name}</div>
              <div className="space-y-2 overflow-y-auto flex-1 min-h-0">
                {history.map((entry: any) => (
                  <div key={entry.id} className="flex items-start gap-2 text-[11px] bg-zinc-100/60 dark:bg-zinc-800/40 rounded-lg px-2.5 py-2">
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2 mb-1">
                        {entry.isMain && (
                          <span className="px-1.5 py-0.5 text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded shrink-0">{t('campaign.live')}</span>
                        )}
                        {entry.comingSoon && (
                          <span className="px-1.5 py-0.5 text-[10px] font-medium bg-zinc-500/10 text-zinc-500 dark:text-zinc-400 rounded shrink-0">{t('campaign.comingSoon')}</span>
                        )}
                        <span className="text-zinc-400 dark:text-zinc-500 shrink-0">{new Date(entry.deployedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })} {new Date(entry.deployedAt).toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}</span>
                      </div>
                      {entry.userPrompt ? (
                        <p className="text-zinc-600 dark:text-zinc-400 leading-snug">&ldquo;{entry.userPrompt}&rdquo;</p>
                      ) : (
                        <p className="text-zinc-400 dark:text-zinc-600 italic">—</p>
                      )}
                      <a href={entry.url} target="_blank" rel="noopener noreferrer" className="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white truncate block mt-1 underline underline-offset-2 decoration-zinc-300 dark:decoration-zinc-700/50">
                        {entry.url.replace('https://', '')}
                      </a>
                    </div>
                    {entry.isMain ? (
                      <span className="px-2 py-1 text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded shrink-0 whitespace-nowrap">{t('campaign.isMain')}</span>
                    ) : (
                      <button onClick={() => setMainDeployment(historyLeadId, entry.id)} className="px-2 py-1 text-[10px] font-medium bg-zinc-200 dark:bg-zinc-700/50 text-zinc-600 dark:text-zinc-300 rounded hover:bg-zinc-300 dark:hover:bg-zinc-700 hover:text-zinc-900 dark:hover:text-white transition-all shrink-0 whitespace-nowrap">{t('campaign.setDefault')}</button>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        );
      })()}

    </div>
  );
}
