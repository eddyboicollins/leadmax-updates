// ── Settings ──

export async function getSettings(): Promise<GlobalSettings> {
  const data = await readJSON<GlobalSettings>(settingsFile(), {} as GlobalSettings);
  return {
    vercelToken: data?.vercelToken || '',
    imgbbKey: data?.imgbbKey || '',
    geminiApiKey: data?.geminiApiKey || '',
    geminiModel: normalizeGeminiModel(data?.geminiModel),
    geminiSource: data?.geminiSource || 'proxy',
    systemPrompt: data?.systemPrompt || '',
    generationInstructions: data?.generationInstructions || '',
    wizardCompleted: data?.wizardCompleted || false,
    defaultMinRating: data?.defaultMinRating ?? 0,
    defaultMaxRating: data?.defaultMaxRating ?? 5,
    defaultMinReviews: data?.defaultMinReviews ?? 0,
  };
}

export async function saveSettings(data: Partial<GlobalSettings>): Promise<void> {
  const existing = await getSettings();
  const toSave: GlobalSettings = {
    vercelToken: data.vercelToken !== undefined ? data.vercelToken : existing.vercelToken,
    imgbbKey: data.imgbbKey !== undefined ? data.imgbbKey : existing.imgbbKey,
    geminiApiKey: data.geminiApiKey !== undefined ? data.geminiApiKey : existing.geminiApiKey,
    geminiModel: normalizeGeminiModel(data.geminiModel || existing.geminiModel),
    geminiSource: data.geminiSource !== undefined ? data.geminiSource : existing.geminiSource || 'proxy',
    systemPrompt: data.systemPrompt !== undefined ? data.systemPrompt : existing.systemPrompt,
    generationInstructions: data.generationInstructions !== undefined ? data.generationInstructions : existing.generationInstructions,
    wizardCompleted: data.wizardCompleted !== undefined ? data.wizardCompleted : existing.wizardCompleted,
    defaultMinRating: data.defaultMinRating !== undefined ? data.defaultMinRating : existing.defaultMinRating ?? 0,
    defaultMaxRating: data.defaultMaxRating !== undefined ? data.defaultMaxRating : existing.defaultMaxRating ?? 5,
    defaultMinReviews: data.defaultMinReviews !== undefined ? data.defaultMinReviews : existing.defaultMinReviews ?? 0,
  };
  await writeJSON(settingsFile(), toSave);
}

// ── Generations ──

export async function createLeadGeneration(data: {
  leadId: string;
  campaignId: string;
  landingPageCode?: string;
  deploymentUrl?: string;
  projectName?: string;
}): Promise<void> {
  const generations = await readJSON<LeadGeneration[]>(GENERATIONS_FILE, []);
  const existingIdx = generations.findIndex(g => g.leadId === data.leadId);
  const now = new Date().toISOString();
  if (existingIdx >= 0) {
    generations[existingIdx] = {
      ...generations[existingIdx],
      landingPageCode: data.landingPageCode || generations[existingIdx].landingPageCode,
      deploymentUrl: data.deploymentUrl || generations[existingIdx].deploymentUrl,
      projectName: data.projectName || generations[existingIdx].projectName,
    };
  } else {
    generations.push({
      id: uuidv4(),
      leadId: data.leadId,
      campaignId: data.campaignId,
      landingPageCode: data.landingPageCode,
      deploymentUrl: data.deploymentUrl,
      projectName: data.projectName,
      createdAt: now,
    });
  }
  await writeJSON(GENERATIONS_FILE, generations);
}

export async function getGenerationCountsForCampaign(campaignId: string): Promise<Record<string, number>> {
  const generations = await readJSON<LeadGeneration[]>(GENERATIONS_FILE, []);
  const filtered = generations.filter(g => g.campaignId === campaignId);
  const counts: Record<string, number> = {};
  for (const g of filtered) {
    counts[g.leadId] = (counts[g.leadId] || 0) + 1;
  }
  return counts;
}

