    { label: 'Instagram', url: 'https://www.instagram.com/motezhadjsalem/', icon: 'M16 4H8a4 4 0 00-4 4v8a4 4 0 004 4h8a4 4 0 004-4V8a4 4 0 00-4-4zm-4 11a3 3 0 110-6 3 3 0 010 6zm3.5-6.5a1 1 0 110-2 1 1 0 010 2z' },
    { label: 'TikTok', url: 'https://www.tiktok.com/@motez.hadjsalem', icon: 'M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.67 2.89 2.89 0 01-2.88-2.89 2.89 2.89 0 012.88-2.89c.36 0 .69.07 1 .19V8.47a6.36 6.36 0 00-1-.08A6.33 6.33 0 002.76 14.7a6.33 6.33 0 006.32 6.26 6.33 6.33 0 006.33-6.33v-3.9a8.21 8.21 0 004.18 1.25v-3.5a4.76 4.76 0 01-4-1.79z' },
