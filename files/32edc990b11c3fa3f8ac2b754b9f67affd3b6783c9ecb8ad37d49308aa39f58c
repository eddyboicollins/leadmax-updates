import { execSync } from 'node:child_process';
import { createHash, sign, createPrivateKey } from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { createRequire } from 'node:module';

const require = createRequire(import.meta.url);
const { canonicalJson } = require('../electron/update-verify.js');

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const projectRoot = path.join(__dirname, '..');
const buildDir = path.join(projectRoot, '.updates-build');
const tmpDir = path.join(projectRoot, '.updates-tmp');

const EXCLUDES = ['node_modules', 'data', 'build', '.env', 'release', 'electron', 'package.json'];

function run(cmd, opts = {}) {
  execSync(cmd, { stdio: 'inherit', shell: true, ...opts });
}

function git(args, cwd) {
  return execSync(['git', ...args].join(' '), {
    cwd,
    stdio: ['ignore', 'pipe', 'ignore'],
    shell: true,
  })
    .toString()
    .trim();
}

function walk(dir, relPrefix = '', isRoot = true) {
  const out = [];
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (isRoot && EXCLUDES.includes(entry.name)) continue;
    if (entry.isSymbolicLink()) continue;
    const rel = relPrefix ? path.join(relPrefix, entry.name) : entry.name;
    if (entry.isDirectory()) {
      out.push(...walk(path.join(dir, entry.name), rel, false));
    } else if (entry.isFile()) {
      out.push(rel);
    }
  }
  return out;
}

console.log('[publish] building...');

const payload = path.join(projectRoot, '.next', 'standalone');
if (!fs.existsSync(path.join(payload, 'server.js'))) {
  console.error('[publish] standalone output missing server.js');
  process.exit(1);
}

console.log('[publish] generating manifest...');
const files = {};
const blobDir = path.join(buildDir, 'files');
fs.rmSync(buildDir, { recursive: true, force: true });
fs.mkdirSync(blobDir, { recursive: true });

for (const rel of walk(payload)) {
  const abs = path.join(payload, rel);
  const hash = createHash('sha256').update(fs.readFileSync(abs)).digest('hex');
  files[rel.split(path.sep).join('/')] = hash;
  if (!fs.existsSync(path.join(blobDir, hash))) {
    fs.copyFileSync(abs, path.join(blobDir, hash));
  }
}

const version = git(['rev-parse', '--short', 'HEAD']);
const unsigned = { version, updatedAt: new Date().toISOString(), files };

// Sign the manifest so the app can verify it came from the publisher. The
// private key must not be committed; it is read from an env var (or a local
// PEM file that is gitignored). Refuse to publish without a valid signature.
const signingKeyPem =
  process.env.LEADMAX_UPDATE_SIGNING_KEY ||
  (fs.existsSync(path.join(projectRoot, 'scripts', 'update-signing-key.pem'))
    ? fs.readFileSync(path.join(projectRoot, 'scripts', 'update-signing-key.pem'), 'utf8')
    : '');

if (!signingKeyPem.trim()) {
  console.error(
    '[publish] ABORT: no update signing key found. Set LEADMAX_UPDATE_SIGNING_KEY or provide scripts/update-signing-key.pem',
  );
  process.exit(1);
}

const signature = sign(null, Buffer.from(canonicalJson(unsigned), 'utf8'), createPrivateKey(signingKeyPem)).toString('base64');
const manifest = { ...unsigned, signature };
fs.writeFileSync(path.join(buildDir, 'manifest.json'), JSON.stringify(manifest, null, 2));
console.log(`[publish] manifest: ${Object.keys(files).length} files, version ${version}, signed`);

// Self-check: verify the freshly written manifest before it goes anywhere, so a
// signing bug can never push an unverifiable manifest to every user.
const { verifyManifestSignature } = require('../electron/update-verify.js');
const written = JSON.parse(fs.readFileSync(path.join(buildDir, 'manifest.json'), 'utf8'));
const check = verifyManifestSignature(written);
if (!check.ok) {
  console.error(`[publish] ABORT: generated manifest failed verification (${check.reason})`);
  process.exit(1);
}
console.log('[publish] manifest signature self-check passed');

const originUrl = git(['remote', 'get-url', 'origin']);
const ownerMatch = originUrl.match(/(?:github\.com[/:]|git@github\.com:)([^/]+)/);
const owner = ownerMatch ? ownerMatch[1] : 'eddyboicollins';
const updatesRepo = process.env.LEADMAX_UPDATES_REPO || 'leadmax-updates';
const remoteUrl = `https://github.com/${owner}/${updatesRepo}.git`;
fs.rmSync(tmpDir, { recursive: true, force: true });
let branchExists = false;
try {
  run(`git clone --depth 1 --single-branch --branch release "${remoteUrl}" "${tmpDir}"`);
  branchExists = true;
} catch {
  fs.mkdirSync(tmpDir, { recursive: true });
  run('git init', { cwd: tmpDir });
  run(`git remote add origin "${remoteUrl}"`, { cwd: tmpDir });
  run('git checkout -b release', { cwd: tmpDir });
  fs.writeFileSync(path.join(tmpDir, '.gitkeep'), '');
  run('git add .gitkeep', { cwd: tmpDir });
  run('git commit -m "init release branch"', { cwd: tmpDir });
}

fs.rmSync(path.join(tmpDir, 'files'), { recursive: true, force: true });
fs.rmSync(path.join(tmpDir, 'manifest.json'), { force: true });
fs.cpSync(path.join(buildDir, 'files'), path.join(tmpDir, 'files'), { recursive: true });
fs.copyFileSync(path.join(buildDir, 'manifest.json'), path.join(tmpDir, 'manifest.json'));

// Blob hashes are computed over the local file bytes. Git must not normalize
// line endings (CRLF -> LF) when committing, or downloaded blobs won't match
// the manifest hashes ("Hash mismatch for ..."). Treat everything as binary.
fs.writeFileSync(path.join(tmpDir, '.gitattributes'), '* -text\n');

const userName = git(['config', 'user.name']) || 'leadmax-update';
const userEmail = git(['config', 'user.email']) || 'leadmax-update@users.noreply.github.com';

run('git add -A', { cwd: tmpDir });
run(
  `git -c user.name="${userName}" -c user.email="${userEmail}" commit -m "Update ${version}"`,
  { cwd: tmpDir },
);
run(branchExists ? 'git push origin release' : 'git push -u origin release', { cwd: tmpDir });

console.log('[publish] pushed to release branch.');

fs.rmSync(tmpDir, { recursive: true, force: true });
fs.rmSync(buildDir, { recursive: true, force: true });
