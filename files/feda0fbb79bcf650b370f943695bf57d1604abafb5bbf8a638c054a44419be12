import type { Metadata } from "next";
import "./globals.css";
import { QueryProvider } from "@/lib/query/QueryProvider";
import I18nClientProvider from "@/components/I18nProvider";
import ThemeProvider from "@/components/ThemeProvider";
import ScrapeProvider from "@/lib/scrape/ScrapeProvider";
import GenerationProvider from "@/lib/generate/GenerationProvider";
import UpdateStatus from "@/components/UpdateStatus";
import ToastProvider from "@/components/Toast";
import ScrollToTop from "@/components/ScrollToTop";
import AppShell from "@/components/AppShell";

export const metadata: Metadata = {
  title: "LeadMax 2.0",
  description: "Find 5-star businesses without websites and generate high-converting landing pages with AI",
};

export default function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
  return (
    <html lang="en" className="h-full" dir="ltr" suppressHydrationWarning>
      <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
      </head>
      <body className="min-h-full bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 antialiased transition-colors" suppressHydrationWarning>
        <QueryProvider>
          <I18nClientProvider>
            <ThemeProvider>
              <ScrapeProvider>
                <GenerationProvider>
                  <ToastProvider>
                    <AppShell>
                      {children}
                      <ScrollToTop />
                      <UpdateStatus />
                    </AppShell>
                  </ToastProvider>
                </GenerationProvider>
              </ScrapeProvider>
            </ThemeProvider>
          </I18nClientProvider>
        </QueryProvider>
      </body>
    </html>
  );
}
