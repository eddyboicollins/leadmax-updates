'use client';

import { useEffect } from 'react';
import { createPortal } from 'react-dom';
import { useLockBodyScroll } from '@/lib/useLockBodyScroll';

/**
 * The app's dialog: dimmed blurred backdrop, one panel style, header with an
 * icon tile, scrollable body, sticky footer. Escape and a backdrop click close
 * it unless `dismissible` is false (e.g. while something is running).
 */

const SIZES = {
  sm: 'max-w-sm',
  md: 'max-w-lg',
  lg: 'max-w-2xl',
  xl: 'max-w-4xl',
} as const;

export function Modal({
  open,
  onClose,
  size = 'md',
  dismissible = true,
  align = 'center',
  z = 'z-[150]',
  className = '',
  children,
}: {
  open: boolean;
  onClose: () => void;
  size?: keyof typeof SIZES;
  dismissible?: boolean;
  /** 'top' for command-palette style dialogs. */
  align?: 'center' | 'top';
  z?: string;
  className?: string;
  children: React.ReactNode;
}) {
  useLockBodyScroll(open);
  useEffect(() => {
    if (!open || !dismissible) return;
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') onClose(); };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [open, dismissible, onClose]);

  if (!open || typeof document === 'undefined') return null;
  // Portal to <body>: a dialog rendered inside a transformed element (e.g. a
  // card lifting on hover) would otherwise be sized/positioned by that element.
  return createPortal(
    <div
      className={`fixed inset-0 ${z} flex justify-center p-4 sm:p-6 ${align === 'top' ? 'items-start pt-[12vh]' : 'items-center'}`}
      role="dialog"
      aria-modal="true"
      // React events still bubble through portals: keep clicks from reaching
      // whatever the dialog was opened from (e.g. a clickable card).
      onClick={e => e.stopPropagation()}
      onMouseDown={e => e.stopPropagation()}
    >
      <div className="lm-fade-in absolute inset-0 bg-zinc-950/70 backdrop-blur-sm" onClick={dismissible ? onClose : undefined} />
      <div
        className={`lm-pop-in relative w-full ${SIZES[size]} max-h-[calc(100dvh-2rem)] sm:max-h-[88vh] flex flex-col overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-2xl shadow-black/40 ${className}`}
        onClick={e => e.stopPropagation()}
      >
        {children}
      </div>
    </div>,
    document.body,
  );
}

export function ModalHeader({ icon, title, description, onClose, children }: {
  /** SVG path(s) for the icon tile, or any node. */
  icon?: string | React.ReactNode;
  title: React.ReactNode;
  description?: React.ReactNode;
  onClose?: () => void;
  /** Extra content under the title row (tabs, search…). */
  children?: React.ReactNode;
}) {
  return (
    <div className="shrink-0 px-5 sm:px-6 pt-5 pb-4 border-b border-zinc-200 dark:border-zinc-800">
      <div className="flex items-start gap-3">
        {icon && (
          <span className="shrink-0 w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
            {typeof icon === 'string'
              ? <svg className="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.9}><path strokeLinecap="round" strokeLinejoin="round" d={icon} /></svg>
              : icon}
          </span>
        )}
        <div className="min-w-0 flex-1 pt-0.5">
          <h2 className="text-[15px] font-semibold text-zinc-900 dark:text-white leading-snug">{title}</h2>
          {description && <p className="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">{description}</p>}
        </div>
        {onClose && (
          <button onClick={onClose} className="-me-1.5 -mt-0.5 p-1.5 rounded-lg text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors shrink-0" aria-label="Close">
            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        )}
      </div>
      {children}
    </div>
  );
}

export function ModalBody({ className = '', children }: { className?: string; children: React.ReactNode }) {
  return <div className={`flex-1 min-h-0 overflow-y-auto px-5 sm:px-6 py-5 ${className}`}>{children}</div>;
}

export function ModalFooter({ className = '', children }: { className?: string; children: React.ReactNode }) {
  return (
    <div className={`shrink-0 px-5 sm:px-6 py-4 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex items-center justify-end gap-2 ${className}`}>
      {children}
    </div>
  );
}

