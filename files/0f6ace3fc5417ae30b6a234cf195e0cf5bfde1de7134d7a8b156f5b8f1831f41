export const GEMINI_MODELS = {
  'gemini-2.5-flash': 'Gemini 2.5 Flash (Recommended)',
  'gemini-2.5-flash-lite': 'Gemini 2.5 Flash Lite',
  'gemini-2.5-pro': 'Gemini 2.5 Pro',
  'gemini-3-flash-preview': 'Gemini 3 Flash Preview',
  'gemini-3-pro-preview': 'Gemini 3 Pro Preview',
} as const;

export type GeminiModel = keyof typeof GEMINI_MODELS;

export type GeminiSource = 'proxy' | 'api';

export const DEFAULT_GEMINI_MODEL: GeminiModel = 'gemini-2.5-flash';

function buildUrl(url: string): string {
  const reqid = Math.floor(100000 + Math.random() * 900000);
  if (url.includes('_reqid=')) {
    return url.replace(/_reqid=\d+/, `_reqid=${reqid}`);
  }
  const separator = url.includes('?') ? '&' : '?';
  return `${url}${separator}_reqid=${reqid}`;
}

function buildPayload(basePayload: string, fullPrompt: string): string {
  const trimmed = basePayload.endsWith('&') ? basePayload.slice(0, -1) : basePayload;
  const params = new URLSearchParams(trimmed);
  const fReqRaw = params.get('f.req');
  if (!fReqRaw) return basePayload;

  try {
    const outer = JSON.parse(fReqRaw);
    if (Array.isArray(outer) && typeof outer[1] === 'string') {
      const inner = JSON.parse(outer[1]);
      if (Array.isArray(inner) && Array.isArray(inner[0])) {
        inner[0][0] = fullPrompt;
        outer[1] = JSON.stringify(inner);
      }
    }
    const nextFReq = JSON.stringify(outer);
    params.set('f.req', nextFReq);
    return `${params.toString()}&`;
  } catch {
    return basePayload.replace(/"hi"/, `"${fullPrompt.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
  }
}

function parseGeminiText(streamText: string): string {
  let bestText = '';
  const cleaned = streamText.replace(")]}'", '');
  const lines = cleaned.split(/\r?\n/);
  for (const rawLine of lines) {
    const line = rawLine.trim();
    if (!line || !line.includes('wrb.fr')) continue;
    let parsedLine: unknown;
    try {
      parsedLine = JSON.parse(line);
    } catch {
      continue;
    }
    const arr = Array.isArray(parsedLine) ? parsedLine : [];
    const entries = arr[0] === 'wrb.fr' ? [arr] : arr.filter((item): item is unknown[] => Array.isArray(item) && item[0] === 'wrb.fr');
    for (const entry of entries) {
      const payload = entry[2];
      if (typeof payload !== 'string') continue;
      let inner: unknown;
      try {
        inner = JSON.parse(payload);
      } catch {
        continue;
      }
      if (Array.isArray(inner) && Array.isArray(inner[4])) {
        for (const candidate of inner[4]) {
          if (Array.isArray(candidate) && Array.isArray(candidate[1])) {
            const text = (candidate[1] as unknown[])
              .filter((p): p is string => typeof p === 'string')
              .join('')
              .trim();
            if (text.length > bestText.length) bestText = text;
          }
        }
      }
    }
  }
  return bestText;
}

export async function askGemini(
  prompt: string,
  _apiKey: string,
  _model: GeminiModel = DEFAULT_GEMINI_MODEL,
  source: GeminiSource = 'proxy',
): Promise<string> {
  if (source === 'api') {
    return officialAskGemini(prompt, _apiKey, _model);
  }
  const url = buildUrl(GEMINI_CONFIG.url);
  const payload = buildPayload(GEMINI_CONFIG.post_data, prompt);

  const response = await fetch(url, {
    method: 'POST',
    headers: GEMINI_CONFIG.headers,
    body: payload,
  });

  if (!response.ok) {
    throw new Error(`Gemini proxy returned HTTP ${response.status}`);
  }

  const text = await response.text();
  const parsed = parseGeminiText(text);
  if (!parsed) throw new Error('Gemini returned an empty response.');

  return parsed;
}

/** Calls the official Gemini REST API (generativelanguage.googleapis.com) with the user's API key. */
export async function officialAskGemini(
  prompt: string,
  apiKey: string,
  model: GeminiModel = DEFAULT_GEMINI_MODEL,
): Promise<string> {
  if (!apiKey) {
    throw new Error('No Gemini API key configured. Add it in Settings or switch the AI source back to Proxy.');
  }
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent?key=${encodeURIComponent(apiKey)}`;
  const response = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      contents: [{ role: 'user', parts: [{ text: prompt }] }],
      generationConfig: { temperature: 0.9, topP: 0.95 },
    }),
  });

  if (!response.ok) {
    const errText = await response.text().catch(() => '');
    let message = `Gemini API returned HTTP ${response.status}`;
    try {
      const j = JSON.parse(errText);
      if (j?.error?.message) message = j.error.message;
    } catch { /* keep default */ }
    throw new Error(message);
  }

  const data = (await response.json()) as {
    candidates?: Array<{ content?: { parts?: Array<{ text?: string }> } }>;
  };
  const text = data?.candidates?.[0]?.content?.parts
    ?.filter(p => typeof p?.text === 'string')
    .map(p => p.text as string)
    .join('')
    .trim();
  if (!text) throw new Error('Gemini returned an empty response.');
  return text;
}

export async function retryAskGemini(
  prompt: string,
  apiKey: string,
  model: GeminiModel,
  maxRetries = 4,
  onRetry?: (attempt: number, maxRetries: number, error: string) => void,
  source: GeminiSource = 'proxy',
): Promise<string> {
  let lastError: Error | null = null;
  for (let attempt = 0; attempt <= maxRetries; attempt++) {
    try {
      return await askGemini(prompt, apiKey, model, source);
    } catch (err) {
      lastError = err instanceof Error ? err : new Error(String(err));
      const isLastAttempt = attempt >= maxRetries;
      const msg = lastError.message;
      onRetry?.(attempt + 1, maxRetries + 1, msg);
      console.error(`[Gemini] Attempt ${attempt + 1}/${maxRetries + 1} failed: ${msg}`);
      if (isLastAttempt) break;
      const delay = Math.min(1000 * Math.pow(2, attempt), 15000);
      console.error(`[Gemini] Retrying in ${delay}ms...`);
      await new Promise(r => setTimeout(r, delay));
    }
  }
  throw lastError || new Error('Gemini request failed after retries');
}
