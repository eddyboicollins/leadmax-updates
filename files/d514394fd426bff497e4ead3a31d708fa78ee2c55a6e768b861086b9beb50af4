import { NextResponse } from 'next/server';
import { getProxyStatus, resetProxyChat } from '@/lib/aiProxy';

/** Proxy health — does not launch the browser, just reports state. */
export async function GET() {
  return NextResponse.json({ ...getProxyStatus(), source: 'proxy' });
}

/** POST { action: 'reset' } — abandon the current Gemini web chat. */
export async function POST(request: Request) {
  try {
    const body = await request.json().catch(() => ({}));
    if (body?.action === 'reset') {
      await resetProxyChat();
      return NextResponse.json({ success: true });
    }
    return NextResponse.json({ error: 'unknown action' }, { status: 400 });
  } catch (err) {
    return NextResponse.json(
      { error: err instanceof Error ? err.message : 'Proxy reset failed' },
      { status: 500 },
    );
  }
}
