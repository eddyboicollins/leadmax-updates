import { NextResponse } from 'next/server';
import { NextRequest } from 'next/server';
import { scrapeGoogleMaps } from '@/lib/scraper';
import { addLeads } from '@/lib/store';
import { v4 as uuidv4 } from 'uuid';

export const dynamic = 'force-dynamic';
export const maxDuration = 300;

interface BatchCampaign {
  campaignId: string;
  keyword: string;
  location: string;
}

const normName = (s: string) => (s || '').toLowerCase().replace(/[^a-z0-9]/g, '');

export async function POST(request: NextRequest) {
  try {
    const { campaigns } = await request.json();
    if (!Array.isArray(campaigns) || campaigns.length === 0) {
      return NextResponse.json({ error: 'campaigns array required' }, { status: 400 });
    }

    const encoder = new TextEncoder();
    const stream = new ReadableStream({
      async start(controller) {
        const send = (type: string, data: any) => {
          controller.enqueue(encoder.encode(JSON.stringify({ type, ...data }) + '\n'));
        };

        send('batch-start', { total: campaigns.length });

        let totalLeads = 0;

        for (const campaign of campaigns as BatchCampaign[]) {
          // Dedupe state is scoped to a single campaign and released after it
          // finishes, so memory stays flat no matter how many campaigns run.
          const existingPlaceIds = new Set<string>();
          const existingPhones = new Set<string>();
          const existingNames = new Set<string>();
          let captured = 0;

          send('campaign-start', {
            index: campaigns.indexOf(campaign),
            campaignId: campaign.campaignId,
            keyword: campaign.keyword,
            location: campaign.location,
          });

          try {
            await scrapeGoogleMaps(
              `${campaign.keyword} ${campaign.location}`,
              (msg) => send('log', { index: campaigns.indexOf(campaign), campaignId: campaign.campaignId, message: msg }),
              async (business) => {
                if (
                  existingPlaceIds.has(business.placeId) ||
                  (business.phone && existingPhones.has(business.phone)) ||
                  existingNames.has(normName(business.name))
                ) return;

                if (business.placeId) existingPlaceIds.add(business.placeId);
                if (business.phone) existingPhones.add(business.phone);
                existingNames.add(normName(business.name));

                const leadId = uuidv4();
                await addLeads(campaign.campaignId, [{ leadId, business }]);
                captured++;
                send('lead', { index: campaigns.indexOf(campaign), campaignId: campaign.campaignId, lead: business, leadId });
              },
              (total) => send('total', { index: campaigns.indexOf(campaign), campaignId: campaign.campaignId, total }),
              {
                onProgress: (processed, total, current) => send('progress', {
                  index: campaigns.indexOf(campaign),
                  campaignId: campaign.campaignId,
                  processed,
                  total,
                  current: current ? {
                    name: current.name,
                    rating: current.rating,
                    ratingCount: current.ratingCount,
                    address: current.address,
                    phone: current.phone,
                  } : null,
                }),
              },
            );

            totalLeads += captured;
            send('campaign-done', {
              index: campaigns.indexOf(campaign),
              campaignId: campaign.campaignId,
              count: captured,
            });
          } catch (err: unknown) {
            send('campaign-error', {
              index: campaigns.indexOf(campaign),
              campaignId: campaign.campaignId,
              error: err instanceof Error ? err.message : 'Campaign scrape failed',
            });
          }
        }

        send('done', { count: totalLeads });
        controller.close();
      },
    });

    return new Response(stream, {
      headers: {
        'Content-Type': 'application/x-ndjson',
        'Cache-Control': 'no-cache',
        Connection: 'keep-alive',
      },
    });
  } catch (error: unknown) {
    console.error('Batch scraping error:', error);
    return NextResponse.json(
      { error: error instanceof Error ? error.message : 'Failed to scrape batch' },
      { status: 500 },
    );
  }
}