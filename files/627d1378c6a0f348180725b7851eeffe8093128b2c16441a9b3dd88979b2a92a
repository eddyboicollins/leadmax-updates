import { promises as fs } from 'fs';
import path from 'path';
import { DATA_DIR, readJSON } from './store';
import type { Campaign, GlobalSettings, LeadGeneration, Chat } from './types';

/**
 * Smart data-folder discovery for older LeadMax installs.
 *
 * Older versions kept their data folder inside the app files, e.g.
 *   <install>/resources/app/data
 *   <install>/win-unpackaged/resources/app/data
 *   <install>/data
 * New versions store it under DATA_DIR (userData/app/data or portable /data).
 *
 * Given the folder the user picked (usually the old install root or the old
 * data folder itself), find the directory that actually contains the LeadMax
 * data files and return a summary of what is inside it.
 */

/** Strong markers: a real LeadMax data folder must contain at least one. */
const STRONG_MARKERS = ['campaigns.json', 'settings.json', 'generations.json', 'chats.json'];

/** Weak markers used as a tie-breaker / extra confidence. */
const WEAK_MARKERS = ['leads', 'scraped', 'chat-messages'];

/** Candidate relative paths probed inside the user-selected folder. */
const CANDIDATE_PATHS = [
  '',
  'data',
  'resources/app/data',
  'win-unpackaged/resources/app/data',
  'app/data',
  'resources/app',
  'app',
  '.next/standalone/data',
];

async function pathExists(p: string): Promise<boolean> {
  try {
    await fs.access(p);
    return true;
  } catch {
    return false;
  }
}

async function isDirectory(p: string): Promise<boolean> {
  try {
    return (await fs.stat(p)).isDirectory();
  } catch {
    return false;
  }
}

/** Returns a confidence score (0 = not a LeadMax data folder). */
async function scoreDataDir(dir: string): Promise<number> {
  let score = 0;
  for (const m of STRONG_MARKERS) {
    if (await pathExists(path.join(dir, m))) score += 2;
  }
  for (const m of WEAK_MARKERS) {
    if (await pathExists(path.join(dir, m))) score += 1;
  }
  return score;
}

/** Counts files recursively under a dir (used for scraped images). */
async function countFiles(dir: string): Promise<number> {
  let total = 0;
  let entries: import('fs').Dirent[];
  try {
    entries = await fs.readdir(dir, { withFileTypes: true });
  } catch {
    return 0;
  }
  for (const e of entries) {
    if (e.isDirectory()) total += await countFiles(path.join(dir, e.name));
    else total += 1;
  }
  return total;
}

export interface DataSummary {
  campaigns: number;
  leads: number;
  generations: number;
  chats: number;
  scrapedImages: number;
}

export async function summarizeDataDir(dir: string): Promise<DataSummary> {
  const campaigns = await readJSON<Campaign[]>(path.join(dir, 'campaigns.json'), []);
  const generations = await readJSON<LeadGeneration[]>(path.join(dir, 'generations.json'), []);
  const chats = await readJSON<Chat[]>(path.join(dir, 'chats.json'), []);
  let leads = 0;
  const leadsDir = path.join(dir, 'leads');
  if (await isDirectory(leadsDir)) {
    let files: string[] = [];
    try {
      files = await fs.readdir(leadsDir);
    } catch {}
    for (const f of files.filter(f => f.endsWith('.json'))) {
      const arr = await readJSON<unknown[]>(path.join(leadsDir, f), []);
      leads += Array.isArray(arr) ? arr.length : 0;
    }
  }
  const scrapedImages = await countFiles(path.join(dir, 'scraped'));
  return {
    campaigns: Array.isArray(campaigns) ? campaigns.length : 0,
    leads,
    generations: Array.isArray(generations) ? generations.length : 0,
    chats: Array.isArray(chats) ? chats.length : 0,
    scrapedImages,
  };
}

export interface Detection {
  found: boolean;
  dataDir: string | null;
  source: string;
  summary: DataSummary | null;
  error?: string;
}

/** Finds the real LeadMax data folder inside the user-selected folder. */
export async function detectDataFolder(source: string): Promise<Detection> {
  if (!source || !(await pathExists(source))) {
    return { found: false, dataDir: null, source, summary: null, error: 'Folder does not exist' };
  }

  let best: { dir: string; score: number } | null = null;

  // 1) Probe well-known candidate paths.
  for (const rel of CANDIDATE_PATHS) {
    const candidate = rel ? path.join(source, rel) : source;
    if (!(await isDirectory(candidate))) continue;
    const score = await scoreDataDir(candidate);
    if (score > 0 && (!best || score > best.score)) best = { dir: candidate, score };
  }

  // 2) Fallback: bounded recursive walk for unusually nested installs.
  if (!best || best.score < 2) {
    const skip = new Set(['node_modules', '.git', 'release', 'build', '.next', 'win-unpackaged']);
    let walkBest: { dir: string; score: number } | null = best;
    const walk = async (dir: string, depth: number): Promise<void> => {
      if (depth > 6) return;
      let entries: import('fs').Dirent[];
      try {
        entries = await fs.readdir(dir, { withFileTypes: true });
      } catch {
        return;
      }
      for (const e of entries) {
        if (!e.isDirectory() || skip.has(e.name)) continue;
        const sub = path.join(dir, e.name);
        if (sub.startsWith(DATA_DIR + path.sep)) continue;
        const score = await scoreDataDir(sub);
        if (score > 0 && (!walkBest || score > walkBest.score)) {
          walkBest = { dir: sub, score };
        }
        await walk(sub, depth + 1);
      }
    };
    await walk(source, 0);
    best = walkBest;
  }

  if (!best) {
    return {
      found: false,
      dataDir: null,
      source,
      summary: null,
      error: 'No LeadMax data found in that folder',
    };
  }

  return {
    found: true,
    dataDir: best.dir,
    source,
    summary: await summarizeDataDir(best.dir),
  };
}

async function copyTree(src: string, dst: string): Promise<{ copied: number; skipped: number }> {
  let copied = 0;
  let skipped = 0;
  await fs.mkdir(dst, { recursive: true });
  const entries = await fs.readdir(src, { withFileTypes: true });
  for (const e of entries) {
    const s = path.join(src, e.name);
    const d = path.join(dst, e.name);
    if (e.isDirectory()) {
      const r = await copyTree(s, d);
      copied += r.copied;
      skipped += r.skipped;
    } else if (e.isFile()) {
      try {
        await fs.copyFile(s, d);
        copied += 1;
      } catch {
        skipped += 1;
      }
    }
  }
  return { copied, skipped };
}

export interface MigrationResult {
  ok: boolean;
  dataDir: string | null;
  copied: number;
  skipped: number;
  summary: DataSummary | null;
  error?: string;
}

/** Copies the old data folder into the current DATA_DIR. */
export async function migrateDataFolder(source: string, dataDirOverride?: string): Promise<MigrationResult> {
  const detection = await detectDataFolder(source);
  if (!detection.found || !detection.dataDir) {
    return {
      ok: false,
      dataDir: null,
      copied: 0,
      skipped: 0,
      summary: null,
      error: detection.error || 'No LeadMax data found in that folder',
    };
  }

  const dataDir = dataDirOverride || detection.dataDir;
  if (path.resolve(dataDir) === path.resolve(DATA_DIR)) {
    return {
      ok: false,
      dataDir,
      copied: 0,
      skipped: 0,
      summary: detection.summary,
      error: 'That folder is already the current data folder',
    };
  }

  await fs.mkdir(DATA_DIR, { recursive: true });
  const { copied, skipped } = await copyTree(dataDir, DATA_DIR);
  return {
    ok: true,
    dataDir,
    copied,
    skipped,
    summary: detection.summary,
  };
}
