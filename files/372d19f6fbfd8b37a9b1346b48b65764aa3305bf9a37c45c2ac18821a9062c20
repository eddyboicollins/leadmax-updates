                    <button onClick={() => unpublishWebsite(lead)} className="flex-1 min-w-0 justify-center inline-flex items-center gap-1 px-1.5 sm:px-2 py-1 sm:py-1.5 text-[10px] sm:text-[11px] font-medium bg-zinc-100 dark:bg-zinc-700/50 text-zinc-600 dark:text-zinc-400 rounded-lg hover:bg-emerald-500/15 hover:text-emerald-400 hover:ring-1 hover:ring-emerald-500/40 transition-all">
