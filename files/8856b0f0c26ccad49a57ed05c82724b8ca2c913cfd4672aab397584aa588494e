import { NextRequest, NextResponse } from 'next/server';
import { getCampaigns, saveCampaign, deleteCampaign } from '@/lib/store';
import type { ManualClient } from '@/lib/types';

export async function GET(request: NextRequest) {
  const deletedParam = request.nextUrl.searchParams.get('deleted');
  const campaigns = await getCampaigns();
  if (deletedParam === 'all') {
    return NextResponse.json({ campaigns });
  }
  if (deletedParam === 'true') {
    return NextResponse.json({ campaigns: campaigns.filter(c => c.deleted) });
  }
  return NextResponse.json({ campaigns: campaigns.filter(c => !c.deleted) });
}

export async function POST(request: NextRequest) {
  try {
    const { keyword, location, minRating, maxRating, minReviews, regions, mode, manualClients, name } = await request.json();
    const isManual = mode === 'manual' || (Array.isArray(manualClients) && manualClients.length > 0);
    if (!isManual && (!keyword || !location)) {
      return NextResponse.json({ error: 'keyword and location required' }, { status: 400 });
    }
    const filter = {
      ...(typeof minRating === 'number' ? { minRating } : {}),
      ...(typeof maxRating === 'number' ? { maxRating } : {}),
      ...(typeof minReviews === 'number' ? { minReviews } : {}),
    };
    let regionList = regions;
    if (Array.isArray(regionList)) {
      regionList = regionList.filter(
        (r: any) => r && typeof r.keyword === 'string' && r.keyword && typeof r.location === 'string' && r.location
      );
      regionList = regionList.map((r: any) => ({
        keyword: r.keyword,
        location: r.location,
        ...(typeof r.minRating === 'number' ? { minRating: r.minRating } : {}),
        ...(typeof r.maxRating === 'number' ? { maxRating: r.maxRating } : {}),
        ...(typeof r.minReviews === 'number' ? { minReviews: r.minReviews } : {}),
      }));
    }
    let manualList: ManualClient[] | undefined;
    if (Array.isArray(manualClients)) {
      const cleaned = manualClients.filter(
        (m): m is ManualClient => !!m && typeof m.url === 'string' && m.url.trim().length > 0
      ).map((m, i) => ({
        id: `${Date.now()}-${i}`,
        name: typeof m.name === 'string' ? m.name.trim() : '',
        url: m.url.trim(),
      }));
      if (cleaned.length > 0) manualList = cleaned;
    }
    // Manual campaigns get a custom campaign name; default to the first client.
    const manualName = typeof name === 'string' && name.trim() ? name.trim() : '';
    const effectiveKeyword = isManual ? (manualName || (manualList && manualList[0]?.name) || keyword || '') : keyword;
    const campaign = await saveCampaign(
      effectiveKeyword || '',
      isManual ? '' : location,
      filter,
      Array.isArray(regionList) && regionList.length > 0 ? regionList : undefined,
      { mode: isManual ? 'manual' : 'search', manualClients: manualList },
    );
    return NextResponse.json(campaign);
  } catch (err: any) {
    return NextResponse.json({ error: err.message }, { status: 500 });
  }
}

export async function DELETE(request: NextRequest) {
  const id = request.nextUrl.searchParams.get('id');
  if (!id) {
    return NextResponse.json({ error: 'id required' }, { status: 400 });
  }
  await deleteCampaign(id);
  return NextResponse.json({ success: true });
}
