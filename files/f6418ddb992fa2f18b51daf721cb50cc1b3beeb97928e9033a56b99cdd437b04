const { contextBridge, ipcRenderer } = require('electron');

contextBridge.exposeInMainWorld('leadmax', {
  onUpdateStatus: (callback) => {
    ipcRenderer.on('update-status', (_event, data) => callback(data));
  },
  applyUpdate: () => {
    ipcRenderer.send('update:apply');
  },
  dismissUpdate: () => {
    ipcRenderer.send('update:dismiss');
  },
  getUpdateStatus: () => {
    ipcRenderer.send('update:get-status');
  },
  selectFolder: () => {
    return ipcRenderer.invoke('dialog:select-folder');
  },
});
