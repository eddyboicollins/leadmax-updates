      {/* Modify Studio: fullscreen chat + live preview */}
      {studioLeadId && (() => {
        const sl = allLeads.find((l: any) => l.id === studioLeadId);
        if (!sl) return null;
        const liveJob = generation.jobs.find(j => j.leadId === sl.id && j.kind === 'modify' && j.phase !== 'done' && j.phase !== 'error') || null;
        const errorJob = !liveJob ? (generation.jobs.find(j => j.leadId === sl.id && j.kind === 'modify' && j.phase === 'error') || null) : null;
        const isBizStudio = (campaign as any)?.assetType === 'bizcard';
        const studioCard = isBizStudio ? (cardsOf(sl).find(c => c.id === studioCardId) || activeCardOf(sl)) : null;
        const studioHistory = studioCard ? (studioCard.deploymentHistory || []) : (sl.deploymentHistory || []);
        const studioMainUrl = studioCard?.deploymentUrl || mainSiteUrl(sl);
        return (
          <ModifyStudio
            businessName={sl.business.name}
            mainUrl={studioMainUrl}
            history={studioHistory}
            images={activeImages(sl.images)}
            uploading={uploading}
            liveJob={liveJob}
            error={errorJob ? (resolveJobMessage(errorJob, t) || null) : null}
            onDismissError={errorJob ? () => generation.dismissJob(errorJob.id) : undefined}
            onSend={sendStudioPrompt}
            onUploadImages={(files) => uploadFilesForLead(sl, files)}
            onDeleteImage={(imageId) => deleteLeadImage(sl.id, imageId)}
            onSetMain={(entryId) => setMainDeployment(sl.id, entryId, studioCard?.id || null)}
            onClose={closeStudio}
          />
        );
