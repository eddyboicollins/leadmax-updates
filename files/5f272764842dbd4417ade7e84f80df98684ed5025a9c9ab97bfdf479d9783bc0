.lm-pin-halo { position: absolute; inset: -14px; border-radius: 999px; background: radial-gradient(circle, rgba(52,211,153,.35) 0%, rgba(52,211,153,.12) 45%, transparent 70%); animation: lm-halo 2.4s ease-out infinite; }
.lm-pin-core { position: absolute; inset: 8px; border-radius: 999px; background: #34d399; border: 3px solid #064e3b; box-shadow: 0 0 0 6px rgba(52,211,153,.25), 0 4px 14px rgba(0,0,0,.45); }
