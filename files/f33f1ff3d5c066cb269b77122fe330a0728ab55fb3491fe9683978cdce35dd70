'use client';

import { useState, useEffect, useLayoutEffect, useRef } from 'react';
import { createPortal } from 'react-dom';
import { useTranslation } from 'react-i18next';
import { businessLang, matchBusinessTypes } from '@/lib/businessTypes';

interface Props {
  value: string;
  onChange: (value: string) => void;
  placeholder?: string;
  className?: string;
  autoFocus?: boolean;
}

/**
 * Campaign keyword field: a list of predefined local business types (in the
 * UI language) to pick from, filtered as you type. Any other typed keyword is
 * kept as-is.
 */
export default function KeywordAutocomplete({ value, onChange, placeholder, className, autoFocus }: Props) {
  const { i18n } = useTranslation();
  const [open, setOpen] = useState(false);
  const [highlight, setHighlight] = useState(0);
  const wrapperRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLInputElement>(null);
  const listRef = useRef<HTMLDivElement>(null);
  const [pos, setPos] = useState<{ left: number; width: number; top?: number; bottom?: number } | null>(null);

  const results = matchBusinessTypes(value, businessLang(i18n.language));
  // Nothing left to suggest once the value is exactly one of the types.
  const exact = results.length === 1 && results[0].toLowerCase() === value.trim().toLowerCase();
  const showList = open && results.length > 0 && !exact;

  // Close on outside click. Capture phase: dialogs stop mousedown propagation.
  useEffect(() => {
    const onDocClick = (e: MouseEvent) => {
      const target = e.target as Node;
      if (wrapperRef.current?.contains(target) || listRef.current?.contains(target)) return;
      setOpen(false);
    };
    document.addEventListener('mousedown', onDocClick, true);
    return () => document.removeEventListener('mousedown', onDocClick, true);
  }, []);

  // Portaled to <body> so dialog bodies can't clip it; pinned under the input.
  useLayoutEffect(() => {
    if (!showList) return;
    const place = () => {
      const r = inputRef.current?.getBoundingClientRect();
      if (!r) return;
      const below = window.innerHeight - r.bottom;
      const up = below < 280 && r.top > below;
      setPos({ left: r.left, width: r.width, top: up ? undefined : r.bottom + 8, bottom: up ? window.innerHeight - r.top + 8 : undefined });
    };
    place();
    window.addEventListener('resize', place);
    window.addEventListener('scroll', place, true);
    return () => { window.removeEventListener('resize', place); window.removeEventListener('scroll', place, true); };
  }, [showList]);

  // Keep the highlighted option in view while moving with the arrow keys.
  useEffect(() => {
    if (!showList) return;
    listRef.current?.querySelector<HTMLElement>(`[data-idx="${highlight}"]`)?.scrollIntoView({ block: 'nearest' });
  }, [highlight, showList]);

  const pick = (type: string) => {
    onChange(type);
    setOpen(false);
  };

  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (!open) { setOpen(true); return; }
      setHighlight(h => Math.min(h + 1, results.length - 1));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setHighlight(h => Math.max(h - 1, 0));
    } else if (e.key === 'Enter') {
      if (showList && results[highlight]) {
        e.preventDefault();
        pick(results[highlight]);
      }
    } else if (e.key === 'Escape') {
      setOpen(false);
    }
  };

  return (
    <div ref={wrapperRef} className="relative">
      <div className="relative">
        <input
          ref={inputRef}
          value={value}
          onChange={e => { onChange(e.target.value); setOpen(true); setHighlight(0); }}
          onFocus={() => setOpen(true)}
          onClick={() => setOpen(true)}
          onKeyDown={handleKeyDown}
          placeholder={placeholder}
          className={`${className ?? ''} pe-9`}
          autoFocus={autoFocus}
          autoComplete="off"
          spellCheck={false}
        />
        <button
          type="button"
          tabIndex={-1}
          onMouseDown={e => e.preventDefault()}
          onClick={() => { setOpen(o => !o); inputRef.current?.focus(); }}
          className="absolute end-2 top-1/2 -translate-y-1/2 p-1 rounded-md text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200"
          aria-label="Show business types"
        >
          <svg className={`w-4 h-4 transition-transform ${showList ? 'rotate-180' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" /></svg>
        </button>
      </div>
      {showList && pos && createPortal(
        <div
          ref={listRef}
          style={{ position: 'fixed', left: pos.left, width: pos.width, top: pos.top, bottom: pos.bottom }}
          className="z-[200] bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-xl shadow-2xl shadow-black/40 overflow-hidden max-h-64 overflow-y-auto"
        >
          {results.map((type, idx) => (
            <button
              key={type}
              data-idx={idx}
              type="button"
              onMouseDown={e => e.preventDefault()}
              onClick={() => pick(type)}
              onMouseEnter={() => setHighlight(idx)}
              className={`w-full text-start px-3 py-2 text-sm text-zinc-700 dark:text-zinc-200 transition-colors ${idx === highlight ? 'bg-emerald-500/10' : ''}`}
            >
              {type}
            </button>
          ))}
        </div>,
        document.body,
      )}
    </div>
  );
}
