import { NextRequest, NextResponse } from 'next/server';
import { getCampaign, getLead, updateLeadLandingPage, getSettings, getAgentCards, updateAgentCard } from '@/lib/store';
import { askGeminiAndValidate, MODIFY_PROMPT_SUFFIX, formatModifyImagesBlock, buildBizCardDataBlock, getLeadImageSources, buildSocialsBlock } from '@/lib/prompts';
import { DEFAULT_GEMINI_MODEL, type GeminiModel, type GeminiSource } from '@/lib/gemini';

export const maxDuration = 300;

export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  const { id, leadId } = await params;

  const body = await request.json();
  const { userPrompt, agentCardId } = body;

  if (!userPrompt || typeof userPrompt !== 'string') {
    return NextResponse.json({ error: 'userPrompt is required' }, { status: 400 });
  }

  const campaign = await getCampaign(id);
  if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

  const lead = await getLead(leadId);
  if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

  const isBizCard = (campaign as any)?.assetType === 'bizcard';

  // Multi-agent card flow: source + agent data live on the card
  let card: any = null;
  if (isBizCard && agentCardId) {
    card = getAgentCards(lead).find(c => c.id === agentCardId) || null;
    if (!card) return NextResponse.json({ error: 'Agent card not found' }, { status: 404 });
  }

  const existingTsx = card?.tsx || lead.landingPage?.tsx || lead.deploymentHistory?.find(e => e.isMain)?.tsx;
  if (!existingTsx) {
    return NextResponse.json({ error: 'No landing page to modify. Generate one first.' }, { status: 400 });
  }

  const imagesBlock = formatModifyImagesBlock(lead);
  const agent: any = card?.agentInfo || (lead as any)?.agentInfo;
  const paletteHint = isBizCard && agent?.palette
    ? `CURRENT PALETTE (use these exact hexes, do not invent others): PRIMARY ${agent.palette.primary} / SECONDARY ${agent.palette.secondary} / BACKGROUND ${agent.palette.background}. Top HUD sm:rounded-t-[28px] rounded-none on mobile, bottom HUD sm:rounded-b-[28px] rounded-none on mobile, scrollable body has custom thin scrollbar, avatar/cover never in gallery.`
    : null;

  const avatarHint = isBizCard && agent && (agent.previousAvatarUrl || agent.previousCoverUrl)
    ? `PHOTO CHANGE (use the NEW urls, never the old): NEW avatar ${agent.avatarUrl || '(none)'} / NEW cover ${agent.coverUrl || '(none)'}. OLD avatar ${agent.previousAvatarUrl || '(none)'} / OLD cover ${agent.previousCoverUrl || '(none)'}. Replace every occurrence of the OLD photo urls anywhere in the component with the corresponding NEW url.`
    : null;

  const settings = await getSettings();
  const apiKey = settings.geminiApiKey || '';
  const model = (settings.geminiModel as GeminiModel) || DEFAULT_GEMINI_MODEL;
  const source = (settings.geminiSource as GeminiSource) || 'proxy';

  // Card flow: inject the card's CURRENT agent data so detail edits (name,
  // phone, photos…) apply to the right values.
  let agentDataBlock: string | null = null;
  if (card?.agentInfo) {
    const srcs = getLeadImageSources(lead).filter(s => s.url !== card.agentInfo.avatarUrl && s.url !== card.agentInfo.coverUrl);
    agentDataBlock = buildBizCardDataBlock(card.agentInfo, {
      name: lead.business.name,
      address: lead.business.address,
      latitude: (lead.business as any).latitude,
      longitude: (lead.business as any).longitude,
      placeId: (lead.business as any).placeId,
      googleUrl: (lead.business as any).googleUrl,
      website: lead.business.website,
      phone: lead.business.phone,
    }, {
      email: (lead.business as any).enrichedEmail,
      instagram: (lead.business as any).enrichedSocials?.instagram,
      linkedin: (lead.business as any).enrichedSocials?.linkedin,
      facebook: (lead.business as any).enrichedSocials?.facebook,
      twitter: (lead.business as any).enrichedSocials?.twitter,
      tiktok: (lead.business as any).enrichedSocials?.tiktok,
      youtube: (lead.business as any).enrichedSocials?.youtube,
    }, JSON.stringify(srcs.map(s => ({ url: s.url, alt: s.alt }))));
  }

  // Site-gen modify: carry the enriched email/socials (if present) so the AI preserves them.
  const enrichedEmail = (lead.business as any).enrichedEmail as string | undefined;
  const enrichedSocials = (lead.business as any).enrichedSocials as { instagram?: string; linkedin?: string; facebook?: string; twitter?: string; tiktok?: string; youtube?: string } | undefined;
  const hasEnriched = !!(
    enrichedEmail ||
    enrichedSocials?.instagram ||
    enrichedSocials?.linkedin ||
    enrichedSocials?.facebook ||
    enrichedSocials?.twitter ||
    enrichedSocials?.tiktok ||
    enrichedSocials?.youtube
  );
  const contactBlock = !isBizCard && hasEnriched
    ? `CURRENT CONTACT & SOCIALS (found online — keep these exact values in the design where relevant):\nEMAIL: ${enrichedEmail || ''}\nSOCIALS:\n${buildSocialsBlock(enrichedSocials)}`
    : null;

  const prompt = [
    'Here is the React component to modify:',
    existingTsx,
    '',
    "User's change request:",
    userPrompt,
    agentDataBlock ? '' : null,
    agentDataBlock ? 'CURRENT AGENT/BUSINESS DATA (use these exact values for any detail edits):' : null,
    agentDataBlock,
    contactBlock ? '' : null,
    contactBlock,
    paletteHint ? '' : null,
    paletteHint,
    avatarHint ? '' : null,
    avatarHint,
    imagesBlock ? '' : null,
    imagesBlock || null,
    '',
    'Return the COMPLETE modified React component (default export), no explanations.',
    MODIFY_PROMPT_SUFFIX,
  ].filter(Boolean).join('\n');

  const encoder = new TextEncoder();
  const stream = new ReadableStream({
    async start(controller) {
      const send = (event: Record<string, unknown>) => {
        try { controller.enqueue(encoder.encode(`data: ${JSON.stringify(event)}\n\n`)); } catch { /* client disconnected */ }
      };
      try {
        send({ step: 'generating', message: 'Updating your website...' });
        const onTruncatedRetry = (retryInSec: number) =>
          send({ step: 'truncated_retry', message: 'Our free AI is experiencing high demand, retrying...', retryInSec });

        const cleanTsx = await askGeminiAndValidate(prompt, apiKey, model, 4, undefined, source, onTruncatedRetry);

        let version: number;
        if (card) {
          const updated = await updateAgentCard(leadId, card.id, {
            tsx: cleanTsx,
            version: (card.version || 0) + 1,
            generatedAt: new Date().toISOString(),
          });
          version = updated?.version || 1;
        } else {
          const lp = lead.landingPage || { generatedAt: new Date().toISOString(), version: 0, sections: [] };
          const landingPage = {
            tsx: cleanTsx,
            generatedAt: lp.generatedAt,
            version: (lp.version || 0) + 1,
            sections: lp.sections || [],
          };
          await updateLeadLandingPage(leadId, landingPage);
          version = landingPage.version;
        }

        send({ step: 'complete', success: true, version });
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : 'Failed to modify landing page';
        send({ step: 'error', error: message });
      } finally {
        try { controller.close(); } catch { /* client disconnected */ }
      }
    },
  });

  return new Response(stream, {
    headers: {
      'Content-Type': 'text/event-stream; charset=utf-8',
      'Cache-Control': 'no-cache, no-transform',
      Connection: 'keep-alive',
    },
  });
}
