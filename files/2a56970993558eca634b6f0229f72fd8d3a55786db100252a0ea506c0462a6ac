                </a>
              )}
            </div>
          </div>
          <div className="flex-1 min-h-0 relative">
            {showingLive ? (
              <div className="absolute inset-0 bg-black overflow-hidden flex flex-col">
                {liveJob.liveCode ? (
                    <pre ref={liveCodeRef} className="flex-1 min-h-0 overflow-y-auto p-4 sm:p-6 text-[11px] sm:text-xs font-mono text-emerald-400 bg-black whitespace-pre-wrap break-words leading-relaxed">
                      {liveJob.liveCode}
                    </pre>
                ) : (
                  <>
                    <MatrixRain />
                    <div className="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center pointer-events-none bg-black/55">
                      <Spinner className="w-12 h-12 text-emerald-400" />
                      <p className="text-sm font-medium text-zinc-100 flex items-center gap-1 max-w-full shadow-black drop-shadow-md">
                        <span className="truncate">{liveJobText || t('campaign.studioWorking')}</span>
                        <span className="status-dots shrink-0" aria-hidden="true">
                          <span>.</span><span>.</span><span>.</span>
                        </span>
                      </p>
                    </div>
                  </>
                )}
              </div>
            ) : studioView === 'code' ? (
              <div className="absolute inset-0 flex flex-col bg-zinc-950">
                <div className="flex items-center gap-2 px-3 sm:px-4 py-2 border-b border-zinc-800 shrink-0">
                  <span className="text-[11px] font-medium text-zinc-400 truncate">
                    v{selected?.n ?? 0}{selectedStatus?.state === 'live' ? ` · ${t('campaign.live')}` : ''} · {((codeSource.length || 0) / 1024).toFixed(1)} KB
                  </span>
                  <button
                    onClick={copyCode}
                    disabled={!codeSource}
                    className="ms-auto inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[11px] font-medium text-zinc-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded-lg transition-all disabled:opacity-40 shrink-0"
                  >
                    {copied ? (
                      <svg className="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" /></svg>
                    ) : (
                      <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                    )}
                    {copied ? t('campaign.studioCopied') : t('campaign.studioCopyCode')}
                  </button>
                </div>
                {codeSource ? (
                  <pre ref={codeRef} className="flex-1 min-h-0 overflow-y-auto p-4 sm:p-6 text-[11px] sm:text-xs font-mono text-zinc-200 whitespace-pre-wrap break-words leading-relaxed">
                    {codeSource}
                  </pre>
                ) : (
                  <div className="flex-1 flex items-center justify-center p-8 text-center">
                    <p className="text-sm text-zinc-500 max-w-sm">{t('campaign.studioNoCode')}</p>
                  </div>
                )}
              </div>
            ) : preview ? (
              <>
                {device === 'desktop' ? (
                  <>
                    {previewLoading}
                    {preview}
                  </>
                ) : (
                  <div className="absolute inset-0 flex items-stretch justify-center p-3 sm:p-4 overflow-hidden">
                    <div
                      style={{ width: DEVICE_W[device] }}
                      className="relative h-full w-full max-w-full rounded-xl overflow-hidden border border-zinc-300 dark:border-zinc-700 shadow-2xl bg-white"
                    >
                      {previewLoading}
                      {preview}
                    </div>
                  </div>
                )}

                {/* Saving shield: the page under it is about to be replaced. */}
                {saving && (
                  <div className="absolute inset-0 z-20 flex items-start justify-center pt-4 cursor-wait">
                    <span className="inline-flex items-center gap-2 px-3 py-1.5 text-[11px] font-medium bg-zinc-900 text-white rounded-full shadow-lg">
                      <span className="animate-spin w-3 h-3 rounded-full border-2 border-emerald-400 border-t-transparent" />
                      {t('campaign.studioSaving')}
                    </span>
                  </div>
                )}

                {/* Edit-mode hint */}
                {(mode === 'edit' || mode === 'images') && !selection && !saving && previewLoaded && (
                  <div className="absolute top-3 left-1/2 -translate-x-1/2 z-20 px-3 py-1.5 text-[11px] font-medium bg-zinc-900/90 text-white rounded-full shadow-lg pointer-events-none whitespace-nowrap max-w-[90%] truncate">
                    {mode === 'images' ? t('campaign.studioImagesHint') : t('campaign.studioEditHint')}
                  </div>
                )}

                {/* Notices (edit refused / no change / duplicate) */}
                {notice && (
                  <div className={`absolute top-3 left-1/2 -translate-x-1/2 z-30 max-w-[min(560px,92%)] flex items-start gap-2 px-3.5 py-2.5 rounded-xl shadow-lg text-[12px] leading-relaxed ${notice.tone === 'error' ? 'bg-zinc-800 text-white ring-1 ring-white/15' : 'bg-zinc-900 text-white'}`}>
                    <span className="flex-1 break-words">{notice.text}</span>
                    <button onClick={() => setNotice(null)} className="opacity-70 hover:opacity-100 shrink-0">✕</button>
                  </div>
                )}

                {/* Render / runtime error of this version */}
                {previewError && (
                  <div className="absolute bottom-3 left-3 right-3 z-30 flex items-start gap-3 px-4 py-3 rounded-xl bg-zinc-900 text-white ring-1 ring-white/10 shadow-xl">
                    <div className="flex-1 min-w-0">
                      <p className="text-[12px] font-semibold">{t('campaign.studioPreviewError')}</p>
                      <p className="text-[11px] opacity-90 break-words line-clamp-3 font-mono">{previewError}</p>
                    </div>
                    <button
                      onClick={() => { if (selected) onSend(`Fix this error so the page renders correctly: ${previewError}`, selected.id); }}
                      disabled={busy}
                      className="shrink-0 px-2.5 py-1.5 text-[11px] font-semibold bg-emerald-500 text-white rounded-lg hover:bg-emerald-400 disabled:opacity-60"
                    >
                      {t('campaign.studioAskAiFix')}
                    </button>
                    <button onClick={() => setPreviewError(null)} className="opacity-70 hover:opacity-100 shrink-0">✕</button>
                  </div>
                )}

                {/* Inspector for the clicked element */}
                {mode === 'comment' && !selection && !saving && previewLoaded && (
                  <div className="absolute top-3 left-1/2 -translate-x-1/2 z-20 px-3 py-1.5 text-[11px] font-medium bg-emerald-800/95 text-white rounded-full shadow-lg pointer-events-none whitespace-nowrap max-w-[90%] truncate">
                    {t('campaign.studioCommentHint')}
                  </div>
                )}

                {/* Comment composer for the clicked element / section */}
                {mode === 'comment' && selection && !saving && (
                  <div className="absolute bottom-3 left-3 z-30 w-[min(380px,calc(100%-24px))] rounded-2xl border border-emerald-600/40 bg-white dark:bg-zinc-900 shadow-2xl">
                    <div className="flex items-center gap-2 px-3.5 py-2 border-b border-zinc-200 dark:border-zinc-800">
                      <span className="min-w-0 flex-1 text-[11px] font-mono text-zinc-500 dark:text-zinc-400 truncate" title={selection.excerpt || ''}>
                        {noteTargetLabel({
                          tag: selection.tag || 'element',
                          section: selection.section,
                          excerpt: selection.excerpt,
                          role: selection.role,
                          label: selection.label,
                          context: selection.context,
                          item: selection.item ?? null,
                          insert: selection.kind === 'insert' && selection.after ? { after: selection.after, before: selection.before ?? null } : undefined,
                        })}
                      </span>
                      {selection.kind !== 'insert' && <button
                        onClick={() => postToPreview({ type: 'select-parent' })}
                        title={t('campaign.studioSelectParent')}
                        className="shrink-0 inline-flex items-center gap-1 px-2 py-1 text-[10px] font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 rounded-md hover:bg-emerald-500/15 hover:text-emerald-600 dark:hover:text-emerald-300 transition-all"
                      >
                        <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}><path strokeLinecap="round" strokeLinejoin="round" d="M5 15l7-7 7 7" /></svg>
                        {t('campaign.studioSelectParent')}
                      </button>}
                      <button onClick={closeSelection} className="shrink-0 p-1 text-zinc-400 hover:text-zinc-900 dark:hover:text-white rounded">
                        <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                      </button>
                    </div>
                    <div className="p-3 space-y-2">
                      <textarea
                        autoFocus
                        value={noteDraft}
                        onChange={e => setNoteDraft(e.target.value)}
                        onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); addNote(); } }}
                        placeholder={selection.kind === 'insert' ? t('campaign.studioInsertPlaceholder') : t('campaign.studioNotePlaceholder')}
                        rows={2}
                        className="w-full resize-none text-[12px] bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg px-2.5 py-2 text-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
                      />
                      <div className="flex items-center justify-between gap-2">
                        <span className="text-[10px] text-zinc-400">{t('campaign.studioNoteHint')}</span>
                        <button
                          onClick={addNote}
                          disabled={!noteDraft.trim()}
                          className="shrink-0 px-2.5 py-1.5 text-[11px] font-semibold bg-emerald-700 text-white rounded-lg hover:bg-emerald-600 disabled:opacity-40 transition-all"
                        >
                          {t('campaign.studioAddNote')}
                        </button>
                      </div>
                    </div>
                  </div>
                )}

                {((mode === 'edit' && selection && selection.kind !== 'image' && selection.kind !== 'bgimage')
                  || (mode === 'images' && selection && (selection.kind === 'image' || selection.kind === 'bgimage'))) && selection && (
                  <div className="absolute bottom-3 left-3 z-30 w-[min(360px,calc(100%-24px))] rounded-2xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-2xl">
                    <div className="flex items-center gap-2 px-3.5 py-2 border-b border-zinc-200 dark:border-zinc-800">
                      <span className="px-1.5 py-0.5 text-[10px] font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 rounded">&lt;{selection.tag || 'element'}&gt;</span>
                      <span className="text-[12px] font-medium text-zinc-800 dark:text-zinc-100 truncate">
                        {selection.kind === 'text' ? t('campaign.studioInspectText')
                          : selection.kind === 'image' || selection.kind === 'bgimage' ? t('campaign.studioInspectImage')
                          : selection.kind === 'link' ? t('campaign.studioInspectLink')
                          : t('campaign.studioInspectElement')}
                      </span>
                      <button onClick={closeSelection} className="ms-auto p-1 text-zinc-400 hover:text-zinc-900 dark:hover:text-white rounded">
                        <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                      </button>
                    </div>
                    <div className="p-3.5 space-y-3">
                      {selection.kind === 'text' && (
                        <p className="text-[11px] text-zinc-500 dark:text-zinc-400">{t('campaign.studioEditTextHint')}</p>
                      )}
                      {selection.kind === 'element' && !linkEditable && (
                        <p className="text-[11px] text-zinc-500 dark:text-zinc-400">{t('campaign.studioEditElementHint')}</p>
                      )}
                      {(selection.kind === 'image' || selection.kind === 'bgimage') && selection.src && (
                        <>
                          <div className="flex items-center gap-2">
                            {/* eslint-disable-next-line @next/next/no-img-element */}
                            <img src={selection.src} alt="" className="w-14 h-14 rounded-lg object-cover border border-zinc-200 dark:border-zinc-700" />
                            <button
                              onClick={() => openCropper(selection)}
                              className="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[11px] font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 rounded-lg hover:bg-emerald-500/15 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all"
                            >
                              <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 2v14a2 2 0 002 2h14M18 22V8a2 2 0 00-2-2H2" /></svg>
                              {t('campaign.studioCropZoom')}
                            </button>
                          </div>
                          <div>
                            <p className="text-[11px] font-medium text-zinc-600 dark:text-zinc-300 mb-1.5">{t('campaign.studioReplacePhoto')}</p>
                            <div className="flex flex-wrap gap-1.5 max-h-28 overflow-y-auto p-0.5">
                              {images.map(img => (
                                <button
                                  key={img.id}
                                  onClick={() => replaceImage(selection, img.url)}
                                  disabled={img.url === (shownPhoto && shownPhoto.page === pageKey && shownPhoto.loc === selection.loc ? shownPhoto.src : selection.src)}
                                  title={img.alt}
                                  className="rounded-md overflow-hidden border-2 border-transparent hover:border-emerald-500 disabled:border-emerald-500 disabled:opacity-60 transition-all"
                                >
                                  {/* eslint-disable-next-line @next/next/no-img-element */}
                                  <img src={img.url} alt={img.alt} className="w-12 h-12 object-cover" />
                                </button>
                              ))}
                              {images.length < MAX_LEAD_IMAGES && (
                                <>
                                  <input
                                    ref={inspectorFileRef}
                                    type="file"
                                    accept="image/*"
                                    multiple
                                    className="hidden"
                                    onChange={e => {
                                      const files = Array.from(e.target.files || []);
                                      e.target.value = '';
                                      if (files.length) uploadFromInspector(selection, files);
                                    }}
                                  />
                                  <button
                                    type="button"
                                    onClick={() => inspectorFileRef.current?.click()}
                                    disabled={uploading}
                                    title={t('campaign.studioUploadPhoto')}
                                    className="w-[52px] h-[52px] rounded-md border-2 border-dashed border-zinc-300 dark:border-zinc-600 text-zinc-400 dark:text-zinc-500 hover:border-emerald-500 hover:text-emerald-600 dark:hover:text-emerald-400 flex flex-col items-center justify-center gap-0.5 transition-all disabled:cursor-wait"
                                  >
                                    {uploading ? (
                                      <span className="animate-spin w-4 h-4 rounded-full border-2 border-emerald-400 border-t-transparent" />
                                    ) : (
                                      <>
                                        <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                                        <span className="text-[9px] font-medium leading-none">{t('campaign.studioUploadShort')}</span>
                                      </>
                                    )}
                                  </button>
                                </>
                              )}
                            </div>
                            <p className="mt-1 text-[10px] text-zinc-400">
                              {images.length >= MAX_LEAD_IMAGES ? t('campaign.studioPhotosFull', { max: MAX_LEAD_IMAGES }) : t('campaign.studioUploadHint')}
                            </p>
                          </div>
                        </>
                      )}
                      {linkEditable && (
                        <div>
                          <p className="text-[11px] font-medium text-zinc-600 dark:text-zinc-300 mb-1.5">{t('campaign.studioLinkUrl')}</p>
                          <div className="flex items-center gap-1.5">
                            <input
                              value={linkDraft}
                              onChange={e => setLinkDraft(e.target.value)}
                              onKeyDown={e => { if (e.key === 'Enter') applyLink(); }}
                              className="flex-1 min-w-0 text-[12px] font-mono bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg px-2 py-1.5 text-zinc-800 dark:text-zinc-100 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
                            />
                            <button
                              onClick={applyLink}
                              disabled={!linkDraft.trim() || linkDraft.trim() === selection.href}
                              className="px-2.5 py-1.5 text-[11px] font-medium bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 disabled:opacity-40 transition-all"
                            >
                              {t('campaign.studioApply')}
                            </button>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                )}
              </>
            ) : (
              <div className="absolute inset-0 flex items-center justify-center p-8 text-center">
                <p className="text-sm text-zinc-400 dark:text-zinc-500 max-w-sm">{versionsLoading ? t('campaign.studioPreviewLoading') : t('campaign.studioNoPreview')}</p>
              </div>
            )}
          </div>
          {(liveJob || publishJob) && (
            <div className="shrink-0 flex items-center gap-2.5 px-3 sm:px-4 py-2.5 border-t border-zinc-800 bg-zinc-950">
              <Spinner className="w-4 h-4 text-emerald-400 shrink-0" />
              <span className="flex-1 min-w-0 text-[12px] font-medium text-zinc-200 truncate">{(liveJob ? liveJobText : publishJobText) || t('campaign.studioWorking')}</span>
              <span className="status-dots shrink-0" aria-hidden="true">
                <span>.</span><span>.</span><span>.</span>
              </span>
              {liveJob && studioView !== 'live' && (
                <button
                  onClick={() => setStudioView('live')}
                  className="shrink-0 inline-flex items-center gap-1 px-2.5 py-1.5 text-[11px] font-medium text-emerald-400 bg-emerald-500/10 hover:bg-emerald-500/20 rounded-lg transition-all"
                >
                  <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                  {t('campaign.studioViewLive')}
                </button>
              )}
              {liveJob && onCancelJob && (
                <button
                  onClick={onCancelJob}
                  className="shrink-0 inline-flex items-center gap-1.5 px-2.5 py-1.5 text-[11px] font-medium text-zinc-200 bg-zinc-800 hover:bg-zinc-700 rounded-lg transition-all"
                >
                  <svg className="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2" /></svg>
                  {t('campaign.studioStopJob')}
                </button>
              )}
            </div>
          )}
        </div>
      </div>

      {cropper && (
        <ImageCropper
          src={cropper.sourceUrl}
          slotAspect={cropper.aspect}
          initialCrop={cropper.crop}
          busy={cropBusy}
          resizable={typeof cropper.target.frameLoc === 'number'}
          copies={cropper.target.frameCopies || 1}
          onCancel={() => { if (!cropBusy) setCropper(null); }}
          onApply={applyCrop}
        />
      )}
    </div>
  );
}
