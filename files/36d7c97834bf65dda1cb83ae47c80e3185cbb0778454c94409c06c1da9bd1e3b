@import "tailwindcss";
@custom-variant dark (&:where(.dark, .dark *));

/* Sticky Navbar height, used by routes that lock to the viewport (e.g. /assistant) */
:root {
  --lm-navbar-h: 56px;
}
@media (min-width: 640px) {
  :root {
    --lm-navbar-h: 60px;
  }
}

/* Shared page safezones: horizontal + vertical padding applied to every route */
.app-page {
  padding: 1.5rem 1rem;
}
@media (min-width: 640px) {
  .app-page {
    padding: 2rem 1.5rem;
  }
}

/* Persistent docked sidebar: when open, push the whole app right of the rail */
body {
  transition: padding-left 0.3s ease;
}
body.lm-sidebar-open {
  padding-left: 288px;
}
@media (max-width: 767px) {
  body.lm-sidebar-open {
    padding-left: 0;
  }
}

/* RTL: the sidebar docks on the right, so push the app from that side instead */
html[dir="rtl"] body.lm-sidebar-open {
  padding-left: 0;
  padding-right: 288px;
}
@media (max-width: 767px) {
  html[dir="rtl"] body.lm-sidebar-open {
    padding-right: 0;
  }
}

/* Prefer Arabic-friendly fonts when browsing right-to-left */
html[dir="rtl"] body {
  font-family: "Segoe UI", "Noto Naskh Arabic", "Noto Sans Arabic", "Tajawal", system-ui, sans-serif;
}

/* Highlight ring for a generation card focused from the sidebar */
.gen-highlight {
  box-shadow: 0 0 0 3px rgb(16 185 129 / 0.6);
  border-color: rgb(16 185 129 / 0.7) !important;
  transition: box-shadow 0.4s ease, border-color 0.4s ease;
}

/* Minimal custom scrollbars (replaces the default browser scroller) */
* {
  scrollbar-width: thin;
  scrollbar-color: rgb(113 113 122 / 0.45) transparent;
}
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgb(113 113 122 / 0.4);
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgb(113 113 122 / 0.65);
}
::-webkit-scrollbar-corner {
  background: transparent;
}
.dark ::-webkit-scrollbar-thumb {
  background: rgb(161 161 170 / 0.35);
}
.dark ::-webkit-scrollbar-thumb:hover {
  background: rgb(161 161 170 / 0.6);
}

@keyframes status-flash {
  0% { color: #34d399; }
  30% { color: #34d399; }
  100% { color: #a1a1aa; }
}
.status-flash {
  animation: status-flash 1s ease-out;
}

.status-dots span {
  display: inline-block;
  animation: status-dot 1.2s infinite ease-in-out;
  animation-delay: 0s;
}
.status-dots span:nth-child(2) { animation-delay: 0.15s; }
.status-dots span:nth-child(3) { animation-delay: 0.3s; }
@keyframes status-dot {
  0%, 60%, 100% { opacity: 0.2; }
  30% { opacity: 1; }
}
