export async function updateLeadScrapedImages(leadId: string, scrapedImages: ScrapedImage[]): Promise<void> {
  const campaignId = await findLeadCampaignId(leadId);
  if (!campaignId) return;
  await withCampaignLeadsLock(campaignId, async () => {
    const leads = await getCampaignLeads(campaignId);
    const lead = leads.find(l => l.id === leadId);
    if (lead) {
      const existing = lead.business.scrapedImages || [];
      const known = new Set(existing.map(i => i.url));
      const merged = [...existing];
      for (const img of scrapedImages) {
        if (known.has(img.url)) continue;
        known.add(img.url);
        merged.push(img);
      }
      lead.business.scrapedImages = merged;
      lead.updatedAt = new Date().toISOString();
      await writeJSON(leadsFile(campaignId), leads);
    }
  });
}

// Persists the list of scraped (discovered) image ids that were already
// imported to this lead, so a later session knows not to re-import the same
// discovered photos (which would create duplicates in the lead's images).
export async function markScrapedImagesImported(leadId: string, scrapedIds: string[]): Promise<void> {
  const campaignId = await findLeadCampaignId(leadId);
  if (!campaignId) return;
  await withCampaignLeadsLock(campaignId, async () => {
    const leads = await getCampaignLeads(campaignId);
    const lead = leads.find(l => l.id === leadId);
    if (lead) {
      const used = new Set(lead.importedScrapedIds || []);
      for (const sid of scrapedIds) used.add(sid);
      lead.importedScrapedIds = Array.from(used);
      lead.deepSearchUsed = true;
      lead.updatedAt = new Date().toISOString();
      await writeJSON(leadsFile(campaignId), leads);
    }
  });
}

// Marks the lead as having run a deep photo search already, so the Discovered
// tab doesn't offer "Deep Search Images" again (avoids re-finding the same
// photos after one of them was already used).
export async function setDeepSearchUsed(leadId: string): Promise<void> {
