import { NextRequest, NextResponse } from 'next/server';
import { getCampaign, deleteCampaign, updateCampaign } from '@/lib/store';
import type { AgentInfo } from '@/lib/types';

export async function GET(
  request: NextRequest,
  { params }: { params: Promise<{ id: string }> },
) {
  const { id } = await params;
  const campaign = await getCampaign(id);
  if (!campaign) {
    return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });
  }
  return NextResponse.json(campaign);
}

export async function PATCH(
  request: NextRequest,
  { params }: { params: Promise<{ id: string }> },
) {
  const { id } = await params;
  const body = await request.json().catch(() => ({}));
  const patch: { assetType?: 'landing' | 'bizcard'; agentInfo?: AgentInfo } = {};
  if (body.assetType === 'landing' || body.assetType === 'bizcard') patch.assetType = body.assetType;
  if (body.agentInfo && typeof body.agentInfo === 'object') {
    patch.agentInfo = body.agentInfo as AgentInfo;
    if (!patch.agentInfo.fullName || !patch.agentInfo.email || !patch.agentInfo.phone) {
      return NextResponse.json({ error: 'agentInfo requires fullName, phone, email' }, { status: 400 });
    }
  }
  const updated = await updateCampaign(id, patch);
  if (!updated) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });
  return NextResponse.json(updated);
}

export async function DELETE(
  request: NextRequest,
  { params }: { params: Promise<{ id: string }> },
) {
  const { id } = await params;
  await deleteCampaign(id);
  return NextResponse.json({ success: true });
}
