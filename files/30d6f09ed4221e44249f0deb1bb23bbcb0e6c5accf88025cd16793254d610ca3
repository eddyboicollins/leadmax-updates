export async function saveSettings(data: Partial<GlobalSettings>): Promise<void> {
  const existing = await getSettings();
  const toSave: GlobalSettings = {
    vercelToken: data.vercelToken !== undefined ? data.vercelToken : existing.vercelToken,
    imgbbKey: data.imgbbKey !== undefined ? data.imgbbKey : existing.imgbbKey,
    geminiApiKey: data.geminiApiKey !== undefined ? data.geminiApiKey : existing.geminiApiKey,
    geminiModel: data.geminiModel || existing.geminiModel || 'gemini-2.5-flash',
    geminiSource: data.geminiSource !== undefined ? data.geminiSource : existing.geminiSource || 'proxy',
    systemPrompt: data.systemPrompt !== undefined ? data.systemPrompt : existing.systemPrompt,
    assistantSystemPrompt: data.assistantSystemPrompt !== undefined ? data.assistantSystemPrompt : existing.assistantSystemPrompt,
    generationInstructions: data.generationInstructions !== undefined ? data.generationInstructions : existing.generationInstructions,
    visionSource: data.visionSource === 'api' || data.visionSource === 'proxy' ? data.visionSource : existing.visionSource,
    gemini1PSID: data.gemini1PSID !== undefined ? data.gemini1PSID : existing.gemini1PSID,
    gemini1PSIDTS: data.gemini1PSIDTS !== undefined ? data.gemini1PSIDTS : existing.gemini1PSIDTS,
    geminiSessionExtra: data.geminiSessionExtra !== undefined ? data.geminiSessionExtra : existing.geminiSessionExtra,
    wizardCompleted: data.wizardCompleted !== undefined ? data.wizardCompleted : existing.wizardCompleted,
  };
  await writeJSON(settingsFile(), toSave);
}

// Last background browser refresh (module-level): spaces out Chrome launches.
let lastBrowserRefresh = 0;

type VisionCreds = { psid: string; psidts: string };

/** Persist a jar: primaries into their fields, companions into extras. No-op when unchanged. */
async function persistJar(jar: Record<string, string>): Promise<void> {
  const current = await getSettings();
  const { '__Secure-1PSID': psid, '__Secure-1PSIDTS': psidts, ...rest } = jar;
  const patch: Partial<GlobalSettings> = {};
  if (psid && psid !== current.gemini1PSID) patch.gemini1PSID = psid;
  if (psidts && psidts !== current.gemini1PSIDTS) patch.gemini1PSIDTS = psidts;
  const existing = current.geminiSessionExtra || {};
  const merged = { ...existing, ...rest };
  if (JSON.stringify(merged) !== JSON.stringify(existing)) patch.geminiSessionExtra = merged;
  if (Object.keys(patch).length > 0) await saveSettings(patch);
}

/** Persist a browser-read jar (primaries + companions). Used by the login claim route. */
export async function persistBrowserJar(jar: Record<string, string>): Promise<void> {
  await persistJar(jar);
}

/**
 * Return working Gemini-web credentials, renewing them without user input
 * when possible. Sends ONLY the two primaries (proven shape — companion
 * cookies from mixed visits get the session treated as anonymous and SNlM0e
 * disappears). Harvests a rotated TS when Google sets one. Returns null only
 * when nothing is stored or the session is dead — the only cases needing a
 * manual re-paste. Always logs the outcome so silent success/failure is
 * impossible to misread.
 */
export async function ensureFreshVisionCreds(): Promise<VisionCreds | null> {
  const s = await getSettings();
  if (!s.gemini1PSID || !s.gemini1PSIDTS) {
    console.log('[vision] check: no cookies stored → setup needed');
    return null;
  }

  // 1. Stored cookies still good? Harvest a rotated TS on the way.
  try {
    const r = await fetchVisionSession(s.gemini1PSID, s.gemini1PSIDTS);
    if (r.session) {
      if (r.rotatedPsidts && r.rotatedPsidts !== s.gemini1PSIDTS) {
        await saveSettings({ gemini1PSIDTS: r.rotatedPsidts });
        console.log('[vision] check: session ok, TS refreshed opportunistically');
      } else {
        console.log('[vision] check: session ok');
      }
      return { psid: s.gemini1PSID, psidts: r.rotatedPsidts || s.gemini1PSIDTS };
    }
    console.log('[vision] check: stored cookies dead → trying rotation');
  } catch (err) {
    // Network/headers/rate-limit: surface it, don't burn a rotation attempt.
    throw err;
  }

  // 2. Stored jar dead — renew through the real browser profile (seeded from
  // the stored primaries), then verify the result before trusting it.
  // (Non-null assertions: both primaries were verified present above.)
  try {
    const refreshed = await refreshBrowserSession({ psid: s.gemini1PSID!, psidts: s.gemini1PSIDTS! });
    if (refreshed) {
      await persistJar(refreshed);
      const s2 = await getSettings();
      const r2 = await fetchVisionSession(s2.gemini1PSID!, s2.gemini1PSIDTS!);
      if (r2.session) {
        if (r2.rotatedPsidts && r2.rotatedPsidts !== s2.gemini1PSIDTS) {
          await saveSettings({ gemini1PSIDTS: r2.rotatedPsidts });
        }
        console.log('[vision] check: renewed via browser session');
        const s3 = await getSettings();
        return { psid: s3.gemini1PSID!, psidts: s3.gemini1PSIDTS! };
      }
    }
  } catch (err) {
    console.error('[vision] check: browser renewal failed:', err instanceof Error ? err.message : err);
    return null;
  }
  console.error('[vision] check: browser session has no usable state — sign in or re-paste in Settings → AI Vision');
  return null;
}

/**
 * Background keep-alive:
 * - heartbeat every ~90s: a lightweight authenticated visit (also harvests a
 *   rotated TS onto a live session);
 * - browser refresh every ~30min: boots the real Chrome profile so Google
 *   rotates state with a genuine fingerprint, then persists the live jar.
 * An idle session is what Google kills — steady activity is what keeps it alive.
 */
async function maintainVisionSession(heartbeat: boolean): Promise<void> {
  try {
    const s = await getSettings();
    if (!s.gemini1PSID || !s.gemini1PSIDTS) return;
    if (heartbeat) {
      const r = await fetchVisionSession(s.gemini1PSID, s.gemini1PSIDTS).catch(() => null);
      if (r?.rotatedPsidts && r.rotatedPsidts !== s.gemini1PSIDTS) {
        await saveSettings({ gemini1PSIDTS: r.rotatedPsidts });
        console.log('[vision] heartbeat: TS refreshed');
      }
      return;
    }
    if (Date.now() - lastBrowserRefresh < 30 * 60 * 1000) return;
    lastBrowserRefresh = Date.now();
    const refreshed = await refreshBrowserSession({ psid: s.gemini1PSID, psidts: s.gemini1PSIDTS }).catch(() => null);
    if (refreshed) {
      await persistJar(refreshed);
      console.log('[vision] session maintained (browser refresh)');
    }
  } catch (err) {
    console.error('[vision] maintenance failed:', err instanceof Error ? err.message : err);
  }
}

const storeGlobals = globalThis as unknown as { __leadmaxVisionMaintainer?: boolean };
if (!storeGlobals.__leadmaxVisionMaintainer) {
  storeGlobals.__leadmaxVisionMaintainer = true;
  const beat = setInterval(() => {
    maintainVisionSession(true).catch(() => {});
  }, 90 * 1000);
  const rotate = setInterval(() => {
    maintainVisionSession(false).catch(() => {});
  }, 10 * 60 * 1000);
  // Don't hold the process open for the timers alone.
  for (const t of [beat, rotate]) (t as unknown as { unref?: () => void }).unref?.();
}

