'use client';

import { useEffect, useRef, useState } from 'react';
import { useLockBodyScroll } from '@/lib/useLockBodyScroll';
import CampaignExportModal from '@/components/CampaignExportModal';

interface Props {
  open: boolean;
  onClose: () => void;
  campaign: any;
}

function esc(s: string): string {
  return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function popupHtml(lead: any): string {
  const b = lead.business || {};
  const socials = b.enrichedSocials || {};
  const socialEntries = Object.entries(socials).filter(([, v]) => v).map(([k, v]) => `${esc(k)}: ${esc(String(v))}`).join(' · ');
  return `
    <div style="min-width:220px;max-width:280px;font-family:system-ui, -apple-system, sans-serif;">
      <div style="font-weight:600;font-size:13px;color:#18181b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(b.name || 'Business')}</div>
      <div style="font-size:11px;color:#71717a;margin-top:2px;">${esc(b.category || '')} ${b.rating ? `· ${esc(String(b.rating))}★ (${esc(String(b.ratingCount || 0))})` : ''}</div>
      ${b.address ? `<div style="font-size:11px;color:#71717a;margin-top:4px;line-height:1.4;">${esc(b.address)}</div>` : ''}
      <div style="margin-top:8px;display:flex;flex-direction:column;gap:4px;font-size:11px;">
        ${b.phone ? `<div><span style="font-weight:500;">Phone:</span> <a href="tel:${esc(b.phone)}" style="color:#059669;text-decoration:none;">${esc(b.phone)}</a></div>` : ''}
        ${b.website ? `<div><span style="font-weight:500;">Website:</span> <a href="${esc(b.website)}" target="_blank" rel="noopener noreferrer" style="color:#059669;word-break:break-all;">${esc(b.website)}</a></div>` : ''}
        ${b.googleUrl ? `<div><a href="${esc(b.googleUrl)}" target="_blank" rel="noopener noreferrer" style="color:#059669;">View on Google Maps →</a></div>` : ''}
        ${b.enrichedEmail ? `<div><span style="font-weight:500;">Email:</span> ${esc(b.enrichedEmail)}</div>` : ''}
        ${socialEntries ? `<div><span style="font-weight:500;">Socials:</span> <span style="color:#52525b;">${socialEntries}</span></div>` : ''}
        ${lead.status ? `<div><span style="font-weight:500;">Status:</span> <span style="display:inline-block;padding:1px 6px;border-radius:9999px;background:rgba(16,185,129,0.1);color:#059669;font-size:10px;">${esc(lead.status)}</span></div>` : ''}
        ${lead.notes ? `<div><span style="font-weight:500;">Notes:</span> <span style="color:#52525b;white-space:pre-wrap;">${esc(lead.notes)}</span></div>` : ''}
        ${lead.deployment?.url ? `<div><span style="font-weight:500;">Site:</span> <a href="${esc(lead.deployment.url)}" target="_blank" style="color:#059669;word-break:break-all;">${esc(lead.deployment.url)}</a></div>` : ''}
      </div>
    </div>
  `;
}

export default function InteractiveMap({ open, onClose, campaign }: Props) {
  useLockBodyScroll(open);
  const mapRef = useRef<HTMLDivElement>(null);
  const leafletMapRef = useRef<any>(null);
  const [exportModalOpen, setExportModalOpen] = useState(false);

  const leads = (campaign?.leads || []).filter((l: any) => !l.deleted && l.business?.latitude && l.business?.longitude);
  const isMulti = Array.isArray(campaign?.regions) && campaign.regions.length > 1;

  // Load leaflet CSS/JS dynamically
  useEffect(() => {
    if (!open) return;
    if (isMulti) return;
    if (leads.length === 0) return;

    let cancelled = false;

    async function init() {
      // Load CSS
      if (!document.querySelector('link[data-leaflet]')) {
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
        link.setAttribute('data-leaflet', '1');
        document.head.appendChild(link);
      }
      // Load JS
      let L: any = (window as any).L;
      if (!L) {
        await new Promise<void>((resolve, reject) => {
          const s = document.createElement('script');
          s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
          s.onload = () => resolve();
          s.onerror = () => reject(new Error('Failed to load leaflet'));
          document.head.appendChild(s);
        });
        L = (window as any).L;
      }
      if (cancelled || !mapRef.current || !L) return;

      // Clean previous map
      if (leafletMapRef.current) {
        try { leafletMapRef.current.remove(); } catch {}
        leafletMapRef.current = null;
      }

      const map = L.map(mapRef.current, {
        attributionControl: false,
        zoomControl: true,
        // Zoom-out guard: never allow the world to repeat/tile or crop into grey
        minZoom: 3,
        maxZoom: 19,
        worldCopyJump: true,
        maxBounds: [[-90, -540], [90, 540]],
        maxBoundsViscosity: 1.0,
      }).setView([leads[0].business.latitude, leads[0].business.longitude], 12);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19 }).addTo(map);
      leafletMapRef.current = map;

      // Add markers with blip and native popup (no photo data)
      const group: any[] = [];
      leads.forEach((lead: any) => {
        const lat = lead.business.latitude;
        const lng = lead.business.longitude;
        const icon = L.divIcon({
          className: 'custom-blip',
          html: `<div style="position:relative;width:24px;height:30px;">
            <span style="position:absolute;left:2px;top:2px;width:20px;height:20px;background:#34d399;border-radius:50%;animation:blip-pulse 2.4s ease-out infinite;opacity:0.3;"></span>
            <span style="position:absolute;left:1px;top:0;width:22px;height:22px;background:#34d399;border:2px solid #ffffff;border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 2px 6px rgba(0,0,0,0.35);"></span>
            <span style="position:absolute;left:8px;top:7px;width:8px;height:8px;background:#ffffff;border-radius:50%;"></span>
          </div>`,
          iconSize: [24, 30],
          iconAnchor: [12, 27],
        });
        const marker = L.marker([lat, lng], { icon }).addTo(map);
        marker.bindPopup(popupHtml(lead), { maxWidth: 300, className: 'lead-popup' });
        group.push([lat, lng]);
      });

      // Fit bounds with fair focus
      if (group.length > 1) {
        const bounds = L.latLngBounds(group);
        map.fitBounds(bounds.pad(0.2), { animate: true });
      } else if (group.length === 1) {
        map.setView(group[0], 14);
      }

      setTimeout(() => map.invalidateSize(), 200);
    }

    init();
    return () => { cancelled = true; };
  }, [open, isMulti, leads.length]);

  // Cleanup on close
  useEffect(() => {
    if (!open && leafletMapRef.current) {
      try { leafletMapRef.current.remove(); } catch {}
      leafletMapRef.current = null;
    }
  }, [open]);

  if (!open) return null;

  return (
    <>
      <div className="fixed inset-0 z-[140] bg-zinc-900 flex flex-col">
        <style>{`@keyframes blip-pulse { 0% { transform: scale(0.8); opacity: 0.3; } 100% { transform: scale(2); opacity: 0; } } .lead-popup .leaflet-popup-content-wrapper { border-radius: 12px; } .lead-popup .leaflet-popup-content { margin: 12px; line-height: 1.4; }`}</style>
        {/* Header */}
        <div className="h-[56px] shrink-0 bg-white dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 flex items-center justify-between px-4">
          <div className="flex items-center gap-3 min-w-0">
            <div className="w-8 h-8 rounded-lg bg-emerald-500 flex items-center justify-center text-white shrink-0">
              <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
            </div>
            <div className="min-w-0">
              <h2 className="text-sm font-semibold text-zinc-900 dark:text-white truncate">{campaign?.displayName || campaign?.keyword} — Interactive Map</h2>
              <p className="text-xs text-zinc-500 dark:text-zinc-400">{leads.length} leads with location {isMulti ? '· disabled for multi-regional' : ''}</p>
            </div>
          </div>
          <div className="flex items-center gap-2 shrink-0">
            <button onClick={() => setExportModalOpen(true)} className="px-3 py-1.5 text-xs font-medium bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-all flex items-center gap-1.5">
              <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Export
            </button>
            <button onClick={onClose} className="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
              <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
        </div>

        {/* Body — full map, no sidebar, popup is native leaflet bubble */}
        <div className="flex-1 min-h-0">
          {isMulti ? (
            <div className="h-full flex items-center justify-center p-8 bg-zinc-50 dark:bg-zinc-900">
              <div className="max-w-md text-center bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-2xl p-6 shadow">
                <div className="w-12 h-12 mx-auto rounded-full bg-amber-500/10 flex items-center justify-center text-amber-500 mb-3">
                  <svg className="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                </div>
                <h3 className="text-sm font-semibold text-zinc-900 dark:text-white">Interactive map not available</h3>
                <p className="text-xs text-zinc-500 dark:text-zinc-400 mt-1">This campaign is multi-regional (has multiple keyword/location pairs). The interactive map only supports single-region campaigns to keep the focus fair.</p>
                <button onClick={onClose} className="mt-4 px-4 py-2 text-sm font-medium bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 rounded-xl">Close</button>
              </div>
            </div>
          ) : leads.length === 0 ? (
            <div className="h-full flex items-center justify-center p-8 bg-zinc-50 dark:bg-zinc-900">
              <p className="text-sm text-zinc-500">No leads with coordinates yet. Run scraping first.</p>
            </div>
          ) : (
            <div ref={mapRef} className="h-full w-full bg-zinc-100 dark:bg-zinc-800" />
          )}
        </div>
      </div>
      <CampaignExportModal open={exportModalOpen} onClose={() => setExportModalOpen(false)} campaign={campaign} />
    </>
  );
}
