export interface ScrapedImage {
  id: string;
  url: string;
  width?: number;
  height?: number;
}

export interface BusinessData {
  id: string;
  name: string;
  rating: number;
  ratingCount: number;
  address: string;
  phone: string;
  website: string;
  category: string;
  reviews: { author: string; text: string; rating: number; date: string; avatar?: string }[];
  latitude: number;
  longitude: number;
  placeId: string;
  googleUrl: string;
  hours: string[];
  scrapedImages?: ScrapedImage[];
  scrapedAt: string;
  /** Enriched contact/socials via AI web search (first biz-card gen only). */
  enrichedEmail?: string;
  enrichedSocials?: {
    instagram?: string;
    linkedin?: string;
    facebook?: string;
    twitter?: string;
    tiktok?: string;
    youtube?: string;
  };
  enrichmentDone?: boolean;
}

export type LeadStatus = 'pending' | 'contacted' | 'negotiating' | 'not_interested' | 'sold';

export interface Lead {
  id: string;
  business: BusinessData;
  status: LeadStatus;
  notes: string;
  deleted?: boolean;
  deletedAt?: string;
  deploymentName?: string;
  landingPage?: LeadLandingPage;
  images?: LeadImage[];
  deployment?: LeadDeployment;
  deploymentHistory?: DeploymentEntry[];
  /** Agent info for biz-card leads (per-card, editable anytime). */
  agentInfo?: AgentInfo;
  /** Multiple agent cards (biz-card campaigns only). Each card = one agent + its own generated source. */
  agentCards?: AgentCard[];
  createdAt: string;
  updatedAt: string;
}

/** One agent + its generated business-card source (biz-card campaigns only). */
export interface AgentCard {
  id: string;
  agentInfo: AgentInfo;
  /** Generated card source code (tsx). Duplicates copy this — never deployment history/urls. */
  tsx?: string;
  version: number;
  generatedAt?: string;
  /** Main card = the lead's primary website url. Defaults to the first card. */
  isMain: boolean;
  deploymentName?: string;
  deploymentUrl?: string;
  projectName?: string;
  deployedAt?: string;
  deploymentHistory?: DeploymentEntry[];
}

export interface LeadLandingPage {
  tsx: string;                        // FULL React component source string
  generatedAt: string;
  version: number;
  sections: LandingPageSection[];     // stored but never rendered
}

export interface LeadImage {
  id: string;
  url: string;
  alt: string;
  width?: number;
  height?: number;
  deleteUrl?: string;
  /** AI-generated description of what the photo shows, e.g. "a pepperoni pizza on a wooden board" */
  aiCaption?: string;
  /** Soft-delete flag: hidden everywhere but restorable from the Deleted tab. */
  deleted?: boolean;
  deletedAt?: string;
}

export interface LeadDeployment {
  provider: 'vercel' | 'ftp';
  url: string;
  deployedAt: string;
  projectName?: string;
}

export interface DeploymentEntry {
  id: string;
  vercelDeploymentId: string;
  url: string;
  aliasUrl: string;
  deployedAt: string;
  userPrompt?: string;
  isMain: boolean;
  comingSoon?: boolean;
  tsx: string;
}

export interface LandingPageSection {
  id: string;
  type: string;
  sortOrder: number;
  content: Record<string, unknown>;
  styles: Record<string, string>;
}

export interface CampaignRegion {
  keyword: string;
  location: string;
}

export type CampaignAssetType = 'landing' | 'bizcard';

export interface AgentPalette {
  primary: string;
  secondary: string;
  background: string;
}

export interface AgentInfo {
  fullName: string;
  fullNameAr?: string;
  title: string;
  titleAr?: string;
  agency: string;
  agencyAr?: string;
  tagline?: string;
  taglineAr?: string;
  phone: string;
  whatsapp?: string;
  email: string;
  website?: string;
  avatarUrl?: string;
  coverUrl?: string;
  /* Under-the-hood: previous avatar/cover so the AI can replace old URLs on regenerate/modify. */
  previousAvatarUrl?: string;
  previousCoverUrl?: string;
  officeAddress?: string;
  officeAddressAr?: string;
  aboutText?: string;
  aboutTextAr?: string;
  languages?: string;
  regulatedText?: string;
  whatsappMessage?: string;
  smsBody?: string;
  palette?: AgentPalette;
}

export interface Campaign {
  id: string;
  keyword: string;
  location: string;
  displayName: string;
  /** 'scrape' (default) or 'manual' (user's own clients, resolved via proxy). */
  source?: 'scrape' | 'manual';
  /** What this campaign generates: landing pages (default) or digital business cards. */
  assetType?: CampaignAssetType;
  agentInfo?: AgentInfo;
  leads: Lead[];
  regions?: CampaignRegion[];
  deleted?: boolean;
  deletedAt?: string;
  createdAt: string;
  updatedAt: string;
}

export interface ScrapeJob {
  id: string;
  campaignId: string;
  status: 'running' | 'completed' | 'failed';
  progress: number;
  message: string;
  createdAt: string;
}

export interface LeadGeneration {
  id: string;
  leadId: string;
  campaignId: string;
  landingPageCode?: string;
  deploymentUrl?: string;
  projectName?: string;
  createdAt: string;
}

export interface GlobalSettings {
  vercelToken?: string;
  imgbbKey?: string;
  geminiApiKey?: string;
  geminiModel: string;
  geminiSource?: 'proxy' | 'api';
  systemPrompt: string;
  assistantSystemPrompt?: string;
  generationInstructions?: string;
  wizardCompleted?: boolean;
  defaultMinRating?: number;
  defaultMaxRating?: number;
  defaultMinReviews?: number;
}

export interface ChatMessage {
  id: string;
  role: 'user' | 'assistant';
  content: string;
  createdAt: string;
}

export interface BusinessProfile {
  name: string;
  category: string;
  address: string;
  rating: number;
  ratingCount: number;
  website?: string | null;
  websiteInsight?: string | null;
}

export interface Chat {
  id: string;
  title: string;
  profile?: BusinessProfile;
  ended?: boolean;
  createdAt: string;
  updatedAt: string;
}
