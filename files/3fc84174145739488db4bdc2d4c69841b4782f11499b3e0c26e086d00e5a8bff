      var el = document.querySelector('[' + LOC + '="' + m.loc + '"]');
      if (el) { el.setAttribute('data-lm-note', String(m.n)); el.title = 'Note ' + m.n; }
    });
  }

  window.addEventListener('message', function (e) {
    var d = e.data || {};
    if (!d.lm) return;
    if (d.type === 'mode') {
      mode = d.mode === 'edit' || d.mode === 'comment' || d.mode === 'images' ? d.mode : 'view';
      if (d.photoLabel) photoLabel = String(d.photoLabel);
      document.documentElement.classList.toggle('lm-pick', picking());
