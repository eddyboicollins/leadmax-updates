export const DATA_DIR = (() => {
  if (process.env.PORTABLE_EXECUTABLE_DIR) {
    return path.join(process.env.PORTABLE_EXECUTABLE_DIR, 'data');
  }
  return path.join(process.cwd(), 'data');
})();
const CAMPAIGNS_FILE = path.join(DATA_DIR, 'campaigns.json');
export const GENERATIONS_FILE = path.join(DATA_DIR, 'generations.json');
export const SCRAPED_DIR = path.join(DATA_DIR, 'scraped');
const CHATS_FILE = path.join(DATA_DIR, 'chats.json');
const CHAT_MESSAGES_DIR = path.join(DATA_DIR, 'chat-messages');

async function ensureDir(dir: string) {
  await fs.mkdir(dir, { recursive: true });
}

export async function readJSON<T>(filePath: string, fallback: T): Promise<T> {
  try {
    const content = await fs.readFile(filePath, 'utf-8');
    return JSON.parse(content);
  } catch {
    return fallback;
  }
}

async function writeJSON(filePath: string, data: unknown): Promise<void> {
  await ensureDir(path.dirname(filePath));
  const tmpPath = `${filePath}.${process.pid}.${Date.now()}.tmp`;
  await fs.writeFile(tmpPath, JSON.stringify(data, null, 2), 'utf-8');
  await fs.rename(tmpPath, filePath);
}

function leadsFile(campaignId: string): string {
  return path.join(DATA_DIR, 'leads', `${campaignId}.json`);
}

function settingsFile(): string {
  return path.join(DATA_DIR, 'settings.json');
}

async function readCampaigns(): Promise<Campaign[]> {
  return readJSON<Campaign[]>(CAMPAIGNS_FILE, []);
}

async function writeCampaigns(campaigns: Campaign[]): Promise<void> {
  const stripped = campaigns.map(c => ({ ...c, leads: [] }));
  await writeJSON(CAMPAIGNS_FILE, stripped);
}

// ── Campaigns ──

export async function getCampaigns(): Promise<Campaign[]> {
  const campaigns = await readCampaigns();
  for (const c of campaigns) {
    c.leads = await getCampaignLeads(c.id);
  }
  return campaigns.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());
}

export async function getCampaign(id: string): Promise<Campaign | null> {
  const campaigns = await readCampaigns();
  const campaign = campaigns.find(c => c.id === id);
  if (!campaign) return null;
  campaign.leads = await getCampaignLeads(id);
  return campaign;
}

export async function saveManualCampaign(displayName: string): Promise<Campaign> {
  const campaigns = await readCampaigns();
  const id = uuidv4();
  const now = new Date().toISOString();
  const campaign: Campaign = {
    id,
    keyword: displayName,
    location: '',
    displayName,
    source: 'manual',
    leads: [],
    createdAt: now,
    updatedAt: now,
  };
  campaigns.push(campaign);
  await writeCampaigns(campaigns);
  return campaign;
}

export async function saveCampaign(keyword: string, location: string, regions?: CampaignRegion[]): Promise<Campaign> {
  const campaigns = await readCampaigns();
  const id = uuidv4();
  const now = new Date().toISOString();
  const campaign: Campaign = {
    id,
    keyword,
    location,
    displayName: `${keyword} - ${location}`,
    leads: [],
    ...(regions && regions.length > 0 ? { regions } : {}),
    createdAt: now,
    updatedAt: now,
  };
  campaigns.push(campaign);
  await writeCampaigns(campaigns);
  return campaign;
}

export async function deleteCampaign(id: string): Promise<void> {
  const campaigns = await readCampaigns();
  const campaign = campaigns.find(c => c.id === id);
  if (campaign && !campaign.deleted) {
    campaign.deleted = true;
    campaign.deletedAt = new Date().toISOString();
    campaign.updatedAt = new Date().toISOString();
  }
  await writeCampaigns(campaigns);
}

export async function restoreCampaign(id: string): Promise<void> {
  const campaigns = await readCampaigns();
  const campaign = campaigns.find(c => c.id === id);
  if (campaign && campaign.deleted) {
    campaign.deleted = false;
    campaign.deletedAt = undefined;
    campaign.updatedAt = new Date().toISOString();
  }
  await writeCampaigns(campaigns);
}

// Permanently erases a soft-deleted campaign: removes it from campaigns.json
// and deletes its leads file. Refuses to erase an active (non-deleted) campaign.
export async function purgeCampaign(id: string): Promise<void> {
  const campaigns = await readCampaigns();
  const campaign = campaigns.find(c => c.id === id);
  if (!campaign) return;
  if (!campaign.deleted) {
    throw new Error('Campaign must be soft-deleted before it can be erased.');
  }
  await writeCampaigns(campaigns.filter(c => c.id !== id));
  try {
    await fs.rm(leadsFile(id), { force: true });
  } catch { /* no leads file */ }
}

// ── Leads ──

// Serializes read-modify-write access to a campaign's leads file so that
// per-lead (single) saves during streaming don't race each other.
const leadWriteLocks = new Map<string, Promise<void>>();

async function withCampaignLeadsLock<T>(campaignId: string, fn: () => Promise<T>): Promise<T> {
  const prev = leadWriteLocks.get(campaignId) || Promise.resolve();
  const next = prev.catch(() => {}).then(async () => fn());
  leadWriteLocks.set(campaignId, next as Promise<void>);
  try {
    return await next;
  } finally {
    if (leadWriteLocks.get(campaignId) === next) leadWriteLocks.delete(campaignId);
  }
}

export async function getCampaignLeads(campaignId: string): Promise<Lead[]> {
  const leads = await readJSON<Lead[]>(leadsFile(campaignId), []);
  return sortLeadsByRating(leads);
}

export async function getLead(leadId: string): Promise<Lead | null> {
  const campaigns = await readCampaigns();
  for (const c of campaigns) {
    const leads = await getCampaignLeads(c.id);
    const lead = leads.find(l => l.id === leadId);
    if (lead) return lead;
  }
  return null;
}

async function findLeadCampaignId(leadId: string): Promise<string | null> {
  const campaigns = await readCampaigns();
  for (const c of campaigns) {
    const leads = await getCampaignLeads(c.id);
    if (leads.some(l => l.id === leadId)) return c.id;
  }
  return null;
}

export async function addLeads(campaignId: string, businesses: { leadId: string; business: BusinessData }[]): Promise<void> {
  if (businesses.length === 0) return;
  await withCampaignLeadsLock(campaignId, async () => {
    const leads = await getCampaignLeads(campaignId);
    const existingIds = new Set(leads.map(l => l.id));
    const existingPlaceIds = new Set(leads.map(l => l.business?.placeId).filter(Boolean));
    const existingPhones = new Set(leads.map(l => l.business?.phone).filter(Boolean));
    const existingNames = new Set(leads.map(l => l.business?.name.toLowerCase().replace(/[^a-z0-9]/g, '')).filter(Boolean));
    const now = new Date().toISOString();
    for (const { leadId, business } of businesses) {
      if (existingIds.has(leadId)) {
        scrapeLog('[save] SKIP existing leadId', leadId, business.name);
        continue;
      }
      const normName = business.name.toLowerCase().replace(/[^a-z0-9]/g, '');
      if (business.placeId && existingPlaceIds.has(business.placeId)) {
        scrapeLog('[save] SKIP duplicate placeId', business.placeId, business.name);
        continue;
      }
      if (business.phone && existingPhones.has(business.phone)) {
        scrapeLog('[save] SKIP duplicate phone', business.phone, business.name);
        continue;
      }
      if (existingNames.has(normName)) {
        scrapeLog('[save] SKIP duplicate name', business.name);
        continue;
      }
      leads.push({
        id: leadId,
        business,
        status: 'pending',
        notes: '',
        createdAt: now,
        updatedAt: now,
      });
      scrapeLog('[save] SAVED lead', JSON.stringify({
        leadId,
        name: business.name,
        rating: business.rating,
        ratingCount: business.ratingCount,
        phone: business.phone,
        placeId: business.placeId,
      }));
    }
    await writeJSON(leadsFile(campaignId), leads);
  });
}

