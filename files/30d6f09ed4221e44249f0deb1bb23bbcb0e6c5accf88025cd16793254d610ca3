export async function createLeadGeneration(data: {
  leadId: string;
  campaignId: string;
  landingPageCode?: string;
  deploymentUrl?: string;
  projectName?: string;
}): Promise<void> {
  const generations = await readJSON<LeadGeneration[]>(GENERATIONS_FILE, []);
  const existingIdx = generations.findIndex(g => g.leadId === data.leadId);
  const now = new Date().toISOString();
  if (existingIdx >= 0) {
    generations[existingIdx] = {
      ...generations[existingIdx],
      landingPageCode: data.landingPageCode || generations[existingIdx].landingPageCode,
      deploymentUrl: data.deploymentUrl || generations[existingIdx].deploymentUrl,
      projectName: data.projectName || generations[existingIdx].projectName,
    };
  } else {
    generations.push({
      id: uuidv4(),
      leadId: data.leadId,
      campaignId: data.campaignId,
      landingPageCode: data.landingPageCode,
      deploymentUrl: data.deploymentUrl,
      projectName: data.projectName,
      createdAt: now,
    });
  }
  await writeJSON(GENERATIONS_FILE, generations);
}

export async function getGenerationCountsForCampaign(campaignId: string): Promise<Record<string, number>> {
  const generations = await readJSON<LeadGeneration[]>(GENERATIONS_FILE, []);
  const filtered = generations.filter(g => g.campaignId === campaignId);
  const counts: Record<string, number> = {};
  for (const g of filtered) {
    counts[g.leadId] = (counts[g.leadId] || 0) + 1;
  }
  return counts;
}

// ── Assistant Chats ──

function chatMessagesFile(chatId: string): string {
  return path.join(CHAT_MESSAGES_DIR, `${chatId}.json`);
}

async function readChats(): Promise<Chat[]> {
  return readJSON<Chat[]>(CHATS_FILE, []);
}

export async function getChats(): Promise<Chat[]> {
  const chats = await readChats();
  return chats
    .filter(c => !(c as Chat & { model?: string }).model)
    .sort((a, b) => new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime());
}

export async function getChat(chatId: string): Promise<Chat | null> {
  const chats = await readChats();
  return chats.find(c => c.id === chatId) || null;
}

export async function createChat(profile?: BusinessProfile): Promise<Chat> {
  const chats = await readChats();
  const now = new Date().toISOString();
  const chat: Chat = {
    id: uuidv4(),
    title: profile ? profileTitle(profile) : 'New conversation',
    ...(profile ? { profile } : {}),
    ended: false,
    createdAt: now,
    updatedAt: now,
  };
  chats.push(chat);
  await writeJSON(CHATS_FILE, chats);
  return chat;
}

export async function deleteChat(chatId: string): Promise<void> {
  const chats = await readChats();
  await writeJSON(CHATS_FILE, chats.filter(c => c.id !== chatId));
  await fs.rm(chatMessagesFile(chatId), { force: true }).catch(() => {});
}

async function updateChat(chatId: string, patch: Partial<Chat>): Promise<Chat | null> {
  const chats = await readChats();
  const chat = chats.find(c => c.id === chatId);
  if (!chat) return null;
  Object.assign(chat, patch, { updatedAt: new Date().toISOString() });
  await writeJSON(CHATS_FILE, chats);
  return chat;
}

export async function endChat(chatId: string): Promise<Chat | null> {
  return updateChat(chatId, { ended: true });
}

export async function getMessages(chatId: string): Promise<ChatMessage[]> {
  return readJSON<ChatMessage[]>(chatMessagesFile(chatId), []);
}

export async function addMessage(chatId: string, message: Omit<ChatMessage, 'id' | 'createdAt'>): Promise<ChatMessage> {
  const messages = await getMessages(chatId);
  const now = new Date().toISOString();
  const full: ChatMessage = { id: uuidv4(), ...message, createdAt: now };
  messages.push(full);
  await writeJSON(chatMessagesFile(chatId), messages);
  await updateChat(chatId, {});
  return full;
}

export async function renameChat(chatId: string, title: string): Promise<void> {
  await updateChat(chatId, { title });
}
