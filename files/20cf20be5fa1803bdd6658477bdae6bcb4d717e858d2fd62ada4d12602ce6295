/**
 * AI Proxy — ChatGPT web UI automation (server-only), logged out.
 *
 * Third AI source next to the official Gemini API and the Gemini proxy
 * (aiProxy.ts). Same contract as askProxy: one serialized queue, a fresh chat
 * per request, oversized prompts sent as same-chat turns, `onChunk` deltas of
 * the code being written, cancellable through an AbortSignal.
 *
 * The reply is read from the network when ChatGPT serves its ndjson
 * conversation stream (`/conversation/updates`): its `markdown` deltas are the
 * raw reply. The page is NOT reliable for long code: next to each delta the
 * stream carries a live-preview widget program holding the whole code block so
 * far, so the stream grows quadratically (tens of MB for one landing page), the
 * page stops rendering after ~20s and later shows "Unable to connect". When no
 * such stream is seen (older layouts), the rendered conversation is read
 * instead: the classic layout (contenteditable composer,
 * [data-message-author-role]) and the newer one (textarea composer,
 * li[data-message-role]).
 *
 * Two variants share this code (see ChatGPTVariant):
 *  - LOGGED OUT ("ChatGPT Web"): chatgpt.com answers logged-out visitors. Its
 *    own profile (`<data>/chatgpt-proxy-profile`) keeps cookies between runs.
 *    Headless by default; CHATGPT_PROXY_HEADLESS=false shows the window.
 *  - ACCOUNT ("ChatGPT Web (login)", see chatgptLogin.ts): a profile the user
 *    signed into once; every request opens a TEMPORARY chat (no history, no
 *    memory) and fails with a "reconnect" message when the session is gone.
 */
/* eslint-disable @typescript-eslint/no-explicit-any -- puppeteer page fns */

import path from 'path';
import { promises as fs } from 'fs';
import type { ProxyStatus } from '@/lib/gemini';
import { dataDir, loadPuppeteer, systemBrowserCandidates, splitPrompt, stripCodeFence } from '@/lib/aiProxy';

const CHATGPT_URL = 'https://chatgpt.com/';
const NAV_TIMEOUT_MS = Number(process.env.PROXY_NAV_TIMEOUT_MS || 60_000);
// Absolute ceiling for one turn.
const TURN_TIMEOUT_MS = Number(process.env.PROXY_STREAM_TIMEOUT_MS || 600_000);
// No new text for this long while ChatGPT still says it is writing: stuck.
const STALL_TIMEOUT_MS = Number(process.env.PROXY_STALL_TIMEOUT_MS || 180_000);
// Longest message sent in one turn; longer prompts go out as several turns.
const CHUNK_LIMIT = Number(process.env.CHATGPT_PROXY_CHUNK_LIMIT || 30_000);
const POLL_MS = 400;

const COMPOSER = '#prompt-textarea, textarea#mobile-composer-prompt, div[contenteditable="true"], textarea';
const ASSISTANT = '[data-message-author-role="assistant"], [data-message-role="assistant"], [data-turn="assistant"]';

const holdSuffix = (i: number, n: number): string =>
  `\n\n[Note: this request continues in part ${i + 1} of ${n} — reply with exactly "OK" and nothing else.]`;
const GO_SUFFIX = `\n\n[Note: this is the final part. Now fulfill the complete request above.]`;
// ChatGPT renders replies as Markdown: unfenced code loses its line breaks and
// tags. The fences are stripped afterwards, so a fenced reply is always safe.
const FENCE_NOTE = `\n\n[Output format for this chat: put your ENTIRE reply inside ONE fenced code block (\`\`\`), nothing before or after it. This overrides any "no markdown fences" instruction above.]`;

/** Which ChatGPT browser a request runs in (each has its own profile, browser and queue). */
export interface ChatGPTVariant {
  /** globalThis slot holding its browser + queue (survives dev HMR). */
  key: string;
  /** Log prefix, e.g. "chatgpt-proxy". */
  log: string;
  profileDir: () => string;
  headless: () => boolean;
  /** Browser to launch (account: the one the login used, so its cookies decrypt). */
  executablePath?: () => Promise<string | undefined>;
  /** Signed-in account: session checked on every chat, temporary chats only. */
  account?: { reconnectHint: string };
}

const LOGGED_OUT: ChatGPTVariant = {
  key: '__leadmaxChatgptProxy',
  log: 'chatgpt-proxy',
  profileDir: () => path.join(dataDir(), 'chatgpt-proxy-profile'),
  headless: () => process.env.CHATGPT_PROXY_HEADLESS !== 'false',
};

function sleep(ms: number): Promise<void> {
  return new Promise(resolve => setTimeout(resolve, ms));
}
const abortError = () => Object.assign(new Error('Cancelled'), { name: 'AbortError' });

// ── Browser singleton + serialized queue (shared across dev HMR reloads) ──

type PuppeteerModule = typeof import('puppeteer');
type Browser = Awaited<ReturnType<PuppeteerModule['launch']>>;
type Page = Awaited<ReturnType<Browser['newPage']>>;

interface Shared {
  browser: Browser | null;
  page: Page | null;
  launching: Promise<Page> | null;
  queue: Promise<unknown>;
  /** Network view of the latest reply stream (null until tapped on `page`). */
  net: NetReply | null;
}

function shared(v: ChatGPTVariant): Shared {
  const g = globalThis as unknown as Record<string, Shared | undefined>;
  if (!g[v.key]) {
    g[v.key] = { browser: null, page: null, launching: null, queue: Promise.resolve(), net: null };
  }
  return g[v.key]!;
}

async function ensureBrowser(v: ChatGPTVariant): Promise<Page> {
  const s = shared(v);
  if (s.page && s.browser?.connected && !s.page.isClosed()) {
    if (!s.net) s.net = await tapReplyStream(s.page).catch(() => null);
    return s.page;
  }
  s.page = null;
  s.net = null;
  if (!s.launching) {
    s.launching = (async () => {
      try {
        const { browser, page } = await launch(v);
        s.browser = browser;
        s.page = page;
        s.net = await tapReplyStream(page).catch((err) => {
          console.warn(`[${v.log}] network tap unavailable, reading the page instead:`, err instanceof Error ? err.message : err);
          return null;
        });
        return page;
      } finally {
        shared(v).launching = null;
      }
    })();
  }
  return s.launching;
}

async function launch(v: ChatGPTVariant): Promise<{ browser: Browser; page: Page }> {
  const puppeteer = await loadPuppeteer();
  await fs.mkdir(v.profileDir(), { recursive: true });
  const headless = v.headless();
  const exe = (await v.executablePath?.()) || process.env.PUPPETEER_EXECUTABLE_PATH;
  const options = {
    headless: headless ? ('new' as any) : false,
    userDataDir: v.profileDir(),
    defaultViewport: { width: 1400, height: 1000 },
    args: [
      '--disable-blink-features=AutomationControlled',
      '--window-size=1400,1000',
      '--lang=en-US',
      '--disable-extensions',
      '--mute-audio',
      '--no-sandbox',
      '--disable-dev-shm-usage',
    ],
  };
  let browser: Browser | null = null;
  try {
    browser = await puppeteer.launch({
      ...options,
      ...(exe ? { executablePath: exe } : {}),
    });
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err);
    if (/already running/i.test(msg)) {
      throw new Error('The ChatGPT proxy browser is already running in another LeadMax instance using the same data folder. Close it and retry.');
    }
    // Bundled Chromium missing/failed: try an installed browser.
    for (const candidate of systemBrowserCandidates()) {
      try { await fs.access(candidate); } catch { continue; }
      try { browser = await puppeteer.launch({ ...options, executablePath: candidate }); break; } catch { /* next */ }
    }
    if (!browser) throw err;
  }
  const page = await browser.newPage();
  if (headless) {
    // Text only: skip images/media/fonts (faster, lighter).
    await page.setRequestInterception(true).catch(() => {});
    page.on('request', (req: any) => {
      const type = req.resourceType();
      if (type === 'image' || type === 'media' || type === 'font') req.abort('blockedbyclient').catch(() => {});
      else req.continue().catch(() => {});
    });
  }
  try {
    const ua = await browser.userAgent();
    await page.setUserAgent(ua.replace('HeadlessChrome', 'Chrome'));
  } catch { /* keep default UA */ }
  return { browser, page };
}

// ── Network reply stream ───────────────────────────────────────────────────

interface NetReply {
  /** Bumped when a new reply stream starts. */
  seq: number;
  /** Raw markdown of the streamed assistant message. */
  text: string;
  messageId: string | null;
  done: boolean;
  failed: string | null;
}

/**
 * Follow ChatGPT's ndjson conversation stream over CDP. Lines look like
 * {"type":"content","messageId","mode":"replace"|"append","markdown",…},
 * {"type":"control","detail":{"kind":"terminal-received","terminalKind",…}}
 * and a final {"type":"end"}.
 */
async function tapReplyStream(p: Page): Promise<NetReply> {
  const reply: NetReply = { seq: 0, text: '', messageId: null, done: false, failed: null };
  const cdp = await p.createCDPSession();
  await cdp.send('Network.enable');
  let current: string | null = null;
  // Chunks that arrive before streamResourceContent answers: fed after its buffered data.
  let pending: string[] | null = null;
  let partial = '';

  const onLine = (line: string) => {
    if (!line.trim()) return;
    if (sse) { onSseLine(line.replace(/\r$/, '')); return; }
    let msg: any;
    try { msg = JSON.parse(line); } catch { return; }
    if (msg?.type === 'content' && typeof msg.markdown === 'string') {
      if (msg.messageId && msg.messageId !== reply.messageId) {
        reply.messageId = msg.messageId;
        reply.text = '';
      }
      reply.text = msg.mode === 'append' ? reply.text + msg.markdown : msg.markdown;
    } else if (msg?.type === 'control' && msg.detail?.kind === 'terminal-received') {
      const kind = String(msg.detail.terminalKind || '');
      if (/fail|error|abort|cancel/i.test(kind)) reply.failed = msg.detail.failureReason || kind;
      else reply.done = true;
    } else if (msg?.type === 'end' && !reply.failed) {
      reply.done = true;
    }
  };
  const feed = (chunk: string) => {
    partial += chunk;
    let nl: number;
    while ((nl = partial.indexOf('\n')) >= 0) {
      onLine(partial.slice(0, nl));
      partial = partial.slice(nl + 1);
    }
  };
  // Signed-in ChatGPT streams /backend-api/f/conversation as SSE in "v1 delta
  // encoding": a message is added ({"v":{"message":…}}), then patched with
  // JSON-pointer ops ({"p","o","v"}, batches {"o":"patch","v":[…]}, and bare
  // {"v":"text"} continuing the previous op). The assistant's raw markdown is
  // /message/content/parts/0; "message_stream_complete" / [DONE] end it.
  let sse = false;
  let lastPath = '';
  let lastOp = '';
  let assistant = false;
  const PART = '/message/content/parts/0';
  const applyOp = (op: any) => {
    if (!op || typeof op !== 'object') return;
    const p = typeof op.p === 'string' ? op.p : lastPath;
    const o = typeof op.o === 'string' ? op.o : lastOp;
    if (typeof op.p === 'string') lastPath = op.p;
    if (typeof op.o === 'string') lastOp = op.o;
    if (o === 'patch' && Array.isArray(op.v)) { op.v.forEach(applyOp); return; }
    if (!p && op.v && typeof op.v === 'object' && !Array.isArray(op.v) && op.v.message) {
      const m = op.v.message;
      assistant = m.author?.role === 'assistant' && (m.content?.content_type || 'text') === 'text' && (m.recipient || 'all') === 'all';
      if (assistant) {
        if (m.id !== reply.messageId) { reply.messageId = m.id; reply.text = ''; }
        reply.text = String(m.content?.parts?.[0] ?? '');
      }
      if (op.v.error) reply.failed = String(op.v.error);
      return;
    }
    if (Array.isArray(op.v) && !op.o && !op.p) { op.v.forEach(applyOp); return; }
    if (!assistant || p !== PART || typeof op.v !== 'string') return;
    reply.text = o === 'replace' ? op.v : reply.text + op.v;
  };
  const onSseLine = (line: string) => {
    if (!line.startsWith('data:')) return;
    const data = line.slice(5).trim();
    if (data === '[DONE]') { if (!reply.failed) reply.done = true; return; }
    let msg: any;
    try { msg = JSON.parse(data); } catch { return; }
    if (typeof msg === 'string') return; // "v1" encoding marker
    if (msg?.type === 'message_stream_complete') { if (!reply.failed) reply.done = true; return; }
    if (msg?.type === 'error' || (typeof msg?.error === 'string' && msg.error && !msg.v)) { reply.failed = String(msg.message || msg.error || 'error'); return; }
    if (msg?.type) return; // markers, metadata, tokens
    applyOp(msg);
  };
  const decode = (b64: string) => Buffer.from(b64, 'base64').toString('utf8');

  cdp.on('Network.responseReceived', (e: any) => {
    const mime = String(e.response?.mimeType || '');
    const url = String(e.response?.url || '').replace(/\?.*/, '');
    const isNdjson = /\/conversation\//.test(url) && /ndjson/i.test(mime);
    const isSse = /\/backend-api\/(?:f\/)?conversation$/.test(url) && /event-stream/i.test(mime);
    if (!isNdjson && !isSse) return;
    sse = isSse;
    lastPath = '';
    lastOp = '';
    assistant = false;
    const id: string = e.requestId;
    current = id;
    pending = [];
    partial = '';
    Object.assign(reply, { seq: reply.seq + 1, text: '', messageId: null, done: false, failed: null });
    cdp.send('Network.streamResourceContent', { requestId: id }).then((r: any) => {
      if (current !== id) return;
      const early = pending || [];
      pending = null;
      feed(decode(r.bufferedData || ''));
      early.forEach(feed);
    }).catch(() => {
      if (current === id) { pending = null; reply.failed = 'stream unreadable'; }
    });
  });
  cdp.on('Network.dataReceived', (e: any) => {
    if (e.requestId !== current || !e.data) return;
    const chunk = decode(e.data);
    if (pending) pending.push(chunk);
    else feed(chunk);
  });
  cdp.on('Network.loadingFinished', (e: any) => {
    if (e.requestId !== current || pending) return;
    feed('\n');
    if (!reply.failed) reply.done = true;
  });
  cdp.on('Network.loadingFailed', (e: any) => {
    if (e.requestId === current && !reply.done) reply.failed = e.errorText || 'connection lost';
  });
  return reply;
}

/**
 * The stream's markdown has its own markup: raw HTML wrapped in <escape>…</escape>
 * and code as <CodeBlock language="html" …>…</CodeBlock>. Unwrap the first, turn
 * the second into ``` fences.
 */
function normalizeMarkdown(md: string): string {
  return md
    .replace(/<\/?escape>/g, '')
    .replace(/^([ \t]*)<CodeBlock\b[^>\n]*>[ \t]*\n?/gm, '$1```\n')
    .replace(/\n?[ \t]*<\/CodeBlock>[ \t]*$/gm, '\n```');
}

/** Largest fenced code block of a markdown reply; an unclosed one (still streaming) counts. */
function codeFromMarkdown(md: string): string {
  md = normalizeMarkdown(md);
  let best = '';
  let fence: string | null = null;
  let body: string[] = [];
  const keep = () => { const b = body.join('\n'); if (b.length > best.length) best = b; };
  for (const line of md.split('\n')) {
    const m = line.match(/^[ \t]*(`{3,}|~{3,})/);
    if (!fence) {
      if (m) { fence = m[1]; body = []; }
    } else if (m && line.trim() === fence) {
      keep();
      fence = null;
    } else {
      body.push(line);
    }
  }
  if (fence) keep();
  return best;
}

// ── Page driving ───────────────────────────────────────────────────────────

/** The signed-in account of the page's ChatGPT session, or null when logged out. */
export async function readSession(p: Page): Promise<{ email: string; name: string } | null> {
  return p.evaluate(async () => {
    try {
      const r = await fetch('/api/auth/session', { credentials: 'include' });
      if (!r.ok) return null;
      const j = await r.json();
      return j?.user && j?.accessToken ? { email: String(j.user.email || ''), name: String(j.user.name || '') } : null;
    } catch {
      return null;
    }
  }).catch(() => null);
}

/** Fresh chat with a ready composer (account: a temporary chat, session checked). */
async function openFreshChat(p: Page, v: ChatGPTVariant): Promise<void> {
  // Temporary chat: kept out of the account's history and memory.
  await p.goto(v.account ? `${CHATGPT_URL}?temporary-chat=true` : CHATGPT_URL, { waitUntil: 'domcontentloaded', timeout: NAV_TIMEOUT_MS });
  const deadline = Date.now() + NAV_TIMEOUT_MS;
  while (Date.now() < deadline) {
    const state = await p.evaluate((composerSel: string) => {
      const text = (document.body?.innerText || '').toLowerCase();
      if (/verify you are human|just a moment|checking your browser|unusual activity/.test(text) && !document.querySelector(composerSel)) {
        return 'challenge';
      }
      const ed = Array.from(document.querySelectorAll<HTMLElement>(composerSel)).find(e => e.offsetParent !== null);
      return ed ? 'ready' : 'loading';
    }, COMPOSER).catch(() => 'loading');
    if (state === 'ready') break;
    if (state === 'challenge' && Date.now() > deadline - NAV_TIMEOUT_MS / 2) {
      throw new Error('ChatGPT showed a verification page. Set CHATGPT_PROXY_HEADLESS=false, retry once and complete it in the window, then switch back.');
    }
    await sleep(500);
  }
  if (v.account && !(await readSession(p))) {
    throw new Error(`ChatGPT is not logged in anymore (the session expired or was signed out). ${v.account.reconnectHint}`);
  }
  await dismissPopups(p);
  const ready = await p.$(COMPOSER);
  if (!ready) throw new Error('ChatGPT did not load its message box. Check your connection and retry.');
}

/** Close login/upsell popups and decline optional cookies (keeps chatting logged out). */
async function dismissPopups(p: Page): Promise<void> {
  await p.evaluate(() => {
    const visible = (el: Element) => (el as HTMLElement).offsetParent !== null;
    const buttons = Array.from(document.querySelectorAll<HTMLElement>('button, a[role="button"], a'));
    for (const b of buttons) {
      if (!visible(b)) continue;
      const t = (b.innerText || b.getAttribute('aria-label') || '').trim().toLowerCase();
      if (t === 'stay logged out' || t === 'reject non-essential' || t === 'reject all' || t === 'decline') b.click();
    }
    for (const d of Array.from(document.querySelectorAll('[role="dialog"]'))) {
      if (!visible(d)) continue;
      const close = d.querySelector<HTMLElement>('button[aria-label="Close"], button[data-testid="close-button"]');
      close?.click();
    }
  }).catch(() => {});
}

/** Put the text in the composer (textarea or rich editor), newlines kept, nothing submitted. */
async function fillComposer(p: Page, text: string): Promise<void> {
  const landed = await p.evaluate((composerSel: string, value: string) => {
    const ed = Array.from(document.querySelectorAll<HTMLElement>(composerSel)).find(e => e.offsetParent !== null);
    if (!ed) return -1;
    ed.focus();
    if (ed instanceof HTMLTextAreaElement) {
      // React-controlled textarea: set through the native setter, then notify.
      const setter = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value')?.set;
      setter?.call(ed, value);
      ed.dispatchEvent(new Event('input', { bubbles: true }));
      return ed.value.length;
    }
    // Rich editor (ProseMirror): a synthetic paste inserts everything at once.
    const sel = window.getSelection();
    if (sel) { const r = document.createRange(); r.selectNodeContents(ed); sel.removeAllRanges(); sel.addRange(r); }
    const dt = new DataTransfer();
    dt.setData('text/plain', value);
    ed.dispatchEvent(new ClipboardEvent('paste', { clipboardData: dt, bubbles: true, cancelable: true }));
    if ((ed.innerText || '').length < value.length * 0.9) {
      // Paste ignored: type it line by line (Enter would submit).
      value.split('\n').forEach((line, i) => {
        if (i > 0) document.execCommand('insertLineBreak');
        if (line) document.execCommand('insertText', false, line);
      });
    }
    return (ed.innerText || '').length;
  }, COMPOSER, text).catch(() => -1);
  if (landed < 0) throw new Error('ChatGPT message box not found.');
  if (landed < text.length * 0.9) {
    throw new Error(`The prompt did not land in ChatGPT's message box (holds ${landed} chars, expected ~${text.length}).`);
  }
}

async function submit(p: Page): Promise<void> {
  for (let i = 0; i < 20; i++) {
    const clicked = await p.evaluate(() => {
      const btn = document.querySelector<HTMLButtonElement>(
        'button[data-testid="send-button"], button[aria-label="Send message"], button[aria-label="Send prompt"], #composer-submit-button',
      );
      if (btn && !btn.disabled) { btn.click(); return true; }
      return false;
    }).catch(() => false);
    if (clicked) return;
    await sleep(250);
  }
  await p.keyboard.press('Enter');
}

interface ReplyState {
  count: number;
  generating: boolean;
  /** Fenced markdown of the latest reply: code blocks as ```lang fences, the rest as text. */
  text: string;
  /** The largest code block of the latest reply (what a code request returns). */
  code: string;
  error: string | null;
  canContinue: boolean;
}

async function readReply(p: Page): Promise<ReplyState> {
  return p.evaluate((assistantSel: string) => {
    const replies = Array.from(document.querySelectorAll<HTMLElement>(assistantSel))
      // Nested matches (a role wrapper inside a turn): keep the outermost.
      .filter((el, _i, all) => !all.some(o => o !== el && o.contains(el)));
    const last = replies[replies.length - 1];
    const buttons = Array.from(document.querySelectorAll<HTMLElement>('button'));
    const generating = buttons.some(b => {
      const id = `${b.getAttribute('data-testid') || ''} ${b.getAttribute('aria-label') || ''}`;
      return /stop-button|stop generating|stop streaming|stop response/i.test(id) && b.offsetParent !== null;
    });
    const canContinue = buttons.some(b => /continue generating/i.test(b.innerText || '') && b.offsetParent !== null);
    let text = '';
    let code = '';
    if (last) {
      const parts: string[] = [];
      const walk = (node: Node) => {
        if (node.nodeType === 3) { parts.push((node as Text).data); return; }
        if (node.nodeType !== 1) return;
        const el = node as HTMLElement;
        if (el.tagName === 'PRE') {
          const c = el.querySelector('code') || el;
          const lang = (c.className.match(/language-([\w-]+)/) || [])[1] || '';
          const body = c.textContent || '';
          if (body.length > code.length) code = body;
          parts.push('\n```' + lang + '\n' + body.replace(/\n$/, '') + '\n```\n');
          return;
        }
        if (/^(BUTTON|svg|SVG)$/.test(el.tagName) || el.getAttribute('aria-hidden') === 'true') return;
        const block = /^(P|DIV|LI|H[1-6]|BR|TR|UL|OL|BLOCKQUOTE)$/.test(el.tagName);
        if (block) parts.push('\n');
        el.childNodes.forEach(walk);
        if (block) parts.push('\n');
      };
      walk(last);
      text = parts.join('').replace(/^\s*ChatGPT said:\s*/i, '').replace(/\n{3,}/g, '\n\n').trim();
    }
    const errEl = last?.querySelector('.text-token-text-error, [class*="text-red"], [data-conversation-recovery-status="failed"]');
    const pageText = document.body.innerText || '';
    const errMatch = pageText.match(/(you've reached (?:our|the) limit[^.\n]*|something went wrong[^.\n]*|too many requests[^.\n]*|the message you submitted was too long[^.\n]*|message is too long[^.\n]*|unable to connect[^.\n]*)/i);
    return {
      count: replies.length,
      generating,
      text,
      code,
      error: (errEl?.textContent || '').trim() || (errMatch ? errMatch[1] : null),
      canContinue,
    };
  }, ASSISTANT).catch(() => ({ count: 0, generating: false, text: '', code: '', error: null, canContinue: false }));
}

async function clickStop(p: Page): Promise<void> {
  await p.evaluate(() => {
    const btn = Array.from(document.querySelectorAll<HTMLElement>('button')).find(b =>
      /stop-button|stop generating|stop streaming|stop response/i.test(`${b.getAttribute('data-testid') || ''} ${b.getAttribute('aria-label') || ''}`));
    btn?.click();
  }).catch(() => {});
}

/**
 * Send one message and wait for ChatGPT's complete reply. `onCode` receives
 * the growing code block while it is written.
 */
async function sendAndWait(
  v: ChatGPTVariant,
  p: Page,
  text: string,
  signal: AbortSignal | undefined,
  onCode?: (code: string) => void,
): Promise<ReplyState> {
  const net = shared(v).net;
  const netBefore = net?.seq ?? 0;
  const before = (await readReply(p)).count;
  await fillComposer(p, text);
  await sleep(300);
  await submit(p);

  const start = Date.now();
  let lastText = '';
  let lastGrowth = Date.now();
  let stableSince = 0;
  let state = await readReply(p);
  while (true) {
    if (signal?.aborted) { await clickStop(p); throw abortError(); }
    await sleep(POLL_MS);
    if (net && net.seq > netBefore) {
      // Network stream: the raw reply, whatever the page manages to render.
      // Wait for the first full line: it tells whether the reply opens a code block.
      if (net.text !== lastText && net.text.includes('\n')) {
        lastText = net.text;
        lastGrowth = Date.now();
        // Unfenced reply (no fence note is sent on this path): the text is the code.
        const code = codeFromMarkdown(net.text) || (/^\s*(?:[`~]{3}|<CodeBlock\b)/.test(net.text) ? '' : normalizeMarkdown(net.text));
        if (code) onCode?.(code);
      }
      if (net.failed) {
        await clickStop(p);
        if (net.text.length > 100_000) {
          throw new Error(`ChatGPT cut the reply off at its length limit (~${Math.round(net.text.length / 1000)}K chars). Ask for a shorter page or switch the AI source.`);
        }
        throw new Error(`ChatGPT's reply broke off (${net.failed}) after ${net.text.length} chars. Try again or switch the AI source.`);
      }
      if (net.done) {
        return { count: before + 1, generating: false, text: normalizeMarkdown(net.text).trim(), code: codeFromMarkdown(net.text), error: null, canContinue: false };
      }
      const now = Date.now();
      if (now - start > TURN_TIMEOUT_MS) throw new Error(`ChatGPT did not finish within ${Math.round(TURN_TIMEOUT_MS / 1000)}s. Try again or switch the AI source.`);
      if (now - lastGrowth > STALL_TIMEOUT_MS) {
        await clickStop(p);
        throw new Error(`ChatGPT stopped responding mid-reply (no output for ${Math.round(STALL_TIMEOUT_MS / 1000)}s). Try again or split the request.`);
      }
      continue;
    }
    state = await readReply(p);
    const mine = state.count > before;
    if (mine && state.text !== lastText) {
      lastText = state.text;
      lastGrowth = Date.now();
      stableSince = 0;
      if (state.code) onCode?.(state.code);
    }
    if (state.error && (!mine || !state.generating)) {
      throw new Error(`ChatGPT stopped with an error: "${state.error.slice(0, 160)}". Try again later or switch the AI source.`);
    }
    if (mine && state.canContinue && !state.generating) {
      // Long answer cut by ChatGPT: let it continue in the same reply.
      await p.evaluate(() => {
        const b = Array.from(document.querySelectorAll<HTMLElement>('button')).find(x => /continue generating/i.test(x.innerText || ''));
        b?.click();
      }).catch(() => {});
      lastGrowth = Date.now();
      continue;
    }
    if (mine && !state.generating && state.text) {
      // Done once the reply stops changing for a moment.
      if (!stableSince) stableSince = Date.now();
      if (Date.now() - stableSince >= 1500) return state;
    }
    const now = Date.now();
    if (now - start > TURN_TIMEOUT_MS) throw new Error(`ChatGPT did not finish within ${Math.round(TURN_TIMEOUT_MS / 1000)}s. Try again or switch the AI source.`);
    if (mine && state.generating && now - lastGrowth > STALL_TIMEOUT_MS) {
      await clickStop(p);
      throw new Error(`ChatGPT stopped responding mid-reply (no output for ${Math.round(STALL_TIMEOUT_MS / 1000)}s). Try again or split the request.`);
    }
    if (!mine && now - start > 90_000) {
      throw new Error(v.account
        ? 'ChatGPT did not start answering. Your account may have hit its usage limit — try again later or switch the AI source.'
        : 'ChatGPT did not start answering. It may be rate-limiting logged-out use — try again later or switch the AI source.');
    }
  }
}

async function runRequest(
  v: ChatGPTVariant,
  prompt: string,
  onChunk: ((text: string) => void) | undefined,
  onStatus: ((event: ProxyStatus) => void) | undefined,
  signal: AbortSignal | undefined,
): Promise<string> {
  onStatus?.({ type: 'uploading' });
  const p = await ensureBrowser(v);
  if (signal?.aborted) throw abortError();
  // Every request starts a new chat: no context carried from the last one.
  await openFreshChat(p, v);

  const pieces = splitPrompt(prompt, CHUNK_LIMIT);
  if (pieces.length > 1) console.log(`[${v.log}] prompt is ${prompt.length} chars, sending as ${pieces.length} same-chat turns`);
  let final: ReplyState | null = null;
  for (let i = 0; i < pieces.length; i++) {
    if (signal?.aborted) throw abortError();
    const isLast = i === pieces.length - 1;
    const text = (pieces.length > 1 ? pieces[i] + (isLast ? GO_SUFFIX : holdSuffix(i, pieces.length)) : pieces[i])
      // The network stream carries raw markdown: fences are only needed when reading the page.
      + (isLast && !shared(v).net ? FENCE_NOTE : '');
    if (pieces.length > 1) {
      console.log(`[${v.log}] turn ${i + 1}/${pieces.length}`);
      onStatus?.({ type: 'turn', turn: i + 1, total: pieces.length });
    }
    if (!isLast) {
      await sendAndWait(v, p, text, signal);
      await sleep(800);
      continue;
    }
    let emitted = '';
    let announced = false;
    const t0 = Date.now();
    final = await sendAndWait(v, p, text, signal, (code) => {
      if (!announced) {
        announced = true;
        onStatus?.({ type: 'streaming' });
      }
      if (code.startsWith(emitted)) {
        const delta = code.slice(emitted.length);
        if (delta) onChunk?.(delta);
      } else {
        // The rendered block changed earlier text: restart the live view.
        onStatus?.({ type: 'restream' });
        onChunk?.(code);
      }
      emitted = code;
    });
    console.log(`[${v.log}] reply: ${final.text.length} chars (code ${final.code.length}) in ${Math.round((Date.now() - t0) / 1000)}s`);
  }
  if (!final) throw new Error('ChatGPT returned no reply.');
  // Edit blocks spread over several code blocks: the whole reply is the answer.
  const blocksIn = (s: string) => (s.match(/^[ \t]*<{5,9}[ \t]*SEARCH[ \t]*$/gim) || []).length;
  if (blocksIn(final.text) > blocksIn(final.code)) return final.text.trim();
  // Code request: the code block is the answer. Otherwise the reply text.
  if (final.code && final.code.length >= Math.min(200, final.text.length * 0.5)) return final.code.trim();
  return stripCodeFence(final.text).trim();
}

/** Ask ChatGPT in the given variant's browser. Serialized per variant; cancellable via `signal`. */
export async function askChatGPTWith(
  v: ChatGPTVariant,
  prompt: string,
  onChunk?: (text: string) => void,
  onStatus?: (event: ProxyStatus) => void,
  signal?: AbortSignal,
): Promise<string> {
  if (typeof window !== 'undefined') throw new Error('askChatGPT is server-only.');
  if (!prompt || !prompt.trim()) throw new Error('Empty prompt.');
  const s = shared(v);
  const task = s.queue.then(() => {
    if (signal?.aborted) throw abortError(); // stopped while waiting: never sent
    return runRequest(v, prompt, onChunk, onStatus, signal);
  });
  s.queue = task.catch(() => {});
  if (!signal) return task;
  return new Promise<string>((resolve, reject) => {
    const onAbort = () => {
      if (s.page) void clickStop(s.page);
      reject(abortError());
    };
    if (signal.aborted) { onAbort(); return; }
    signal.addEventListener('abort', onAbort, { once: true });
    task.then(resolve, reject).finally(() => signal.removeEventListener('abort', onAbort));
  });
}

/** Ask the ChatGPT web UI, logged out. */
export function askChatGPTProxy(
  prompt: string,
  onChunk?: (text: string) => void,
  onStatus?: (event: ProxyStatus) => void,
  signal?: AbortSignal,
): Promise<string> {
  return askChatGPTWith(LOGGED_OUT, prompt, onChunk, onStatus, signal);
}

/**
 * The account the variant's background browser is signed into (null: logged
 * out). Runs in the variant's queue, so it never interrupts a request.
 */
export async function checkChatGPTSession(v: ChatGPTVariant): Promise<{ email: string; name: string } | null> {
  const s = shared(v);
  const task = s.queue.then(async () => {
    const p = await ensureBrowser(v);
    await p.goto(CHATGPT_URL, { waitUntil: 'domcontentloaded', timeout: NAV_TIMEOUT_MS });
    // The app may still be setting up its session right after load.
    for (let i = 0; i < 10; i++) {
      const session = await readSession(p);
      if (session) return session;
      await sleep(1_000);
    }
    return null;
  });
  s.queue = task.catch(() => {});
  return task;
}

export async function closeChatGPTWith(v: ChatGPTVariant): Promise<void> {
  const s = shared(v);
  try { await s.browser?.close(); } catch { /* already closed */ }
  s.browser = null;
  s.page = null;
  s.net = null;
}

export function closeChatGPTProxy(): Promise<void> {
  return closeChatGPTWith(LOGGED_OUT);
}
