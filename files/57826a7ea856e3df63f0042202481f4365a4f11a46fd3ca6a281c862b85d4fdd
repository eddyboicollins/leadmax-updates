const LANG_INDEX: Record<BusinessLang, number> = { en: 0, fr: 1, ar: 2 };

/** 'fr-FR' → 'fr'; anything unknown falls back to English. */
export function businessLang(lang: string | undefined): BusinessLang {
  const l = (lang || '').toLowerCase();
  return l.startsWith('fr') ? 'fr' : l.startsWith('ar') ? 'ar' : 'en';
}

/** Lowercase, accents stripped — "cafe" matches "Café". */
export function foldText(s: string): string {
  return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
}

/**
 * Labels (in `lang`) of the types matching the query: starting with it first,
 * then a word starting with it, then anywhere. Matches the label in `lang` and
 * the English name, so English typing still works in any UI language.
 */
export function matchBusinessTypes(query: string, lang: BusinessLang): string[] {
  const idx = LANG_INDEX[lang];
  const labels = [...new Set(TYPES.map(t => t[idx]))];
  const q = foldText(query);
  if (!q) return labels;
  const rank = new Map<string, number>();
  for (const t of TYPES) {
    const label = t[idx];
    for (const name of new Set([label, t[0]])) {
      const f = foldText(name);
      const r = f.startsWith(q) ? 0 : f.includes(' ' + q) ? 1 : f.includes(q) ? 2 : -1;
      if (r >= 0 && (rank.get(label) ?? 3) > r) rank.set(label, r);
    }
  }
  return labels.filter(l => rank.has(l)).sort((a, b) => rank.get(a)! - rank.get(b)!);
}
