import { NextRequest, NextResponse } from 'next/server';
import { getCampaign, getLead, setMainDeployment, setMainAgentCardDeployment, getAgentCards, getSettings } from '@/lib/store';
import { assignVercelAlias, slugifyProjectName } from '@/lib/vercel-deploy';

export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;
    const { entryId, agentCardId } = await request.json();

    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    const settings = await getSettings();
    if (!settings.vercelToken) {
      return NextResponse.json({ error: 'No Vercel token configured' }, { status: 400 });
    }

    // Multi-agent card flow: flip main inside the CARD's history
    if (agentCardId) {
      const card = getAgentCards(lead).find(c => c.id === agentCardId);
      if (!card) return NextResponse.json({ error: 'Agent card not found' }, { status: 404 });
      const entry = card.deploymentHistory?.find(e => e.id === entryId);
      if (!entry) return NextResponse.json({ error: 'Deployment entry not found' }, { status: 404 });
      if (!entry.vercelDeploymentId) {
        return NextResponse.json({ error: 'Deployment has no Vercel deployment ID' }, { status: 400 });
      }
      const projectName = card.deploymentName || lead.deploymentName || slugifyProjectName(lead.business.name);
      await assignVercelAlias(settings.vercelToken, projectName, entry.vercelDeploymentId);
      const { entry: updated } = await setMainAgentCardDeployment(leadId, card.id, entryId);
      return NextResponse.json({ success: true, entry: updated });
    }

    const entry = lead.deploymentHistory?.find(e => e.id === entryId);
    if (!entry) return NextResponse.json({ error: 'Deployment entry not found' }, { status: 404 });

    if (!entry.vercelDeploymentId) {
      return NextResponse.json({ error: 'Deployment has no Vercel deployment ID' }, { status: 400 });
    }
    const projectName = lead.deploymentName || slugifyProjectName(lead.business.name);
    await assignVercelAlias(settings.vercelToken, projectName, entry.vercelDeploymentId);

    const { entry: updated } = await setMainDeployment(leadId, entryId);

    return NextResponse.json({ success: true, entry: updated });
  } catch (err: unknown) {
    const message = err instanceof Error ? err.message : 'Failed to set main deployment';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
