      {/* Add Clients Modal (manual campaigns) */}
      {showAddClients && (
        <div className="fixed inset-0 z-[110] bg-black/70 flex items-center justify-center p-4" onClick={() => { if (!resolvingClients) setShowAddClients(false); }}>
