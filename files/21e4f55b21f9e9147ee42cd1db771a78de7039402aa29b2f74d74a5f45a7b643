import { NextRequest, NextResponse } from 'next/server';
import { getCampaigns, saveCampaign, deleteCampaign } from '@/lib/store';

export async function GET() {
  const campaigns = await getCampaigns();
  return NextResponse.json({ campaigns });
}

export async function POST(request: NextRequest) {
  try {
    const { keyword, location, minRating, maxRating, minReviews, regions } = await request.json();
    if (!keyword || !location) {
      return NextResponse.json({ error: 'keyword and location required' }, { status: 400 });
    }
    const filter = {
      ...(typeof minRating === 'number' ? { minRating } : {}),
      ...(typeof maxRating === 'number' ? { maxRating } : {}),
      ...(typeof minReviews === 'number' ? { minReviews } : {}),
    };
    let regionList = regions;
    if (Array.isArray(regionList)) {
      regionList = regionList.filter(
        (r: any) => r && typeof r.keyword === 'string' && r.keyword && typeof r.location === 'string' && r.location
      );
      regionList = regionList.map((r: any) => ({
        keyword: r.keyword,
        location: r.location,
        ...(typeof r.minRating === 'number' ? { minRating: r.minRating } : {}),
        ...(typeof r.maxRating === 'number' ? { maxRating: r.maxRating } : {}),
        ...(typeof r.minReviews === 'number' ? { minReviews: r.minReviews } : {}),
      }));
    }
    const campaign = await saveCampaign(keyword, location, filter, Array.isArray(regionList) && regionList.length > 0 ? regionList : undefined);
    return NextResponse.json(campaign);
  } catch (err: any) {
    return NextResponse.json({ error: err.message }, { status: 500 });
  }
}

export async function DELETE(request: NextRequest) {
  const id = request.nextUrl.searchParams.get('id');
  if (!id) {
    return NextResponse.json({ error: 'id required' }, { status: 400 });
  }
  await deleteCampaign(id);
  return NextResponse.json({ success: true });
}
