    var blocks = pageBlocks();
    for (var i = 0; i < blocks.length; i++) {
      var prev = blocks[i], next = blocks[i + 1] || null;
      var r = prev.getBoundingClientRect();
      var node = document.createElement('div');
      node.className = 'lm-ins';
      node.style.top = Math.round(r.bottom + window.scrollY) + 'px';
      node.innerHTML = '<b>+</b>';
      node.title = next ? 'Add something here' : 'Add something at the end';
      var key = locOf(prev) + ':' + (next ? locOf(next) : 'end');
