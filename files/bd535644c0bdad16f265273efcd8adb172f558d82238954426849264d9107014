'use client';

import { useState, useEffect } from 'react';
import { useTranslation } from 'react-i18next';
import { SetNavbar } from '@/components/AppShell';
import { useToast } from '@/components/Toast';
import { verifyVercelToken, verifyImgbbKey } from '@/lib/verify-tokens';
import { GEMINI_MODELS, DEFAULT_GEMINI_MODEL, type GeminiModel, type GeminiSource } from '@/lib/gemini';

function StatusBadge({ configured }: { configured: boolean }) {
  const { t } = useTranslation();
  return (
    <span className={`px-2.5 py-1 text-xs font-medium rounded-lg ${configured ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-amber-500/10 text-amber-600 dark:text-amber-400'}`}>
      {configured ? t('settings.configured') : t('settings.notConfigured')}
    </span>
  );
}

function SaveButton({ busy, done, disabled, onSave }: { busy: boolean; done: boolean; disabled: boolean; onSave: () => void }) {
  const { t } = useTranslation();
  return (
    <button
      onClick={onSave}
      disabled={disabled}
      className="shrink-0 px-4 py-2.5 text-sm font-medium text-white bg-gradient-to-r from-emerald-500 to-emerald-600 rounded-xl hover:from-emerald-400 hover:to-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-lg shadow-emerald-500/20 active:scale-[0.98]"
    >
      {busy ? (
        <svg className="animate-spin w-4 h-4" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
      ) : done ? t('settings.saved') : t('settings.save')}
    </button>
  );
}

function Card({ title, badge, className, children }: { title: string; badge?: React.ReactNode; className?: string; children: React.ReactNode }) {
  return (
    <section className={`bg-white dark:bg-zinc-800/40 border border-gray-200 dark:border-zinc-700/50 rounded-xl p-5 ${className || ''}`}>
      <div className="flex items-center justify-between mb-3 gap-2">
        <h2 className="text-sm font-semibold text-gray-900 dark:text-white">{title}</h2>
        {badge}
      </div>
      {children}
    </section>
  );
}

export default function SettingsPage() {
  const { t } = useTranslation();
  const { toast } = useToast();

  const [hasVercel, setHasVercel] = useState(false);
  const [hasImgbb, setHasImgbb] = useState(false);
  const [hasGemini, setHasGemini] = useState(false);
  const [model, setModel] = useState<GeminiModel>(DEFAULT_GEMINI_MODEL);
  const [source, setSource] = useState<GeminiSource>('proxy');
  const [assistantPrompt, setAssistantPrompt] = useState('');
  const [minRating, setMinRating] = useState(4);
  const [maxRating, setMaxRating] = useState(5);
  const [minReviews, setMinReviews] = useState(50);

  const [vercelToken, setVercelToken] = useState('');
  const [imgbbKey, setImgbbKey] = useState('');
  const [geminiKey, setGeminiKey] = useState('');

  const [saving, setSaving] = useState<Record<string, boolean>>({});
  const [saved, setSaved] = useState<Record<string, boolean>>({});

  useEffect(() => {
    let mounted = true;
    fetch('/api/settings')
      .then(r => r.json())
      .then(data => {
        if (!mounted) return;
        setHasVercel(!!data.hasVercelToken);
        setHasImgbb(!!data.hasImgbbKey);
        setHasGemini(!!data.hasGeminiApiKey);
        setModel((data.geminiModel as GeminiModel) || DEFAULT_GEMINI_MODEL);
        setSource((data.geminiSource as GeminiSource) || 'proxy');
        setAssistantPrompt(data.assistantSystemPrompt || '');
        setMinRating(data.defaultMinRating ?? 4);
        setMaxRating(data.defaultMaxRating ?? 5);
        setMinReviews(data.defaultMinReviews ?? 50);
      })
      .catch(() => {});
    return () => {
      mounted = false;
    };
  }, []);

  function flashSaved(key: string) {
    setSaved(s => ({ ...s, [key]: true }));
    setTimeout(() => setSaved(s => ({ ...s, [key]: false })), 2500);
  }

  async function put(body: Record<string, unknown>) {
    const res = await fetch('/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) throw new Error((await res.json()).error);
  }

  async function saveVercel() {
    const token = vercelToken.trim();
    if (!token) return;
    setSaving(s => ({ ...s, vercel: true }));
    try {
      const vResult = await verifyVercelToken(token);
      if (!vResult.valid) {
        toast(vResult.error, 'error');
        return;
      }
      await put({ vercelToken: token });
      setHasVercel(true);
      setVercelToken('');
      flashSaved('vercel');
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(s => ({ ...s, vercel: false }));
    }
  }

  async function saveImgbb() {
    const key = imgbbKey.trim();
    if (!key) return;
    setSaving(s => ({ ...s, imgbb: true }));
    try {
      const iResult = await verifyImgbbKey(key);
      if (!iResult.valid) {
        toast(iResult.error, 'error');
        return;
      }
      await put({ imgbbKey: key });
      setHasImgbb(true);
      setImgbbKey('');
      flashSaved('imgbb');
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(s => ({ ...s, imgbb: false }));
    }
  }

  async function saveGeminiKey() {
    const key = geminiKey.trim();
    if (!key) return;
    setSaving(s => ({ ...s, geminiKey: true }));
    try {
      await put({ geminiApiKey: key });
      setHasGemini(true);
      setGeminiKey('');
      flashSaved('geminiKey');
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(s => ({ ...s, geminiKey: false }));
    }
  }

  async function saveModel() {
    setSaving(s => ({ ...s, model: true }));
    try {
      await put({ geminiModel: model });
      flashSaved('model');
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(s => ({ ...s, model: false }));
    }
  }

  async function saveSource() {
    setSaving(s => ({ ...s, source: true }));
    try {
      await put({ geminiSource: source });
      flashSaved('source');
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(s => ({ ...s, source: false }));
    }
  }

  async function saveAssistant() {
    setSaving(s => ({ ...s, assistant: true }));
    try {
      await put({ assistantSystemPrompt: assistantPrompt.trim() });
      flashSaved('assistant');
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(s => ({ ...s, assistant: false }));
    }
  }

  async function saveCampaignDefaults() {
    setSaving(s => ({ ...s, campaignDefaults: true }));
    try {
      await put({ defaultMinRating: minRating, defaultMaxRating: maxRating, defaultMinReviews: minReviews });
      flashSaved('campaignDefaults');
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSaving(s => ({ ...s, campaignDefaults: false }));
    }
  }

  const inputCls =
    'flex-1 min-w-0 px-4 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all font-mono text-sm';

  return (
    <div className="flex-1 bg-gradient-to-br from-gray-100 via-white to-gray-50 dark:from-zinc-900 dark:via-zinc-800 dark:to-zinc-900 transition-colors flex flex-col">
      <SetNavbar title={t('settings.title')} subtitle={t('settings.subtitle')} />

      <main className="app-page flex-1">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
          {/* Vercel Token */}
          <Card title={t('settings.vercelToken')} badge={<StatusBadge configured={hasVercel} />}>
            <div className="bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-700/30 rounded-xl p-4 mb-3">
              <h3 className="text-xs font-semibold text-zinc-600 dark:text-zinc-300 mb-3 flex items-center gap-2">
                <svg className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {t('settings.howToVercel')}
              </h3>
              <ol className="space-y-2 text-xs text-zinc-500 dark:text-zinc-400 list-decimal list-inside">
                <li>{t('settings.vercelStep1')}</li>
                <li>{t('settings.vercelStep2')}</li>
                <li>{t('settings.vercelStep3')}</li>
                <li>{t('settings.vercelStep4')}</li>
              </ol>
              <a href="https://vercel.com/account/tokens" target="_blank" rel="noopener noreferrer" className="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">
                <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                {t('settings.openVercelPage')}
              </a>
            </div>
            <div className="flex gap-2">
              <input type="password" value={vercelToken} onChange={e => setVercelToken(e.target.value)} placeholder={t('settings.vercelPlaceholder')} className={inputCls} />
              <SaveButton busy={!!saving.vercel} done={!!saved.vercel} disabled={!!saving.vercel || !vercelToken.trim()} onSave={saveVercel} />
            </div>
          </Card>

          {/* ImgBB Key */}
          <Card title={t('settings.imgbbKey')} badge={<StatusBadge configured={hasImgbb} />}>
            <div className="bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-700/30 rounded-xl p-4 mb-3">
              <h3 className="text-xs font-semibold text-zinc-600 dark:text-zinc-300 mb-3 flex items-center gap-2">
                <svg className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {t('settings.howToImgbb')}
              </h3>
              <ol className="space-y-2 text-xs text-zinc-500 dark:text-zinc-400 list-decimal list-inside">
                <li>{t('settings.imgbbStep1')}</li>
                <li>{t('settings.imgbbStep2')}</li>
                <li>{t('settings.imgbbStep3')}</li>
              </ol>
              <a href="https://api.imgbb.com" target="_blank" rel="noopener noreferrer" className="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">
                <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                {t('settings.openImgbbPage')}
              </a>
            </div>
            <div className="flex gap-2">
              <input type="password" value={imgbbKey} onChange={e => setImgbbKey(e.target.value)} placeholder={t('settings.imgbbPlaceholder')} className={inputCls} />
              <SaveButton busy={!!saving.imgbb} done={!!saved.imgbb} disabled={!!saving.imgbb || !imgbbKey.trim()} onSave={saveImgbb} />
            </div>
          </Card>

          {/* Gemini */}
          <Card title="Gemini" badge={<StatusBadge configured={hasGemini} />}>
            <div className="bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-700/30 rounded-xl p-4 mb-4">
              <h3 className="text-xs font-semibold text-zinc-600 dark:text-zinc-300 mb-3 flex items-center gap-2">
                <svg className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {t('settings.howToGemini')}
              </h3>
              <ol className="space-y-2 text-xs text-zinc-500 dark:text-zinc-400 list-decimal list-inside">
                <li>{t('settings.geminiStep1')}</li>
                <li>{t('settings.geminiStep2')}</li>
                <li>{t('settings.geminiStep3')}</li>
                <li>{t('settings.geminiStep4')}</li>
              </ol>
              <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener noreferrer" className="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">
                <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                {t('settings.openGeminiPage')}
              </a>
            </div>
            <div className="flex items-center justify-between gap-3 mb-4 pb-4 border-b border-gray-200 dark:border-zinc-700/50">
              <div className="min-w-0">
                <h3 className="text-sm font-semibold text-gray-900 dark:text-white">{t('settings.geminiSource')}</h3>
                <p className="text-xs text-zinc-500 dark:text-zinc-400">{t('settings.geminiSourceDesc')}</p>
                <p className="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1">{t('settings.geminiSourceApiHint')}</p>
              </div>
              <div className="flex items-center gap-2 shrink-0">
                <select value={source} onChange={e => setSource(e.target.value as GeminiSource)} className="px-3 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm">
                  <option value="proxy">{t('settings.geminiSourceProxy')}</option>
                  <option value="api">{t('settings.geminiSourceApi')}</option>
                </select>
                <SaveButton busy={!!saving.source} done={!!saved.source} disabled={!!saving.source} onSave={saveSource} />
              </div>
            </div>
            {source === 'api' && (
              <>
                <p className="text-xs text-zinc-500 dark:text-zinc-400 mb-3">{t('settings.geminiApiKeyDesc')}</p>
                <div className="flex gap-2 mb-4">
                  <input type="password" value={geminiKey} onChange={e => setGeminiKey(e.target.value)} placeholder={t('settings.geminiApiKeyPlaceholder')} className={inputCls} />
                  <SaveButton busy={!!saving.geminiKey} done={!!saved.geminiKey} disabled={!!saving.geminiKey || !geminiKey.trim()} onSave={saveGeminiKey} />
                </div>
                <div className="flex items-center justify-between gap-3 border-t border-gray-200 dark:border-zinc-700/50 pt-4">
                  <div className="min-w-0">
                    <h3 className="text-sm font-semibold text-gray-900 dark:text-white">{t('settings.geminiModel')}</h3>
                    <p className="text-xs text-zinc-500 dark:text-zinc-400">{t('settings.geminiModelDesc')}</p>
                  </div>
                  <div className="flex items-center gap-2 shrink-0">
                    <select value={model} onChange={e => setModel(e.target.value as GeminiModel)} className="px-3 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm">
                      {Object.entries(GEMINI_MODELS).map(([value, label]) => (
                        <option key={value} value={value}>{label}</option>
                      ))}
                    </select>
                    <SaveButton busy={!!saving.model} done={!!saved.model} disabled={!!saving.model} onSave={saveModel} />
                  </div>
                </div>
              </>
            )}
          </Card>

          {/* Assistant System Prompt */}
          <Card title={t('settings.assistantSystemPrompt')}>
            <textarea
              value={assistantPrompt}
              onChange={e => setAssistantPrompt(e.target.value)}
              rows={4}
              placeholder={t('settings.assistantSystemPromptPlaceholder')}
              className="w-full px-4 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm resize-y"
            />
            <p className="mt-1.5 text-[11px] text-zinc-500 dark:text-zinc-400">{t('settings.assistantSystemPromptDesc')}</p>
            <div className="mt-3 flex justify-end">
              <SaveButton busy={!!saving.assistant} done={!!saved.assistant} disabled={!!saving.assistant} onSave={saveAssistant} />
            </div>
          </Card>

          {/* Campaign Defaults */}
          <Card title={t('settings.campaignDefaults')}>
            <p className="text-xs text-zinc-500 dark:text-zinc-400 mb-3">{t('settings.campaignDefaultsDesc')}</p>
            <div className="grid grid-cols-3 gap-3 mb-3">
              <div>
                <label className="block text-[10px] font-medium text-gray-500 dark:text-zinc-400 mb-1.5 uppercase tracking-wider">{t('home.minRating')}</label>
                <input
                  type="number" min={0} max={5} step={0.1}
                  value={minRating}
                  onChange={e => setMinRating(Number(e.target.value) || 0)}
                  className="w-full px-3 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all"
                />
              </div>
              <div>
                <label className="block text-[10px] font-medium text-gray-500 dark:text-zinc-400 mb-1.5 uppercase tracking-wider">{t('home.maxRating')}</label>
                <input
                  type="number" min={0} max={5} step={0.1}
                  value={maxRating}
                  onChange={e => setMaxRating(Number(e.target.value) || 0)}
                  className="w-full px-3 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all"
                />
              </div>
              <div>
                <label className="block text-[10px] font-medium text-gray-500 dark:text-zinc-400 mb-1.5 uppercase tracking-wider">{t('home.minReviews')}</label>
                <input
                  type="number" min={0} step={1}
                  value={minReviews}
                  onChange={e => setMinReviews(Number(e.target.value) || 0)}
                  className="w-full px-3 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all"
                />
              </div>
            </div>
            <div className="flex justify-end">
              <SaveButton busy={!!saving.campaignDefaults} done={!!saved.campaignDefaults} disabled={!!saving.campaignDefaults} onSave={saveCampaignDefaults} />
            </div>
          </Card>
        </div>
      </main>
    </div>
  );
}
