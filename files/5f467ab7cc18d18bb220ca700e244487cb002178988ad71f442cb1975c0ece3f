export function emptyInvoiceSettings(): InvoiceSettings {
  return {
    identityKind: 'freelancer',
    lang: 'en',
    legalName: '',
    address: '',
    phone: '',
    contactEmail: '',
    companyName: '',
    website: '',
    logoDataUrl: '',
  };
}

export function newInvoiceLine(
  partial?: Partial<InvoiceLine>,
): InvoiceLine {
  return {
    id:
      partial?.id ||
      (typeof crypto !== 'undefined' && crypto.randomUUID
        ? crypto.randomUUID()
        : `line-${Date.now()}-${Math.random()
            .toString(36)
            .slice(2, 8)}`),
    description: partial?.description ?? '',
    quantity: partial?.quantity ?? 1,
    unitPrice: partial?.unitPrice ?? 0,
  };
}

function hostOf(url: string | undefined): string {
  if (!url) return '';

  try {
    return new URL(url).host;
  } catch {
    return String(url)
      .replace(/^https?:\/\//, '')
      .split('/')[0]
      .trim();
  }
}

function modificationInvoiceLines(
  lead: { deploymentHistory?: DeploymentEntry[] },
): InvoiceLine[] {
  return (lead.deploymentHistory || [])
    .filter(
      (entry) =>
        entry.userPrompt &&
        entry.userPrompt.trim() &&
        !/coming soon/i.test(entry.userPrompt),
    )
    .map((entry) =>
      newInvoiceLine({
        description: `Modifications: ${entry.userPrompt!.trim()}`,
      }),
    );
}

export function freshInvoiceForLead(
  lead: Pick<
    Lead,
    'id' | 'business' | 'deployment' | 'deploymentHistory'
  >,
): LeadInvoice {
  const now = new Date();
  const ymd = now.toISOString().slice(0, 10);

  const short =
    (lead.id || '')
      .replace(/-/g, '')
      .slice(0, 6)
      .toUpperCase() || '000000';

  const lines: InvoiceLine[] = [
    newInvoiceLine({
      description: lead.business?.name
        ? `Website — ${lead.business.name}`
        : 'Website',
    }),
  ];

  const domain = hostOf(lead.deployment?.url);

  if (domain) {
    lines.push(
      newInvoiceLine({
        description: domain,
      }),
    );
  }

  lines.push(...modificationInvoiceLines(lead));

  return {
    number: `INV-${ymd.replace(/-/g, '')}-${short}`,
    issueDate: ymd,
    currency: 'TND',
    clientName: lead.business?.name || '',
    clientAddress: lead.business?.address || '',
    clientPhone: lead.business?.phone || '',
    lines,
    updatedAt: now.toISOString(),
  };
}

export function defaultLeadInvoice(
  lead: Pick<
    Lead,
    'id' | 'business' | 'invoice' | 'deployment' | 'deploymentHistory'
  >,
): LeadInvoice {
  if (lead.invoice?.number) {
    return {
      ...lead.invoice,
      lines: lead.invoice.lines?.length
        ? lead.invoice.lines
        : [newInvoiceLine()],
    };
  }

  return freshInvoiceForLead(lead);
}

function escapeHtml(value: string): string {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

function formatMoney(
  amount: number,
  currency: string,
): string {
  const n = Number.isFinite(amount) ? amount : 0;

  try {
    return new Intl.NumberFormat(undefined, {
      style: 'currency',
      currency: currency || 'TND',
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(n);
  } catch {
    return `${n.toFixed(2)} ${currency || 'TND'}`;
  }
}

export function invoiceTotals(
  invoice: LeadInvoice,
): { subtotal: number } {
  const subtotal = (invoice.lines || []).reduce(
    (sum, line) => {
      const quantity = Number(line.quantity) || 0;
      const unitPrice = Number(line.unitPrice) || 0;

      return sum + quantity * unitPrice;
    },
    0,
  );

  return { subtotal };
}

