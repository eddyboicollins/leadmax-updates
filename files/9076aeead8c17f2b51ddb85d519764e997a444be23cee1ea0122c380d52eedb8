export const GEMINI_MODELS = {
  'gemini-3.6-flash': 'Gemini 3.6 Flash',
  'gemini-3.5-flash-lite': 'Gemini 3.5 Flash Lite (Recommended)',
  'gemini-3.1-pro-preview': 'Gemini 3.1 Pro',
  'gemini-2.5-flash': 'Gemini 2.5 Flash',
} as const;

export type GeminiModel = keyof typeof GEMINI_MODELS;

export const DEFAULT_GEMINI_MODEL: GeminiModel = 'gemini-3.5-flash-lite';

/** official: Gemini API (key) · proxy: Gemini web UI · chatgpt: ChatGPT web UI (logged out). */
export type AiSource = 'official' | 'proxy' | 'chatgpt';

export const DEFAULT_AI_SOURCE: AiSource = 'proxy';

export function normalizeAiSource(v: unknown): AiSource {
  return v === 'official' || v === 'proxy' || v === 'chatgpt' ? v : DEFAULT_AI_SOURCE;
}

/** Progress events the proxy emits while driving the Gemini web UI. */
export type ProxyStatus =
  | { type: 'uploading' }
  | { type: 'turn'; turn: number; total: number }
  | { type: 'streaming' }
  /** Earlier streamed text changed: the live view must restart from scratch. */
  | { type: 'restream' };

export function isQuotaOrOverloadError(message: string): boolean {
  return /quota|rate[\s_-]*limit|too many requests|resource[\s_-]*exhausted|overloaded|overload|high demand|429|503/i.test(message || '');
}

export function normalizeGeminiModel(v: unknown): GeminiModel {
  return typeof v === 'string' && v in GEMINI_MODELS ? (v as GeminiModel) : DEFAULT_GEMINI_MODEL;
}

const PROXY_TIMEOUT_MS = 100000;

export async function askGemini(
  prompt: string,
  apiKey: string,
  model: GeminiModel = DEFAULT_GEMINI_MODEL,
  onChunk?: (text: string) => void,
  signal?: AbortSignal,
): Promise<string> {
  if (!apiKey) {
    throw new Error('No Gemini API key configured. Add it in Settings.');
  }
  const isStreaming = typeof onChunk === 'function';
  const endpoint = isStreaming ? 'streamGenerateContent?alt=sse' : 'generateContent';
  const url = `https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:${endpoint}&key=${encodeURIComponent(apiKey)}`;
  
  let response: Response;
  try {
    response = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ role: 'user', parts: [{ text: prompt }] }],
        generationConfig: { temperature: 0.9, topP: 0.95 },
      }),
      signal: signal ? AbortSignal.any([signal, AbortSignal.timeout(PROXY_TIMEOUT_MS)]) : AbortSignal.timeout(PROXY_TIMEOUT_MS),
    });
  } catch (err) {
    const e = err instanceof Error ? err : new Error(String(err));
    if (signal?.aborted) throw e; // cancelled by the user: not a timeout
    if (e.name === 'AbortError' || e.name === 'TimeoutError') {
      throw new Error('Gemini API request timed out');
    }
    throw e;
  }

  if (!response.ok) {
    const errText = await response.text().catch(() => '');
    let message = `Gemini API returned HTTP ${response.status}`;
    try {
      const j = JSON.parse(errText);
      if (j?.error?.message) message = j.error.message;
    } catch { /* keep default */ }
    throw new Error(message);
  }

  if (isStreaming && response.body) {
    const reader = response.body.getReader();
    const decoder = new TextDecoder('utf-8');
    let fullText = '';
    let buffer = '';
    while (true) {
      const { done, value } = await reader.read();
      if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n');
      buffer = lines.pop() || '';
      for (const line of lines) {
        if (line.startsWith('data: ')) {
          const dataStr = line.slice(6);
          if (dataStr === '[DONE]') continue;
          try {
            const j = JSON.parse(dataStr);
            const chunk = j?.candidates?.[0]?.content?.parts?.[0]?.text;
            if (chunk) {
              fullText += chunk;
              onChunk(chunk);
            }
          } catch { /* ignore JSON parse error for partial lines if any */ }
        }
      }
    }
    if (!fullText) throw new Error('Gemini returned an empty stream response.');
    return fullText;
  } else {
    const data = (await response.json()) as {
      candidates?: Array<{ content?: { parts?: Array<{ text?: string }> } }>;
    };
    const text = data?.candidates?.[0]?.content?.parts
      ?.filter(p => typeof p?.text === 'string')
      .map(p => p.text as string)
      .join('')
      .trim();
    if (!text) throw new Error('Gemini returned an empty response.');
    return text;
  }
}

export async function retryAskGemini(
  prompt: string,
  apiKey: string,
  model: GeminiModel,
  onChunk?: (text: string) => void,
  signal?: AbortSignal,
): Promise<string> {
  // Official API: single attempt, no retries — failures surface immediately.
  return askGemini(prompt, apiKey, model, onChunk, signal);
}
