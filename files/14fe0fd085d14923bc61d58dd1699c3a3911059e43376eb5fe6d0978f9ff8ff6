.lm-map { background: #e4e4e7; }
.dark .lm-map { background: #09090b; }
/* Dark mode: invert the OSM tiles to a neutral dark grey with a faint emerald cast */
.dark .lm-map .leaflet-tile-pane { filter: invert(1) hue-rotate(180deg) grayscale(1) brightness(0.8) contrast(0.95) sepia(0.12) hue-rotate(95deg) saturate(1.6); }
