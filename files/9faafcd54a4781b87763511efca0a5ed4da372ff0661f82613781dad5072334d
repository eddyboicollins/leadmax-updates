/**
 * Asks the AI once (no retries on either source) and validates the response
 * with sanitizeGeneratedTsx. Any failure — transport or malformed output —
 * throws immediately with its real message.
 */
export async function askGeminiAndValidate(
  prompt: string,
  apiKey: string,
  model: GeminiModel,
  onChunk?: (text: string) => void,
  source: AiSource = 'official',
  onStatus?: (event: ProxyStatus) => void,
): Promise<string> {
  const raw = await askAIWithSource(prompt, apiKey, model, onChunk, source, onStatus);
  return sanitizeGeneratedTsx(raw);
}

