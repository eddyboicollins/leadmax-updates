'use client';

import { useEffect, useRef, useState } from 'react';
import { useTranslation } from 'react-i18next';
import { useSettings, useSaveSettings } from '@/lib/query/useCampaign';
import { GEMINI_MODELS, DEFAULT_GEMINI_MODEL, normalizeAiSource, type AiSource, type GeminiModel } from '@/lib/gemini';

/**
 * Quick AI source / model switch (same settings as the Settings page). Saved
 * at once; the next AI job (modify / regenerate) uses it. A running job keeps
 * the source it started with.
 */
export default function AiSourcePicker() {
  const { t } = useTranslation();
  const { data: settings } = useSettings();
  const save = useSaveSettings();
  const [open, setOpen] = useState(false);
  const rootRef = useRef<HTMLDivElement>(null);

  const source: AiSource = normalizeAiSource(settings?.aiSource);
  const model: GeminiModel = settings?.geminiModel && settings.geminiModel in GEMINI_MODELS ? settings.geminiModel : DEFAULT_GEMINI_MODEL;
  const hasKey = !!settings?.hasGeminiApiKey;

  useEffect(() => {
    if (!open) return;
    const onDown = (e: MouseEvent) => { if (!rootRef.current?.contains(e.target as Node)) setOpen(false); };
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') setOpen(false); };
    window.addEventListener('mousedown', onDown);
    window.addEventListener('keydown', onKey);
    return () => { window.removeEventListener('mousedown', onDown); window.removeEventListener('keydown', onKey); };
  }, [open]);

  if (!settings) return null;

  const pick = (patch: { aiSource?: AiSource; geminiModel?: GeminiModel }) => {
    if ((patch.aiSource ?? source) === source && (patch.geminiModel ?? model) === model) return;
    save.mutate(patch);
  };
  const modelLabel = (m: GeminiModel) => GEMINI_MODELS[m].replace(/\s*\(.*\)\s*$/, '');
  const option = (active: boolean) =>
    `w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-start text-[12px] transition-colors disabled:opacity-40 disabled:cursor-not-allowed ${active ? 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 font-medium' : 'text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800'}`;
  const check = (active: boolean) => (
    <svg className={`w-3.5 h-3.5 shrink-0 ${active ? '' : 'invisible'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}><path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" /></svg>
  );

  return (
    <div ref={rootRef} className="relative">
      <button
        type="button"
        onClick={() => setOpen(o => !o)}
        aria-expanded={open}
        title={t('campaign.studioAiPickerTitle')}
        className="inline-flex items-center gap-1 h-6 px-2 rounded-md border border-zinc-200 dark:border-zinc-700 text-[11px] font-medium text-zinc-600 dark:text-zinc-300 hover:border-emerald-500/50 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors max-w-[220px]"
      >
        {save.isPending
          ? <span className="animate-spin w-3 h-3 rounded-full border-2 border-emerald-500 border-t-transparent shrink-0" />
          : <svg className="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>}
        <span className="truncate">
          {source === 'proxy' ? t('settings.geminiSourceProxy') : `API · ${modelLabel(model)}`}
        </span>
        <svg className={`w-3 h-3 shrink-0 transition-transform ${open ? 'rotate-180' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}><path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </button>
      {open && (
        <div className="absolute bottom-full end-0 mb-1.5 z-50 w-64 p-1.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-2xl">
          <p className="px-2.5 pt-1 pb-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">{t('settings.geminiSource')}</p>
          <button type="button" className={option(source === 'proxy')} onClick={() => pick({ aiSource: 'proxy' })}>
            {check(source === 'proxy')}{t('settings.geminiSourceProxy')}
          </button>
          <button
            type="button"
            className={option(source === 'official')}
            disabled={!hasKey}
            title={hasKey ? undefined : t('campaign.studioAiNeedsKey')}
            onClick={() => pick({ aiSource: 'official' })}
          >
            {check(source === 'official')}{t('settings.geminiSourceApi')}
          </button>
          {!hasKey && <p className="px-2.5 pt-1 text-[10px] leading-snug text-zinc-500 dark:text-zinc-400">{t('campaign.studioAiNeedsKey')}</p>}
          {source === 'official' && (
            <>
              <p className="px-2.5 pt-2.5 pb-1.5 mt-1.5 border-t border-zinc-200 dark:border-zinc-800 text-[10px] font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">{t('settings.geminiModel')}</p>
              {(Object.keys(GEMINI_MODELS) as GeminiModel[]).map(m => (
                <button key={m} type="button" className={option(model === m)} onClick={() => pick({ geminiModel: m })}>
                  {check(model === m)}<span className="truncate">{GEMINI_MODELS[m]}</span>
                </button>
              ))}
            </>
          )}
        </div>
      )}
    </div>
  );
}
