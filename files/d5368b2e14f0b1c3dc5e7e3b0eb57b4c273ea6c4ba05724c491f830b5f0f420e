/**
 * Deterministic (no-AI) edits from the visual editor, mapped back onto the
 * component source. Every edit either lands on exactly one literal in the
 * code or is refused with a clear reason — never a guess.
 *
 * Several edits (e.g. the text runs of one rich heading) are resolved against
 * the SAME original code and applied together, so offsets never drift.
 */
import {
  tokenize,
  elementAt,
  scanTag,
  JSX_TAG_START,
  textTokens,
  textKey,
  encodeTextTok,
  syntaxError,
  type TextTok,
  type Tok,
  type JsxElementRange,
} from './jsx';

export type VisualEdit =
  | { kind: 'text'; loc: number; oldText: string; newText: string }
  | ({ kind: 'attr'; loc: number; attr: 'href' | 'src'; oldValue: string; newValue: string } & InstanceHint)
  | ({ kind: 'bgimage'; loc: number; oldUrl: string; newUrl: string } & InstanceHint);

/**
 * Which on-screen copy was clicked when the same element is rendered several
 * times from a list (e.g. one card template per item): index of the clicked
 * one among same-template elements showing the same value, and their count.
 */
export interface InstanceHint {
  instance?: number;
  instances?: number;
}

export class VisualEditError extends Error {
  constructor(message: string) {
    super(message);
    this.name = 'VisualEditError';
  }
}

/** One replacement in the original code. */
interface Splice {
  start: number;
  end: number;
  text: string;
  summary: string;
}

/**
 * A photo/link value that lives in data (e.g. a cards array) — pick the ONE
 * literal that feeds the clicked element, or null when that can't be proven
 * (the caller then overrides the clicked element's own attribute instead).
 * Several literals map to the clicked copy only when the list renders exactly
 * that many copies with this value (1:1 in source order).
 */
function pickDataLiteral(candidates: TextTok[], hint: InstanceHint): TextTok | null {
  if (candidates.length === 1) return candidates[0];
  const { instance, instances } = hint;
  if (candidates.length > 1 && typeof instance === 'number' && instances === candidates.length && instance >= 0 && instance < candidates.length) {
    return candidates[instance];
  }
  return null;
}

/** Opening-tag ranges of every JSX element (literals inside belong to that element). */
function openingTagRanges(code: string, tokens: Tok[]): [number, number][] {
  const out: [number, number][] = [];
  for (let i = 0; i < tokens.length; i++) {
    if (tokens[i].type !== JSX_TAG_START) continue;
    const tag = scanTag(code, tokens, i);
    if (tag && !tag.closing) out.push([tag.start, tag.end]);
  }
  return out;
}

/** True when the literal is written on ANOTHER element's tag (never ours to change). */
function onOtherElement(tok: TextTok, tags: [number, number][], el: JsxElementRange | null): boolean {
  return tags.some(([a, b]) => tok.start >= a && tok.end <= b && !(el && a === el.open.start));
}

function clip(s: string, n = 40): string {
  const t = textKey(s);
  return t.length > n ? t.slice(0, n - 1) + '…' : t;
}

function within(tok: { start: number; end: number }, start: number, end: number) {
  return tok.start >= start && tok.end <= end;
}

/** Pick the single right literal: inside the element first, then file-wide. */
function pickUnique(
  candidates: TextTok[],
  el: JsxElementRange | null,
  scope: 'inner' | 'tag',
  what: string,
): TextTok {
  if (el) {
    const [s, e] = scope === 'inner' ? [el.innerStart, el.innerEnd] : [el.open.start, el.open.end];
    const local = candidates.filter(c => within(c, s, e));
    if (local.length === 1) return local[0];
    if (local.length > 1) {
      throw new VisualEditError(`${what} appears several times inside this element, so it can't be changed safely here. Ask the AI instead.`);
    }
  }
  if (candidates.length === 1) return candidates[0];
  if (candidates.length === 0) {
    throw new VisualEditError(`${what} is computed by code (not plain text in the page), so it can't be edited visually. Ask the AI instead.`);
  }
  throw new VisualEditError(`${what} appears ${candidates.length} times in the page, so it can't be changed safely here. Ask the AI instead.`);
}

function resolveText(code: string, tokens: Tok[], el: JsxElementRange | null, edit: Extract<VisualEdit, { kind: 'text' }>): Splice | null {
  const oldKey = textKey(edit.oldText);
  const newText = edit.newText.replace(/[\r\n]+/g, ' ');
  if (!oldKey) {
    if (!textKey(newText)) return null;
    throw new VisualEditError('Text typed in an empty spot can\'t be placed safely. Type inside existing text, or ask the AI.');
  }
  if (textKey(newText) === oldKey) return null;
  const all = textTokens(code, tokens).filter(t => textKey(t.value) === oldKey);
  const tok = pickUnique(all, el, 'inner', `“${clip(edit.oldText)}”`);
  return {
    start: tok.start,
    end: tok.end,
    text: encodeTextTok(code, tok, newText.trim()),
    summary: `Text “${clip(edit.oldText)}” → “${clip(newText)}”`,
  };
}

function resolveAttr(code: string, tokens: Tok[], el: JsxElementRange | null, edit: Extract<VisualEdit, { kind: 'attr' }>): Splice[] {
  if (edit.newValue === edit.oldValue) return [];
  const label = edit.attr === 'href' ? 'Link' : 'Image';
  const summary = edit.attr === 'href'
    ? `Link → ${clip(edit.newValue, 60)}`
    : `Image replaced (${clip(edit.oldValue.split('/').pop() || edit.oldValue, 24)} → ${clip(edit.newValue.split('/').pop() || edit.newValue, 24)})`;
  const lits = textTokens(code, tokens);
  const tags = openingTagRanges(code, tokens);
  const splice = (t: TextTok): Splice => ({ start: t.start, end: t.end, text: encodeTextTok(code, t, edit.newValue), summary });

  // 1) The value written on the clicked element itself (also inside an earlier
  //    override such as src={(x) === "A" ? "B" : (x)}).
  const attr = el?.open.attrs.find(a => a.name === edit.attr);
  if (attr) {
    const own = lits.filter(t => t.start >= attr.start && t.end <= attr.end && t.value === edit.oldValue);
    if (own.length) return [splice(own[own.length - 1])];
  }
  // 2) The value comes from data (e.g. a cards array) — only a literal that
  //    provably feeds THIS element; literals on other elements are never touched.
  const data = pickDataLiteral(lits.filter(t => t.value === edit.oldValue && !onOtherElement(t, tags, el)), edit);
  if (data) return [splice(data)];
  // 3) Images only: URL embedded inside a larger literal (same rules).
  if (edit.attr === 'src') {
    const inside = resolveUrlInside(code, tokens, el, edit.oldValue, edit.newValue, summary, edit);
    if (inside) return inside;
  }
  // 4) Otherwise override the clicked element's own attribute — only it changes.
  return [rewriteAttr(code, tokens, el, edit.attr, edit.oldValue, edit.newValue, summary, edit, label)];
}

/** Source text of an attribute's `{ … }` expression (without the braces). */
function attrExpr(code: string, tokens: Tok[], el: JsxElementRange, name: string): string | null {
  const a = el.open.attrs.find(x => x.name === name);
  if (!a || a.exprStart === undefined || a.exprEnd === undefined) return null;
  return code.slice(tokens[a.exprStart].end, tokens[a.exprEnd].start).trim() || null;
}

/** Where to add a new attribute: after the last one (so it wins over spreads). */
function attrInsertPoint(el: JsxElementRange): number {
  const attrs = el.open.attrs;
  return attrs.length ? attrs[attrs.length - 1].end : el.open.nameEnd;
}

/**
 * The value isn't a literal anywhere: change the clicked element's attribute.
 * A computed value gets a value-based condition, so only the copy (in a list)
 * that showed the old value changes. Layout/size classes are never touched.
 */
function rewriteAttr(
  code: string,
  tokens: Tok[],
  el: JsxElementRange | null,
  name: 'src' | 'href',
  oldValue: string,
  newValue: string,
  summary: string,
  hint: InstanceHint,
  label: string,
): Splice {
  if (!el) throw new VisualEditError(`${label} could not be located in the code. Ask the AI instead.`);
  const attr = el.open.attrs.find(a => a.name === name);
  const expr = attrExpr(code, tokens, el, name);
  // A computed value may differ per copy (lists): only the copy that showed
  // the old value gets the new one. A missing/plain attribute is replaced.
  void hint;
  const value = expr
    ? `{(${expr}) === ${JSON.stringify(oldValue)} ? ${JSON.stringify(newValue)} : (${expr})}`
    : `{${JSON.stringify(newValue)}}`;
  if (attr) return { start: attr.start, end: attr.end, text: `${name}=${value}`, summary };
  const at = attrInsertPoint(el);
  return { start: at, end: at, text: ` ${name}=${value}`, summary };
}

/**
 * Background photo computed by code: set backgroundImage inline on the
 * clicked element (inline style wins over classes). For list copies the
 * override applies only where the element's style/className holds the old URL.
 */
function rewriteBackground(code: string, tokens: Tok[], el: JsxElementRange | null, oldUrl: string, newUrl: string, hint: InstanceHint): Splice {
  if (!el) throw new VisualEditError('This background could not be located in the code. Ask the AI instead.');
  const bg = `{ backgroundImage: ${JSON.stringify(`url("${newUrl}")`)} }`;
  const styleAttr = el.open.attrs.find(a => a.name === 'style');
  const styleExpr = attrExpr(code, tokens, el, 'style');
  const sources = [styleExpr, attrExpr(code, tokens, el, 'className')].filter((x): x is string => !!x);
  // Computed style/className may differ per copy: override only the copy that showed the old photo.
  void hint;
  const cond = sources.length
    ? `[${sources.map(x => `(${x})`).join(', ')}].some(v => JSON.stringify(v ?? '').includes(${JSON.stringify(oldUrl)}))`
    : null;
  const summary = 'Background image replaced';
  if (styleAttr && styleExpr) {
    const text = cond
      ? `style={{ ...(${styleExpr}), ...(${cond} ? ${bg} : {}) }}`
      : `style={{ ...(${styleExpr}), ...${bg} }}`;
    return { start: styleAttr.start, end: styleAttr.end, text, summary };
  }
  const at = attrInsertPoint(el);
  return { start: at, end: at, text: cond ? ` style={${cond} ? ${bg} : undefined}` : ` style={${bg}}`, summary };
}

/** Replace a URL that appears inside a literal (a CSS url() value or a Tailwind arbitrary background class). */
/** Returns null when no literal contains the URL (it's computed by code). */
function resolveUrlInside(code: string, tokens: Tok[], el: JsxElementRange | null, oldUrl: string, newUrl: string, summary: string, hint: InstanceHint): Splice[] | null {
  if (!oldUrl) return null;
  const containing = textTokens(code, tokens).filter(t => code.slice(t.start, t.end).includes(oldUrl));
  if (containing.length === 0) return null;
  const swap = (tok: TextTok): Splice[] => {
    const raw = code.slice(tok.start, tok.end);
    return [{ start: tok.start, end: tok.end, text: raw.split(oldUrl).join(newUrl), summary }];
  };
  // The literal written on the clicked element itself (style / className / src).
  const own = el ? containing.filter(t => within(t, el.open.start, el.open.end)) : [];
  if (own.length) return swap(own[own.length - 1]);
  // Data literal that provably feeds this element; never another element's tag.
  const tags = openingTagRanges(code, tokens);
  const data = pickDataLiteral(containing.filter(t => !onOtherElement(t, tags, el)), hint);
  return data ? swap(data) : null;
}

function resolveEdit(code: string, tokens: Tok[], edit: VisualEdit): Splice[] {
  const el = elementAt(code, tokens, edit.loc);
  if (edit.kind === 'text') {
    const one = resolveText(code, tokens, el, edit);
    return one ? [one] : [];
  }
  if (edit.kind === 'attr') return resolveAttr(code, tokens, el, edit);
  if (edit.newUrl === edit.oldUrl) return [];
  return resolveUrlInside(code, tokens, el, edit.oldUrl, edit.newUrl, 'Background image replaced', edit)
    ?? [rewriteBackground(code, tokens, el, edit.oldUrl, edit.newUrl, edit)];
}

/**
 * How offsets moved: every position >= `at` (in the old code) shifts by `delta`.
 * Lets the live preview keep its element positions in sync without reloading.
 */
export interface OffsetShift {
  at: number;
  delta: number;
}

/** Apply one or several edits atomically (all resolved against the same code). */
export function applyVisualEdits(code: string, edits: VisualEdit[]): { code: string; summary: string; shifts: OffsetShift[] } {
  let tokens: Tok[];
  try {
    tokens = tokenize(code);
  } catch {
    throw new VisualEditError('This version has a syntax error; fix it with the AI before editing visually.');
  }

  const splices = edits
    .flatMap(e => resolveEdit(code, tokens, e))
    .sort((a, b) => b.start - a.start);
  if (splices.length === 0) return { code, summary: '', shifts: [] };

  for (let i = 1; i < splices.length; i++) {
    if (splices[i].end > splices[i - 1].start) {
      throw new VisualEditError('Two changes hit the same piece of text. Edit them one at a time.');
    }
  }

  let out = code;
  for (const s of splices) out = out.slice(0, s.start) + s.text + out.slice(s.end);

  const err = syntaxError(out);
  if (err) throw new VisualEditError(`This edit would break the page (${err}). Ask the AI instead.`);
  const ordered = splices.reverse();
  return {
    code: out,
    summary: ordered.map(sp => sp.summary).join(' · '),
    shifts: ordered.map(s => ({ at: s.end, delta: s.text.length - (s.end - s.start) })).filter(x => x.delta !== 0),
  };
}

export function applyVisualEdit(code: string, edit: VisualEdit): { code: string; summary: string; shifts: OffsetShift[] } {
  return applyVisualEdits(code, [edit]);
}
