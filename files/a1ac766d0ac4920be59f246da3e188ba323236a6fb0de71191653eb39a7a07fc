/** Embedded campaign map: one marker per lead, the selected lead highlighted and followed. */
export default function CampaignMap({ leads, selectedId, onSelect, dark }: Props) {
  const containerRef = useRef<HTMLDivElement>(null);
  const mapRef = useRef<any>(null);
  const tilesRef = useRef<any>(null);
  const markersRef = useRef<Map<string, any>>(new Map());
  const onSelectRef = useRef(onSelect);
  const fittedKeyRef = useRef('');
  const placed = leads.filter(l => typeof l.lat === 'number' && typeof l.lng === 'number');
  const placedKey = placed.map(l => `${l.id}:${l.tone}:${l.name}:${l.rating ?? ''}`).join('|');

  useEffect(() => { onSelectRef.current = onSelect; });

  // Create the map once.
  useEffect(() => {
    let cancelled = false;
    let ro: ResizeObserver | null = null;
    const markers = markersRef.current;
    loadLeaflet().then(L => {
      if (cancelled || !containerRef.current || mapRef.current) return;
      const map = L.map(containerRef.current, {
        zoomControl: false,
        attributionControl: true,
        minZoom: 3,
        maxZoom: 19,
        worldCopyJump: true,
        maxBounds: [[-90, -540], [90, 540]],
        maxBoundsViscosity: 1.0,
      }).setView([20, 0], 3);
      L.control.zoom({ position: 'bottomleft' }).addTo(map);
      map.attributionControl.setPrefix('');
      mapRef.current = map;
      ro = new ResizeObserver(() => map.invalidateSize());
      ro.observe(containerRef.current);
      // Trigger the dependent effects now that the map exists.
      fittedKeyRef.current = '';
      setTiles(L, dark);
      syncMarkers(L);
    }).catch(() => { /* map unavailable offline — the list still works */ });
    return () => {
      cancelled = true;
      ro?.disconnect();
      if (mapRef.current) {
        try { mapRef.current.remove(); } catch { /* already removed */ }
        mapRef.current = null;
        markers.clear();
      }
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  function setTiles(L: any, isDark: boolean) {
    const map = mapRef.current;
    if (!map) return;
    if (tilesRef.current) map.removeLayer(tilesRef.current);
    void isDark; // same tiles in both themes; the dark look comes from CSS
    tilesRef.current = L.tileLayer(TILE_URL, {
      maxZoom: 19,
      attribution: ATTRIBUTION,
    }).addTo(map);
  }

  function syncMarkers(L: any) {
    const map = mapRef.current;
    if (!map) return;
    const store = markersRef.current;
    const keep = new Set(placed.map(l => l.id));
    for (const [id, m] of store) {
      if (!keep.has(id)) { map.removeLayer(m); store.delete(id); }
    }
    for (const lead of placed) {
      const sel = lead.id === selectedId;
      const icon = L.divIcon({
        className: '',
        html: markerHtml(lead, sel),
        iconSize: sel ? [40, 40] : [18, 18],
        iconAnchor: sel ? [20, 20] : [9, 9],
      });
      const existing = store.get(lead.id);
      if (existing) {
        existing.setIcon(icon);
        existing.setZIndexOffset(sel ? 1000 : 0);
      } else {
        const m = L.marker([lead.lat, lead.lng], { icon, zIndexOffset: sel ? 1000 : 0, keyboard: false })
          .addTo(map)
          .on('click', () => onSelectRef.current(lead.id));
        store.set(lead.id, m);
      }
    }
    // Frame all leads when the set of placed leads changes (not on selection).
    const idsKey = placed.map(l => l.id).join('|');
    if (idsKey && idsKey !== fittedKeyRef.current) {
      fittedKeyRef.current = idsKey;
      const pts = placed.map(l => [l.lat, l.lng]);
      if (pts.length === 1) map.setView(pts[0], 15);
      else map.fitBounds(L.latLngBounds(pts).pad(0.15), { animate: false, maxZoom: 16 });
    }
  }

  useEffect(() => {
    const L = (window as any).L;
    if (L && mapRef.current) setTiles(L, dark);
  }, [dark]);

  useEffect(() => {
    const L = (window as any).L;
    if (L && mapRef.current) syncMarkers(L);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [placedKey, selectedId]);

  // Follow the selected lead.
  useEffect(() => {
    const map = mapRef.current;
    const lead = placed.find(l => l.id === selectedId);
    if (!map || !lead) return;
    map.flyTo([lead.lat, lead.lng], Math.max(map.getZoom(), 15), { duration: 0.6 });
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedId]);

  return (
    <div className="relative w-full h-full isolate z-0">
      <style>{MAP_CSS}</style>
      <div ref={containerRef} className="lm-map absolute inset-0" />
    </div>
  );
}
/* eslint-enable @typescript-eslint/no-explicit-any */
