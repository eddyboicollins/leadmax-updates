'use client';

import { createContext, useContext, useEffect, useState } from 'react';
import Navbar from './Navbar';
import Sidebar from './Sidebar';
import { useLocalStoragePref } from '@/lib/useLocalStoragePref';

interface NavbarState {
  title: string;
  subtitle?: string;
  badge?: { label: string; color: 'emerald' | 'amber' } | null;
  rightActions?: React.ReactNode;
}

const ShellContext = createContext<(state: NavbarState) => void>(() => {});

export function SetNavbar(props: NavbarState) {
  const setNavbar = useContext(ShellContext);
  const { title, subtitle, badge, rightActions } = props;
  useEffect(() => {
    setNavbar({ title, subtitle, badge, rightActions });
  }, [title, subtitle, badge, rightActions]);
  return null;
}

export default function AppShell({ children }: { children: React.ReactNode }) {
  const [navbar, setNavbar] = useState<NavbarState>({ title: '' });
  // md+: full sidebar or icon rail (remembered). Below md: overlay drawer.
  const [expanded, setExpanded] = useLocalStoragePref('lm_sidebar');
  const [mobileOpen, setMobileOpen] = useState(false);

  useEffect(() => {
    document.body.classList.toggle('lm-sidebar-open', expanded);
    document.body.classList.toggle('lm-sidebar-rail', !expanded);
  }, [expanded]);

  return (
    <ShellContext.Provider value={setNavbar}>
      <Sidebar
        expanded={expanded}
        onToggleExpanded={() => setExpanded(!expanded)}
        mobileOpen={mobileOpen}
        onCloseMobile={() => setMobileOpen(false)}
      />
      <div className="min-h-screen flex flex-col bg-white dark:bg-zinc-950">
        <Navbar
          title={navbar.title}
          subtitle={navbar.subtitle}
          badge={navbar.badge}
          rightActions={navbar.rightActions}
          onOpenMenu={() => setMobileOpen(true)}
        />
        <div className="flex-1 flex flex-col min-h-0">{children}</div>
      </div>
    </ShellContext.Provider>
  );
}
