interface ModifyStudioProps {
  campaignId: string;
  leadId: string;
  businessName: string;
  mainUrl: string;
  /** Vercel deployments (which versions are online). */
  deployments: StudioHistoryEntry[];
  images: StudioImage[];
  uploading: boolean;
  /** Running AI job (generate / modify) for this lead. */
  liveJob: StudioLiveJob | null;
  /** Running publish / unpublish job for this lead. */
  publishJob: StudioLiveJob | null;
  /** Version produced by the most recent finished job (auto-selected). */
  lastJobVersionId?: string | null;
  error?: string | null;
  onDismissError?: () => void;
  /** The request whose AI job failed: kept in the chat so it is never lost. */
  failedRequest?: { prompt: string; display: string; notes: StudioNote[]; cancelled?: boolean } | null;
  /** Run the failed action again, as-is. False when it couldn't start. */
  onRetry?: () => boolean | void;
  /** Stop the running AI job (generate / modify): nothing is saved, the request can be retried or edited. */
  onCancelJob?: () => void;
  /** Returns false when the job could not start (e.g. another AI job is running). */
  onSend: (prompt: string, baseVersionId: string | null, notes?: StudioNote[]) => boolean | void;
  onPublish: (versionId: string) => void;
  /** Resolves with the hosted URLs of the photos that uploaded successfully. */
  onUploadImages: (files: File[]) => void | Promise<string[] | void>;
  onDeleteImage: (imageId: string) => void;
  onSetMain: (entryId: string) => void;
  onClose: () => void;
}

