'use client';

import { useEffect, useMemo, useRef, useState } from 'react';
import { useTranslation } from 'react-i18next';
import { useLocalStorageNumberPref } from '@/lib/useLocalStoragePref';
import SafeImg from '@/components/SafeImg';

const DEFAULT_CHAT_W = 400;
const MIN_CHAT_W = 280;
const MIN_PREVIEW_W = 320;

const DEVICE_W: Record<'tablet' | 'phone', number> = { tablet: 768, phone: 390 };

export interface StudioHistoryEntry {
  id: string;
  url: string;
  aliasUrl: string;
  deployedAt: string;
  userPrompt?: string;
  isMain: boolean;
  comingSoon?: boolean;
}

export interface StudioLiveJob {
  message: string;
  phase: string;
  userPrompt?: string;
}

export interface StudioImage {
  id: string;
  url: string;
  alt: string;
}

interface ModifyStudioProps {
  businessName: string;
  mainUrl: string;
  history: StudioHistoryEntry[];
  images: StudioImage[];
  uploading: boolean;
  liveJob: StudioLiveJob | null;
  onSend: (prompt: string) => void;
  onUploadImages: (files: File[]) => void;
  onDeleteImage: (imageId: string) => void;
  onSetMain: (entryId: string) => void;
  onClose: () => void;
}

interface ChatMsg {
  key: string;
  role: 'user' | 'assistant';
  text: string;
  entryId?: string;
  time?: string;
}

function fmtDate(iso: string): string {
  try {
    const d = new Date(iso);
    return `${d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })} ${d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}`;
  } catch {
    return '';
  }
}

/** Ambient horizontal code drift (canvas, blurred emerald on black). */
function MatrixRain() {
  const ref = useRef<HTMLCanvasElement | null>(null);

  useEffect(() => {
    const canvas = ref.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const SNIPPETS = [
      'const site = await build()', 'export default function Page()', 'return (',
      '<section id="hero">', '</div>', 'useState(null)', 'useEffect(() => {',
      '=>', 'import { useState }', 'await deploy()', 'npm run deploy',
      'git push origin main', 'vercel.app', '200 OK', '✓ deployed',
      '{...props}', '.map((s) => (', 'tailwind', 'backdrop-blur-md',
      'rounded-2xl', 'font-semibold', 'async function fix()', 'try {',
      '} catch (e) {', '`', '&&', '||', '===', '?.', '/* section */',
      '<img src=', 'className="', 'fetch(url)', 'JSON.stringify(',
    ];
    const FONT = 13;
    const ROW_H = 26;
    let raf = 0;
    let rows = 0;
    let items: { x: number; y: number; speed: number; text: string; alpha: number }[] = [];

    const spawn = (i: number, anywhere = false) => {
      const text = SNIPPETS[Math.floor(Math.random() * SNIPPETS.length)];
      const w = ctx.measureText(text).width;
      items[i] = {
        x: anywhere ? Math.random() * (canvas.width + w) - w : -w - Math.random() * 200,
        y: (i % Math.max(1, rows)) * ROW_H + ROW_H * 0.7,
        speed: 10 + Math.random() * 22, // px per second — slow drift
        text,
        alpha: 0.25 + Math.random() * 0.55,
      };
    };

    const resize = () => {
      const parent = canvas.parentElement;
      if (!parent) return;
      const rect = parent.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(rect.width));
      canvas.height = Math.max(1, Math.floor(rect.height));
      rows = Math.max(1, Math.floor(canvas.height / ROW_H));
      const count = Math.min(rows, 40);
      items = new Array(count);
      for (let i = 0; i < count; i++) spawn(i, true);
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    };
    ctx.font = `${FONT}px ui-monospace, monospace`;
    resize();
    window.addEventListener('resize', resize);

    // Static single frame for reduced-motion users.
    if (typeof window !== 'undefined' && window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
      ctx.fillStyle = '#34d399';
      items.forEach(it => {
        ctx.globalAlpha = it.alpha;
        ctx.fillText(it.text, it.x, it.y);
      });
      ctx.globalAlpha = 1;
      return () => window.removeEventListener('resize', resize);
    }

    let last = performance.now();
    const tick = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.06)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < items.length; i++) {
        const it = items[i];
        it.x += it.speed * dt;
        const w = ctx.measureText(it.text).width;
        if (it.x > canvas.width + 40) {
          spawn(i);
          continue;
        }
        ctx.globalAlpha = it.alpha;
        ctx.fillStyle = '#34d399';
        ctx.fillText(it.text, it.x, it.y);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', resize);
    };
  }, []);

  return <canvas ref={ref} className="absolute inset-0 w-full h-full blur-[1.5px]" aria-hidden="true" />;
}

export default function ModifyStudio({ businessName, mainUrl, history, images, uploading, liveJob, onSend, onUploadImages, onDeleteImage, onSetMain, onClose }: ModifyStudioProps) {
  const { t } = useTranslation();
  const [draft, setDraft] = useState('');
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [refreshNonce, setRefreshNonce] = useState(0);
  const [savedChatW, setSavedChatW] = useLocalStorageNumberPref('lm_studio_chat_w', DEFAULT_CHAT_W);
  const [dragChatW, setDragChatW] = useState<number | null>(null);
  const [dragging, setDragging] = useState(false);
  const threadRef = useRef<HTMLDivElement | null>(null);
  const splitRef = useRef<HTMLDivElement | null>(null);
  const fileRef = useRef<HTMLInputElement | null>(null);
  const inputRef = useRef<HTMLTextAreaElement | null>(null);

  const autoGrowInput = () => {
    const el = inputRef.current;
    if (!el) return;
    el.style.height = '40px';
    el.style.height = Math.min(el.scrollHeight, 128) + 'px';
  };
  const dragState = useRef<{ startX: number; startW: number; rtl: boolean } | null>(null);

  const [device, setDevice] = useState<'desktop' | 'tablet' | 'phone'>('desktop');

  // No upper cap besides keeping a usable preview sliver: chat can grow freely.
  const chatW = Math.max(MIN_CHAT_W, dragChatW ?? savedChatW);

  const clampChatW = (w: number) => {
    const total = splitRef.current?.getBoundingClientRect().width ?? window.innerWidth;
    return Math.min(total - MIN_PREVIEW_W, Math.max(MIN_CHAT_W, w));
  };

  // Live width shown while dragging; committed to localStorage on release.
  const latestDragW = useRef<number>(chatW);

  const onDividerDown = (e: React.PointerEvent<HTMLDivElement>) => {
    e.preventDefault();
    const rtl = typeof document !== 'undefined' && document.documentElement.dir === 'rtl';
    dragState.current = { startX: e.clientX, startW: chatW, rtl };
    latestDragW.current = chatW;
    setDragging(true);
    document.body.style.cursor = 'ew-resize';
    const move = (ev: PointerEvent) => {
      const st = dragState.current;
      if (!st) return;
      // Safety: if the release was missed (e.g. over the iframe), end the drag.
      if (ev.buttons === 0) { up(); return; }
      const dx = ev.clientX - st.startX;
      const next = clampChatW(st.startW + (st.rtl ? -dx : dx));
      latestDragW.current = next;
      setDragChatW(next);
    };
    const up = () => {
      if (!dragState.current) return;
      dragState.current = null;
      setDragging(false);
      setDragChatW(null);
      setSavedChatW(latestDragW.current);
      document.body.style.cursor = '';
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      window.removeEventListener('pointercancel', up);
      window.removeEventListener('blur', up);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
    window.addEventListener('pointercancel', up);
    window.addEventListener('blur', up);
  };

  const ascending = useMemo(
    () => [...history].sort((a, b) => new Date(a.deployedAt).getTime() - new Date(b.deployedAt).getTime()),
    [history],
  );
  const mainId = history.find(e => e.isMain)?.id ?? null;

  // Follow the live version whenever a new deploy becomes main.
  const prevMainId = useRef<string | null>(null);
  useEffect(() => {
    if (prevMainId.current !== null && mainId !== prevMainId.current) setSelectedId(null);
    prevMainId.current = mainId;
  }, [mainId]);

  const selected: StudioHistoryEntry | null =
    (selectedId ? ascending.find(e => e.id === selectedId) ?? null : null)
    ?? ascending.find(e => e.isMain)
    ?? ascending[ascending.length - 1]
    ?? null;

  const messages: ChatMsg[] = useMemo(() => {
    const out: ChatMsg[] = [];
    ascending.forEach((entry, i) => {
      if (entry.userPrompt) {
        out.push({ key: `u-${entry.id}`, role: 'user', text: entry.userPrompt, time: entry.deployedAt });
      } else if (i === 0) {
        out.push({ key: `s-${entry.id}`, role: 'assistant', text: t('campaign.studioInitialVersion'), entryId: entry.id, time: entry.deployedAt });
      }
      if (entry.userPrompt || i !== 0) {
        out.push({ key: `a-${entry.id}`, role: 'assistant', text: fmtDate(entry.deployedAt), entryId: entry.id, time: entry.deployedAt });
      }
    });
    return out;
  }, [ascending, t]);

  // Keep the thread pinned to the latest message.
  useEffect(() => {
    const el = threadRef.current;
    if (el) el.scrollTop = el.scrollHeight;
  }, [messages.length, liveJob?.message, liveJob?.phase]);

  // Escape closes the studio.
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') onClose(); };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
  }, [onClose]);

  const send = () => {
    const prompt = draft.trim();
    if (!prompt) return;
    setDraft('');
    if (inputRef.current) inputRef.current.style.height = '40px';
    onSend(prompt);
  };

  const previewUrl = selected ? selected.url || selected.aliasUrl : '';

  return (
    <div className="fixed inset-0 z-[140] bg-white dark:bg-zinc-900 flex flex-col">
      {/* Fullscreen shield while dragging: keeps pointer events out of the preview
          iframe so the release is never swallowed and the drag reliably ends. */}
      {dragging && <div className="fixed inset-0 z-[200] cursor-ew-resize" />}
      {/* Header */}
      <div className="flex items-center gap-3 px-4 sm:px-5 h-[56px] border-b border-zinc-200 dark:border-zinc-800 shrink-0">
        <div className="min-w-0">
          <h2 className="text-sm font-semibold text-zinc-900 dark:text-white truncate">{businessName}</h2>
          <p className="text-[11px] text-zinc-500 dark:text-zinc-400 truncate">{t('campaign.modifyTitle')}</p>
        </div>
        <button onClick={onClose} className="ms-auto p-1.5 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-all shrink-0" title={t('campaign.done')}>
          <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      {/* Split view */}
      <div
        ref={splitRef}
        style={{ '--chat-w': `${chatW}px` } as React.CSSProperties}
        className={`flex-1 min-h-0 flex flex-col lg:flex-row ${dragging ? 'select-none' : ''}`}
      >
        {/* Chat */}
        <div className="flex flex-col h-[42%] lg:h-full lg:w-[var(--chat-w)] shrink-0 border-b lg:border-b-0 border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/40">
          <div ref={threadRef} className="flex-1 min-h-0 overflow-y-auto px-4 py-4 space-y-3">
            {messages.length === 0 && !liveJob && (
              <div className="rounded-xl bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-3.5 py-3 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                {t('campaign.modifyDesc')}
              </div>
            )}
            {messages.map(m => {
              const isSelected = m.entryId != null && selected?.id === m.entryId;
              const entry = m.entryId ? ascending.find(e => e.id === m.entryId) : null;
              if (m.role === 'user') {
                return (
                  <div key={m.key} className="flex justify-end">
                    <div className="max-w-[85%] rounded-2xl rounded-br-md bg-emerald-600 text-white px-3.5 py-2.5 text-[13px] leading-relaxed shadow-sm">
                      {m.text}
                    </div>
                  </div>
                );
              }
              return (
                <div key={m.key} className="flex justify-start">
                  <button
                    type="button"
                    disabled={!m.entryId}
                    onClick={() => { if (m.entryId) setSelectedId(m.entryId); }}
                    className={`max-w-[85%] text-start rounded-2xl rounded-bl-md px-3.5 py-2.5 text-[13px] leading-relaxed border transition-all ${isSelected ? 'bg-emerald-500/10 dark:bg-emerald-500/10 border-emerald-500/50 text-zinc-800 dark:text-zinc-100' : 'bg-white dark:bg-zinc-800 border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:border-emerald-500/40'}`}
                  >
                    <span className="flex items-center gap-2">
                      <span>{m.text}</span>
                      {entry?.isMain && (
                        <span className="px-1.5 py-0.5 text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded shrink-0">{t('campaign.live')}</span>
                      )}
                    </span>
                  </button>
                </div>
              );
            })}
            {liveJob?.userPrompt && (
              <div className="flex justify-end">
                <div className="max-w-[85%] rounded-2xl rounded-br-md bg-emerald-600 text-white px-3.5 py-2.5 text-[13px] leading-relaxed shadow-sm">
                  {liveJob.userPrompt}
                </div>
              </div>
            )}
            {liveJob && (
              <div className="flex justify-start">
                <div className="max-w-[85%] rounded-2xl rounded-bl-md bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-3.5 py-2.5 text-[13px] text-zinc-600 dark:text-zinc-300">
                  <span className="flex items-center gap-2">
                    <span className="animate-spin w-3.5 h-3.5 rounded-full border-2 border-emerald-400 border-t-transparent shrink-0" />
                    <span className="truncate">{liveJob.message || t('campaign.aiModifying')}</span>
                  </span>
                </div>
              </div>
            )}
          </div>
          <div className="shrink-0 p-3 border-t border-zinc-200 dark:border-zinc-800">
            <div className="flex items-center gap-1.5 mb-2 flex-wrap max-h-24 overflow-y-auto p-0.5">
                {images.map(img => (
                  <div key={img.id} className="relative group/img shrink-0 [content-visibility:auto] [contain-intrinsic-size:32px]">
                    <SafeImg
                      src={img.url}
                      alt={img.alt}
                      title={img.alt}
                      className="block w-8 h-8 rounded-md border border-zinc-200 dark:border-zinc-700 overflow-hidden"
                      imgClassName="w-8 h-8 rounded-md object-cover"
                      fallback={
                        <span className="w-8 h-8 rounded-md bg-zinc-200 dark:bg-zinc-700 text-zinc-400 dark:text-zinc-500 flex items-center justify-center">
                          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        </span>
                      }
                    />
                    <button
                      onClick={() => onDeleteImage(img.id)}
                      title="Remove image"
                      className="absolute top-0 right-0 w-4 h-4 bg-red-600/90 text-white rounded-full text-[8px] leading-none opacity-0 group-hover/img:opacity-100 transition-opacity hover:bg-red-500 flex items-center justify-center"
                    >
                      ✕
                    </button>
                  </div>
                ))}
                {(10 - images.length) > 0 && (
                  <>
                    <input
                      ref={fileRef}
                      type="file"
                      accept="image/*"
                      multiple
                      className="hidden"
                      onChange={e => { const files = Array.from(e.target.files || []); e.target.value = ''; if (files.length > 0) onUploadImages(files); }}
                    />
                    <button
                      onClick={() => fileRef.current?.click()}
                      disabled={uploading}
                      title={t('campaign.studioAttachImage')}
                      className="w-8 h-8 rounded-md border-2 border-dashed border-zinc-300 dark:border-zinc-700 text-zinc-400 dark:text-zinc-500 hover:border-emerald-500/60 hover:text-emerald-500 flex items-center justify-center transition-all shrink-0 disabled:opacity-50 disabled:cursor-wait"
                    >
                      {uploading ? (
                        <span className="animate-spin w-4 h-4 rounded-full border-2 border-emerald-400 border-t-transparent" />
                      ) : (
                        <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2} strokeLinecap="round" strokeLinejoin="round"><path d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20 10" /></svg>
                      )}
                    </button>
                  </>
                )}
              </div>
            <div className="flex items-end gap-2">
              <textarea
                ref={inputRef}
                value={draft}
                onChange={e => { setDraft(e.target.value); autoGrowInput(); }}
                onKeyDown={e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); } }}
                placeholder={t('campaign.modifyPlaceholder')}
                rows={1}
                className="flex-1 min-w-0 h-10 max-h-32 overflow-y-auto bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-zinc-900 dark:text-white text-[13px] px-2.5 py-2 resize-none focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all placeholder-zinc-400 dark:placeholder-zinc-500"
              />
              <button onClick={send} disabled={!draft.trim()} className="shrink-0 w-10 h-10 flex items-center justify-center bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-xl hover:from-emerald-400 hover:to-teal-500 transition-all shadow-sm shadow-emerald-500/20 disabled:opacity-40 disabled:cursor-not-allowed" title={t('campaign.studioSend')}>
                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </div>
          </div>
        </div>

        {/* Draggable splitter (desktop only) */}
        <div
          role="separator"
          aria-orientation="vertical"
          onPointerDown={onDividerDown}
          onDoubleClick={() => setSavedChatW(DEFAULT_CHAT_W)}
          title="Drag to resize · double-click to reset"
          className={`hidden lg:flex w-2 -mx-1 shrink-0 cursor-ew-resize items-center justify-center z-10 transition-colors group/split ${dragging ? 'bg-emerald-500/40' : 'hover:bg-emerald-500/25 bg-transparent'}`}
        >
          <div className={`w-1 h-10 rounded-full transition-colors ${dragging ? 'bg-emerald-500' : 'bg-zinc-300 dark:bg-zinc-700 group-hover/split:bg-emerald-500'}`} />
        </div>

        {/* Preview */}
        <div className="flex-1 min-h-0 min-w-0 flex flex-col bg-zinc-100 dark:bg-black/40 border-t lg:border-t-0 lg:border-s border-zinc-200 dark:border-zinc-800">
          <div className="flex items-center gap-2 px-3 sm:px-4 py-2 border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shrink-0 flex-wrap">
            <span className="text-[11px] font-medium text-zinc-500 dark:text-zinc-400 shrink-0">{t('campaign.studioPreview')}</span>
            {ascending.length > 0 && (
              <select
                value={selected?.id ?? ''}
                onChange={e => setSelectedId(e.target.value)}
                className="min-w-0 max-w-[220px] text-xs bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-lg px-2 py-1.5 text-zinc-700 dark:text-zinc-200 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 truncate"
              >
                {[...ascending].reverse().map((e, ri) => {
                  const v = ascending.length - ri;
                  return (
                    <option key={e.id} value={e.id}>
                      v{v} · {fmtDate(e.deployedAt)}{e.isMain ? ` · ${t('campaign.live')}` : ''}
                    </option>
                  );
                })}
              </select>
            )}
            {selected && !selected.isMain && (
              <button onClick={() => onSetMain(selected.id)} className="px-2.5 py-1.5 text-[11px] font-medium bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 transition-all shrink-0 whitespace-nowrap">
                {t('campaign.setDefault')}
              </button>
            )}
            {selected?.isMain && (
              <span className="px-2 py-1 text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded shrink-0 whitespace-nowrap">{t('campaign.isMain')}</span>
            )}
            <div className="ms-auto flex items-center gap-1 shrink-0">
              {!liveJob && (
                <div className="flex items-center gap-0.5 me-1 p-0.5 bg-zinc-100 dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700">
                  {([
                    { key: 'desktop', title: t('campaign.studioViewDesktop'), icon: <><rect x="2" y="3" width="20" height="13" rx="2" /><path d="M8 21h8M12 16v5" /></> },
                    { key: 'tablet', title: t('campaign.studioViewTablet'), icon: <><rect x="4" y="2" width="16" height="20" rx="2" /><path d="M12 18h.01" /></> },
                    { key: 'phone', title: t('campaign.studioViewPhone'), icon: <><rect x="7" y="2" width="10" height="20" rx="2" /><path d="M12 18h.01" /></> },
                  ] as const).map(d => (
                    <button
                      key={d.key}
                      onClick={() => setDevice(d.key)}
                      title={d.title}
                      className={`p-1.5 rounded-md transition-all ${device === d.key ? 'bg-white dark:bg-zinc-700 text-emerald-600 dark:text-emerald-400 shadow-sm' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white'}`}
                    >
                      <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2} strokeLinecap="round" strokeLinejoin="round">{d.icon}</svg>
                    </button>
                  ))}
                </div>
              )}
              <button onClick={() => setRefreshNonce(n => n + 1)} disabled={!selected} className="p-1.5 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-all disabled:opacity-40" title="Refresh">
                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
              </button>
              {previewUrl && (
                <a href={previewUrl} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 px-2.5 py-1.5 text-[11px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-all whitespace-nowrap">
                  <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  {t('campaign.studioOpenVersion')}
                </a>
              )}
              <a href={mainUrl} target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1 px-2.5 py-1.5 text-[11px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-all whitespace-nowrap">
                <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                {t('campaign.studioOpenSite')}
              </a>
            </div>
          </div>
          <div className="flex-1 min-h-0 relative">
            {liveJob ? (
              <div className="absolute inset-0 bg-black overflow-hidden">
                <MatrixRain />
                <div className="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center bg-black/55">
                  <svg className="animate-spin w-12 h-12 text-emerald-400" viewBox="0 0 24 24" fill="none">
                    <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" />
                    <path className="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                  </svg>
                  <p className="text-sm font-medium text-zinc-100 flex items-center gap-1 max-w-full">
                    <span className="truncate">{liveJob.message || t('campaign.studioWorking')}</span>
                    <span className="status-dots shrink-0" aria-hidden="true">
                      <span>.</span><span>.</span><span>.</span>
                    </span>
                  </p>
                </div>
              </div>
            ) : selected && previewUrl ? (
              device === 'desktop' ? (
                <iframe key={`desktop-${selected.id}-${refreshNonce}`} src={previewUrl} title={businessName} className="absolute inset-0 w-full h-full bg-white" />
              ) : (
                <div className="absolute inset-0 flex items-stretch justify-center p-3 sm:p-4 overflow-hidden">
                  <div
                    style={{ width: DEVICE_W[device] }}
                    className="h-full w-full max-w-full rounded-xl overflow-hidden border border-zinc-300 dark:border-zinc-700 shadow-2xl bg-white"
                  >
                    <iframe key={`${device}-${selected.id}-${refreshNonce}`} src={previewUrl} title={businessName} className="w-full h-full bg-white" />
                  </div>
                </div>
              )
            ) : (
              <div className="absolute inset-0 flex items-center justify-center p-8 text-center">
                <p className="text-sm text-zinc-400 dark:text-zinc-500 max-w-sm">{t('campaign.studioNoPreview')}</p>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  );
}
