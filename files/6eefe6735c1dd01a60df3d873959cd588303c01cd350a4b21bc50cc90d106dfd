import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import sharp from 'sharp';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const projectRoot = path.join(__dirname, '..');
const src = path.join(projectRoot, 'public', 'leadmax-icon.png');

if (!fs.existsSync(src)) {
  console.error('[generate-ico] public/leadmax-icon.png missing');
  process.exit(1);
}

const sizes = [16, 24, 32, 48, 64, 128, 256];
const bufs = [];
for (const s of sizes) {
  bufs.push({
    size: s,
    buf: await sharp(src)
      .resize(s, s, { fit: 'contain', background: { r: 0, g: 0, b: 0, alpha: 0 } })
      .png()
      .toBuffer(),
  });
}

const header = Buffer.alloc(6);
header.writeUInt16LE(0, 0);
header.writeUInt16LE(1, 2);
header.writeUInt16LE(sizes.length, 4);

const entries = [];
let offset = 6 + 16 * sizes.length;
for (const { size, buf } of bufs) {
  const e = Buffer.alloc(16);
  e[0] = size === 256 ? 0 : size;
  e[1] = size === 256 ? 0 : size;
  e[2] = 0;
  e[3] = 0;
  e.writeUInt16LE(1, 4);
  e.writeUInt16LE(32, 6);
  e.writeUInt32LE(buf.length, 8);
  e.writeUInt32LE(offset, 12);
  entries.push(e);
  offset += buf.length;
}

const ico = Buffer.concat([header, ...entries, ...bufs.map((x) => x.buf)]);
fs.mkdirSync(path.join(projectRoot, 'build'), { recursive: true });
fs.writeFileSync(path.join(projectRoot, 'build', 'icon.ico'), ico);
console.log(`[generate-ico] wrote build/icon.ico (${ico.length} bytes, ${sizes.length} sizes)`);
