import { NextRequest, NextResponse } from 'next/server';
import { getCampaign, getLead, updateLeadLandingPage, getSettings } from '@/lib/store';
import { buildPromptData, renderPrompt, DEFAULT_SYSTEM_PROMPT, askGeminiAndValidate } from '@/lib/prompts';
import { DEFAULT_GEMINI_MODEL, normalizeAiSource, type GeminiModel } from '@/lib/gemini';
import { commitVersion } from '@/lib/site/versions';

export const maxDuration = 300;

const DEFAULT_SECTIONS = [
  { id: 'navbar', type: 'navbar', sortOrder: 0, content: {}, styles: {} },
  { id: 'hero', type: 'hero', sortOrder: 1, content: {}, styles: {} },
  { id: 'services', type: 'services', sortOrder: 2, content: {}, styles: {} },
  { id: 'testimonials', type: 'testimonials', sortOrder: 3, content: {}, styles: {} },
  { id: 'faq', type: 'faq', sortOrder: 4, content: {}, styles: {} },
  { id: 'contact', type: 'contact', sortOrder: 5, content: {}, styles: {} },
  { id: 'map', type: 'map', sortOrder: 6, content: {}, styles: {} },
  { id: 'footer', type: 'footer', sortOrder: 7, content: {}, styles: {} },
];

export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  const { id, leadId } = await params;

  const campaign = await getCampaign(id);
  if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

  const lead = await getLead(leadId);
  if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

  const body = await request.json().catch(() => ({}));
  const extraInstructions = body.extraInstructions || '';

  const settings = await getSettings();
  const apiKey = settings.geminiApiKey || '';
  const model = (settings.geminiModel as GeminiModel) || DEFAULT_GEMINI_MODEL;
  const aiSource = normalizeAiSource(settings.aiSource);

  const encoder = new TextEncoder();
  const stream = new ReadableStream({
    async start(controller) {
      const send = (event: Record<string, unknown>) => {
        try { controller.enqueue(encoder.encode(`data: ${JSON.stringify(event)}\n\n`)); } catch { /* client disconnected */ }
      };
      try {
        send({ step: 'generating', message: 'Generating your website...' });

        const data = buildPromptData(lead);
        const template = DEFAULT_SYSTEM_PROMPT;
        const persistent = (settings.generationInstructions || '').trim();
        // "Regenerate" = the lead already has a site. Unlike modify (which feeds
        // the previous code back), regeneration must NOT be influenced by any
        // prior version — force a totally new design.
        const isRegeneration = !!(lead.landingPage || lead.deploymentHistory?.length);
        const combined = [
          isRegeneration
            ? 'REGENERATION MODE: create a COMPLETELY NEW and DIFFERENT website — new layout, new color palette, new typography, new section arrangement. Do NOT reuse or imitate any previous design.'
            : '',
          extraInstructions,
          persistent,
        ].filter(Boolean).join('\n\n');
        const finalTemplate = combined
          ? `EXTRA INSTRUCTIONS FROM USER (these take priority over everything):\n${combined}\n\n${template}`
          : template;
        const prompt = renderPrompt(finalTemplate, data);
        
        const cleanTsx = await askGeminiAndValidate(prompt, apiKey, model, (chunk) => send({ step: 'generating_chunk', chunk }), aiSource, (ev) => send({ step: 'proxy_status', ...ev }));

        if (!lead.landingPage) {
          await updateLeadLandingPage(leadId, {
            tsx: cleanTsx,
            generatedAt: new Date().toISOString(),
            version: 1,
            sections: DEFAULT_SECTIONS,
          });
        }
        // Saved as a new local version (previewed in the studio). Nothing is
        // published until the user explicitly puts a version online.
        const { version, status } = await commitVersion(lead, {
          tsx: cleanTsx,
          source: 'generate',
          parentId: null,
          prompt: extraInstructions || undefined,
        });

        send({ step: 'complete', success: true, versionId: version.id, version: version.n, status });
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : 'Failed to generate landing page';
        send({ step: 'error', error: message });
      } finally {
        try { controller.close(); } catch { /* client disconnected */ }
      }
    },
  });

  return new Response(stream, {
    headers: {
      'Content-Type': 'text/event-stream; charset=utf-8',
      'Cache-Control': 'no-cache, no-transform',
      Connection: 'keep-alive',
    },
  });
}

export async function GET(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;
    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    if (!lead.landingPage) {
      return NextResponse.json({ error: 'No landing page generated yet' }, { status: 404 });
    }

    return NextResponse.json(lead.landingPage);
  } catch (err: unknown) {
    const message = err instanceof Error ? err.message : 'Request failed';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}

export async function PUT(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;
    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    const body = await request.json();
    const existingLp = lead.landingPage;
    const tx = body.tsx || existingLp?.tsx;

    const landingPage = {
      tsx: tx,
      generatedAt: existingLp?.generatedAt || new Date().toISOString(),
      version: (existingLp?.version || 0) + 1,
      sections: body.sections || existingLp?.sections || [],
    };

    await updateLeadLandingPage(leadId, landingPage);

    return NextResponse.json({ success: true, version: landingPage.version });
  } catch (err: unknown) {
    const message = err instanceof Error ? err.message : 'Request failed';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
