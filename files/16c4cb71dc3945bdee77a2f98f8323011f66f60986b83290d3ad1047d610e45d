import type { Lead } from './types';

/** Highest star rating first, then highest review count. */
export function sortLeadsByRating(leads: Lead[]): Lead[] {
  return [...leads].sort((a, b) => {
    const ratingDiff = (b.business.rating || 0) - (a.business.rating || 0);
    if (ratingDiff !== 0) return ratingDiff;
    return (b.business.ratingCount || 0) - (a.business.ratingCount || 0);
  });
}
