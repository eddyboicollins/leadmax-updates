// ── Lead helpers ───────────────────────────────────────────────────────────

export const liveLeads = (c: any): any[] => (c.leads || []).filter((l: any) => !l.deleted);

/** Best photo for a lead: a discovered photo (not session-gated Google), then an upload. */
export function leadPhoto(l: any): string | undefined {
  const discovered = (l?.business?.scrapedImages || []).find((s: any) => s?.url && !/googleusercontent|\.google\.com/.test(s.url))?.url;
  if (discovered) return discovered;
  return (l?.images || []).find((i: any) => !i.deleted)?.url;
}

export const hasAiSite = (l: any) => !!(l.landingPage || l.deployment);
/** No website of its own and no AI site yet: a ready opportunity. */
export const isOpportunity = (l: any) => !hasAiSite(l) && !hasOwnWebsite(l.business?.name || '', l.business?.website);

// Greys for leads not moving, a darker → brighter green as a deal progresses.
export const PIPELINE = [
  { status: 'pending', key: 'campaign.pending', color: 'bg-zinc-300 dark:bg-zinc-700', dot: 'bg-zinc-300 dark:bg-zinc-600' },
  { status: 'contacted', key: 'campaign.contacted', color: 'bg-emerald-200 dark:bg-emerald-900', dot: 'bg-emerald-200 dark:bg-emerald-800' },
  { status: 'negotiating', key: 'campaign.negotiating', color: 'bg-emerald-400 dark:bg-emerald-700', dot: 'bg-emerald-400 dark:bg-emerald-600' },
  { status: 'sold', key: 'campaign.sold', color: 'bg-emerald-600 dark:bg-emerald-400', dot: 'bg-emerald-600 dark:bg-emerald-400' },
  { status: 'not_interested', key: 'campaign.notInterested', color: 'bg-zinc-500 dark:bg-zinc-500', dot: 'bg-zinc-500' },
] as const;

export function pipelineCounts(leads: any[]): Record<string, number> {
  const out: Record<string, number> = {};
  for (const l of leads) out[l.status || 'pending'] = (out[l.status || 'pending'] || 0) + 1;
  return out;
}

const fmtDate = (iso: string, lang: string) =>
  new Date(iso).toLocaleDateString(lang?.startsWith('ar') ? 'ar' : lang?.startsWith('fr') ? 'fr-FR' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' });

function Svg({ d, className = 'w-4 h-4' }: { d: string; className?: string }) {
  return <svg className={className} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d={d} /></svg>;
}
