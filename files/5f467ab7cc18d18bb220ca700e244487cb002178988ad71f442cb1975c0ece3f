    : invoiceCopyEn;
}

function telHref(phone: string): string {
  return `tel:${String(phone || '').replace(
    /[^\d+]/g,
    '',
  )}`;
}

function mapsHref(address: string): string {
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
    String(address || '').trim(),
  )}`;
}

function siteHref(url: string): string {
  const value = String(url || '').trim();

  if (!value) return '';

  return /^https?:\/\//i.test(value)
    ? value
    : `https://${value}`;
}

function mailtoHref(email: string): string {
  const value = String(email || '').trim();

  if (!value) return '';

  return `mailto:${value}`;
}

function linkLine(
  text: string,
  href: string,
): string {
  if (!href) {
    return `<div>${escapeHtml(text)}</div>`;
  }

  return `
    <div>
      <a
        href="${escapeHtml(href)}"
        target="_blank"
        rel="noopener"
      >
        ${escapeHtml(text)}
      </a>
    </div>
  `;
}

function sellerHtml(
  settings: InvoiceSettings,
): string {
  const parts: string[] = [];

  const isCompany =
    settings.identityKind === 'company';

  const website = siteHref(settings.website);

  if (
    isCompany &&
    settings.companyName.trim()
  ) {
    parts.push(
      `<div class="seller-name">${escapeHtml(
        settings.companyName.trim(),
      )}</div>`,
    );

    if (
      settings.legalName.trim() &&
      settings.legalName.trim() !==
        settings.companyName.trim()
    ) {
      parts.push(
        `<div>${escapeHtml(
          settings.legalName.trim(),
        )}</div>`,
      );
    }
  } else if (settings.legalName.trim()) {
    parts.push(
      `<div class="seller-name">${escapeHtml(
        settings.legalName.trim(),
      )}</div>`,
    );
  }

  if (website) {
    parts.push(
      linkLine(
        settings.website.trim(),
        website,
      ),
    );
  }

  if (settings.address.trim()) {
    parts.push(
      linkLine(
        settings.address.trim(),
        mapsHref(settings.address),
      ),
    );
  }

  if (settings.phone.trim()) {
    parts.push(
      linkLine(
        settings.phone.trim(),
        telHref(settings.phone),
      ),
    );
  }

  if (settings.contactEmail.trim()) {
    parts.push(
      linkLine(
        settings.contactEmail.trim(),
        mailtoHref(settings.contactEmail),
      ),
    );
  }

  return parts.join('');
}

