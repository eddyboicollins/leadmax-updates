/**
 * A normal, visible browser window for account logins (DeepSeek, ChatGPT),
 * attached over its DevTools port. Started like a user would start it — no
 * automation flags — because puppeteer-launched windows can render blank and
 * look automated to login pages (Google / Cloudflare checks).
 */
/* eslint-disable @typescript-eslint/no-explicit-any -- puppeteer browser */

import net from 'net';
import { spawn, type ChildProcess } from 'child_process';
import { promises as fs } from 'fs';
import { loadPuppeteer, systemBrowserCandidates } from '@/lib/aiProxy';

function freePort(): Promise<number> {
  return new Promise((resolve, reject) => {
    const srv = net.createServer();
    srv.once('error', reject);
    srv.listen(0, '127.0.0.1', () => {
      const { port } = srv.address() as net.AddressInfo;
      srv.close(() => resolve(port));
    });
  });
}

/** First installed Chrome / Edge / Brave (or puppeteer's own browser). */
export async function findBrowserExecutable(): Promise<string> {
  const puppeteer = await loadPuppeteer();
  const candidates = [process.env.PUPPETEER_EXECUTABLE_PATH, ...systemBrowserCandidates()].filter(Boolean) as string[];
  try { candidates.push(await puppeteer.executablePath()); } catch { /* no bundled browser */ }
  for (const c of candidates) {
    try { await fs.access(c); return c; } catch { /* next */ }
  }
  return '';
}

export interface VisibleBrowser {
  browser: any;
  /** The executable used: reuse it for the background browser (same cookie encryption). */
  exe: string;
  child: ChildProcess;
}

/**
 * Open `url` in a visible window on `profileDir`. `service` names the site in
 * error messages ("DeepSeek", "ChatGPT").
 */
export async function launchVisibleBrowser(profileDir: string, url: string, service: string): Promise<VisibleBrowser> {
  const puppeteer = await loadPuppeteer();
  await fs.mkdir(profileDir, { recursive: true });
  const exe = await findBrowserExecutable();
  if (!exe) throw new Error(`No Chrome, Edge or Brave browser found to open the ${service} login.`);

  const port = await freePort();
  const child = spawn(exe, [
    `--user-data-dir=${profileDir}`,
    `--remote-debugging-port=${port}`,
    '--remote-allow-origins=*',
    '--no-first-run',
    '--no-default-browser-check',
    '--hide-crash-restore-bubble',
    '--window-size=1100,900',
    url,
  ], { stdio: 'ignore', detached: true });
  child.unref();

  // Wait for the DevTools endpoint, then attach.
  const deadline = Date.now() + 20_000;
  while (Date.now() < deadline) {
    if (child.exitCode !== null) {
      throw new Error(`The browser closed right away — a ${service} login window may already be open. Close it and retry.`);
    }
    try {
      const res = await fetch(`http://127.0.0.1:${port}/json/version`, { signal: AbortSignal.timeout(1_000) });
      if (res.ok) {
        const browser = await puppeteer.connect({ browserURL: `http://127.0.0.1:${port}`, defaultViewport: null });
        return { browser, exe, child };
      }
    } catch { /* not up yet */ }
    await new Promise(r => setTimeout(r, 300));
  }
  try { child.kill(); } catch { /* gone */ }
  throw new Error(`The ${service} login browser did not start.`);
}

/** Wait until the browser process has exited (its profile lock is released). */
export async function waitForExit(child: ChildProcess, ms = 15_000): Promise<void> {
  if (child.exitCode !== null) return;
  await new Promise<void>(resolve => {
    const timer = setTimeout(resolve, ms);
    child.once('exit', () => { clearTimeout(timer); resolve(); });
  });
}
