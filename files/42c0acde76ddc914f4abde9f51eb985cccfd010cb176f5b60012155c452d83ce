// Permanently erases a soft-deleted lead and its local scraped-image files.
// Refuses to erase an active (non-deleted) lead.
export async function purgeLead(leadId: string): Promise<void> {
  const campaignId = await findLeadCampaignId(leadId);
  if (!campaignId) return;
  let filesToDelete: string[] = [];
  await withCampaignLeadsLock(campaignId, async () => {
    const leads = await getCampaignLeads(campaignId);
    const lead = leads.find(l => l.id === leadId);
    if (!lead) return;
    if (!lead.deleted) {
      throw new Error('Lead must be soft-deleted before it can be erased.');
    }
    filesToDelete = (lead.business.scrapedImages || [])
      .map(i => i.url.replace(/^\/api\/scraped-images\//, ''))
      .filter(f => /^[a-z0-9-]+\.(jpg|jpeg|png|webp|gif)$/i.test(f))
      .map(f => path.join(SCRAPED_DIR, f));
    await writeJSON(leadsFile(campaignId), leads.filter(l => l.id !== leadId));
  });
  for (const file of filesToDelete) {
    await fs.unlink(file).catch(() => {});
  }
}

export async function updateLead(
  leadId: string,
  data: { status?: LeadStatus; notes?: string },
): Promise<void> {
  const campaignId = await findLeadCampaignId(leadId);
  if (!campaignId) return;
  await withCampaignLeadsLock(campaignId, async () => {
    const leads = await getCampaignLeads(campaignId);
    const lead = leads.find(l => l.id === leadId);
    if (lead) {
      if (data.status) lead.status = data.status;
      if (data.notes !== undefined) lead.notes = data.notes;
      lead.updatedAt = new Date().toISOString();
      await writeJSON(leadsFile(campaignId), leads);
    }
  });
}

