import { NextRequest, NextResponse } from 'next/server';
import { getCampaign, getLead, updateLeadImages, getSettings, SCRAPED_DIR } from '@/lib/store';
import sharp from 'sharp';
import { uploadToImgbb } from '@/lib/imgbb';
import { promises as fs } from 'fs';
import path from 'path';

const MAX_IMAGES = 10;
const BROWSER_UA =
  'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36';

async function readImage(url: string): Promise<Buffer> {
  // Locally stored scraped images are served by this app itself.
  if (url.startsWith('/api/scraped-images/')) {
    const file = url.replace(/^\/api\/scraped-images\//, '');
    if (!/^[a-z0-9-]+\.(jpg|jpeg|png|webp|gif)$/i.test(file)) throw new Error('Invalid local image path');
    return fs.readFile(path.join(SCRAPED_DIR, file));
  }
  const res = await fetch(url, {
    headers: {
      'User-Agent': BROWSER_UA,
      Referer: 'https://www.google.com/',
      Accept: 'image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8',
    },
  });
  if (!res.ok) throw new Error(`Failed to download image (${res.status})`);
  return Buffer.from(await res.arrayBuffer());
}

export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;
    const settings = await getSettings();
    const imgbbKey = settings.imgbbKey;
    if (!imgbbKey) {
      return NextResponse.json({ error: 'ImgBB API key not configured. Set it in Settings.' }, { status: 400 });
    }

    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    const { urls } = await request.json();
    if (!Array.isArray(urls) || urls.length === 0) {
      return NextResponse.json({ error: 'No image urls provided' }, { status: 400 });
    }

    const currentImages = lead.images || [];
    const remaining = MAX_IMAGES - currentImages.length;
    if (remaining <= 0) {
      return NextResponse.json({ error: 'Maximum 10 images allowed' }, { status: 400 });
    }

    const alt = lead.business?.name || '';
    const newImages = [...currentImages];
    const results: { url: string; ok: boolean; error?: string }[] = [];

    for (const url of urls.slice(0, remaining)) {
      try {
        const inputBuffer = await readImage(url);
        const transformer = sharp(inputBuffer);
        const metadata = await transformer.metadata();
        let webpBuffer = await transformer.webp({ quality: 80 }).toBuffer();
        // Guard against pathologically large images
        if (Buffer.byteLength(webpBuffer) > 8 * 1024 * 1024) {
          webpBuffer = await sharp(inputBuffer).resize({ width: 2000, withoutEnlargement: true }).webp({ quality: 75 }).toBuffer();
        }
        const b64 = webpBuffer.toString('base64');
        const { url: uploadedUrl, delete_url } = await uploadToImgbb(b64, imgbbKey);
        newImages.push({
          id: crypto.randomUUID(),
          url: uploadedUrl,
          alt,
          width: metadata.width,
          height: metadata.height,
          deleteUrl: delete_url,
        });
        results.push({ url, ok: true });
      } catch (err: any) {
        results.push({ url, ok: false, error: err.message || 'Upload failed' });
      }
    }

    if (newImages.length > currentImages.length) {
      await updateLeadImages(leadId, newImages);
    }

    return NextResponse.json({ imported: results.filter(r => r.ok).length, failed: results.filter(r => !r.ok).length, results });
  } catch (err: any) {
    return NextResponse.json({ error: err.message || 'Import failed' }, { status: 500 });
  }
}
