      var img = t.closest && t.closest('img');
      if (img && tagged(img) === img) { setHover(img, true); return; }
      var photo = photoAt(e.clientX, e.clientY);
      setHover(photo ? photo.el : null, !!photo);
      return;
    }
    // Edit mode: texts and links only.
    var el = tagged(t);
    var rich = el && richRoot(el);
    if (rich) { setHover(rich); return; }
