      if (s.now.replace(/\s+/g, ' ').trim() !== s.old.replace(/\s+/g, ' ').trim() && s.loc != null) {
        edits.push({ kind: 'text', loc: s.loc, oldText: s.old, newText: s.now, cardTexts: cardTextsOf(el) });
