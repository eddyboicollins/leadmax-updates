.dark .lm-map .leaflet-control-zoom a:hover { background: #27272a; }
.lm-pin { position: relative; width: 18px; height: 18px; cursor: pointer; }
.lm-pin-dot { position: absolute; inset: 2px; border-radius: 999px; border: 2px solid #09090b; box-shadow: 0 0 0 2px rgba(255,255,255,.08), 0 2px 6px rgba(0,0,0,.4); transition: transform .15s; }
.lm-pin:hover .lm-pin-dot { transform: scale(1.3); }
.lm-tone-new .lm-pin-dot { background: #047857; }
.lm-tone-nosite .lm-pin-dot { background: #34d399; box-shadow: 0 0 0 3px rgba(52,211,153,.25), 0 2px 6px rgba(0,0,0,.4); }
