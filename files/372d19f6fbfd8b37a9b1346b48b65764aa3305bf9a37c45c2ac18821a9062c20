                <button onClick={() => setImagesTab('discovered')} className={`px-4 py-2 text-xs font-medium rounded-t-lg transition-all ${imagesTab === 'discovered' ? 'text-zinc-900 dark:text-white border-b-2 border-emerald-500' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white'}`}>
                  {t('campaign.imagesTabDiscovered')} ({(imagesLead.business.scrapedImages || []).length})
                </button>
                <button onClick={() => setImagesTab('deleted')} className={`px-4 py-2 text-xs font-medium rounded-t-lg transition-all ${imagesTab === 'deleted' ? 'text-zinc-900 dark:text-white border-b-2 border-emerald-500' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white'}`}>
                  {t('campaign.imagesTabDeleted')} ({modalDeletedImages.length})
