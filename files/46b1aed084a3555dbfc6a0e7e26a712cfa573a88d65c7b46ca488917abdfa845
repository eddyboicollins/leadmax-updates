export async function addDeploymentEntry(
  leadId: string,
  entry: DeploymentEntry,
): Promise<void> {
  const campaignId = await findLeadCampaignId(leadId);
  if (!campaignId) return;
  await withCampaignLeadsLock(campaignId, async () => {
    const leads = await getCampaignLeads(campaignId);
    const lead = leads.find(l => l.id === leadId);
    if (lead) {
      if (!lead.deploymentHistory) lead.deploymentHistory = [];
      for (const e of lead.deploymentHistory) e.isMain = false;
      entry.isMain = true;
      lead.deploymentHistory.unshift(entry);
      lead.deployment = { provider: 'vercel', url: entry.aliasUrl, deployedAt: entry.deployedAt, projectName: entry.aliasUrl.replace('https://', '').split('.')[0] };
      lead.updatedAt = new Date().toISOString();
      await writeJSON(leadsFile(campaignId), leads);
    }
  });
}

export async function setMainDeployment(
  leadId: string,
  entryId: string,
): Promise<{ entry: DeploymentEntry | null }> {
  const campaignId = await findLeadCampaignId(leadId);
  if (!campaignId) return { entry: null };
  return withCampaignLeadsLock(campaignId, async () => {
    const leads = await getCampaignLeads(campaignId);
    const lead = leads.find(l => l.id === leadId);
    if (lead && lead.deploymentHistory) {
      let found: DeploymentEntry | null = null;
      for (const e of lead.deploymentHistory) {
        if (e.id === entryId) {
          e.isMain = true;
          found = e;
        } else {
          e.isMain = false;
        }
      }
      if (found) {
        lead.deployment = { provider: 'vercel', url: found.aliasUrl, deployedAt: found.deployedAt, projectName: found.aliasUrl.replace('https://', '').split('.')[0] };
      }
      lead.updatedAt = new Date().toISOString();
      await writeJSON(leadsFile(campaignId), leads);
      return { entry: found };
    }
    return { entry: null };
  });
}

