import { retryAskGemini } from '@/lib/gemini';
import type { GeminiModel, GeminiSource } from '@/lib/gemini';
import { isCodeComplete, sanitizeGeneratedTsx } from '@/lib/prompts';

/**
 * Chunked editing for AI-generated landing pages.
 *
 * A page remains a SINGLE React component (`landingPage.tsx`) — the single
 * entity all existing logic (deploy, history, generations) depends on. To
 * enable surgical edits, the generation prompt asks the model to wrap each
 * top-level section in inert JSX comment markers:
 *
 *   _START_ navbar END_ (rendered in code as: brace-slash-star LM:START:id star-slash, then JSX, then the matching END marker)
 *
 * These markers are just JSX comments, so they are stripped by the compiler,
 * invisible on the deployed site, and flow through deployment history and
 * generations.json untouched. Modifying a page becomes: send the ENTIRE
 * component (head + all section chunks + tail) as input, ask the model to
 * return only the chunk(s) that changed (still wrapped in their markers),
 * splice them back into the full component, and verify the reassembled code is
 * still structurally complete.
 *
 * The model has FULL control over every part of the page. Besides the marked
 * sections, it can edit the component head (use client directive, imports,
 * state, handlers, the "return (", root element, and font <link> tags) by
 * returning it as a `head` chunk, and the component tail (closing tags, ");",
 * final "}") as a `tail` chunk. Validation (per-chunk balance, whole-file
 * completeness, sanitization) remains the safety net, not the sandbox.
 *
 * Pages that have no markers (legacy leads, or a model that ignored the
 * instruction) fall back to the original full-rewrite path.
 */

export const LM_START_RE = /\{\/\*\s*LM:START:([A-Za-z0-9_-]+)\s*\*\/\}/g;
export const LM_END_RE = /\{\/\*\s*LM:END:([A-Za-z0-9_-]+)\s*\*\/\}/g;

export interface ParsedChunk {
  id: string;
  /** Raw substring of the tsx including the START and END markers. */
  raw: string;
}

export interface ParsedChunks {
  prefix: string;
  chunks: ParsedChunk[];
  suffix: string;
}

function collect(re: RegExp, tsx: string): { id: string; index: number; len: number }[] {
  re.lastIndex = 0;
  const out: { id: string; index: number; len: number }[] = [];
  for (const m of tsx.matchAll(re)) {
    out.push({ id: m[1], index: m.index, len: m[0].length });
  }
  return out;
}

/**
 * Parse a full component into ordered chunks (each raw slice includes markers).
 * Returns null when the page has fewer than two well-formed, non-overlapping,
 * fully round-trippable sections — i.e. when chunked editing is not possible
 * and the caller should fall back to the full rewrite path.
 */
export function parseChunks(tsx: string): ParsedChunks | null {
  const starts = collect(LM_START_RE, tsx);
  const ends = collect(LM_END_RE, tsx);
  if (starts.length < 2) return null;

  const chunks: ParsedChunk[] = [];
  let cursor = starts[0].index;
  for (const s of starts) {
    const e = ends.find(en => en.id === s.id && en.index > s.index && en.index >= s.index + s.len);
    if (!e) return null;
    if (s.index < cursor) return null;
    // Slice from the running cursor so the whitespace between the previous
    // chunk's END marker and this chunk's START marker stays in this raw.
    chunks.push({ id: s.id, raw: tsx.slice(cursor, e.index + e.len) });
    cursor = e.index + e.len;
  }

  const prefix = tsx.slice(0, starts[0].index);
  const suffix = tsx.slice(cursor);
  if (prefix + chunks.map(c => c.raw).join('') + suffix !== tsx) return null;

  return { prefix, chunks, suffix };
}

/** Strip the LM:START:id / LM:END:id wrapper from a returned chunk block. */
export function stripChunkMarkers(block: string, id: string): string {
  const startRe = new RegExp(`\\{\\/\\*\\s*LM:START:${id}\\s*\\*\\/\\}\\s*`);
  const endRe = new RegExp(`\\s*\\{\\/\\*\\s*LM:END:${id}\\s*\\*\\/\\}`);
  return block.replace(startRe, '').replace(endRe, '').trim();
}

/** Reassemble the full component after replacing one or more chunk raws. */
export function applyChunkEdits(parts: ParsedChunks, edits: Record<string, string>): string {
  const chunkIds = new Set(parts.chunks.map(c => c.id));
  const chunks = parts.chunks.map(c => {
    const next = edits[c.id];
    if (next === undefined) return c;
    // Keep the original indentation/blank-line gap that preceded this chunk's
    // START marker so the reassembled JSX stays clean.
    const startMatch = LM_START_RE.exec(c.raw);
    LM_START_RE.lastIndex = 0;
    const lead = startMatch ? c.raw.slice(0, startMatch.index) : '';
    return { ...c, raw: lead + next };
  });

  // Brand-new sections: edit ids that don't exist anywhere in the page and
  // aren't the head/tail regions. They are wrapped in their own markers and
  // appended after the last existing section, before the tail.
  const newBlocks: string[] = [];
  for (const [id, block] of Object.entries(edits)) {
    if (id === 'head' || id === 'tail') continue;
    if (chunkIds.has(id)) continue;
    newBlocks.push(block.trim());
  }

  const prefix = edits.head !== undefined
    ? stripChunkMarkers(edits.head, 'head')
    : parts.prefix;
  const suffix = edits.tail !== undefined
    ? stripChunkMarkers(edits.tail, 'tail')
    : parts.suffix;
  const body = chunks.map(c => c.raw).join('');
  const added = newBlocks.length > 0 ? '\n\n' + newBlocks.join('\n\n') : '';
  return prefix + body + added + suffix;
}

/** Strip code fences and any stray 'use client' directives from model output. */
export function cleanChunkOutput(raw: string): string {
  return raw
    .replace(/```tsx\s*/gi, '')
    .replace(/```jsx\s*/gi, '')
    .replace(/```\s*$/g, '')
    .replace(/'use client';\s*/g, '')
    .trim();
}

/**
 * Extract the LM:START / LM:END marker blocks the model returned.
 * Returns a map id -> full block (markers included). Malformed blocks skipped.
 */
export function extractChunkBlocks(raw: string): Map<string, string> {
  const cleaned = cleanChunkOutput(raw);
  const starts = collect(LM_START_RE, cleaned);
  const ends = collect(LM_END_RE, cleaned);
  const out = new Map<string, string>();
  let cursor = 0;
  for (const s of starts) {
    const e = ends.find(en => en.id === s.id && en.index > s.index && en.index >= cursor);
    if (!e) continue;
    out.set(s.id, cleaned.slice(s.index, e.index + e.len));
    cursor = e.index + e.len;
  }
  return out;
}

/** Lightweight structural check for a single chunk block (balanced braces). */
export function isChunkBalanced(block: string): boolean {
  const body = block.replace(LM_START_RE, '').replace(LM_END_RE, '');
  let inString = false;
  let escaped = false;
  let depth = 0;
  for (const ch of body) {
    if (escaped) { escaped = false; continue; }
    if (ch === '\\') { escaped = true; continue; }
    if (ch === '"') { inString = !inString; continue; }
    if (inString) continue;
    if (ch === '{') depth++;
    if (ch === '}') depth--;
  }
  return depth === 0;
}

/** Condensed deployment rules used when editing one or more chunks. */
export const CHUNK_MODIFY_RULES = `
RULES (apply to every chunk you return):
- Return ONLY the changed chunks, each wrapped in its ORIGINAL or a NEW {/* LM:START:id */} ... {/* LM:END:id */} marker pair, always using the id that identifies the chunk.
- You have FULL control: you may edit any section chunk, the HEAD chunk, or the TAIL chunk. Anything you do NOT return stays exactly as it is.
- To ADD a brand-new section, return it wrapped in a NEW unique marker id (e.g. {/* LM:START:gallery */} ... {/* LM:END:gallery */}) that does not exist yet, and give the section its own id attribute (id="gallery"). New sections are appended at the end of the page content.
- HEAD chunk = everything from 'use client' (and imports, state, handlers, "return (", the root <div>, and any <link> tags) up to the FIRST section marker. Return it as {/* LM:START:head */} ... {/* LM:END:head */} ONLY when you change fonts, <link> tags, imports, state, handlers, or the root element. When returned, it must contain the COMPLETE new head (preserve the 'use client' directive and all unchanged imports/state/handlers verbatim).
- TAIL chunk = everything after the LAST section marker (closing tags, ");", final "}"). Return it as {/* LM:START:tail */} ... {/* LM:END:tail */} only when you change the closing structure.
- NO TypeScript type annotations. NO <style> tags. Fonts via <link rel="stylesheet"> only.
- Font Awesome is pre-loaded — use className="fas fa-*" only.
- Every JSX opening tag must close with the same tag name (section→</section>, nav→</nav>).
- Numeric JSX props use braces: rows={4} not rows="4".
- Each returned section keeps its id attribute (id="hero", id="services", etc.).
- Maintain the existing brand color scheme (2-3 colors max) and rounded corners (rounded-xl rounded-2xl).
- No explanations, no markdown fences — code only.
`;

/** Build the prompt for a surgical, chunk-level modification. */
export function buildChunkModifyPrompt(
  parts: ParsedChunks,
  userPrompt: string,
  imagesBlock?: string,
): string {
  const sections = parts.chunks.map(c => c.raw).join('\n\n');
  return [
    'You are editing an existing React landing page. The page is ONE component and you have FULL CONTROL over the entire file.',
    'It is split into labeled chunks: the HEAD chunk (everything before the first section marker),',
    'the section chunks (each wrapped in its own LM:START / LM:END JSX comment markers), and the TAIL chunk (after the last marker).',
    '',
    '=== HEAD CHUNK (imports, state, handlers, "return (", root <div>, <link> tags) ===',
    parts.prefix.trim(),
    '=== END HEAD CHUNK ===',
    '',
    '=== SECTION CHUNKS ===',
    sections,
    '',
    '=== TAIL CHUNK (closing tags, ");", final "}") ===',
    parts.suffix.trim(),
    '=== END TAIL CHUNK ===',
    '',
    "User's change request:",
    userPrompt,
    imagesBlock ? '' : null,
    imagesBlock || null,
    '',
    'Identify which chunk(s) need to change to satisfy the request, then return ONLY those changed chunk(s),',
    'each wrapped in its markers with the SAME id (sections keep their own id; the whole head is "head"; the',
    'whole tail is "tail").',
    'If the request asks for a brand-new section (e.g. a gallery, pricing, map, etc.), CREATE it: return it as a',
    'new marker pair with a fresh unique id that does not exist yet (e.g. {/* LM:START:gallery */} ...',
    '{/* LM:END:gallery */}), give the section its own id attribute, and it will be appended to the page.',
    CHUNK_MODIFY_RULES,
  ].filter(Boolean).join('\n');
}

/**
 * Ask Gemini to modify only the section(s) that need changing. The model sees
 * every chunk (full context) but must return ONLY the changed chunks, each
 * wrapped in its original LM:START/LM:END markers. Returns the reassembled
 * full component. Throws on failure so the caller can fall back to a full
 * rewrite if needed.
 */
export async function modifyChunksViaGemini(
  prompt: string,
  apiKey: string,
  model: GeminiModel,
  source: GeminiSource,
  parts: ParsedChunks,
): Promise<string> {
  const maxAttempts = 3;
  let lastError: Error | null = null;

  for (let attempt = 0; attempt < maxAttempts; attempt++) {
    try {
      const raw = await retryAskGemini(prompt, apiKey, model, 4, undefined, source);
      const blocks = extractChunkBlocks(raw);
      if (blocks.size === 0) {
        lastError = new Error('Model did not return a chunked response');
        continue;
      }

      const edits: Record<string, string> = {};
      let anyValid = false;
      for (const [id, block] of blocks) {
        // head/tail are whole-file regions, never balanced on their own;
        // sections must stay brace-balanced. Everything is re-validated below
        // against the reassembled full component.
        const isRegion = id === 'head' || id === 'tail';
        const isKnown = isRegion || parts.chunks.some(c => c.id === id);
        if (!isRegion && !isChunkBalanced(block)) {
          lastError = new Error(`Edited section "${id}" is not balanced`);
          continue;
        }
        // Unknown ids (not head/tail, not an existing section) are treated as
        // brand-new sections and get appended at the end of the page by
        // applyChunkEdits. They must be well-formed, marker-wrapped blocks
        // carrying their own id attribute.
        if (!isKnown) {
          const hasId = /\bid=["'][A-Za-z0-9_-]+["']/.test(block);
          if (!hasId) {
            lastError = new Error(`New section "${id}" is missing an id attribute`);
            continue;
          }
        }
        edits[id] = block;
        anyValid = true;
      }

      if (!anyValid) {
        lastError = new Error('No valid chunk edits returned');
        continue;
      }

      const reassembled = applyChunkEdits(parts, edits);
      const complete = isCodeComplete(reassembled);
      if (!complete.ok) {
        lastError = new Error(`Reassembled page failed validation: ${complete.reason}`);
        continue;
      }
      try {
        // Run the same normalization used on full rewrites (className fixes,
        // 'use client' directive, font-link extraction) on the spliced result.
        return sanitizeGeneratedTsx(reassembled);
      } catch (err) {
        lastError = err instanceof Error ? err : new Error(String(err));
        continue;
      }
    } catch (err) {
      lastError = err instanceof Error ? err : new Error(String(err));
      continue;
    }
  }

  throw lastError || new Error('Failed to modify page via chunks');
}

/** Instruction appended to the generation prompt so sections get markers. */
export const SECTION_MARKERS_INSTRUCTION = `
==================================================
SECTION MARKERS (REQUIRED)
==================================================

Wrap EVERY top-level section of the page body in inert JSX comment markers.
Each section gets its OWN unique lowercase id.

Example structure:
{/* LM:START:navbar */}
<nav id="navbar" className="...">...</nav>
{/* LM:END:navbar */}
{/* LM:START:hero */}
<section id="hero" className="...">...</section>
{/* LM:END:hero */}

Rules:
- The marker pairs must appear DIRECTLY around each top-level section's JSX, as siblings inside the return ().
- Do NOT nest sections inside other sections' marker pairs.
- Do NOT wrap the root container <div>, <link> tags, or the "return (".
- Use short descriptive ids: navbar, hero, services, testimonials, faq, contact, map, footer, etc.
- The section markers are inert JSX comments — they must not affect visuals or behavior.
`;