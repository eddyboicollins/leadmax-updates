/** Strip markdown fences and normalize common AI output issues. */
/**
 * Remove Markdown wrapping around an AI reply, whatever form it takes:
 *  - a fenced block with chat text around it → keep the block holding the component
 *  - fences with any language tag (```tsx, ```javascript, bare ```)
 *  - a fence glued to the first code line (```'use client'; / ```import …)
 *  - chat text before the first line of code
 * Code never starts a line with three backticks, so stripping those is safe.
 */
export function unwrapMarkdownCode(raw: string): string {
  let code = raw.replace(/\r\n/g, '\n');
  const blocks = [...code.matchAll(/```[^\n`]*\n([\s\S]*?)\n[ \t]*```/g)]
    .map(m => m[1])
    .filter(b => /export\s+default/.test(b));
  if (blocks.length) code = blocks.sort((a, b) => b.length - a.length)[0];
  code = code
    .replace(/^[ \t]*```[a-zA-Z0-9_+-]*[ \t]*$/gm, '') // fence-only lines
    .replace(/^[ \t]*```(?:tsx|jsx|typescript|javascript|react|ts|js)?[ \t]*/gm, ''); // fence glued to code
  const start = code.search(/^[ \t]*(['"`]?use client|import\s|export\s|const\s|let\s|function\s|\/\*|\/\/)/m);
  if (start > 0) code = code.slice(start);
  return code;
}

export function sanitizeGeneratedTsx(raw: string): string {
  let code = unwrapMarkdownCode(raw)
    .replace(/\[(https?:\/\/[^\]]+)\]\((https?:\/\/[^)]+)\)/g, '$1')
    .trim();

  // AI sometimes wraps the whole component in quotes or leaves a stray quote after the closing brace
  if (
    (code.startsWith("'") && code.endsWith("'") && !code.startsWith("'use client"))
    || (code.startsWith('"') && code.endsWith('"') && !code.startsWith('"use client'))
  ) {
    code = code.slice(1, -1).trim();
  }
  code = code.replace(/\}\s*\n\s*['"]+\s*$/m, '}');
  code = code.replace(/\}\s*['"]+\s*$/g, '}');

  // Fix HTML class= → className= on JSX elements
  code = code.replace(/\sclass="/g, ' className="').replace(/\sclass='/g, " className='");

  // Extract Google Font URLs from <style> blocks and convert to <link> tags
  const fontLinks: string[] = [];
  const styleBlockRegex = /<style[^>]*>\{`([\s\S]*?)`\}<\/style>/g;
  code = code.replace(styleBlockRegex, (_match, css: string) => {
    for (const imp of css.matchAll(/@import\s+url\(['"]?([^'")]+)['"]?\)/g)) {
      if (imp[1].includes('fonts.googleapis.com')) {
        fontLinks.push(`<link rel="stylesheet" href="${imp[1]}" />`);
      }
    }
    return '';
  });

  if (fontLinks.length > 0) {
    const uniqueLinks = [...new Set(fontLinks)];
    code = code.replace(
      /return\s*\(\s*\n?(\s*)(<[a-zA-Z])/,
      (_m, indent, firstTag) => `return (\n${indent}${uniqueLinks.join(`\n${indent}`)}\n${indent}${firstTag}`,
    );
  }

  return normalizeUseClientDirective(code);
}

/** Strip any use-client variants and emit a single valid Next.js directive. */
function normalizeUseClientDirective(code: string): string {
  // Any directive variant, including half-quoted ones left by broken fences ("use client';").
  const body = code
    .replace(/^[ \t]*['"`]?use client['"`]?[ \t]*;?[ \t]*(?:\n|$)/gim, '')
    .trimStart();
  return `'use client';\n\n${body}`;
}

