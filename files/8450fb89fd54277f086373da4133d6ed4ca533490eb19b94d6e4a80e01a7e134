import { NextResponse } from 'next/server';
import { NextRequest } from 'next/server';
import { scrapeGoogleMaps, scrapeGoogleMapsUrls } from '@/lib/scraper';
import { v4 as uuidv4 } from 'uuid';
import type { BusinessData } from '@/lib/types';

export const dynamic = 'force-dynamic';
export const maxDuration = 300;

export async function POST(request: NextRequest) {
  try {
    const { keyword, location, urls } = await request.json();
    const isUrlMode = Array.isArray(urls) && urls.length > 0;
    if (!isUrlMode && (!keyword || !location)) {
      return NextResponse.json({ error: 'keyword and location required' }, { status: 400 });
    }
    if (isUrlMode) {
      for (const u of urls) {
        if (!u || typeof u.url !== 'string' || !u.url.trim()) {
          return NextResponse.json({ error: 'each client must include a valid url' }, { status: 400 });
        }
      }
    }

    const encoder = new TextEncoder();
    const stream = new ReadableStream({
      async start(controller) {
        const send = (type: string, data: any) => {
          try {
            controller.enqueue(encoder.encode(JSON.stringify({ type, ...data }) + '\n'));
          } catch { /* controller closed */
          }
        };

        const fail = (message: string) => {
          console.error('[scrape] error:', message);
          send('error', { error: message });
          try { controller.close(); } catch { /* already closed */
          }
        };

        // Safety valve so a hung browser can't leave the client spinning forever.
        // Deliberately generous: large result sets legitimately take 10+ minutes
        // when listings are processed serially, so a short cap would only cause
        // false "timed out" failures.
        const timeout = setTimeout(() => {
          fail('Scrape timed out after 20 minutes. The browser may be stuck.');
        }, 20 * 60 * 1000);

        try {
          send('log', { message: 'Starting scrape...' });

          const existingPlaceIds = new Set<string>();
          const existingPhones = new Set<string>();
          const existingNames = new Set<string>();

          const normName = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
          const newLeads: { leadId: string; business: BusinessData }[] = [];

          if (isUrlMode) {
            const clientList: { name: string; url: string }[] = urls
              .filter((u: unknown) => !!u && typeof u === 'object' && typeof (u as { url?: unknown }).url === 'string')
              .map((u) => ({ name: String((u as { name?: unknown }).name || '').trim(), url: String((u as { url?: unknown }).url).trim() }));
            await scrapeGoogleMapsUrls(
              clientList,
              (msg) => send('log', { message: msg }),
              (business) => {
                const isDuplicate = existingPlaceIds.has(business.placeId) ||
                  (business.phone && existingPhones.has(business.phone)) ||
                  existingNames.has(normName(business.name));
                if (isDuplicate) return;

                if (business.placeId) existingPlaceIds.add(business.placeId);
                if (business.phone) existingPhones.add(business.phone);
                existingNames.add(normName(business.name));

                const leadId = uuidv4();
                newLeads.push({ leadId, business });
                send('lead', { lead: business, leadId });
              },
              (total) => send('total', { total }),
              {
                onProgress: (processed, total, current) => send('progress', {
                  processed,
                  total,
                  current: current ? {
                    name: current.name,
                    rating: current.rating,
                    ratingCount: current.ratingCount,
                    address: current.address,
                    phone: current.phone,
                  } : null,
                }),
              },
            );
          } else {
            await scrapeGoogleMaps(
              `${keyword} ${location}`,
              (msg) => send('log', { message: msg }),
              (business) => {
                const isDuplicate = existingPlaceIds.has(business.placeId) ||
                  (business.phone && existingPhones.has(business.phone)) ||
                  existingNames.has(normName(business.name));
                if (isDuplicate) return;

                if (business.placeId) existingPlaceIds.add(business.placeId);
                if (business.phone) existingPhones.add(business.phone);
                existingNames.add(normName(business.name));

                const leadId = uuidv4();
                newLeads.push({ leadId, business });
                send('lead', { lead: business, leadId });
              },
              (total) => send('total', { total }),
              {
                onProgress: (processed, total, current) => send('progress', {
                  processed,
                  total,
                  current: current ? {
                    name: current.name,
                    rating: current.rating,
                    ratingCount: current.ratingCount,
                    address: current.address,
                    phone: current.phone,
                  } : null,
                }),
              },
            );
          }

          clearTimeout(timeout);
          send('done', { count: newLeads.length });
          try { controller.close(); } catch { /* stream may already be closed */ }
        } catch (err: unknown) {
          clearTimeout(timeout);
          if (err instanceof Error) {
            console.error('[scrape] error stack:', err.stack || err.message);
            fail(err.message);
          } else {
            fail('Scraping failed');
          }
        }
      },
    });

    return new Response(stream, {
      headers: {
        'Content-Type': 'application/x-ndjson',
        'Cache-Control': 'no-cache',
        Connection: 'keep-alive',
      },
    });
  } catch (error: unknown) {
    console.error('Scraping error:', error);
    return NextResponse.json(
      { error: error instanceof Error ? error.message : 'Failed to scrape' },
      { status: 500 },
    );
  }
}