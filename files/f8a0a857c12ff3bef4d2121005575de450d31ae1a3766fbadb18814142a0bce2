import { NextRequest, NextResponse } from 'next/server';
import { getCampaign, getLead, updateLeadScrapedImages, setDeepSearchUsed } from '@/lib/store';
import { deepSearchPlaceImages } from '@/lib/scraper';

export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;

    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    const googleUrl = lead.business.googleUrl;
    if (!googleUrl) {
      return NextResponse.json({ error: 'Lead has no Google Maps link to search' }, { status: 400 });
    }

    const scrapedImages = await deepSearchPlaceImages(googleUrl, lead.business.name);

    if (scrapedImages.length > 0) {
      await updateLeadScrapedImages(leadId, scrapedImages);
      // Deep search is a one-shot per lead: running it again re-discovers the
      // same photos, so mark it as used once at least one was found.
      await setDeepSearchUsed(leadId);
    }

    return NextResponse.json({ found: scrapedImages.length });
  } catch (err: unknown) {
    return NextResponse.json({ error: err instanceof Error ? err.message : 'Deep search failed' }, { status: 500 });
  }
}