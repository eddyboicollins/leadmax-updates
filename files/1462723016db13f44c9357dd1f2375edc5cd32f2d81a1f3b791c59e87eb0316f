'use client';

import { useRouter } from 'next/navigation';
import { useState, useEffect } from 'react';
import { useTranslation } from 'react-i18next';
import { useTheme } from './ThemeProvider';
import AboutModal from './AboutModal';
import Sidebar from './Sidebar';
import { useLocalStoragePref } from '@/lib/useLocalStoragePref';
import i18n from '@/lib/i18n';

interface NavbarProps {
  title: string;
  subtitle?: string;
  badge?: { label: string; color: 'emerald' | 'amber' } | null;
  rightActions?: React.ReactNode;
}

export default function Navbar({ title, subtitle, badge, rightActions }: NavbarProps) {
  const router = useRouter();
  const { t } = useTranslation();
  const { theme, toggle: toggleTheme } = useTheme();
  const [aboutOpen, setAboutOpen] = useState(false);
  const [langOpen, setLangOpen] = useState(false);
  const [sidebarOpen, setSidebarOpen] = useLocalStoragePref('lm_sidebar');
  const currentLang = i18n.language?.startsWith('en') ? 'en' : 'fr';

  useEffect(() => {
    const stored = localStorage.getItem('i18nextLng');
    if (stored && stored !== i18n.language) i18n.changeLanguage(stored);
  }, []);

  useEffect(() => {
    document.body.classList.toggle('lm-sidebar-open', sidebarOpen);
  }, [sidebarOpen]);

  function switchLang(lng: string) {
    i18n.changeLanguage(lng);
    localStorage.setItem('i18nextLng', lng);
    setLangOpen(false);
  }

  return (
    <>
    <AboutModal open={aboutOpen} onClose={() => setAboutOpen(false)} />
    <Sidebar open={sidebarOpen} onClose={() => setSidebarOpen(false)} />
    <header className="border-b border-gray-200 dark:border-zinc-700/50 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm sticky top-0 z-50 transition-colors">
      <div className="px-4 sm:px-6 h-14 sm:h-[60px] flex items-center justify-between gap-2">
        <div className="flex items-center gap-2 sm:gap-3 min-w-0">
          {!sidebarOpen && (
            <>
              <button onClick={() => setSidebarOpen(true)} className="p-1.5 sm:p-2 text-zinc-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-zinc-800 rounded-lg transition-all shrink-0" title={t('nav.menu')}>
                <svg className="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
              </button>
              <button onClick={() => router.push('/')} className="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white font-bold text-sm sm:text-lg shadow-lg shadow-emerald-500/20 shrink-0 hover:opacity-90 transition-opacity cursor-pointer" title={t('nav.home')}>
                LM
              </button>
            </>
          )}
          <div className="min-w-0">
            <div className="flex items-center gap-1.5 sm:gap-2">
              <h1 className="text-base sm:text-xl font-bold text-gray-900 dark:text-white tracking-tight truncate transition-colors">{title}</h1>
              {badge && (
                <span className={`px-1 py-0.5 text-[9px] sm:text-[10px] font-medium rounded whitespace-nowrap ${badge.color === 'emerald' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-amber-500/10 text-amber-400'}`}>
                  {badge.label}
                </span>
              )}
            </div>
            {subtitle && <p className="text-[11px] sm:text-xs text-zinc-400 truncate -mt-0.5">{subtitle}</p>}
          </div>
        </div>

        <div className="flex items-center gap-1.5 sm:gap-3 shrink-0">
          {rightActions}
          <button onClick={() => setAboutOpen(true)} className="px-2 sm:px-2.5 py-1.5 text-xs font-medium text-zinc-400 hover:text-gray-900 dark:hover:text-white bg-gray-100 dark:bg-zinc-800 rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition-all">
            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </button>
          <button onClick={toggleTheme} className="px-2 sm:px-2.5 py-1.5 text-xs font-medium text-zinc-400 hover:text-gray-900 dark:hover:text-white bg-gray-100 dark:bg-zinc-800 rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition-all">
            {theme === 'dark' ? (
              <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            ) : (
              <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
            )}
          </button>
          <button onClick={() => router.push('/settings')} className="px-2.5 sm:px-3 py-1.5 text-xs font-medium text-zinc-400 hover:text-gray-900 dark:hover:text-white bg-gray-100 dark:bg-zinc-800 rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition-all">
            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </button>
          <div className="relative">
            <button onClick={() => setLangOpen(!langOpen)} className="px-2 sm:px-2.5 py-1.5 text-xs font-medium text-zinc-400 hover:text-gray-900 dark:hover:text-white bg-gray-100 dark:bg-zinc-800 rounded-lg hover:bg-gray-200 dark:hover:bg-zinc-700 transition-all flex items-center gap-1">
              <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {currentLang === 'en' ? 'EN' : 'FR'}
            </button>
            {langOpen && (
              <div className="absolute right-0 mt-1 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-lg shadow-xl overflow-hidden z-50 min-w-[130px]">
                <button onClick={() => switchLang('en')} className={`w-full px-3 py-2 text-xs text-left hover:bg-gray-100 dark:hover:bg-zinc-700 transition-colors ${currentLang === 'en' ? 'text-emerald-400 bg-gray-100 dark:bg-zinc-700/50' : 'text-gray-600 dark:text-zinc-300'}`}>
                  {t('lang.en')}
                </button>
                <button onClick={() => switchLang('fr')} className={`w-full px-3 py-2 text-xs text-left hover:bg-gray-100 dark:hover:bg-zinc-700 transition-colors ${currentLang === 'fr' ? 'text-emerald-400 bg-gray-100 dark:bg-zinc-700/50' : 'text-gray-600 dark:text-zinc-300'}`}>
                  {t('lang.fr')}
                </button>
              </div>
            )}
          </div>
        </div>
      </div>
    </header>
    </>
  );
}
