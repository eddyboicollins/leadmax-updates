.lm-pin-dot { position: absolute; inset: 2px; border-radius: 999px; border: 2px solid #09090b; box-shadow: 0 0 0 2px rgba(255,255,255,.08), 0 2px 6px rgba(0,0,0,.4); transition: transform .15s; }
.lm-pin:hover .lm-pin-dot { transform: scale(1.3); }
.lm-tone-new .lm-pin-dot { background: #34d399; }
.lm-tone-site .lm-pin-dot { background: #ffffff; }
.lm-tone-worked .lm-pin-dot { background: #a1a1aa; }
.lm-tone-muted .lm-pin-dot { background: #52525b; }
