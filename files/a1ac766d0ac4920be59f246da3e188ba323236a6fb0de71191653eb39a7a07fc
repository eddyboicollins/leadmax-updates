'use client';

import { useEffect, useRef } from 'react';

/** Minimal lead shape the map needs. */
export interface MapLead {
  id: string;
  name: string;
  rating?: number;
  lat?: number;
  lng?: number;
  /** Marker tone: fresh lead (with / without a website of its own), has an AI site, or already being worked. */
  tone: 'new' | 'nosite' | 'site' | 'worked' | 'muted';
}

interface Props {
  leads: MapLead[];
  selectedId: string | null;
  onSelect: (id: string) => void;
  dark: boolean;
}

// Standard OpenStreetMap tiles (same as the original Leaflet map, no API key).
// Dark mode is produced with a CSS filter on the tile layer (see MAP_CSS).
const TILE_URL = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
const ATTRIBUTION = '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>';

let leafletPromise: Promise<any> | null = null; // eslint-disable-line @typescript-eslint/no-explicit-any
/* eslint-disable @typescript-eslint/no-explicit-any -- Leaflet is loaded from CDN (untyped global) */
function loadLeaflet(): Promise<any> {
  if ((window as any).L) return Promise.resolve((window as any).L);
  if (leafletPromise) return leafletPromise;
  leafletPromise = new Promise((resolve, reject) => {
    if (!document.querySelector('link[data-leaflet]')) {
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      link.setAttribute('data-leaflet', '1');
      document.head.appendChild(link);
    }
    const s = document.createElement('script');
    s.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
    s.onload = () => resolve((window as any).L);
    s.onerror = () => { leafletPromise = null; reject(new Error('Failed to load the map')); };
    document.head.appendChild(s);
  });
  return leafletPromise;
}

function esc(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

/** Per-lead animation offset (0–1.6s) so bobbing pins don't move in unison. */
function bobDelay(id: string): string {
  let h = 0;
  for (let i = 0; i < id.length; i++) h = (h * 31 + id.charCodeAt(i)) | 0;
  return `${-((Math.abs(h) % 160) / 100)}s`;
}

function markerHtml(lead: MapLead, selected: boolean): string {
  if (selected) {
    return `<div class="lm-pin lm-pin-sel">
      <span class="lm-pin-halo"></span><span class="lm-pin-core"></span>
      <span class="lm-pin-label"><b>${esc(lead.name)}</b>${lead.rating ? `<i>${lead.rating}★</i>` : ''}</span>
    </div>`;
  }
  const delay = lead.tone === 'nosite' ? ` style="animation-delay:${bobDelay(lead.id)}"` : '';
  return `<div class="lm-pin lm-tone-${lead.tone}"${delay} title="${esc(lead.name)}"><span class="lm-pin-dot"></span></div>`;
}

