'use client';

import { useEffect, useMemo, useRef, useState } from 'react';
import { useTranslation } from 'react-i18next';
import { Modal, ModalHeader, ModalFooter, btn } from './ui/Modal';

export interface NormalizedCrop {
  x: number;
  y: number;
  w: number;
  h: number;
}

interface ImageCropperProps {
  /** Original (uncropped) photo. */
  src: string;
  /** Width / height of the slot the photo fills on the page. */
  slotAspect: number;
  /** Previous crop of this photo, to continue from. */
  initialCrop?: NormalizedCrop | null;
  busy?: boolean;
  /**
   * The photo's box on the page can take another ratio (false: it is sized by
   * other content, e.g. a hero behind text — only the current ratio is offered).
   */
  resizable?: boolean;
  /** How many boxes on the page share that template (list cards resize together). */
  copies?: number;
  onCancel: () => void;
  /** aspect: the chosen width / height; differs from slotAspect when the box should be resized. */
  onApply: (crop: NormalizedCrop, aspect: number) => void;
}

const MAX_W = 640;
const MAX_H = 420;
const MAX_ZOOM = 5;

const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

/** Zoom / pan / reframe a photo for one slot of the page (no AI). */
export default function ImageCropper({ src, slotAspect, initialCrop, busy, resizable = false, copies = 1, onCancel, onApply }: ImageCropperProps) {
  const { t } = useTranslation();
  const [natural, setNatural] = useState<{ w: number; h: number } | null>(null);
  const [failed, setFailed] = useState(false);
  const slot = Number.isFinite(slotAspect) && slotAspect > 0 ? slotAspect : 16 / 9;
  const [aspect, setAspect] = useState(slot);
  const [zoom, setZoom] = useState(1);
  const [center, setCenter] = useState({ x: 0.5, y: 0.5 });
  const drag = useRef<{ x: number; y: number; cx: number; cy: number } | null>(null);

  const frame = useMemo(() => {
    let w = MAX_W;
    let h = w / aspect;
    if (h > MAX_H) { h = MAX_H; w = h * aspect; }
    return { w: Math.round(w), h: Math.round(h) };
  }, [aspect]);

  // Scale at which the photo exactly covers the frame (zoom = 1).
  const coverScale = natural ? Math.max(frame.w / natural.w, frame.h / natural.h) : 1;
  const scale = coverScale * zoom;

  const crop = useMemo(() => {
    if (!natural) return null;
    const cw = Math.min(natural.w, frame.w / scale);
    const ch = Math.min(natural.h, frame.h / scale);
    const x = clamp(center.x * natural.w - cw / 2, 0, natural.w - cw);
    const y = clamp(center.y * natural.h - ch / 2, 0, natural.h - ch);
    return { x, y, cw, ch };
  }, [natural, frame, scale, center]);

  // Once the photo's real size is known, continue from the previous crop.
  const onImageLoad = (e: React.SyntheticEvent<HTMLImageElement>) => {
    const n = { w: e.currentTarget.naturalWidth, h: e.currentTarget.naturalHeight };
    setNatural(n);
    if (!initialCrop) return;
    const cw = initialCrop.w * n.w;
    const ch = initialCrop.h * n.h;
    if (cw > 0 && ch > 0) {
      const a = cw / ch;
      if (resizable && Math.abs(a - slot) > 0.02) setAspect(a);
      const fw = a >= MAX_W / MAX_H ? MAX_W : MAX_H * a;
      const cover = Math.max(fw / n.w, (fw / a) / n.h);
      setZoom(clamp(fw / cw / cover, 1, MAX_ZOOM));
    }
    setCenter({ x: initialCrop.x + initialCrop.w / 2, y: initialCrop.y + initialCrop.h / 2 });
  };

  useEffect(() => {
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') { e.stopPropagation(); onCancel(); } };
    window.addEventListener('keydown', onKey, true);
    return () => window.removeEventListener('keydown', onKey, true);
  }, [onCancel]);

  const onPointerDown = (e: React.PointerEvent<HTMLDivElement>) => {
    (e.target as HTMLElement).setPointerCapture?.(e.pointerId);
    // Start from the visible (clamped) framing so there is no dead zone after zooming out.
    const cx = crop && natural ? (crop.x + crop.cw / 2) / natural.w : center.x;
    const cy = crop && natural ? (crop.y + crop.ch / 2) / natural.h : center.y;
    drag.current = { x: e.clientX, y: e.clientY, cx, cy };
  };
  const onPointerMove = (e: React.PointerEvent<HTMLDivElement>) => {
    const d = drag.current;
    if (!d || !natural) return;
    setCenter({
      x: d.cx - (e.clientX - d.x) / scale / natural.w,
      y: d.cy - (e.clientY - d.y) / scale / natural.h,
    });
  };
  const onPointerUp = () => { drag.current = null; };
  const onWheel = (e: React.WheelEvent<HTMLDivElement>) => {
    setZoom(z => clamp(z * (e.deltaY < 0 ? 1.08 : 1 / 1.08), 1, MAX_ZOOM));
  };

  const apply = () => {
    if (!crop || !natural) return;
    onApply({ x: crop.x / natural.w, y: crop.y / natural.h, w: crop.cw / natural.w, h: crop.ch / natural.h }, aspect);
  };

  const ratios: { label: string; value: number }[] = resizable ? [
    { label: t('campaign.studioCropSlot'), value: slot },
    ...(natural ? [{ label: t('campaign.studioCropWhole'), value: natural.w / natural.h }] : []),
    { label: '1:1', value: 1 },
    { label: '4:3', value: 4 / 3 },
    { label: '16:9', value: 16 / 9 },
    { label: '3:4', value: 3 / 4 },
  ] : [{ label: t('campaign.studioCropSlot'), value: slot }];
  const resizing = resizable && Math.abs(aspect - slot) > 0.02;

  return (
    <Modal open onClose={onCancel} dismissible={!busy} size="lg" z="z-[220]" className="!max-w-[700px]">
        <ModalHeader
          icon="M6 2v14a2 2 0 002 2h14M2 6h14a2 2 0 012 2v14"
          title={t('campaign.studioCropTitle')}
          description={t('campaign.studioCropHint')}
          onClose={busy ? undefined : onCancel}
        />
        <div className="flex-1 min-h-0 overflow-y-auto p-5 flex flex-col items-center gap-4">
          <div
            className="relative overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800 cursor-grab active:cursor-grabbing touch-none select-none max-w-full"
            style={{ width: frame.w, height: frame.h }}
            onPointerDown={onPointerDown}
            onPointerMove={onPointerMove}
            onPointerUp={onPointerUp}
            onPointerCancel={onPointerUp}
            onWheel={onWheel}
          >
            {/* eslint-disable-next-line @next/next/no-img-element */}
            <img
              src={src}
              alt=""
              draggable={false}
              onLoad={onImageLoad}
              onError={() => setFailed(true)}
              className="absolute max-w-none pointer-events-none"
              style={natural && crop ? {
                width: natural.w * scale,
                height: natural.h * scale,
                left: -crop.x * scale,
                top: -crop.y * scale,
              } : { opacity: 0 }}
            />
            {/* Rule-of-thirds guide */}
            <div className="absolute inset-0 pointer-events-none grid grid-cols-3 grid-rows-3">
              {Array.from({ length: 9 }).map((_, i) => <div key={i} className="border border-white/25" />)}
            </div>
            {!natural && !failed && (
              <div className="absolute inset-0 flex items-center justify-center">
                <span className="animate-spin w-6 h-6 rounded-full border-2 border-emerald-400 border-t-transparent" />
              </div>
            )}
            {failed && (
              <div className="absolute inset-0 flex items-center justify-center text-xs text-zinc-500 dark:text-zinc-400 p-4 text-center">{t('campaign.studioCropLoadFailed')}</div>
            )}
          </div>
          <div className="w-full flex flex-wrap items-center gap-3">
            <label className="flex items-center gap-2 text-[11px] text-zinc-500 dark:text-zinc-400 flex-1 min-w-[200px]">
              {t('campaign.studioZoom')}
              <input
                type="range"
                min={1}
                max={MAX_ZOOM}
                step={0.01}
                value={zoom}
                onChange={e => setZoom(Number(e.target.value))}
                className="flex-1 accent-emerald-500"
              />
            </label>
            <div className="flex items-center gap-1 p-0.5 bg-zinc-100 dark:bg-zinc-800 rounded-lg border border-zinc-200 dark:border-zinc-700">
              {ratios.map(r => (
                <button
                  key={r.label}
                  onClick={() => setAspect(r.value)}
                  className={`px-2 py-1 text-[11px] rounded-md transition-all ${Math.abs(aspect - r.value) < 0.005 ? 'bg-white dark:bg-zinc-700 text-emerald-600 dark:text-emerald-400 shadow-sm' : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white'}`}
                >
                  {r.label}
                </button>
              ))}
            </div>
          </div>
        </div>
        <p className={`px-5 -mt-1 pb-3 text-[11px] leading-relaxed ${resizing ? 'text-emerald-600 dark:text-emerald-400' : 'text-zinc-500 dark:text-zinc-400'}`}>
          {!resizable
            ? t('campaign.studioCropFixedBox')
            : resizing
              ? (copies > 1 ? t('campaign.studioCropResizeAll', { count: copies }) : t('campaign.studioCropResizeOne'))
              : t('campaign.studioCropSameBox')}
        </p>
        <ModalFooter>
          <button onClick={onCancel} disabled={busy} className={btn.secondary}>{t('campaign.studioCancel')}</button>
          <button onClick={apply} disabled={busy || !crop} className={btn.primary}>
            {busy && <span className="animate-spin w-4 h-4 rounded-full border-2 border-white border-t-transparent" />}
            {t('campaign.studioApply')}
          </button>
        </ModalFooter>
    </Modal>
  );
}
