'use client';

import { useMemo } from 'react';
import { useTranslation } from 'react-i18next';
import { useScrape } from '@/lib/scrape/ScrapeProvider';
import { formatRating } from '@/lib/businessProfiles';

export default function ScrapeProgressPanel({ campaignId }: { campaignId: string }) {
  const s = useScrape();
  const { t } = useTranslation();

  const progressPct = useMemo(
    () => (s.totalLeads && s.totalLeads > 0 ? Math.min(100, Math.round((s.opProgress / s.totalLeads) * 100)) : 0),
    [s.totalLeads, s.opProgress],
  );
  const regionCount = s.regions.length;
  const regionLocation = s.regions[s.regionIndex]?.location ?? s.campaignLocation;
  const regionFilters = s.regions[s.regionIndex];

  // Same decision logic as the client-side filter in ScrapeProvider, shown live
  // so the user sees whether the lead being processed will be saved or ignored.
  const leadStatus = useMemo(() => {
    if (!s.currentLead) return null;
    const { minRating, maxRating, minReviews } = regionFilters || {};
    const rating = s.currentLead.rating ?? 0;
    const ratingCount = s.currentLead.ratingCount ?? 0;
    if (typeof minRating === 'number' && rating > 0 && rating < minRating) {
      return { ok: false as const, label: t('scrape.ignoredBelowRating', { min: minRating }) };
    }
    if (typeof maxRating === 'number' && rating > 0 && rating > maxRating) {
      return { ok: false as const, label: t('scrape.ignoredAboveRating', { max: maxRating }) };
    }
    if (typeof minReviews === 'number' && ratingCount > 0 && ratingCount < minReviews) {
      return { ok: false as const, label: t('scrape.ignoredFewReviews', { min: minReviews }) };
    }
    return { ok: true as const, label: t('scrape.willSave') };
  }, [s.currentLead, regionFilters, t]);

  const etaLabel =
    s.etaSeconds != null && s.etaSeconds > 0
      ? s.etaSeconds >= 60
        ? t('campaign.etaMinutes', { min: Math.max(1, Math.round(s.etaSeconds / 60)) })
        : t('campaign.etaSeconds', { sec: Math.max(1, s.etaSeconds) })
      : null;

  const forThisCampaign = (s.running || s.error) && s.campaignId === campaignId;
  if (!forThisCampaign) return null;

  if (s.error) {
    return (
      <div className="flex-1 flex flex-col items-center justify-center text-center">
        <div className="w-16 h-16 rounded-full bg-red-500/15 text-red-500 dark:text-red-400 flex items-center justify-center">
          <svg className="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /></svg>
        </div>
        <h2 className="mt-4 text-lg font-semibold text-zinc-900 dark:text-white">{t('scrape.failed')}</h2>
        <p className="mt-2 text-sm text-red-600 dark:text-red-300 break-words max-w-full">{s.error}</p>
        {s.logs.length > 0 && (
          <div className="mt-4 w-full max-w-md bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 rounded-xl px-4 py-3 text-start max-h-40 overflow-y-auto">
            {s.logs.slice(-6).map((line, i) => (
              <p key={i} className="text-[11px] text-zinc-600 dark:text-zinc-400 font-mono leading-relaxed">{line}</p>
            ))}
          </div>
        )}
        <button
          onClick={() => s.clearError()}
          className="mt-6 px-8 py-2.5 bg-black/10 hover:bg-black/15 text-zinc-900 dark:bg-white/10 dark:hover:bg-white/15 dark:text-white font-medium rounded-full transition-all text-sm"
        >
          {t('scrape.close')}
        </button>
      </div>
    );
  }

  const ringRadius = 92;
  const ringCircumference = 2 * Math.PI * ringRadius;
  const ringDashOffset = ringCircumference * (1 - progressPct / 100);

  return (
    <div className="flex-1 flex flex-col items-center justify-center text-center">
      <div className="relative w-56 h-56 sm:w-64 sm:h-64">
        <svg className="w-full h-full -rotate-90" viewBox={`0 0 ${ringRadius * 2 + 24} ${ringRadius * 2 + 24}`}>
          <defs>
            <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stopColor="#34d399" />
              <stop offset="100%" stopColor="#10b981" />
            </linearGradient>
          </defs>
          <circle cx={ringRadius + 12} cy={ringRadius + 12} r={ringRadius} fill="none" strokeWidth="14" stroke="currentColor" strokeLinecap="round" className="text-black/10 dark:text-white/10" />
          <circle
            cx={ringRadius + 12} cy={ringRadius + 12} r={ringRadius}
            fill="none" strokeWidth="14" stroke="url(#ringGrad)" strokeLinecap="round"
            strokeDasharray={ringCircumference} strokeDashoffset={ringDashOffset}
            className="transition-all duration-700 ease-out"
            style={s.totalLeads ? {} : { opacity: 0.25 }}
          />
        </svg>
        <div className="absolute inset-0 flex flex-col items-center justify-center">
          {s.totalLeads ? (
            <>
              <span className="text-5xl sm:text-6xl font-bold text-zinc-900 dark:text-white tabular-nums">{progressPct}%</span>
              <span className="mt-1 text-xs text-zinc-500 dark:text-zinc-400 uppercase tracking-widest">
                {t('campaign.leadsCount', { count: s.scrapedCount })}
              </span>
              <span className="mt-1 text-[11px] text-zinc-500">{t('campaign.ofTotal', { total: s.totalLeads })}</span>
            </>
          ) : (
            <>
              <svg className="animate-spin w-10 h-10 text-emerald-500 dark:text-emerald-400" viewBox="0 0 24 24" fill="none">
                <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" />
                <path className="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
              </svg>
              <span className="mt-3 text-xs text-zinc-500 dark:text-zinc-400 animate-pulse">{s.mode === 'clients' ? t('campaign.fetchingClients') : t('campaign.searching')}</span>
            </>
          )}
        </div>
      </div>

      {regionCount > 1 && s.mode !== 'clients' && (
        <p className="mt-5 text-[11px] uppercase tracking-widest text-zinc-600 dark:text-zinc-500">
          {t('campaign.regionOf', { index: s.regionIndex + 1, total: regionCount })}
        </p>
      )}
      <h2 className="mt-3 text-lg sm:text-xl font-semibold text-zinc-900 dark:text-white">
        {s.mode === 'clients' ? t('campaign.fetchingClients') : t('campaign.searchingIn', { keyword: s.campaignKeyword, location: regionLocation })}
      </h2>

      {s.currentLead && (
        <div className="mt-5 flex flex-col items-center gap-2.5">
          <div className="flex items-center gap-2.5 max-w-full">
            <p className="text-sm font-medium text-zinc-900 dark:text-white truncate">{s.currentLead.name}</p>
            {(s.currentLead.rating ?? 0) > 0 && (
              <span className="flex items-center gap-1 text-xs text-amber-500 dark:text-amber-400 whitespace-nowrap shrink-0">
                <svg className="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.363-1.118l-2.8-2.034c-.784-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                {formatRating(s.currentLead.rating!)}
                {(s.currentLead.ratingCount ?? 0) > 0 && (
                  <span className="text-zinc-500 dark:text-zinc-400">
                    ({s.currentLead.ratingCount})
                  </span>
                )}
              </span>
            )}
            <span className="status-dots" aria-hidden="true">
              <span>.</span><span>.</span><span>.</span>
            </span>
          </div>
          {leadStatus && (
            <span className={`shrink-0 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-semibold uppercase tracking-wide whitespace-nowrap ${
              leadStatus.ok
                ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 ring-1 ring-emerald-500/30'
                : 'bg-amber-500/15 text-amber-600 dark:text-amber-400 ring-1 ring-amber-500/30'
            }`}>
              {leadStatus.ok ? t('scrape.saved') : t('scrape.ignored')}
              {!leadStatus.ok && <span className="font-normal normal-case">{leadStatus.label}</span>}
            </span>
          )}
        </div>
      )}

      {etaLabel && <p className="mt-3 text-sm font-medium text-emerald-600 dark:text-emerald-400">{etaLabel}</p>}

      <button
        onClick={() => s.cancelScrape()}
        className="mt-8 px-8 py-2.5 bg-black/5 hover:bg-black/10 border border-black/15 text-zinc-900 dark:bg-white/5 dark:hover:bg-white/10 dark:border-white/15 dark:text-white font-medium rounded-full transition-all flex items-center gap-2 text-sm"
      >
        <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>
        {t('campaign.cancel')}
      </button>
    </div>
  );
}
