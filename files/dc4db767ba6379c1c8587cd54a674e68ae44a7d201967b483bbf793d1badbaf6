'use client';

import { useState, useEffect, useRef } from 'react';
import { useTranslation } from 'react-i18next';
import { SetNavbar } from '@/components/AppShell';
import { useToast } from '@/components/Toast';
import { formatRating } from '@/lib/businessProfiles';
import type { BusinessProfile } from '@/lib/types';

interface ChatLite {
  id: string;
  title: string;
  profile?: BusinessProfile;
  ended?: boolean;
  createdAt: string;
  updatedAt: string;
}

interface Message {
  id: string;
  role: 'user' | 'assistant';
  content: string;
  createdAt: string;
}

function Stars({ rating }: { rating: number }) {
  const filled = Math.round(rating);
  return (
    <span className="inline-flex items-center gap-0.5">
      {[1, 2, 3, 4, 5].map(i => (
        <svg
          key={i}
          className={`w-3.5 h-3.5 ${i <= filled ? 'text-amber-400' : 'text-zinc-400/40'}`}
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
      ))}
    </span>
  );
}

function ChatView({ chatId, onUpdated, onNewCall, generating }: { chatId: string; onUpdated: () => void; onNewCall: () => void; generating: boolean }) {
  const { t } = useTranslation();
  const [messages, setMessages] = useState<Message[]>([]);
  const [profile, setProfile] = useState<BusinessProfile | null>(null);
  const [loading, setLoading] = useState(true);
  const [ended, setEnded] = useState(false);
  const [input, setInput] = useState('');
  const [sending, setSending] = useState(false);
  const [streamingText, setStreamingText] = useState('');
  const [error, setError] = useState('');
  const bottomRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    fetch(`/api/chats/${chatId}/messages`)
      .then(r => r.json())
      .then(data => {
        setMessages(data.messages || []);
        setProfile(data.chat?.profile || null);
        setEnded(!!data.chat?.ended);
      })
      .catch(() => setError(t('assistant.loadFailed')))
      .finally(() => setLoading(false));
  }, [chatId, t]);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages, streamingText, sending]);

  async function send() {
    const content = input.trim();
    if (!content || sending || ended) return;
    setInput('');
    setError('');
    setSending(true);
    setStreamingText('');
    const userMsg: Message = {
      id: 'user-' + Date.now(),
      role: 'user',
      content,
      createdAt: new Date().toISOString(),
    };
    setMessages(prev => [...prev, userMsg]);

    try {
      const res = await fetch(`/api/chats/${chatId}/messages`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ content }),
      });
      if (!res.ok) {
        const errData = await res.json().catch(() => ({}));
        throw new Error(errData.error || 'Request failed');
      }
      if (!res.body) throw new Error('No response body');
      const reader = res.body.getReader();
      const decoder = new TextDecoder('utf-8');
      let done = false;
      let accumulated = '';
      while (!done) {
        const { value, done: readerDone } = await reader.read();
        done = readerDone;
        if (value) {
          const chunk = decoder.decode(value, { stream: true });
          for (const line of chunk.split('\n').filter(l => l.trim())) {
            try {
              const data = JSON.parse(line);
              if (data.type === 'chunk') {
                accumulated += data.content + ' ';
                setStreamingText(accumulated.trimStart());
              } else if (data.type === 'done') {
                setMessages(prev => [
                  ...prev,
                  { id: 'reply-' + Date.now(), role: 'assistant', content: accumulated.trim(), createdAt: new Date().toISOString() },
                ]);
                setStreamingText('');
                if (data.ended) setEnded(true);
                onUpdated();
              } else if (data.type === 'error') {
                throw new Error(data.error || 'Assistant failed');
              }
            } catch { /* skip malformed lines */ }
          }
        }
      }
    } catch (err) {
      setError(err instanceof Error ? err.message : t('assistant.sendFailed'));
      setMessages(prev => prev.filter(m => m.id !== userMsg.id));
      setInput(content);
      setStreamingText('');
    } finally {
      setSending(false);
    }
  }

  return (
    <div className="flex-1 min-w-0 min-h-0 flex flex-col border border-gray-200 dark:border-zinc-700/50 rounded-xl bg-white dark:bg-zinc-800/40 overflow-hidden">
      {/* Business profile */}
      {profile && (
        <div className="px-4 py-3 border-b border-gray-200 dark:border-zinc-700/50 bg-gradient-to-r from-emerald-500/[0.05] to-transparent">
          <div className="flex items-center justify-between gap-3">
            <div className="min-w-0">
              <div className="flex items-center gap-2 flex-wrap">
                <h3 className="text-sm font-semibold text-gray-900 dark:text-white truncate">{profile.name}</h3>
                <span className="text-[10px] font-medium uppercase tracking-wide text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 rounded-md px-1.5 py-0.5 shrink-0">
                  {profile.category}
                </span>
              </div>
              <div className="mt-1.5 flex items-center gap-1.5">
                <Stars rating={profile.rating} />
                <span className="text-xs font-semibold text-gray-900 dark:text-white">{formatRating(profile.rating)}</span>
                <span className="text-xs text-zinc-400">{t('assistant.reviews', { count: profile.ratingCount })}</span>
              </div>
              <div className="mt-1 flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400">
                <svg className="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                <span className="truncate">{profile.address}</span>
              </div>
              {profile.website ? (
                <div className="mt-1 flex items-center gap-1.5 min-w-0">
                  <svg className="w-3.5 h-3.5 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <a
                    href={profile.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="truncate text-xs text-emerald-600 dark:text-emerald-400 hover:underline"
                  >
                    {profile.website.replace(/^https?:\/\/(www\.)?/i, '')}
                  </a>
                  {profile.websiteInsight && (
                    <span className="shrink-0 max-w-[45%] truncate text-[10px] font-medium px-1.5 py-0.5 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400">
                      {profile.websiteInsight}
                    </span>
                  )}
                </div>
              ) : (
                <div className="mt-1 flex items-center gap-1.5 min-w-0">
                  <svg className="w-3.5 h-3.5 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span className="truncate text-xs text-zinc-500 dark:text-zinc-400">{t('assistant.noWebsite')}</span>
                </div>
              )}
            </div>
            <button
              onClick={onNewCall}
              disabled={generating}
              className="shrink-0 flex items-center gap-1.5 px-3 py-1.5 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white text-xs font-medium rounded-lg hover:from-emerald-400 hover:to-emerald-500 transition-all shadow shadow-emerald-500/20 active:scale-[0.98] disabled:opacity-60 disabled:cursor-wait"
            >
              {generating ? (
                <svg className="animate-spin w-3.5 h-3.5" viewBox="0 0 24 24" fill="none"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
              ) : (
                <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              )}
              {generating ? t('assistant.generatingProfileShort') : t('assistant.generateProfileShort')}
            </button>
          </div>
        </div>
      )}

      {/* Messages */}
      <div className="flex-1 overflow-y-auto p-4 space-y-3">
        {loading ? (
          <p className="text-sm text-zinc-400 text-center py-8">{t('assistant.loading')}</p>
        ) : messages.length === 0 && !sending ? (
          <div className="text-center py-16 px-4">
            <div className="mb-4 flex justify-center">
              <svg className="w-14 h-14 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5} strokeLinecap="round" strokeLinejoin="round">
                <path d="m11 17 2 2a1 1 0 1 0 3-3" />
                <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" />
                <path d="m21 3 1 11h-2" />
                <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" />
                <path d="M3 4h8" />
              </svg>
            </div>
            <h3 className="text-base font-semibold text-gray-900 dark:text-white mb-1">{t('assistant.openingTitle')}</h3>
            <p className="text-sm text-zinc-400 max-w-sm mx-auto">{t('assistant.openingDesc')}</p>
          </div>
        ) : (
          <>
            {messages.map(m => (
              <div key={m.id} className={`flex ${m.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                <div
                  className={`max-w-[85%] sm:max-w-[75%] px-4 py-2.5 rounded-2xl text-sm leading-relaxed whitespace-pre-wrap transition-colors ${
                    m.role === 'user'
                      ? 'bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-br-md shadow-md shadow-emerald-500/20'
                      : 'bg-gray-100 dark:bg-zinc-700/60 text-gray-900 dark:text-zinc-100 rounded-bl-md border border-gray-200 dark:border-zinc-700/50'
                  }`}
                >
                  {m.content}
                </div>
              </div>
            ))}
            {ended && (
              <div className="flex justify-center pt-1">
                <span className="text-[11px] text-zinc-400 dark:text-zinc-500">{t('assistant.prospectEndedText')}</span>
              </div>
            )}
            {sending && streamingText && (
              <div className="flex justify-start">
                <div className="max-w-[85%] sm:max-w-[75%] px-4 py-2.5 rounded-2xl rounded-bl-md text-sm leading-relaxed whitespace-pre-wrap bg-gray-100 dark:bg-zinc-700/60 text-gray-900 dark:text-zinc-100 border border-gray-200 dark:border-zinc-700/50">
                  {streamingText}
                  <span className="inline-block w-2 h-4 ml-0.5 align-text-bottom bg-emerald-400 animate-pulse" />
                </div>
              </div>
            )}
            {sending && !streamingText && (
              <div className="flex justify-start">
                <div className="flex items-center gap-2 px-4 py-2.5 rounded-2xl rounded-bl-md bg-gray-100 dark:bg-zinc-700/60 border border-gray-200 dark:border-zinc-700/50">
                  <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce" style={{ animationDelay: '0ms' }} />
                  <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce" style={{ animationDelay: '150ms' }} />
                  <span className="w-2 h-2 bg-zinc-400 rounded-full animate-bounce" style={{ animationDelay: '300ms' }} />
                </div>
              </div>
            )}
          </>
        )}

        {error && (
          <div className="px-4 py-2.5 bg-red-500/10 border border-red-500/30 rounded-xl text-sm text-red-400">
            {error}
          </div>
        )}
        <div ref={bottomRef} />
      </div>

      {/* Input */}
      <div className="p-3 border-t border-gray-200 dark:border-zinc-700/50">
        <form onSubmit={e => { e.preventDefault(); send(); }} className="flex items-center gap-2">
          <input
            ref={inputRef}
            value={input}
            onChange={e => setInput(e.target.value)}
            placeholder={ended ? t('assistant.callEndedPlaceholder') : t('assistant.placeholder')}
            disabled={sending || ended}
            className="flex-1 px-4 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm disabled:opacity-50"
          />
          <button
            type="submit"
            disabled={sending || ended || !input.trim()}
            className="shrink-0 px-4 py-2.5 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-medium rounded-xl hover:from-emerald-400 hover:to-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-lg shadow-emerald-500/20 active:scale-[0.98]"
          >
            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
          </button>
        </form>
      </div>
    </div>
  );
}

export default function AssistantPage() {
  const { t } = useTranslation();
  const { toast, confirm } = useToast();
  const [chats, setChats] = useState<ChatLite[]>([]);
  const [loadingChats, setLoadingChats] = useState(true);
  const [activeId, setActiveId] = useState<string | null>(null);
  const [generating, setGenerating] = useState(false);

  useEffect(() => {
    fetch('/api/chats')
      .then(r => r.json())
      .then(data => {
        const list: ChatLite[] = data.chats || [];
        setChats(list);
        if (list.length > 0) {
          setActiveId(prev => (prev && list.some(c => c.id === prev) ? prev : list[0].id));
        }
      })
      .catch(() => setChats([]))
      .finally(() => setLoadingChats(false));
  }, []);

  function refreshChats() {
    fetch('/api/chats')
      .then(r => r.json())
      .then(data => {
        const list: ChatLite[] = data.chats || [];
        setChats(list);
        setActiveId(prev => (prev && list.some(c => c.id === prev) ? prev : (list[0]?.id ?? null)));
      })
      .catch(() => {});
  }

  async function newChat() {
    if (generating) return;
    setGenerating(true);
    try {
      const res = await fetch('/api/chats', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ generateProfile: true }),
      });
      const data = await res.json();
      const chat: ChatLite = data.chat;
      setChats(prev => [chat, ...prev]);
      setActiveId(chat.id);
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setGenerating(false);
    }
  }

  async function deleteChat(id: string) {
    if (!(await confirm({ message: t('assistant.deleteConfirm') }))) return;
    await fetch(`/api/chats?id=${id}`, { method: 'DELETE' }).catch(() => {});
    const next = chats.filter(c => c.id !== id);
    setChats(next);
    if (activeId === id) {
      setActiveId(next.length > 0 ? next[0].id : null);
    }
  }

  const activeChat = chats.find(c => c.id === activeId) || null;

  return (
    <div className="shrink-0 h-[calc(100dvh-var(--lm-navbar-h))] overflow-hidden bg-gradient-to-br from-gray-100 via-white to-gray-50 dark:from-zinc-900 dark:via-zinc-800 dark:to-zinc-900 transition-colors flex flex-col">
      <SetNavbar title={t('assistant.title')} subtitle={t('assistant.subtitle')} />
      <main className="app-page flex-1 flex flex-col min-h-0">
        <div className="flex gap-4 flex-1 min-h-0">
          {/* Chat list */}
          <aside className="hidden md:flex w-64 shrink-0 flex-col border border-gray-200 dark:border-zinc-700/50 rounded-xl bg-white dark:bg-zinc-800/40 overflow-hidden">
            <div className="flex-1 overflow-y-auto p-2 space-y-1">
              {loadingChats ? (
                <p className="px-3 py-2 text-xs text-zinc-400">{t('assistant.loading')}</p>
              ) : chats.length === 0 ? (
                <p className="px-3 py-2 text-xs text-zinc-400">{t('assistant.noChats')}</p>
              ) : (
                chats.map(chat => (
                  <div key={chat.id} className={`group flex items-center rounded-lg transition-all ${activeId === chat.id ? 'bg-emerald-500/10' : 'hover:bg-gray-100 dark:hover:bg-zinc-800'}`}>
                    <button
                      onClick={() => setActiveId(chat.id)}
                      className="flex-1 min-w-0 flex items-center gap-2 px-3 py-2 text-left"
                    >
                      <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0" />
                      <span className="truncate text-sm text-gray-700 dark:text-zinc-200">{chat.title}</span>
                    </button>
                    <button
                      onClick={() => deleteChat(chat.id)}
                      className="p-1.5 mr-1 text-zinc-400 opacity-0 group-hover:opacity-100 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-all shrink-0"
                      title={t('assistant.deleteChat')}
                    >
                      <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </div>
                ))
              )}
            </div>
          </aside>

          {/* Chat area */}
          <div className="flex-1 min-w-0 flex flex-col min-h-0">
            <div className="md:hidden flex items-center gap-2 p-3 mb-1 border border-gray-200 dark:border-zinc-700/50 rounded-xl bg-white dark:bg-zinc-800/40">
              <button
                onClick={() => newChat()}
                disabled={generating}
                className="px-3 py-1.5 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-medium rounded-lg hover:from-emerald-400 hover:to-emerald-500 transition-all shadow shadow-emerald-500/20 text-xs flex items-center gap-1.5 shrink-0 disabled:opacity-60 disabled:cursor-wait"
              >
                {generating ? (
                  <svg className="animate-spin w-3.5 h-3.5" viewBox="0 0 24 24" fill="none"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                ) : (
                  <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                )}
                {generating ? t('assistant.generatingProfileShort') : t('assistant.generateProfileShort')}
              </button>
              <span className="text-xs text-zinc-400 truncate">{activeChat?.title || t('assistant.noChatSelected')}</span>
            </div>

            {activeId === null ? (
              <div className="flex-1 min-w-0 flex flex-col border border-gray-200 dark:border-zinc-700/50 rounded-xl bg-white dark:bg-zinc-800/40 items-center justify-center text-center py-16 px-4">
                <div className="mb-4 flex justify-center">
                  <svg className="w-14 h-14 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5} strokeLinecap="round" strokeLinejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                </div>
                <h3 className="text-base font-semibold text-gray-900 dark:text-white mb-1">{t('assistant.noChats')}</h3>
                <p className="text-sm text-zinc-400 mb-6 max-w-sm mx-auto">{t('assistant.noChatsDesc')}</p>
                <button
                  onClick={() => newChat()}
                  disabled={generating}
                  className="px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-medium rounded-xl hover:from-emerald-400 hover:to-emerald-500 transition-all shadow-lg shadow-emerald-500/20 active:scale-[0.98] disabled:opacity-60 disabled:cursor-wait text-sm flex items-center gap-2"
                >
                  {generating ? (
                    <svg className="animate-spin w-4 h-4" viewBox="0 0 24 24" fill="none"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                  ) : (
                    <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                  )}
                  {generating ? t('assistant.generatingProfile') : t('assistant.generateProfile')}
                </button>
              </div>
            ) : (
              <ChatView key={activeId} chatId={activeId} onUpdated={refreshChats} onNewCall={newChat} generating={generating} />
            )}
          </div>
        </div>
      </main>
    </div>
  );
}
