const { app } = require('electron');
const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const config = require('./update-config');

const EXCLUDES = ['node_modules', 'data', 'build', '.env', 'release', 'electron', 'package.json'];

function logFile(...args) {
  try {
    const dir = app.isPackaged ? app.getPath('userData') : __dirname;
    fs.mkdirSync(dir, { recursive: true });
    fs.appendFileSync(
      path.join(dir, 'updater.log'),
      new Date().toISOString() + ' [updater] ' + args.map(String).join(' ') + '\n',
    );
  } catch {}
}

async function fetchWithRetry(url, opts = {}, retries = 3) {
  let lastErr;
  for (let attempt = 0; attempt < retries; attempt++) {
    try {
      const res = await fetch(url, opts);
      if (res.ok) return res;
      lastErr = new Error('HTTP ' + res.status);
      if (res.status !== 429 && res.status < 500) return res;
    } catch (err) {
      lastErr = err;
    }
    const wait = 800 * Math.pow(2, attempt);
    logFile(
      `retrying ${url.split('/').slice(-2).join('/')} (${attempt + 1}/${retries}) after ${wait}ms: ${lastErr.message}`,
    );
    await new Promise((r) => setTimeout(r, wait));
  }
  throw lastErr;
}

function serverDir() {
  if (app.isPackaged) {
    return path.join(app.getPath('userData'), 'app');
  }
  return path.join(__dirname, '..', '.next', 'standalone');
}

function appDir() {
  return path.join(app.getPath('userData'), 'app');
}

function nodeModulesDir() {
  if (app.isPackaged) {
    return path.join(process.resourcesPath, 'app', 'node_modules');
  }
  return path.join(__dirname, '..', '.next', 'standalone', 'node_modules');
}

function localManifestPath() {
  return path.join(app.getPath('userData'), 'local-manifest.json');
}

function sha256(buf) {
  return crypto.createHash('sha256').update(buf).digest('hex');
}

function walk(dir, relPrefix = '', isRoot = true) {
  const out = [];
  if (!fs.existsSync(dir)) return out;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    if (isRoot && EXCLUDES.includes(entry.name)) continue;
    if (entry.isSymbolicLink()) continue;
    const rel = relPrefix ? path.join(relPrefix, entry.name) : entry.name;
    if (entry.isDirectory()) {
      out.push(...walk(path.join(dir, entry.name), rel, false));
    } else {
      out.push(rel);
    }
  }
  return out;
}

function buildManifest(dir) {
  const files = {};
  for (const rel of walk(dir)) {
    const abs = path.join(dir, rel);
    files[rel.split(path.sep).join('/')] = sha256(fs.readFileSync(abs));
  }
  return files;
}

function copyDirExcluding(src, dst) {
  const root = src;
  fs.cpSync(src, dst, {
    recursive: true,
    dereference: true,
    filter: (s) => {
      if (s === root) return true;
      const rel = path.relative(root, s).split(path.sep);
      if (EXCLUDES.includes(rel[0])) return false;
      for (let i = 0; i < rel.length - 1; i++) {
        if (rel[i] === '.next' && rel[i + 1] === 'node_modules') return false;
      }
      return true;
    },
  });
}

function removeTreeSafely(p) {
  let st;
  try {
    st = fs.lstatSync(p);
  } catch {
    return;
  }
  if (st.isSymbolicLink()) {
    fs.unlinkSync(p);
    return;
  }
  if (!st.isDirectory()) {
    fs.rmSync(p, { force: true });
    return;
  }
  for (const entry of fs.readdirSync(p, { withFileTypes: true })) {
    const abs = path.join(p, entry.name);
    const es = fs.lstatSync(abs);
    if (es.isSymbolicLink()) fs.unlinkSync(abs);
    else if (es.isDirectory()) removeTreeSafely(abs);
    else fs.rmSync(abs, { force: true });
  }
  fs.rmdirSync(p);
}

function ensureNodeModulesLink() {
  if (!app.isPackaged) return;
  const target = path.join(process.resourcesPath, 'app', 'node_modules');
  if (!fs.existsSync(target)) return;
  const link = path.join(appDir(), 'node_modules');
  try {
    if (fs.lstatSync(link).isSymbolicLink()) return;
  } catch {
    // link does not exist yet
  }
  removeTreeSafely(link);
  fs.symlinkSync(target, link, 'junction');
  console.log('[updater] node_modules linked');
}

function walkFiles(dir, out = []) {
  if (!fs.existsSync(dir)) return out;
  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
    const abs = path.join(dir, entry.name);
    if (entry.isDirectory()) walkFiles(abs, out);
    else if (entry.isFile()) out.push(abs);
  }
  return out;
}

function ensureNextNodeModulesLink() {
  if (!app.isPackaged) return;
  const idRe = /([a-zA-Z@][\w@./\\-]*-[0-9a-f]{16,32})/g;
  const ids = new Set();
  const serverDirs = [
    path.join(appDir(), '.next', 'server'),
    path.join(appDir(), '.next', 'standalone', '.next', 'server'),
  ];
  for (const serverDir of serverDirs) {
    if (!fs.existsSync(serverDir)) continue;
    for (const file of walkFiles(serverDir)) {
      let content;
      try {
        content = fs.readFileSync(file, 'utf8');
      } catch {
        continue;
      }
      for (const m of content.matchAll(idRe)) ids.add(m[1]);
    }
  }

  const linkDir = path.join(appDir(), '.next', 'node_modules');
  removeTreeSafely(linkDir);
  fs.mkdirSync(linkDir, { recursive: true });
  const baseModules = path.join(process.resourcesPath, 'app', 'node_modules');
  let created = 0;
  for (const id of ids) {
    if (id.startsWith('node_modules/')) continue;
    const realName = id.replace(/-[0-9a-f]{16,32}$/, '');
    const realTarget = path.join(baseModules, ...realName.split('/'));
    if (!fs.existsSync(realTarget)) continue;
    const dest = path.join(linkDir, ...id.split('/'));
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    try {
      fs.symlinkSync(realTarget, dest, 'junction');
      created++;
    } catch {
      // already linked
    }
  }
  if (ids.size > 0 || created > 0) {
    console.log(`[updater] .next/node_modules markers linked (${created})`);
  }
}

function ensureSeed() {
  if (!app.isPackaged) return;
  const target = appDir();
  const source = path.join(process.resourcesPath, 'app');
  if (!fs.existsSync(source)) return;
  const local = readLocal();
  const localFiles = local.files || {};
  const needSeed =
    !fs.existsSync(path.join(target, 'server.js')) || Object.keys(localFiles).length === 0;
  if (needSeed) {
    const bundled = { version: 'bundle', files: buildManifest(source) };
    logFile(
      `seeding/refreshing app directory from bundled build (bundled ${Object.keys(bundled.files).length} files)`,
    );
    fs.mkdirSync(target, { recursive: true });
    copyDirExcluding(source, target);
    fs.writeFileSync(localManifestPath(), JSON.stringify(bundled));
  }
  ensureNodeModulesLink();
  ensureNextNodeModulesLink();
}

function readLocal() {
  try {
    return JSON.parse(fs.readFileSync(localManifestPath(), 'utf8'));
  } catch {
    return { version: 'seed', files: buildManifest(appDir()) };
  }
}

function readLocalManifest() {
  return readLocal();
}

async function fetchRemoteManifest() {
  const raw = `https://raw.githubusercontent.com/${config.owner}/${config.repo}/${config.branch}/manifest.json`;
  const cdn = `https://cdn.jsdelivr.net/gh/${config.owner}/${config.repo}@${config.branch}`;
  const started = Date.now();
  try {
    logFile('fetching manifest from raw.githubusercontent');
    const res = await fetchWithRetry(raw, { signal: AbortSignal.timeout(20000) }, 2);
    if (res.ok) {
      const j = await res.json();
      logFile(
        `manifest fetched (raw) in ${Date.now() - started}ms, ${Object.keys(j.files || {}).length} files`,
      );
      return j;
    }
    if (res.status === 404) {
      logFile('manifest 404 (raw)');
      return null;
    }
    throw new Error('HTTP ' + res.status);
  } catch (err) {
    logFile('raw manifest failed: ' + err.message + ', falling back to jsDelivr');
    try {
      const res = await fetchWithRetry(`${cdn}/manifest.json`, { signal: AbortSignal.timeout(20000) }, 2);
      if (res.ok) {
        const j = await res.json();
        logFile(
          `manifest fetched (jsdelivr) in ${Date.now() - started}ms, ${Object.keys(j.files || {}).length} files`,
        );
        return j;
      }
      if (res.status === 404) {
        logFile('manifest 404 (jsdelivr)');
        return null;
      }
      throw new Error('HTTP ' + res.status);
    } catch (err2) {
      logFile('jsdelivr manifest failed: ' + err2.message);
      throw err2;
    }
  }
}

async function downloadBlob(sha) {
  const cacheDir = path.join(app.getPath('userData'), 'update-cache');
  const cached = path.join(cacheDir, sha);
  if (fs.existsSync(cached)) {
    try {
      if (sha256(fs.readFileSync(cached)) === sha) return cached;
      logFile('cache corrupted for ' + sha.slice(0, 8) + ', re-downloading');
    } catch {}
  }

  const cdn = `https://cdn.jsdelivr.net/gh/${config.owner}/${config.repo}@${config.branch}`;
  const raw = `https://raw.githubusercontent.com/${config.owner}/${config.repo}/${config.branch}/files/${sha}`;
  let buf = null;
  let lastErr = null;
  for (const url of [`${cdn}/files/${sha}`, raw]) {
    try {
      const res = await fetchWithRetry(url, { signal: AbortSignal.timeout(60000) }, 2);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      buf = Buffer.from(await res.arrayBuffer());
      break;
    } catch (err) {
      lastErr = err;
      logFile(
        `blob ${sha.slice(0, 8)} via ${url.includes('jsdelivr') ? 'cdn' : 'raw'} failed: ${err.message}`,
      );
    }
  }
  if (!buf) throw lastErr || new Error('download failed for ' + sha);
  if (sha256(buf) !== sha) throw new Error('Hash mismatch for ' + sha);
  fs.mkdirSync(cacheDir, { recursive: true });
  fs.writeFileSync(cached, buf);
  return cached;
}

async function applyUpdate(remote, onProgress = () => {}) {
  const local = readLocal();
  const remoteFiles = remote.files || {};
  const localFiles = local.files || {};

  const changed = [];
  for (const [rel, sha] of Object.entries(remoteFiles)) {
    if (localFiles[rel] !== sha) changed.push({ rel, sha });
  }
  const deleted = Object.keys(localFiles).filter((rel) => !(rel in remoteFiles));
  if (changed.length === 0 && deleted.length === 0) return { changed: 0, deleted: 0 };

  logFile(`${changed.length} file(s) changed, ${deleted.length} removed`);
  const target = appDir();
  const staging = path.join(app.getPath('userData'), 'staging');
  removeTreeSafely(staging);

  let cumulativeBytes = 0;
  for (let i = 0; i < changed.length; i++) {
    const { rel, sha } = changed[i];
    const src = await downloadBlob(sha);
    let bytes = 0;
    try {
      bytes = fs.statSync(src).size;
    } catch {}
    cumulativeBytes += bytes;
    onProgress({
      index: i + 1,
      total: changed.length,
      rel,
      sha,
      bytes,
      cumulativeBytes,
    });
    const dest = path.join(staging, rel);
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    fs.copyFileSync(src, dest);
  }
  for (const { rel } of changed) {
    const dest = path.join(target, rel);
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    fs.copyFileSync(path.join(staging, rel), dest);
  }
  for (const rel of deleted) {
    const dest = path.join(target, rel);
    if (fs.existsSync(dest)) fs.rmSync(dest, { force: true });
  }

  removeTreeSafely(staging);
  fs.writeFileSync(localManifestPath(), JSON.stringify(remote));
  ensureNextNodeModulesLink();
  logFile(`apply finished: ${changed.length} new/changed, ${deleted.length} removed, ${cumulativeBytes} bytes downloaded`);

  try {
    const actual = buildManifest(target);
    const missing = Object.keys(remoteFiles).filter((rel) => actual[rel] !== remoteFiles[rel]);
    const extra = Object.keys(actual).filter((rel) => !(rel in remoteFiles));
    if (missing.length > 0 || extra.length > 0) {
      logFile(`verification: ${missing.length} mismatched, ${extra.length} extra file(s)`);
    } else {
      logFile('verification: local files match remote manifest');
    }
  } catch (err) {
    console.warn('[updater] verification skipped:', err.message);
  }

  return { changed: changed.length, deleted: deleted.length };
}

function diffTotals(remote) {
  const local = readLocal();
  const remoteFiles = remote.files || {};
  const localFiles = local.files || {};
  const changed = [];
  for (const [rel, sha] of Object.entries(remoteFiles)) {
    if (localFiles[rel] !== sha) changed.push({ rel, sha });
  }
  const deleted = Object.keys(localFiles).filter((rel) => !(rel in remoteFiles));
  return { changed, deleted, total: changed.length + deleted.length };
}

async function fetchBlobSizes(changed) {
  const cacheDir = path.join(app.getPath('userData'), 'update-cache');
  const cdn = `https://cdn.jsdelivr.net/gh/${config.owner}/${config.repo}@${config.branch}`;
  const raw = `https://raw.githubusercontent.com/${config.owner}/${config.repo}/${config.branch}`;
  const queue = [...changed];
  let total = 0;
  let processed = 0;
  let known = true;
  const worker = async () => {
    while (queue.length) {
      const { sha } = queue.shift();
      let size = null;
      const cached = path.join(cacheDir, sha);
      if (fs.existsSync(cached)) {
        size = fs.statSync(cached).size;
      } else {
        for (const url of [`${raw}/files/${sha}`, `${cdn}/files/${sha}`]) {
          try {
            const res = await fetch(url, { method: 'HEAD', signal: AbortSignal.timeout(6000) });
            const len = res.headers.get('content-length');
            if (res.ok && len) {
              size = Number(len);
              break;
            }
          } catch {}
        }
      }
      if (size == null || Number.isNaN(size)) known = false;
      else total += size;
      processed++;
    }
  };
  const workers = [];
  for (let i = 0; i < Math.min(16, changed.length); i++) workers.push(worker());
  await Promise.race([Promise.all(workers), new Promise((r) => setTimeout(r, 15000))]);
  if (processed < changed.length) return null;
  return known ? total : null;
}

async function checkForUpdates(onStatus = () => {}) {
  if (!app.isPackaged) {
    logFile('skipping (dev mode)');
    return { status: 'up-to-date' };
  }
  ensureSeed();
  logFile('checking for updates...');
  onStatus({ type: 'checking' });
  let remote;
  try {
    remote = await fetchRemoteManifest();
    if (!remote) {
      logFile('no update channel published yet');
      onStatus({ type: 'up-to-date' });
      return { status: 'up-to-date' };
    }
  } catch (err) {
    logFile('could not fetch manifest: ' + err.message);
    onStatus({ type: 'error', message: err.message });
    return { status: 'error', message: err.message };
  }

  const { changed, deleted, total } = diffTotals(remote);
  logFile(
    `local manifest: ${Object.keys(readLocal().files || {}).length} files, remote: ${Object.keys(remote.files || {}).length} files`,
  );
  if (total === 0) {
    logFile('up to date');
    onStatus({ type: 'up-to-date' });
    return { status: 'up-to-date', remote };
  }

  logFile(`update available: ${changed.length} file(s) changed, ${deleted.length} removed`);
  const size = await fetchBlobSizes(changed);
  logFile(`download size: ${size == null ? 'unknown' : size + ' bytes'}`);
  onStatus({
    type: 'available',
    totals: { changed: changed.length, deleted: deleted.length, total },
    size,
  });
  return { status: 'available', totals: { changed: changed.length, deleted: deleted.length, total }, size, remote };
}

module.exports = {
  serverDir,
  nodeModulesDir,
  ensureSeed,
  checkForUpdates,
  applyUpdate,
  readLocalManifest,
};
