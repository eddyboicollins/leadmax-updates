import { readJSON, getCampaign, getLead } from '@/lib/store';
import type { LeadGeneration } from '@/lib/types';

export async function GET() {
  const { GENERATIONS_FILE } = await import('@/lib/store');
  const generations = await readJSON<LeadGeneration[]>(GENERATIONS_FILE, []);

  const enriched = await Promise.all(generations.map(async (gen) => {
    const campaign = await getCampaign(gen.campaignId);
    const lead = await getLead(gen.leadId);
    return {
      ...gen,
      businessName: lead?.business?.name || 'Unknown',
      campaignName: campaign?.displayName || 'Unknown Campaign',
    };
  }));

  enriched.sort((a, b) => new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime());

  return Response.json(enriched);
}
