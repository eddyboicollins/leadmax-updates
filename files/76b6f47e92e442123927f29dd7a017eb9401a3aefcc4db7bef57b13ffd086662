/**
 * Plain HTTP client for Google endpoints (Maps, Gemini) — the Node twin of the
 * PHP version's cURL calls. No browser: one HTTPS request per call.
 *
 * Built on node:https instead of fetch() because Google's pages send response
 * headers larger than undici's 16 KB limit (gemini.google.com/app fails with
 * UND_ERR_HEADERS_OVERFLOW unless the whole process runs with a raised
 * --max-http-header-size, which the packaged app doesn't).
 */
import http from 'http';
import https from 'https';
import zlib from 'zlib';

export const UA =
  'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36';

/** Pre-answered cookie banner, so EU visitors don't get consent.google.com instead of data. */
export const CONSENT_COOKIE = 'SOCS=CAESEwgDEgk0ODE3Nzk3MjQaAmVuIAEaBgiA_LyaBg; CONSENT=YES+';

const MAX_HEADER_SIZE = 256 * 1024;

export interface HttpOptions {
  method?: 'GET' | 'POST';
  headers?: Record<string, string>;
  body?: string;
  /** Whole-request ceiling. */
  timeoutMs?: number;
  /** No byte received for this long → the request fails (slow but alive is fine). */
  idleTimeoutMs?: number;
  maxRedirects?: number;
  signal?: AbortSignal;
  /** Streaming: called with each decoded text chunk as it arrives. */
  onText?: (chunk: string) => void;
}

export interface HttpResponse {
  status: number;
  headers: http.IncomingHttpHeaders;
  /** Raw (decompressed) body. Empty when onText consumed the stream. */
  body: Buffer;
  finalUrl: string;
  /** "name=value" pairs from every Set-Cookie on the way (redirects included). */
  cookies: string[];
  text(): string;
}

function decoder(res: http.IncomingMessage): NodeJS.ReadableStream {
  switch (String(res.headers['content-encoding'] || '').toLowerCase()) {
    case 'gzip': return res.pipe(zlib.createGunzip());
    case 'deflate': return res.pipe(zlib.createInflate());
    case 'br': return res.pipe(zlib.createBrotliDecompress());
    default: return res;
  }
}

function once(url: string, opts: HttpOptions, deadline: number): Promise<{ res: http.IncomingMessage; req: http.ClientRequest }> {
  return new Promise((resolve, reject) => {
    const u = new URL(url);
    const mod = u.protocol === 'http:' ? http : https;
    const headers: Record<string, string> = {
      'User-Agent': UA,
      'Accept-Language': 'en-US,en;q=0.9',
      'Accept-Encoding': 'gzip, deflate, br',
      Accept: '*/*',
      ...opts.headers,
    };
    if (opts.body != null) headers['Content-Length'] = String(Buffer.byteLength(opts.body));
    const req = mod.request(u, {
      method: opts.method || 'GET',
      headers,
      maxHeaderSize: MAX_HEADER_SIZE,
      timeout: opts.idleTimeoutMs ?? 30_000,
    });
    // A Stop must not wait for the first byte (Gemini can think for a minute before answering).
    const onAbort = () => req.destroy(Object.assign(new Error('Cancelled'), { name: 'AbortError' }));
    opts.signal?.addEventListener('abort', onAbort, { once: true });
    req.on('response', res => {
      opts.signal?.removeEventListener('abort', onAbort);
      resolve({ res, req });
    });
    req.on('timeout', () => req.destroy(new Error(`no response for ${Math.round((opts.idleTimeoutMs ?? 30_000) / 1000)}s`)));
    req.on('error', err => {
      opts.signal?.removeEventListener('abort', onAbort);
      reject(err);
    });
    const left = deadline - Date.now();
    if (left <= 0) req.destroy(new Error('timed out'));
    if (opts.body != null) req.write(opts.body);
    req.end();
  });
}

export async function httpRequest(url: string, opts: HttpOptions = {}): Promise<HttpResponse> {
  const deadline = Date.now() + (opts.timeoutMs ?? 30_000);
  const cookies: string[] = [];
  let current = url;
  let method = opts.method || 'GET';
  let body = opts.body;
  const abortErr = () => Object.assign(new Error('Cancelled'), { name: 'AbortError' });
  if (opts.signal?.aborted) throw abortErr();

  for (let hop = 0; ; hop++) {
    const { res, req } = await once(current, { ...opts, method, body }, deadline);
    for (const c of res.headers['set-cookie'] || []) cookies.push(c.split(';')[0]);
    const loc = res.headers.location;
    if (res.statusCode && res.statusCode >= 300 && res.statusCode < 400 && loc && hop < (opts.maxRedirects ?? 5)) {
      res.resume();
      current = new URL(loc, current).toString();
      if (res.statusCode !== 307 && res.statusCode !== 308) { method = 'GET'; body = undefined; }
      continue;
    }

    return await new Promise<HttpResponse>((resolve, reject) => {
      const parts: Buffer[] = [];
      const stream = decoder(res);
      const td = new TextDecoder();
      const total = setTimeout(() => req.destroy(new Error('timed out')), Math.max(0, deadline - Date.now()));
      const onAbort = () => req.destroy(abortErr());
      opts.signal?.addEventListener('abort', onAbort, { once: true });
      const finish = (err?: Error) => {
        clearTimeout(total);
        opts.signal?.removeEventListener('abort', onAbort);
        if (err) return reject(err);
        const buf = Buffer.concat(parts);
        resolve({
          status: res.statusCode || 0,
          headers: res.headers,
          body: buf,
          finalUrl: current,
          cookies,
          text: () => buf.toString('utf8'),
        });
      };
      stream.on('data', (chunk: Buffer) => {
        if (opts.onText) {
          const s = td.decode(chunk, { stream: true });
          if (s) opts.onText(s);
        } else {
          parts.push(chunk);
        }
      });
      stream.on('end', () => {
        if (opts.onText) {
          const s = td.decode();
          if (s) opts.onText(s);
        }
        finish();
      });
      stream.on('error', err => finish(err));
      req.on('error', err => finish(err));
      res.on('aborted', () => finish(new Error('connection closed mid-response')));
    });
  }
}

/** GET with retries on network errors / 5xx (never on 429 or a captcha — asking again makes it worse). */
export async function httpGet(url: string, opts: HttpOptions & { attempts?: number } = {}): Promise<HttpResponse> {
  const attempts = opts.attempts ?? 3;
  let lastErr: unknown;
  for (let i = 1; i <= attempts; i++) {
    try {
      const res = await httpRequest(url, opts);
      if (res.status < 500 || i === attempts) return res;
    } catch (err) {
      if ((err as Error)?.name === 'AbortError') throw err;
      lastErr = err;
      if (i === attempts) throw err;
    }
    await new Promise(r => setTimeout(r, 1500 * i));
  }
  throw lastErr;
}

/** Why this answer means Google is pushing back, or null when it doesn't. */
export function googleBlockSignal(status: number, body: string): string | null {
  if (status === 429) return 'HTTP 429';
  const head = body.slice(0, 20_000);
  if (head.includes('/sorry/') || /unusual traffic/i.test(head)) return `captcha (HTTP ${status})`;
  if (head.includes('consent.google.')) return `consent page (HTTP ${status})`;
  if (status === 403) return 'HTTP 403';
  return null;
}
