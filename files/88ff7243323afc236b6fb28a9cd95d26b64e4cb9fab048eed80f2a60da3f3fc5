import { NextRequest, NextResponse } from 'next/server';
import { getSettings } from '@/lib/store';
import { checkVercelNameAvailability } from '@/lib/vercel-deploy';

export async function GET(request: NextRequest) {
  try {
    const { searchParams } = new URL(request.url);
    const name = (searchParams.get('name') || '').trim();

    const settings = await getSettings();
    if (!settings.vercelToken) {
      return NextResponse.json({ error: 'No Vercel token configured' }, { status: 400 });
    }
    if (!name) {
      return NextResponse.json({ error: 'Name is required' }, { status: 400 });
    }

    const availability = await checkVercelNameAvailability(settings.vercelToken, name);
    if (availability === 'invalid') {
      return NextResponse.json(
        { error: 'Invalid name. Use lowercase letters, numbers and hyphens only.' },
        { status: 400 },
      );
    }
    return NextResponse.json({ name, available: availability === 'available' });
  } catch (err: unknown) {
    const message = err instanceof Error ? err.message : 'Availability check failed';
    return NextResponse.json({ error: message }, { status: 500 });
  }
}
