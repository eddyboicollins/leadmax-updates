      </div>

      {/* Modify Studio: fullscreen chat + live preview */}
      {studioLeadId && (() => {
        const sl = allLeads.find((l: any) => l.id === studioLeadId);
        if (!sl) return null;
        const liveJob = generation.jobs.find(j => j.leadId === sl.id && j.kind === 'modify' && j.phase !== 'done' && j.phase !== 'error') || null;
        return (
          <ModifyStudio
            businessName={sl.business.name}
            mainUrl={mainSiteUrl(sl)}
            history={sl.deploymentHistory || []}
            images={activeImages(sl.images)}
            uploading={uploading}
            liveJob={liveJob}
            onSend={sendStudioPrompt}
            onUploadImages={(files) => uploadFilesForLead(sl, files)}
            onDeleteImage={(imageId) => deleteLeadImage(sl.id, imageId)}
            onSetMain={(entryId) => setMainDeployment(sl.id, entryId)}
            onClose={closeStudio}
          />
        );
      })()}

      {/* Add Clients Modal (manual campaigns) */}
      {showAddClients && (
        <div className="fixed inset-0 z-[110] bg-black/70 flex items-center justify-center p-4" onClick={() => { if (!resolvingClients) setShowAddClients(false); }}>
          <div className="bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-2xl w-full max-w-lg overflow-hidden shadow-2xl" onClick={e => e.stopPropagation()}>
            <div className="flex items-center justify-between px-5 py-4 border-b border-zinc-200 dark:border-zinc-700">
              <div>
                <h3 className="text-sm font-semibold text-zinc-900 dark:text-white">{t('campaign.addClients')}</h3>
                <p className="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{t('home.ownClientsDesc')}</p>
              </div>
              <button onClick={() => { if (!resolvingClients) setShowAddClients(false); }} className="p-1 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-700 rounded-lg transition-all">
                <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
            <div className="p-5 space-y-3 max-h-[60vh] overflow-y-auto">
              {manualRows.map((r, i) => (
                <div key={i} className="flex gap-2 items-end">
                  <div className="flex-1 min-w-0 grid gap-2 grid-cols-2">
                    <div>
                      <label className="block text-[10px] font-medium text-zinc-500 dark:text-zinc-400 mb-1 uppercase tracking-wider">{t('home.businessName')}</label>
                      <input
                        value={r.name}
                        onChange={e => updateManualRow(i, { name: e.target.value })}
                        placeholder={t('home.businessNamePlaceholder')}
                        disabled={resolvingClients}
                        className="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-lg text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm disabled:opacity-50"
                      />
                    </div>
                    <div>
                      <label className="block text-[10px] font-medium text-zinc-500 dark:text-zinc-400 mb-1 uppercase tracking-wide">{t('home.mapsLink')}</label>
                      <input
                        value={r.mapsUrl}
                        onChange={e => updateManualRow(i, { mapsUrl: e.target.value })}
                        placeholder={t('home.mapsLinkPlaceholder')}
                        disabled={resolvingClients}
                        className="w-full px-3 py-2 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-lg text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm disabled:opacity-50"
                      />
                    </div>
                  </div>
                  <button onClick={() => setManualRows(prev => (prev.length <= 1 ? prev : prev.filter((_, idx) => idx !== i)))} disabled={resolvingClients || manualRows.length === 1} className="p-2 text-zinc-400 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-all disabled:opacity-30 disabled:cursor-not-allowed shrink-0 mb-0.5" title={t('home.removeBusiness')}>
                    <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" /></svg>
                  </button>
                </div>
