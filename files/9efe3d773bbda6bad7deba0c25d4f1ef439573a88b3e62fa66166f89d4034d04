'use client';

import { useState, useEffect, useCallback } from 'react';
import { useTranslation } from 'react-i18next';

const PROMO_URL = 'https://countdown.leadmaxhq.com/';
const TOTAL = 3;

function Arrow({ dir, rtl, onClick }: { dir: 'prev' | 'next'; rtl: boolean; onClick: () => void }) {
  const isPrev = dir === 'prev';
  // LTR: prev on the left pointing left, next on the right pointing right.
  // RTL: flipped — prev on the right pointing right, next on the left pointing left.
  const flip = isPrev ? !rtl : rtl;
  return (
    <button
      type="button"
      onClick={onClick}
      aria-label={dir}
      className="absolute top-1/2 -translate-y-1/2 z-20 hidden sm:flex items-center justify-center w-9 h-9 rounded-full bg-white/15 hover:bg-white/25 text-white transition-all"
      style={flip ? { left: 12 } : { right: 12 }}
    >
      <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
        {flip ? (
          <path strokeLinecap="round" strokeLinejoin="round" d="M15 19l-7-7 7-7" />
        ) : (
          <path strokeLinecap="round" strokeLinejoin="round" d="M9 5l7 7-7 7" />
        )}
      </svg>
    </button>
  );
}

function Cta({ label, rtl }: { label: string; rtl: boolean }) {
  return (
    <span className="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold text-emerald-700 bg-white hover:bg-emerald-50 rounded-xl shadow-lg shadow-emerald-900/20 transition-all">
      {label}
      <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
        {rtl ? (
          <path strokeLinecap="round" strokeLinejoin="round" d="M19 12H5M11 18l-6-6 6-6" />
        ) : (
          <path strokeLinecap="round" strokeLinejoin="round" d="M5 12h14M13 6l6 6-6 6" />
        )}
      </svg>
    </span>
  );
}

export default function LeadMax3Promo() {
  const { t, i18n } = useTranslation();
  const rtl = i18n.language?.toLowerCase().startsWith('ar');
  const [index, setIndex] = useState(0);

  const go = useCallback((i: number) => setIndex(((i % TOTAL) + TOTAL) % TOTAL), []);

  useEffect(() => {
    const id = setInterval(() => setIndex(i => (i + 1) % TOTAL), 7000);
    return () => clearInterval(id);
  }, []);

  return (
    <div className="relative mb-6 sm:mb-8 overflow-hidden rounded-2xl border border-emerald-500/20 shadow-lg shadow-emerald-500/10">
      {/* Animated green motion background */}
      <div className="absolute inset-0 bg-gradient-to-br from-emerald-500 via-emerald-600 to-teal-800" />
      <div className="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-emerald-300/40 blur-3xl promo-blob-1" />
      <div className="absolute -bottom-32 -right-16 w-[28rem] h-[28rem] rounded-full bg-teal-300/30 blur-3xl promo-blob-2" />
      <div className="absolute top-1/3 right-1/4 w-72 h-72 rounded-full bg-lime-300/25 blur-3xl promo-blob-3" />
      <div className="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-emerald-950/40" />

      <div className="relative z-10 overflow-hidden">
        <div className="flex transition-transform duration-500 ease-out" style={{ transform: `translateX(${rtl ? '' : '-'}${index * 100}%)` }}>
          {/* Slide 1 — announcement */}
          <a href={PROMO_URL} target="_blank" rel="noopener noreferrer" className="w-full shrink-0 flex min-h-[300px] flex-col items-center justify-center text-center gap-2.5 p-6 sm:p-8 md:p-10">
            <span className="inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-emerald-900 bg-white/90 border border-white/40 rounded-full backdrop-blur-sm">
              <svg className="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              {t('promo.new')}
            </span>
            <h3 className="text-2xl sm:text-3xl font-bold text-white leading-tight max-w-lg drop-shadow-md">{t('promo.slide1Title')}</h3>
            <p className="text-sm sm:text-base text-emerald-50/90 max-w-lg drop-shadow-sm">{t('promo.slide1Body')}</p>
            <div className="mt-1"><Cta label={t('promo.cta')} rtl={rtl} /></div>
          </a>

          {/* Slide 2 — why move to 3.0 */}
          <a href={PROMO_URL} target="_blank" rel="noopener noreferrer" className="w-full shrink-0 flex min-h-[300px] flex-col items-center justify-center gap-4 p-6 sm:p-8 md:p-10">
            <h3 className="text-lg sm:text-xl font-bold text-white leading-snug max-w-xl drop-shadow-md text-center">{t('promo.slide2Title')}</h3>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-xl">
              <div className="rounded-xl border border-white/20 bg-white/10 backdrop-blur-sm p-4 space-y-2">
                <div className="flex items-center justify-between gap-2">
                  <span className="text-sm font-semibold text-white/80">{t('promo.v20Label')}</span>
                  <span className="text-xs text-white/60">{t('promo.v20Price')}</span>
                </div>
                <p className="text-xs text-white/70 leading-relaxed">{t('promo.v20Static')}</p>
                <p className="text-xs text-white/60">{t('promo.v20Devices')}</p>
              </div>
              <div className="rounded-xl border border-white/40 bg-white/20 backdrop-blur-sm p-4 space-y-2">
                <div className="flex items-center justify-between gap-2">
                  <span className="text-sm font-bold text-white">{t('promo.v30Label')}</span>
                  <span className="text-xs font-bold text-emerald-100">{t('promo.v30Price')}</span>
                </div>
                <p className="text-xs text-white leading-relaxed">{t('promo.v30Devices')}</p>
              </div>
            </div>
            <div><Cta label={t('promo.cta')} rtl={rtl} /></div>
          </a>

          {/* Slide 3 — legacy */}
          <a href={PROMO_URL} target="_blank" rel="noopener noreferrer" className="w-full shrink-0 flex min-h-[300px] flex-col items-center justify-center text-center gap-4 p-6 sm:p-8 md:p-10">
            <div className="space-y-2">
              <p className="text-base sm:text-lg text-white/70">{t('promo.slide3L1')}</p>
              <p className="text-base sm:text-lg text-white/90">{t('promo.slide3L2')}</p>
              <p className="text-xl sm:text-2xl font-bold text-white drop-shadow-md">{t('promo.slide3L3')}</p>
            </div>
            <div><Cta label={t('promo.cta')} rtl={rtl} /></div>
          </a>
        </div>
      </div>

      <div className="absolute left-0 right-0 z-20 flex items-center justify-center gap-2" style={{ bottom: 12 }}>
        {Array.from({ length: TOTAL }).map((_, i) => (
          <button
            key={i}
            type="button"
            onClick={() => go(i)}
            aria-label={`slide-${i + 1}`}
            className={`h-2 rounded-full transition-all duration-300 ${i === index ? 'w-8 bg-white' : 'w-2 bg-white/50 hover:bg-white/80'}`}
          />
        ))}
      </div>

      <Arrow dir="prev" rtl={rtl} onClick={() => go(index - 1)} />
      <Arrow dir="next" rtl={rtl} onClick={() => go(index + 1)} />
    </div>
  );
}
