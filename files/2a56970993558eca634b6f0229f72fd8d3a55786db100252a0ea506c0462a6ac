  | { kind: 'frame'; loc: number; ratio: string };

/** CSS aspect-ratio for a crop: exact for the presets, rounded otherwise. */
function ratioCss(aspect: number): string {
  const presets: [number, string][] = [[1, '1 / 1'], [4 / 3, '4 / 3'], [16 / 9, '16 / 9'], [3 / 4, '3 / 4'], [3 / 2, '3 / 2'], [2 / 3, '2 / 3']];
  const hit = presets.find(([v]) => Math.abs(v - aspect) < 0.005);
  return hit ? hit[1] : String(Math.round(aspect * 10000) / 10000);
}

const toDataUrl = (html: string) => `data:text/html;charset=utf-8,${encodeURIComponent(html)}`;

/**
 * The user's request in the chat. Long ones (pasted orders, many notes) start
 * folded to a few lines, with the same arrow as the version details.
 */
function RequestBubble({ text, faded = false }: { text: string; faded?: boolean }) {
  const { t } = useTranslation();
  const long = text.length > 320 || text.split('\n').length > 6;
  const [open, setOpen] = useState(false);
  const folded = long && !open;
  return (
    <div className={`max-w-[85%] rounded-2xl rounded-br-md text-white px-3.5 py-2.5 text-[13px] leading-relaxed whitespace-pre-wrap break-words ${faded ? 'bg-emerald-600/60' : 'bg-emerald-600 shadow-sm'}`}>
      <div className={folded ? 'line-clamp-5' : undefined}>{text}</div>
      {long && (
        <button
          onClick={() => setOpen(o => !o)}
          aria-expanded={open}
          className="mt-1.5 inline-flex items-center gap-1 text-[11px] font-medium text-white/80 hover:text-white transition-colors"
        >
          <svg className={`w-3.5 h-3.5 transition-transform ${open ? '-rotate-90' : 'rotate-90'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}><path strokeLinecap="round" strokeLinejoin="round" d="M9 5l7 7-7 7" /></svg>
          {open ? t('campaign.studioShowLess') : t('campaign.studioShowMore')}
        </button>
      )}
    </div>
  );
}

function fmtDate(iso: string): string {
  try {
    const d = new Date(iso);
    return `${d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })} ${d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}`;
  } catch {
    return '';
  }
}

/** Ambient horizontal code drift (canvas, blurred emerald on black). */
function MatrixRain() {
  const ref = useRef<HTMLCanvasElement | null>(null);

  useEffect(() => {
    const canvas = ref.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const SNIPPETS = [
      'const site = await build()', 'export default function Page()', 'return (',
      '<section id="hero">', '</div>', 'useState(null)', 'useEffect(() => {',
      '=>', 'import { useState }', 'await deploy()', 'npm run deploy',
      'git push origin main', 'vercel.app', '200 OK', '✓ deployed',
      '{...props}', '.map((s) => (', 'tailwind', 'backdrop-blur-md',
      'rounded-2xl', 'font-semibold', 'async function fix()', 'try {',
      '} catch (e) {', '`', '&&', '||', '===', '?.', '/* section */',
      '<img src=', 'className="', 'fetch(url)', 'JSON.stringify(',
    ];
    const FONT = 13;
    const ROW_H = 26;
    let raf = 0;
    let rows = 0;
    let items: { x: number; y: number; speed: number; text: string; alpha: number }[] = [];

    const spawn = (i: number, anywhere = false) => {
      const text = SNIPPETS[Math.floor(Math.random() * SNIPPETS.length)];
      const w = ctx.measureText(text).width;
      items[i] = {
        x: anywhere ? Math.random() * (canvas.width + w) - w : -w - Math.random() * 200,
        y: (i % Math.max(1, rows)) * ROW_H + ROW_H * 0.7,
        speed: 10 + Math.random() * 22, // px per second — slow drift
        text,
        alpha: 0.25 + Math.random() * 0.55,
      };
    };

    const resize = () => {
      const parent = canvas.parentElement;
      if (!parent) return;
      const rect = parent.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(rect.width));
      canvas.height = Math.max(1, Math.floor(rect.height));
      rows = Math.max(1, Math.floor(canvas.height / ROW_H));
      const count = Math.min(rows, 40);
      items = new Array(count);
      for (let i = 0; i < count; i++) spawn(i, true);
      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    };
    ctx.font = `${FONT}px ui-monospace, monospace`;
    resize();
    window.addEventListener('resize', resize);

    // Static single frame for reduced-motion users.
    if (typeof window !== 'undefined' && window.matchMedia?.('(prefers-reduced-motion: reduce)').matches) {
      ctx.fillStyle = '#34d399';
      items.forEach(it => {
        ctx.globalAlpha = it.alpha;
        ctx.fillText(it.text, it.x, it.y);
      });
      ctx.globalAlpha = 1;
      return () => window.removeEventListener('resize', resize);
    }

    let last = performance.now();
    const tick = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      ctx.fillStyle = 'rgba(0, 0, 0, 0.06)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < items.length; i++) {
        const it = items[i];
        it.x += it.speed * dt;
        if (it.x > canvas.width + 40) {
          spawn(i);
          continue;
        }
        ctx.globalAlpha = it.alpha;
        ctx.fillStyle = '#34d399';
        ctx.fillText(it.text, it.x, it.y);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(tick);
    };
    raf = requestAnimationFrame(tick);

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('resize', resize);
    };
  }, []);

  return <canvas ref={ref} className="absolute inset-0 w-full h-full blur-[1.5px]" aria-hidden="true" />;
}

function Spinner({ className = 'w-10 h-10 text-emerald-500' }: { className?: string }) {
  return (
    <svg className={`animate-spin ${className}`} viewBox="0 0 24 24" fill="none">
      <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" />
      <path className="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
    </svg>
  );
}

export default function ModifyStudio({
  campaignId, leadId, businessName, mainUrl, deployments, images, uploading, liveJob, publishJob,
  lastJobVersionId, error, onDismissError, failedRequest, onRetry, onCancelJob, onSend, onPublish, onUploadImages, onDeleteImage, onSetMain, onClose,
}: ModifyStudioProps) {
  const { t } = useTranslation();
  const queryClient = useQueryClient();
  const apiBase = `/api/campaigns/${campaignId}/leads/${leadId}`;

  const { data: versionsData, isLoading: versionsLoading } = useQuery({
    queryKey: ['site-versions', leadId],
    queryFn: async () => {
      const res = await fetch(`${apiBase}/versions`);
      if (!res.ok) return [] as StudioVersion[];
      const data = await res.json();
      return (data.versions || []) as StudioVersion[];
    },
    staleTime: 5 * 1000,
  });
  const versions = useMemo(() => versionsData || [], [versionsData]);

  const [draft, setDraft] = useState('');
  // Version change details in the chat are collapsed by default.
  const [expandedIds, setExpandedIds] = useState<Set<string>>(() => new Set());
  const toggleExpanded = (id: string) => setExpandedIds(prev => {
    const next = new Set(prev);
    if (next.has(id)) next.delete(id); else next.add(id);
    return next;
  });
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [refreshNonce, setRefreshNonce] = useState(0);
  const [savedChatW, setSavedChatW] = useLocalStorageNumberPref('lm_studio_chat_w', DEFAULT_CHAT_W);
  const [dragChatW, setDragChatW] = useState<number | null>(null);
  const [dragging, setDragging] = useState(false);
  const threadRef = useRef<HTMLDivElement | null>(null);
  const splitRef = useRef<HTMLDivElement | null>(null);
  const fileRef = useRef<HTMLInputElement | null>(null);
  const inspectorFileRef = useRef<HTMLInputElement | null>(null);
  const inputRef = useRef<HTMLTextAreaElement | null>(null);
  const liveCodeRef = useRef<HTMLPreElement | null>(null);
  const iframeRef = useRef<HTMLIFrameElement | null>(null);

  // Auto-scroll the live code pane to the bottom as the code streams in.
  useLayoutEffect(() => {
    if (liveCodeRef.current) {
      liveCodeRef.current.scrollTop = liveCodeRef.current.scrollHeight;
    }
  }, [liveJob?.liveCode]);

  const autoGrowInput = () => {
    const el = inputRef.current;
    if (!el) return;
    el.style.height = '40px';
    el.style.height = Math.min(el.scrollHeight, 128) + 'px';
  };
  const dragState = useRef<{ startX: number; startW: number; rtl: boolean } | null>(null);

  const [device, setDevice] = useState<'desktop' | 'tablet' | 'phone'>('desktop');
  // 'interact' = use the page normally; 'edit' = click text/photos/links to change them.
  // ── Comment mode: queued notes, sent to the AI in one request ─────────
  const notesKey = `lm_studio_notes_${leadId}`;
  const [notes, setNotes] = useState<StudioNote[]>(() => {
    try {
      const raw = typeof window !== 'undefined' ? window.localStorage.getItem(notesKey) : null;
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  });

  // 'interact' = use the page; 'edit' = change text/photos/links directly;
  // 'comment' = pin notes to any element, queued and sent to the AI in bulk.
  const [modeState, setMode] = useState<StudioMode>('interact');
  // Visual editing is locked when:
  // - an AI or publish job runs (its edits would miss the job's result or
  //   alter the version being published). Comments stay available: queuing a
  //   note doesn't touch the code; only sending waits.
  // - notes are queued: each note pins an exact position in its version, and
  //   visual edits merge into (rewrite) the current draft version — the notes
  //   could then point at the wrong element. One kind of change per batch:
  //   prompt + notes (one AI request) OR visual edits. Send/clear notes first.
  const jobRunning = !!liveJob || !!publishJob;
  const notesPending = notes.length > 0;
  const editLocked = jobRunning || notesPending;
  const mode: StudioMode = editLocked && (modeState === 'edit' || modeState === 'images') ? 'interact' : modeState;

  // Right-pane view: 'live' (streaming generation), or the SELECTED version's
  // 'preview' / 'code'. 'live' is only selectable while a job runs, so code
  // gen never blocks inspecting an older version's preview/code.
  const [studioView, setStudioView] = useState<'live' | 'preview' | 'code'>('preview');
  const [copied, setCopied] = useState(false);
  const codeRef = useRef<HTMLPreElement | null>(null);

  // Jump to the live stream whenever a NEW AI job starts, but never fight the
  // user switching away to preview an older version mid-job.
  const prevLiveJobId = useRef<string | null>(null);
  useEffect(() => {
    const id = liveJob?.id ?? null;
    if (id && id !== prevLiveJobId.current) setStudioView('live');
    if (!id && prevLiveJobId.current) setStudioView(v => (v === 'live' ? 'preview' : v));
    prevLiveJobId.current = id;
  }, [liveJob?.id]);

  const hasLive = !!liveJob;
  const showingLive = hasLive && studioView === 'live';

  // No upper cap besides keeping a usable preview sliver: chat can grow freely.
  const chatW = Math.max(MIN_CHAT_W, dragChatW ?? savedChatW);

  const clampChatW = (w: number) => {
    const total = splitRef.current?.getBoundingClientRect().width ?? window.innerWidth;
    return Math.min(total - MIN_PREVIEW_W, Math.max(MIN_CHAT_W, w));
  };

  // Live width shown while dragging; committed to localStorage on release.
  const latestDragW = useRef<number>(chatW);

  const onDividerDown = (e: React.PointerEvent<HTMLDivElement>) => {
    e.preventDefault();
    const rtl = typeof document !== 'undefined' && document.documentElement.dir === 'rtl';
    dragState.current = { startX: e.clientX, startW: chatW, rtl };
    latestDragW.current = chatW;
    setDragging(true);
    document.body.style.cursor = 'ew-resize';
    const move = (ev: PointerEvent) => {
      const st = dragState.current;
      if (!st) return;
      // Safety: if the release was missed (e.g. over the iframe), end the drag.
      if (ev.buttons === 0) { up(); return; }
      const dx = ev.clientX - st.startX;
      const next = clampChatW(st.startW + (st.rtl ? -dx : dx));
      latestDragW.current = next;
      setDragChatW(next);
    };
    const up = () => {
      if (!dragState.current) return;
      dragState.current = null;
      setDragging(false);
      setDragChatW(null);
      setSavedChatW(latestDragW.current);
      document.body.style.cursor = '';
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      window.removeEventListener('pointercancel', up);
      window.removeEventListener('blur', up);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
    window.addEventListener('pointercancel', up);
    window.addEventListener('blur', up);
  };

  const newest = versions.length ? versions[versions.length - 1] : null;

  // Follow the newest version when one is added (AI edit, generation, fix),
  // and a finished job's version (it may be an existing one, e.g. identical
  // result). Adjusted during render — no effect round-trip.
  const [seenNewestN, setSeenNewestN] = useState<number | null>(null);
  if (newest && newest.n !== seenNewestN) {
    setSeenNewestN(newest.n);
    if (seenNewestN !== null && newest.n > seenNewestN) setSelectedId(newest.id);
  }
  const [seenJobVersionId, setSeenJobVersionId] = useState(lastJobVersionId ?? null);
  if ((lastJobVersionId ?? null) !== seenJobVersionId) {
    setSeenJobVersionId(lastJobVersionId ?? null);
    if (lastJobVersionId) setSelectedId(lastJobVersionId);
  }

  const selected: StudioVersion | null =
    (selectedId ? versions.find(v => v.id === selectedId) ?? null : null) ?? newest;

  const mainEntry = deployments.find(d => d.isMain) ?? null;
  const versionStatus = useCallback((v: StudioVersion) => {
    if (mainEntry && v.publishedEntryIds.includes(mainEntry.id)) return { state: 'live' as const };
    const entries = deployments
      .filter(d => v.publishedEntryIds.includes(d.id))
      .sort((a, b) => new Date(b.deployedAt).getTime() - new Date(a.deployedAt).getTime());
    if (entries.length) return { state: 'published' as const, entryId: entries[0].id };
    return { state: 'draft' as const };
  }, [deployments, mainEntry]);
  const selectedStatus = selected ? versionStatus(selected) : null;
  const liveVersion = versions.find(v => versionStatus(v).state === 'live') ?? null;

  const codeSource = selected?.tsx || '';

  // Reset copy feedback whenever looking at another version's code.
  useEffect(() => {
    setCopied(false);
  }, [selected?.id]);

  const copyCode = async () => {
    if (!codeSource) return;
    try {
      await navigator.clipboard.writeText(codeSource);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = codeSource;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const sourceLabel = (v: StudioVersion) => ({
    generate: t('campaign.studioSrcGenerate'),
    ai: t('campaign.studioSrcAi'),
    visual: t('campaign.studioSrcVisual'),
    fix: t('campaign.studioSrcFix'),
    import: t('campaign.studioSrcImport'),
  }[v.source]);

  const liveJobText = liveJob
    ? (liveJob.messageKey ? t(liveJob.messageKey, liveJob.messageParams) : (liveJob.message || t(liveJob.kind === 'generate' ? 'campaign.generatingSite' : 'campaign.aiModifying')))
    : '';
  const publishJobText = publishJob
    ? (publishJob.messageKey ? t(publishJob.messageKey, publishJob.messageParams) : (publishJob.message || t('campaign.deployingSite')))
    : '';

  // Keep the thread pinned to the latest message.
  useEffect(() => {
    const el = threadRef.current;
    if (el) el.scrollTop = el.scrollHeight;
  }, [versions.length, newest?.updatedAt, liveJob?.message, liveJob?.messageKey, JSON.stringify(liveJob?.messageParams), liveJob?.phase]);

  // ── Visual editing ──────────────────────────────────────────────────
  // Selection, render errors and "loaded" all belong to one displayed page
  // (version + reload + device); keying them avoids resetting state in effects.
  const [selectionState, setSelection] = useState<(Selection & { page: string }) | null>(null);
  const [linkDraft, setLinkDraft] = useState('');
  const [saving, setSaving] = useState(false);
  // Photo currently displayed in the page for the selected slot (may be ahead of
  // the saved code during quick swaps), and the latest pick waiting to be saved.
  const [shownPhoto, setShownPhoto] = useState<{ page: string; loc: number; src: string } | null>(null);
  const pendingPhotoRef = useRef<{ loc: number; newUrl: string } | null>(null);
  const [notice, setNotice] = useState<{ tone: 'error' | 'info'; text: string } | null>(null);
  const [previewErrorState, setPreviewError] = useState<{ page: string; message: string } | null>(null);
  const [loadedPage, setLoadedPage] = useState<string | null>(null);
  const [cropper, setCropper] = useState<{ sourceUrl: string; crop: NormalizedCrop | null; aspect: number; target: Selection } | null>(null);
  const [cropBusy, setCropBusy] = useState(false);
  const scrollRef = useRef(0);

  const postToPreview = useCallback((msg: Record<string, unknown>) => {
    iframeRef.current?.contentWindow?.postMessage({ lm: true, ...msg }, '*');
  }, []);

  useEffect(() => {
    postToPreview({ type: 'mode', mode: bridgeMode(mode), photoLabel: t('campaign.studioPhotoHover') });
  }, [mode, postToPreview, t]);

  // Local preview of the selected version (served by this app, no Vercel).
  const previewSrc = selected
    ? `${apiBase}/preview?${new URLSearchParams({ v: selected.id, t: selected.updatedAt }).toString()}`
    : '';
  const previewUrlFor = (v: { id: string; updatedAt: string }) =>
    `${apiBase}/preview?${new URLSearchParams({ v: v.id, t: v.updatedAt }).toString()}`;
  // Visual edits don't reload the page: the page already showing the change
  // "adopts" the saved version (map: version's doc key → doc on screen).
  // That live-edited DOM only exists in the open iframe, so the moment the
  // user moves to another version/device/refresh, adoptions are dropped and
  // `gen` bumps: every version (including the edited one, when revisited)
  // then loads fresh from its saved code.
  const [adoption, setAdoption] = useState<{ map: Record<string, string>; gen: number }>({ map: {}, gen: 0 });
  const docKeyFor = (src: string) => `${src}#${refreshNonce}#${device}#g${adoption.gen}`;
  const rawDocKey = docKeyFor(previewSrc);
  const adoptedTo = adoption.map[rawDocKey];
  const [lastRawDocKey, setLastRawDocKey] = useState(rawDocKey);
  if (rawDocKey !== lastRawDocKey) {
    setLastRawDocKey(rawDocKey);
    if (!adoptedTo && Object.keys(adoption.map).length > 0) {
      setAdoption(a => ({ map: {}, gen: a.gen + 1 }));
    }
  }
  const docKey = adoptedTo ?? rawDocKey;
  const pageKey = docKey;
  const previewLoaded = loadedPage === pageKey;

  // The page is fetched and loaded as a data: URL. data: documents ALWAYS get
  // an opaque origin (even with allow-same-origin), so generated code stays
  // isolated from the app (can't read its settings/API keys). allow-same-origin
  // only lets NESTED frames keep their real origin, which embeds such as
  // YouTube need to run. Never switch this to srcdoc/blob: with that flag —
  // those inherit the app's origin.
  const [previewDoc, setPreviewDoc] = useState<{ key: string; url: string } | null>(null);
  useEffect(() => {
    // Adopted (live-edited) pages are already on screen: nothing to fetch.
    if (!previewSrc || docKey !== rawDocKey) return;
    let cancelled = false;
    fetch(previewSrc)
      .then(r => r.text())
      .then(html => { if (!cancelled) setPreviewDoc({ key: docKey, url: toDataUrl(html) }); })
      .catch(err => {
        if (!cancelled) setPreviewDoc({ key: docKey, url: toDataUrl(`<pre style="padding:24px;color:#b91c1c">${String(err?.message || err)}</pre>`) });
      });
    return () => { cancelled = true; };
  }, [previewSrc, docKey, rawDocKey]);
  const previewDataUrl = previewDoc?.key === docKey ? previewDoc.url : null;
  const selection = mode !== 'interact' && selectionState?.page === pageKey ? selectionState : null;
  const previewError = previewErrorState?.page === pageKey ? previewErrorState.message : null;

  useEffect(() => {
    if (!notice || notice.tone === 'error') return;
    const timer = setTimeout(() => setNotice(null), 3500);
    return () => clearTimeout(timer);
  }, [notice]);

  /**
   * Save visual edit(s). `live` updates the page instantly (before the save);
   * on success the open page adopts the new version and its element positions
   * are shifted to match the new code — no reload, no scroll jump.
   */
  const applyEdit = async (
    edit: VisualEditBody | VisualEditBody[],
    live?: { kind: 'src' | 'href' | 'bgimage'; loc: number; oldValue: string; newValue: string },
  ) => {
    if (!selected) return;
    setSaving(true);
    setNotice(null);
    if (live) postToPreview({ type: 'patch-dom', ...live, selectedOnly: true });
    const shownDoc = docKey;
    try {
      const res = await fetch(`${apiBase}/versions/visual-edit`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ baseVersionId: selected.id, baseUpdatedAt: selected.updatedAt, edits: Array.isArray(edit) ? edit : [edit] }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Edit failed');
      if (data.status === 'unchanged') {
        setNotice({ tone: 'info', text: t('campaign.studioNoChange') });
        setRefreshNonce(n => n + 1);
        return;
      }
      if (data.status === 'duplicate' && data.version) {
        setNotice({ tone: 'info', text: t('campaign.studioSameAs', { v: data.version.n }) });
      }
      if (data.version?.id) {
        // Same photo/link replaced in every place it appears: update all copies on screen too.
        if (data.everywhere && live) postToPreview({ type: 'patch-dom', ...live, everywhere: true });
        postToPreview({ type: 'remap', shifts: Array.isArray(data.shifts) ? data.shifts : [] });
        const nextKey = docKeyFor(previewUrlFor(data.version));
        setAdoption(prev => ({ ...prev, map: { ...prev.map, [nextKey]: shownDoc } }));
        if (live) {
          // Keep the inspector open on the element, now showing its new value.
          setSelection(prev => (prev ? {
            ...prev,
            ...(live.kind === 'href' ? { href: live.newValue } : { src: live.newValue }),
          } : prev));
        }
      }
      await queryClient.invalidateQueries({ queryKey: ['site-versions', leadId] });
      if (data.version?.id) setSelectedId(data.version.id);
    } catch (err) {
      setNotice({ tone: 'error', text: err instanceof Error ? err.message : String(err) });
      // Revert the inline edit shown in the page.
      pendingPhotoRef.current = null;
      setShownPhoto(null);
      setRefreshNonce(n => n + 1);
    } finally {
      setSaving(false);
    }
  };

  // The message listener calls the latest applyEdit without re-subscribing.
  const applyEditRef = useRef(applyEdit);
  useEffect(() => { applyEditRef.current = applyEdit; });

  // Messages from the preview iframe.
  useEffect(() => {
    const onMessage = (e: MessageEvent) => {
      if (!iframeRef.current || e.source !== iframeRef.current.contentWindow) return;
      const d = e.data || {};
      if (!d.lm) return;
      if (d.type === 'ready') {
        setLoadedPage(pageKey);
        postToPreview({ type: 'mode', mode: bridgeMode(mode), photoLabel: t('campaign.studioPhotoHover') });
        // Keep the reader's place across reloads and version switches.
        if (scrollRef.current) postToPreview({ type: 'scroll-to', y: scrollRef.current });
      } else if (d.type === 'error') {
        setLoadedPage(pageKey);
        setPreviewError({ page: pageKey, message: String(d.message || 'Error') });
      } else if (d.type === 'scroll') {
        scrollRef.current = Number(d.y) || 0;
      } else if (d.type === 'select') {
        const sel = d as Selection;
        setSelection({ ...sel, page: pageKey });
        setLinkDraft(sel.href || '');
      } else if (d.type === 'text-commit') {
        // One commit may carry several text runs (rich heading): applied atomically.
        const edits = (Array.isArray(d.edits) ? d.edits : [])
          .filter((x: { loc?: unknown }) => typeof x?.loc === 'number')
          .map((x: { loc: number; oldText?: string; newText?: string; cardTexts?: string[] }) => ({ kind: 'text' as const, loc: x.loc, oldText: String(x.oldText || ''), newText: String(x.newText || ''), cardTexts: Array.isArray(x.cardTexts) ? x.cardTexts : undefined }));
        if (edits.length) applyEditRef.current(edits);
      }
    };
    window.addEventListener('message', onMessage);
    return () => window.removeEventListener('message', onMessage);
  }, [mode, pageKey, postToPreview, t]);

  /** The edit + live patch that swap `target`'s photo (`target.src`: the photo in the saved code). */
  const photoEdit = (target: Selection, newUrl: string) => {
    const src = target.src || '';
    return target.kind === 'bgimage'
      ? {
        edit: { kind: 'bgimage' as const, loc: target.loc, oldUrl: src, newUrl, instance: target.instance, instances: target.instances, cardTexts: target.cardTexts },
        live: { kind: 'bgimage' as const, loc: target.loc, oldValue: src, newValue: newUrl },
      }
      : {
        edit: { kind: 'attr' as const, loc: target.loc, attr: 'src' as const, oldValue: src, newValue: newUrl, instance: target.instance, instances: target.instances, cardTexts: target.cardTexts },
        live: { kind: 'src' as const, loc: target.loc, oldValue: src, newValue: newUrl },
      };
  };

  /** Save one photo swap. */
  const savePhoto = (target: Selection, newUrl: string) => {
    if (!target.src || newUrl === target.src) return;
    const { edit, live } = photoEdit(target, newUrl);
    applyEdit(edit, live);
  };

  /**
   * Swap a photo: shown instantly. If a save is already running, the pick is
   * queued and only the LATEST queued pick is saved next — quick back-and-forth
   * testing never piles up saves or hides the picker.
   */
  const replaceImage = (target: Selection, newUrl: string) => {
    if (!target.src) return;
    const shown = shownPhoto && shownPhoto.page === pageKey && shownPhoto.loc === target.loc ? shownPhoto.src : target.src;
    if (newUrl === shown) return;
    postToPreview({ type: 'patch-dom', kind: target.kind === 'bgimage' ? 'bgimage' : 'src', loc: target.loc, oldValue: shown, newValue: newUrl, selectedOnly: true });
    setShownPhoto({ page: pageKey, loc: target.loc, src: newUrl });
    if (saving) {
      pendingPhotoRef.current = { loc: target.loc, newUrl };
      return;
    }
    savePhoto(target, newUrl);
  };
  const savePhotoRef = useRef(savePhoto);
  useEffect(() => { savePhotoRef.current = savePhoto; });

  // When a save finishes, save the latest queued pick (from the now-current code).
  useEffect(() => {
    const next = pendingPhotoRef.current;
    if (saving || !next) return;
    pendingPhotoRef.current = null;
    if (selection && selection.loc === next.loc && (selection.kind === 'image' || selection.kind === 'bgimage')) {
      savePhotoRef.current(selection, next.newUrl);
    }
  }, [saving, selection]);

  /** Upload from the photo inspector; a single new photo goes straight into the selected slot. */
  const uploadFromInspector = async (target: Selection, files: File[]) => {
    const urls = await onUploadImages(files);
    if (Array.isArray(urls) && urls.length === 1 && files.length === 1) replaceImage(target, urls[0]);
  };

  const openCropper = async (target: Selection) => {
    if (!target.src) return;
    let sourceUrl = target.src;
    let crop: NormalizedCrop | null = null;
    try {
      const res = await fetch(`${apiBase}/images/crop?url=${encodeURIComponent(target.src)}`);
      if (res.ok) {
        const data = await res.json();
        sourceUrl = data.sourceUrl || target.src;
        crop = data.crop || null;
      }
    } catch { /* crop from the current image */ }
    const aspect = target.rect && target.rect.h > 0 ? target.rect.w / target.rect.h : 16 / 9;
    setCropper({ sourceUrl, crop, aspect, target });
  };

  const applyCrop = async (crop: NormalizedCrop, aspect: number) => {
    if (!cropper) return;
    setCropBusy(true);
    try {
      const res = await fetch(`${apiBase}/images/crop`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sourceUrl: cropper.sourceUrl, crop }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.url) throw new Error(data.error || 'Crop failed');
      const target = cropper.target;
      setCropper(null);
      const frameLoc = target.frameLoc;
      if (typeof frameLoc === 'number' && Math.abs(aspect - cropper.aspect) > 0.02 && target.src) {
        // New shape: the cropped photo AND its box ratio, saved together as one change.
        const ratio = ratioCss(aspect);
        const { edit, live } = photoEdit(target, data.url);
        postToPreview({ type: 'patch-dom', ...live, selectedOnly: true });
        postToPreview({ type: 'frame-ratio', loc: frameLoc, ratio });
        setShownPhoto({ page: pageKey, loc: target.loc, src: data.url });
        await applyEdit([edit, { kind: 'frame', loc: frameLoc, ratio }], live);
      } else {
        replaceImage(target, data.url);
      }
    } catch (err) {
      setNotice({ tone: 'error', text: err instanceof Error ? err.message : String(err) });
    } finally {
      setCropBusy(false);
    }
  };

  const applyLink = () => {
    if (!selection) return;
    const loc = selection.kind === 'link' || selection.tag === 'a' ? selection.loc : selection.linkLoc;
    if (typeof loc !== 'number' || selection.href === undefined) return;
    const next = linkDraft.trim();
    if (!next || next === selection.href) return;
    const own = selection.kind === 'link' || selection.tag === 'a';
    applyEdit(
      { kind: 'attr', loc, attr: 'href', oldValue: selection.href, newValue: next, instance: own ? selection.instance : selection.linkInstance, instances: own ? selection.instances : selection.linkInstances, cardTexts: selection.cardTexts },
      { kind: 'href', loc, oldValue: selection.href, newValue: next },
    );
  };

  const closeSelection = () => {
    setSelection(null);
    postToPreview({ type: 'deselect' });
  };

  // Escape: close the cropper / selection first, then the studio.
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      if (e.key !== 'Escape' || cropper) return;
      if (selection) { closeSelection(); return; }
      onClose();
    };
    window.addEventListener('keydown', onKey);
    return () => window.removeEventListener('keydown', onKey);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [onClose, cropper, selection]);

  // ── Comment mode: queued notes (state declared above, with the mode lock) ──
  useEffect(() => {
    try {
      if (notes.length) window.localStorage.setItem(notesKey, JSON.stringify(notes));
      else window.localStorage.removeItem(notesKey);
    } catch { /* storage unavailable: queue lives for this session only */ }
  }, [notes, notesKey]);
  const [notesOpen, setNotesOpen] = useState(true);
  const [noteDraft, setNoteDraft] = useState('');

  const addNote = () => {
    if (!selection || !selected || !noteDraft.trim()) return;
    setNotes(prev => [...prev, {
      id: `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 7)}`,
      versionId: selected.id,
      loc: selection.loc,
      tag: selection.tag || 'element',
      section: selection.section || undefined,
      excerpt: selection.kind === 'image' || selection.kind === 'bgimage' ? selection.src : selection.excerpt,
      role: selection.role,
      label: selection.label,
      context: selection.context,
      item: selection.item ?? null,
      note: noteDraft.trim(),
      insert: selection.kind === 'insert' && selection.after ? { after: selection.after, before: selection.before ?? null } : undefined,
    }]);
    setNoteDraft('');
    setNotesOpen(true);
    closeSelection();
  };
  const removeNote = (id: string) => setNotes(prev => prev.filter(n => n.id !== id));

  // Outline elements that already have a note (on the version they were taken on).
  useEffect(() => {
    if (!previewLoaded) return;
    const locs = notes
      .map((n, i) => ({ loc: n.loc, n: i + 1, v: n.versionId, ins: !!n.insert }))
      .filter(m => m.v === selected?.id && !m.ins)
      .map(({ loc, n }) => ({ loc, n }));
    postToPreview({ type: 'markers', locs });
  }, [notes, previewLoaded, selected?.id, postToPreview]);

  /** Put a failed request back into the composer (text + its notes) to tweak and resend. */
  const editFailedRequest = () => {
    if (!failedRequest) return;
    if (failedRequest.prompt) setDraft(prev => (prev.trim() ? `${prev.trim()}\n${failedRequest.prompt}` : failedRequest.prompt));
    if (failedRequest.notes.length) {
      setNotes(prev => [...prev, ...failedRequest.notes.filter(n => !prev.some(p => p.id === n.id))]);
    }
    onDismissError?.();
    setTimeout(() => { inputRef.current?.focus(); autoGrowInput(); }, 0);
  };

  const send = () => {
    const prompt = draft.trim();
    if ((!prompt && notes.length === 0) || jobRunning) return;
    const started = onSend(prompt, selected?.id ?? null, notes);
    if (started === false) return;
    setDraft('');
    setNotes([]);
    if (inputRef.current) inputRef.current.style.height = '40px';
  };


  const isPublishing = !!publishJob;
  const busy = !!liveJob || isPublishing;

  const linkEditable = !!selection && selection.href !== undefined
    && (selection.kind === 'link' || selection.tag === 'a' || typeof selection.linkLoc === 'number');

  const preview = selected && previewSrc ? (previewDataUrl === null ? <span /> : (
    <iframe
      ref={iframeRef}
      key={pageKey}
      src={previewDataUrl}
      title={businessName}
      sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals allow-presentation"
      allow="autoplay; encrypted-media; fullscreen; picture-in-picture; clipboard-write"
      allowFullScreen
      onLoad={() => setTimeout(() => setLoadedPage(pageKey), 4000)}
      className={device === 'desktop' ? 'absolute inset-0 w-full h-full bg-white' : 'w-full h-full bg-white'}
    />
  )) : null;

  const previewLoading = !previewLoaded && (
    <div className="absolute inset-0 z-10 flex flex-col items-center justify-center gap-3 bg-zinc-100 dark:bg-zinc-950">
      <Spinner />
      <p className="text-xs text-zinc-500 dark:text-zinc-400">{t('campaign.studioPreviewLoading')}</p>
    </div>
  );

  return (
    <div className="fixed inset-0 z-[140] bg-white dark:bg-zinc-900 flex flex-col">
      {/* Fullscreen shield while dragging: keeps pointer events out of the preview
          iframe so the release is never swallowed and the drag reliably ends. */}
      {dragging && <div className="fixed inset-0 z-[200] cursor-ew-resize" />}
      {/* Header */}
      <div className="flex items-center gap-3 px-4 sm:px-5 h-[56px] border-b border-zinc-200 dark:border-zinc-800 shrink-0">
        <div className="min-w-0">
          <h2 className="text-sm font-semibold text-zinc-900 dark:text-white truncate">{businessName}</h2>
          <p className="text-[11px] text-zinc-500 dark:text-zinc-400 truncate">{t('campaign.studioLocalPreview')}</p>
        </div>
        <button onClick={onClose} className="ms-auto p-1.5 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-all shrink-0" title={t('campaign.done')}>
          <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      {/* Split view */}
      <div
        ref={splitRef}
        style={{ '--chat-w': `${chatW}px` } as React.CSSProperties}
        className={`flex-1 min-h-0 flex flex-col lg:flex-row ${dragging ? 'select-none' : ''}`}
      >
        {/* Chat */}
        <div className="flex flex-col h-[42%] lg:h-full lg:w-[var(--chat-w)] shrink-0 border-b lg:border-b-0 border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/40">
          <div ref={threadRef} className="flex-1 min-h-0 overflow-y-auto px-4 py-4 space-y-3">
            {versions.length === 0 && !liveJob && (
              <div className="rounded-xl bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-3.5 py-3 text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                {versionsLoading ? t('campaign.studioPreviewLoading') : t('campaign.modifyDesc')}
              </div>
            )}
            {versions.map(v => {
              const isSelected = selected?.id === v.id;
              const status = versionStatus(v);
              const changes = v.changes || [];
              const hasDetails = changes.length > 0 || !!v.sections?.length || !!v.added || !!v.removed;
              const isOpen = expandedIds.has(v.id);
              return (
                <div key={v.id} className="space-y-3">
                  {v.prompt && (v.source === 'ai' || v.source === 'generate') && (
                    <div className="flex justify-end">
                      <RequestBubble text={v.prompt} />
                    </div>
                  )}
                  <div className="flex justify-start">
                    <div
                      role="button"
                      tabIndex={0}
                      onClick={() => setSelectedId(v.id)}
                      onKeyDown={e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); setSelectedId(v.id); } }}
                      className={`max-w-[85%] text-start cursor-pointer rounded-2xl rounded-bl-md px-3.5 py-2.5 text-[13px] leading-relaxed border transition-all ${isSelected ? 'bg-emerald-500/10 dark:bg-emerald-500/10 border-emerald-500/50 text-zinc-800 dark:text-zinc-100' : 'bg-white dark:bg-zinc-800 border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:border-emerald-500/40'}`}
                    >
                      <span className="flex items-center gap-2 flex-wrap">
                        {hasDetails && (
                          <button
                            type="button"
                            onClick={e => { e.stopPropagation(); toggleExpanded(v.id); }}
                            aria-expanded={isOpen}
                            title={isOpen ? t('campaign.studioHideChanges') : t('campaign.studioShowChanges')}
                            className="-ms-1 p-0.5 rounded text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-500/10 transition-all"
                          >
                            <svg className={`w-3.5 h-3.5 transition-transform ${isOpen ? 'rotate-90' : 'rtl:rotate-180'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}><path strokeLinecap="round" strokeLinejoin="round" d="M9 5l7 7-7 7" /></svg>
                          </button>
                        )}
                        <span className="font-semibold">v{v.n}</span>
                        <span className="text-zinc-500 dark:text-zinc-400">{sourceLabel(v)}</span>
                        {status.state === 'live' && (
                          <span className="px-1.5 py-0.5 text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 rounded shrink-0">{t('campaign.live')}</span>
                        )}
                        {status.state === 'published' && (
                          <span className="px-1.5 py-0.5 text-[10px] font-medium bg-zinc-500/10 text-zinc-500 dark:text-zinc-400 rounded shrink-0">{t('campaign.studioPublished')}</span>
                        )}
                      </span>
                      {isOpen && changes.length > 0 && (
                        <ul className="mt-1.5 space-y-0.5 text-[12px] text-zinc-500 dark:text-zinc-400 break-words list-disc ps-4">
                          {changes.map((c, i) => <li key={i}>{c}</li>)}
                        </ul>
                      )}
                      {isOpen && (v.sections?.length || v.added || v.removed) ? (
                        <span className="flex items-center gap-1 flex-wrap mt-1.5">
                          {(v.sections || []).map(s => (
                            <span key={s} className="px-1.5 py-0.5 text-[10px] font-mono bg-zinc-100 dark:bg-zinc-700/60 text-zinc-500 dark:text-zinc-300 rounded">#{s}</span>
                          ))}
                          {(v.added || v.removed) ? (
                            <span className="text-[10px] font-mono">
                              <span className="text-emerald-600 dark:text-emerald-400">+{v.added || 0}</span>{' '}
                              <span className="text-zinc-500 dark:text-zinc-400">−{v.removed || 0}</span>
                            </span>
                          ) : null}
                        </span>
                      ) : null}
                      <span className="block mt-1 text-[10px] text-zinc-400 dark:text-zinc-500">{fmtDate(v.updatedAt)}</span>
                    </div>
                  </div>
                </div>
              );
            })}
            {error && failedRequest?.display && (
              <div className="flex flex-col items-end gap-1">
                <RequestBubble text={failedRequest.display} faded />
                <span className="text-[10px] text-zinc-400 dark:text-zinc-500">{failedRequest.cancelled ? t('campaign.studioRequestCancelled') : t('campaign.studioRequestFailed')}</span>
              </div>
            )}
            {error && (
              <div className="flex justify-start">
                <div className="max-w-[85%] rounded-2xl rounded-bl-md bg-zinc-100 dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-600 px-3.5 py-2.5 text-[13px] leading-relaxed text-zinc-800 dark:text-zinc-100">
                  <div className="flex items-start gap-2">
                    <svg className="w-4 h-4 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /></svg>
                    <span className="flex-1 min-w-0 [overflow-wrap:anywhere]">{error}</span>
                    {onDismissError && (
                      <button onClick={onDismissError} className="p-0.5 -m-1 text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-100 shrink-0" title={t('campaign.done')}>
                        <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                      </button>
                    )}
                  </div>
                  {(onRetry || failedRequest) && (
                    <div className="flex flex-wrap gap-2 mt-2.5">
                      {onRetry && (
                        <button
                          onClick={() => { onRetry(); }}
                          disabled={jobRunning}
                          title={jobRunning ? t('campaign.studioWaitForJob') : undefined}
                          className="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-[12px] font-semibold transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
                        >
                          <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                          {t('campaign.studioRetry')}
                        </button>
                      )}
                      {failedRequest && (failedRequest.prompt || failedRequest.notes.length > 0) && (
                        <button
                          onClick={editFailedRequest}
