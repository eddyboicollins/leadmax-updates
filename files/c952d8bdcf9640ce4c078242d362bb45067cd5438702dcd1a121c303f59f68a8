  sparkle: <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={1.8}><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15z" /></svg>,
};

export default function LeadDetail(p: Props) {
  const { t } = useTranslation();
  const { lead } = p;
  const b = lead.business;
  const [photoIdx, setPhotoIdx] = useState(0);
  const idx = Math.min(photoIdx, Math.max(0, p.photos.length - 1));
