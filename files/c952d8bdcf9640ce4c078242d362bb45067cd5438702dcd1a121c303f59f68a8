            </Row>
          )}
          {hours.today && (
            <Row icon={I.clock} label={t('campaign.detailHours')}>
              <span title={hours.all}>{hours.today}</span>
            </Row>
          )}
          {b.enrichedEmail && (
            <Row icon={I.mail} label={t('campaign.detailEmail')}>
              <a href={`mailto:${b.enrichedEmail}`} className="hover:text-emerald-600 dark:hover:text-emerald-400">{b.enrichedEmail}</a>
            </Row>
          )}
          {socials.length > 0 && (
            <Row icon={I.at} label={t('campaign.detailSocials')}>
              <span className="inline-flex items-center gap-2">
                {socials.map(([k, v]) => {
                  const base: Record<string, string> = { instagram: 'https://instagram.com/', facebook: 'https://facebook.com/', linkedin: 'https://linkedin.com/in/', twitter: 'https://x.com/', tiktok: 'https://tiktok.com/@', youtube: 'https://youtube.com/@' };
                  return (
                    <a key={k} href={`${base[k]}${handle(v)}`} target="_blank" rel="noopener noreferrer" className="capitalize hover:text-emerald-600 dark:hover:text-emerald-400">
                      {k === 'twitter' ? 'X' : k}
                    </a>
                  );
                })}
              </span>
            </Row>
          )}
          {isWebUrl(b.googleUrl) && (
            <Row icon={I.pin} label={t('campaign.detailMaps')}>
              <a href={b.googleUrl} target="_blank" rel="noopener noreferrer" className="hover:text-emerald-600 dark:hover:text-emerald-400">{t('campaign.viewOnGoogleMaps')}</a>
            </Row>
          )}
        </div>

        {/* AI website card */}
        {!lead.deleted && (
          <div className="mt-4 rounded-2xl border border-emerald-500/30 bg-emerald-500/[0.06] dark:bg-emerald-500/[0.07] p-4">
            <div className="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400">
              <span className="w-4 h-4">{I.sparkle}</span>
              {t('campaign.detailAiSite')}
