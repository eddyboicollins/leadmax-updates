}

// Removes a single discovered image from the lead and deletes its local file
// so storage isn't wasted on photos the user never wants.
export async function removeLeadScrapedImage(leadId: string, scrapedImageId: string): Promise<void> {
  const campaignId = await findLeadCampaignId(leadId);
  if (!campaignId) return;
  let fileToDelete: string | null = null;
  await withCampaignLeadsLock(campaignId, async () => {
    const leads = await getCampaignLeads(campaignId);
    const lead = leads.find(l => l.id === leadId);
    if (!lead) return;
    const scraped = lead.business.scrapedImages || [];
    const target = scraped.find(i => i.id === scrapedImageId);
    lead.business.scrapedImages = scraped.filter(i => i.id !== scrapedImageId);
    if (target && target.url.startsWith('/api/scraped-images/')) {
      const file = target.url.replace(/^\/api\/scraped-images\//, '');
      if (/^[a-z0-9-]+\.(jpg|jpeg|png|webp|gif)$/i.test(file)) {
        fileToDelete = path.join(SCRAPED_DIR, file);
      }
    }
    lead.updatedAt = new Date().toISOString();
    await writeJSON(leadsFile(campaignId), leads);
  });
  if (fileToDelete) {
    await fs.unlink(fileToDelete).catch(() => {});
  }
}

