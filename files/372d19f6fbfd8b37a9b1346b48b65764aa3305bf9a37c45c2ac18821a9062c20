            </div>
          </div>
        </div>
      )}

      {/* Images Modal */}
      {showImagesModal && imagesLead && (
        <div className="fixed inset-0 z-[110] bg-black/70 flex items-center justify-center p-4">
          <div className="bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl">
            <div className="flex items-center justify-between px-5 py-4 border-b border-zinc-200 dark:border-zinc-700">
              <div>
                <h3 className="text-sm font-semibold text-zinc-900 dark:text-white">{t('campaign.imagesTitle', { name: imagesLead.business.name })}</h3>
                <p className="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{t('campaign.imagesDesc')}</p>
