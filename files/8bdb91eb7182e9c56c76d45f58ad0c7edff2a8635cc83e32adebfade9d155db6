'use client';

import { useState, useEffect } from 'react';
import { useTranslation, Trans } from 'react-i18next';
import { useQuery } from '@tanstack/react-query';
import { SetNavbar } from '@/components/AppShell';
import { useToast } from '@/components/Toast';
import DeepSeekConnect from '@/components/DeepSeekConnect';
import { verifyVercelToken, verifyFilebaseKeys } from '@/lib/verify-tokens';
import { GEMINI_MODELS, DEFAULT_GEMINI_MODEL, DEFAULT_AI_SOURCE, normalizeAiSource, type GeminiModel, type AiSource } from '@/lib/gemini';

function StatusBadge({ configured }: { configured: boolean }) {
  const { t } = useTranslation();
  return (
    <span className={`px-2.5 py-1 text-xs font-medium rounded-lg ${configured ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-zinc-400/10 text-zinc-600 dark:text-zinc-300'}`}>
      {configured ? t('settings.configured') : t('settings.notConfigured')}
    </span>
  );
}

function Card({ title, description, icon, badge, className, id, children }: { title: string; description?: string; icon?: React.ReactNode; badge?: React.ReactNode; className?: string; id?: string; children: React.ReactNode }) {
  return (
    <section id={id} className={`bg-white dark:bg-zinc-800/40 border border-gray-200 dark:border-zinc-700/50 rounded-2xl p-5 sm:p-6 ${className || ''}`}>
      <div className="flex items-start justify-between mb-4 gap-3">
        <div className="flex items-start gap-3 min-w-0">
          {icon && <span className="shrink-0 w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">{icon}</span>}
          <div className="min-w-0">
            <h2 className="text-sm font-semibold text-gray-900 dark:text-white">{title}</h2>
            {description && <p className="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{description}</p>}
          </div>
        </div>
        {badge}
      </div>
      {children}
    </section>
  );
}

/** Setup steps, folded away once the thing they explain is configured. */
function HowTo({ title, defaultOpen, href, linkLabel, children }: { title: string; defaultOpen: boolean; href: string; linkLabel: string; children: React.ReactNode }) {
  return (
    <details open={defaultOpen} className="group bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-700/30 rounded-xl mb-4">
      <summary className="list-none [&::-webkit-details-marker]:hidden cursor-pointer select-none flex items-center gap-2 px-4 py-3 text-xs font-semibold text-zinc-600 dark:text-zinc-300">
        <svg className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span className="flex-1">{title}</span>
        <svg className="w-3.5 h-3.5 text-zinc-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}><path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" /></svg>
      </summary>
      <div className="px-4 pb-4">
        <ol className="space-y-2 text-xs text-zinc-500 dark:text-zinc-400 list-decimal list-inside">{children}</ol>
        <a href={href} target="_blank" rel="noopener noreferrer" className="mt-3 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">
          <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          {linkLabel}
        </a>
      </div>
    </details>
  );
}

function Field({ label, hint, children }: { label: string; hint?: string; children: React.ReactNode }) {
  return (
    <div>
      <label className="block text-xs font-medium text-zinc-700 dark:text-zinc-200 mb-1.5">{label}</label>
      {children}
      {hint && <p className="text-[11px] text-zinc-500 dark:text-zinc-400 mt-1.5">{hint}</p>}
    </div>
  );
}

const AI_SOURCES = [
  { value: 'proxy', label: 'settings.geminiSourceProxy', hint: 'settings.aiHintProxy' },
  { value: 'chatgpt', label: 'settings.geminiSourceChatgpt', hint: 'settings.aiHintChatgpt' },
  { value: 'deepseek', label: 'settings.geminiSourceDeepseek', hint: 'settings.aiHintDeepseek' },
  { value: 'official', label: 'settings.geminiSourceApi', hint: 'settings.aiHintOfficial' },
] as const;

interface Snapshot {
  vercelToken: string;
  filebaseAccessKey: string;
  filebaseSecretKey: string;
  filebaseBucket: string;
  geminiKey: string;
  model: GeminiModel;
  aiSource: AiSource;
}

function SecretInput({ value, onChange, placeholder, className, visible, onToggleVisible }: {
  value: string;
  onChange: (v: string) => void;
  placeholder: string;
  className: string;
  visible: boolean;
  onToggleVisible: () => void;
}) {
  const { t } = useTranslation();
  return (
    <div className="relative w-full">
      <input
        type={visible ? 'text' : 'password'}
        value={value}
        onChange={e => onChange(e.target.value)}
        placeholder={placeholder}
        className={`${className} w-full pr-10`}
      />
      <button
        type="button"
        onClick={onToggleVisible}
        tabIndex={-1}
        title={visible ? t('settings.hideKey') : t('settings.showKey')}
        className="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 rounded-lg transition-colors"
      >
        {visible ? (
          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
          </svg>
        ) : (
          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path strokeLinecap="round" strokeLinejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        )}
      </button>
    </div>
  );
}

export default function SettingsPage() {
  const { t } = useTranslation();
  const { toast } = useToast();

  const [initial, setInitial] = useState<Snapshot | null>(null);
  const [model, setModel] = useState<GeminiModel>(DEFAULT_GEMINI_MODEL);
  const [aiSource, setAiSource] = useState<AiSource>(DEFAULT_AI_SOURCE);

  const [vercelToken, setVercelToken] = useState('');
  const [filebaseAccessKey, setFilebaseAccessKey] = useState('');
  const [filebaseSecretKey, setFilebaseSecretKey] = useState('');
  const [filebaseBucket, setFilebaseBucket] = useState('');
  const [geminiKey, setGeminiKey] = useState('');
  const [showVercel, setShowVercel] = useState(false);
  const [showFilebaseSecret, setShowFilebaseSecret] = useState(false);
  const [showGemini, setShowGemini] = useState(false);

  const [savingAll, setSavingAll] = useState(false);
  const [savedAll, setSavedAll] = useState(false);
  const { data: deepseek } = useQuery<{ connected: boolean }>({
    queryKey: ['deepseek-status'],
    queryFn: async () => (await fetch('/api/deepseek')).json(),
  });

  useEffect(() => {
    let mounted = true;
    fetch('/api/settings')
      .then(r => r.json())
      .then(data => {
        if (!mounted) return;
        const snap: Snapshot = {
          vercelToken: data.vercelToken || '',
          filebaseAccessKey: data.filebaseAccessKey || '',
          filebaseSecretKey: data.filebaseSecretKey || '',
          filebaseBucket: data.filebaseBucket || '',
          geminiKey: data.geminiApiKey || '',
          model: (data.geminiModel as GeminiModel) || DEFAULT_GEMINI_MODEL,
          aiSource: normalizeAiSource(data.aiSource),
        };
        setInitial(snap);
        setVercelToken(snap.vercelToken);
        setFilebaseAccessKey(snap.filebaseAccessKey);
        setFilebaseSecretKey(snap.filebaseSecretKey);
        setFilebaseBucket(snap.filebaseBucket);
        setGeminiKey(snap.geminiKey);
        setModel(snap.model);
        setAiSource(snap.aiSource);
      })
      .catch(() => {});
    return () => {
      mounted = false;
    };
  }, []);

  // Highlight the imgbb card when arriving via ?focus= link.
  useEffect(() => {
    if (typeof window === 'undefined') return;
    const params = new URLSearchParams(window.location.search);
    const focus = params.get('focus');
    const targetId = focus === 'imgxxKey' ? 'imgxx-key-card' : focus === 'filebaseKey' ? 'filebase-key-card' : null;
    if (!targetId) return;
    let attempts = 0;
    const tick = () => {
      const el = document.getElementById(targetId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.add('gen-highlight');
        setTimeout(() => el.classList.remove('gen-highlight'), 4000);
        const url = new URL(window.location.href);
        url.searchParams.delete('focus');
        window.history.replaceState({}, '', url.toString());
      } else if (attempts++ < 60) {
        setTimeout(tick, 200);
      }
    };
    tick();
  }, []);

  // Active dirty detection: any diverged field vs the loaded snapshot.
  const isDirty = !!initial && (
    vercelToken.trim() !== initial.vercelToken ||
    filebaseAccessKey.trim() !== initial.filebaseAccessKey ||
    filebaseSecretKey.trim() !== initial.filebaseSecretKey ||
    filebaseBucket.trim() !== initial.filebaseBucket ||
    geminiKey.trim() !== initial.geminiKey ||
    model !== initial.model ||
    aiSource !== initial.aiSource
  );

  function discardChanges() {
    if (!initial) return;
    setVercelToken(initial.vercelToken);
    setFilebaseAccessKey(initial.filebaseAccessKey);
    setFilebaseSecretKey(initial.filebaseSecretKey);
    setFilebaseBucket(initial.filebaseBucket);
    setGeminiKey(initial.geminiKey);
    setModel(initial.model);
    setAiSource(initial.aiSource);
  }

  async function saveAll() {
    if (savingAll || !isDirty || !initial) return;
    setSavingAll(true);
    try {
      const trimmedVercel = vercelToken.trim();
      const trimmedFbAccess = filebaseAccessKey.trim();
      const trimmedFbSecret = filebaseSecretKey.trim();
      const trimmedFbBucket = filebaseBucket.trim();
      const trimmedGemini = geminiKey.trim();

      if (trimmedVercel && trimmedVercel !== initial.vercelToken) {
        const vResult = await verifyVercelToken(trimmedVercel);
        if (!vResult.valid) {
          toast(vResult.error, 'error');
          return;
        }
      }
      if ((trimmedFbAccess && trimmedFbAccess !== initial.filebaseAccessKey) || (trimmedFbSecret && trimmedFbSecret !== initial.filebaseSecretKey) || (trimmedFbBucket && trimmedFbBucket !== initial.filebaseBucket)) {
        const iResult = await verifyFilebaseKeys(trimmedFbAccess, trimmedFbSecret, trimmedFbBucket);
        if (!iResult.valid) {
          toast(iResult.error, 'error');
          return;
        }
      }

      const body: Record<string, unknown> = {};
      if (trimmedVercel !== initial.vercelToken) body.vercelToken = trimmedVercel;
      if (trimmedFbAccess !== initial.filebaseAccessKey) body.filebaseAccessKey = trimmedFbAccess;
      if (trimmedFbSecret !== initial.filebaseSecretKey) body.filebaseSecretKey = trimmedFbSecret;
      if (trimmedFbBucket !== initial.filebaseBucket) body.filebaseBucket = trimmedFbBucket;
      if (trimmedGemini !== initial.geminiKey) body.geminiApiKey = trimmedGemini;
      if (model !== initial.model) body.geminiModel = model;
      if (aiSource !== initial.aiSource) body.aiSource = aiSource;

      const res = await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      if (!res.ok) throw new Error((await res.json()).error);

      setInitial({
        vercelToken: trimmedVercel,
        filebaseAccessKey: trimmedFbAccess,
        filebaseSecretKey: trimmedFbSecret,
        filebaseBucket: trimmedFbBucket,
        geminiKey: trimmedGemini,
        model,
        aiSource,
      });
      setSavedAll(true);
      setTimeout(() => setSavedAll(false), 2500);
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSavingAll(false);
    }
  }

  const hasVercel = vercelToken.trim() !== '';
  const hasFilebase = filebaseAccessKey.trim() !== '' && filebaseSecretKey.trim() !== '' && filebaseBucket.trim() !== '';
  const aiReady = aiSource === 'official' ? geminiKey.trim() !== '' : aiSource === 'deepseek' ? !!deepseek?.connected : true;

  const inputCls =
    'flex-1 min-w-0 w-full px-4 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all font-mono text-sm';
  const selectCls =
    'px-4 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm cursor-pointer';

  return (
    <div className="flex-1 bg-gradient-to-br from-gray-100 via-white to-gray-50 dark:bg-none dark:bg-zinc-950 transition-colors flex flex-col">
      <SetNavbar title={t('settings.title')} subtitle={t('settings.subtitle')} />

      <main className="app-page flex-1">
        <div className="max-w-3xl mx-auto space-y-5">
          {/* AI */}
          <Card
            title={t('settings.geminiSource')}
            description={t('settings.geminiSourceDesc')}
            icon={<svg className="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>}
            badge={<StatusBadge configured={aiReady} />}
          >
            <Field label={t('settings.aiSourceLabel')} hint={t(AI_SOURCES.find(s => s.value === aiSource)!.hint)}>
              <div className="relative">
                <select
                  value={aiSource}
                  onChange={e => setAiSource(normalizeAiSource(e.target.value))}
                  className={`${selectCls} w-full appearance-none pe-10 font-medium`}
                >
                  {AI_SOURCES.map(s => <option key={s.value} value={s.value}>{t(s.label)}</option>)}
                </select>
                <svg className="pointer-events-none absolute end-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}><path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" /></svg>
              </div>
            </Field>

            {/* Details of the selected source only. */}
            {aiSource === 'deepseek' && <DeepSeekConnect />}

            {aiSource === 'official' && (
              <div className="mt-5 pt-5 border-t border-gray-200 dark:border-zinc-700/50 space-y-4">
                <HowTo title={t('settings.howToGemini')} defaultOpen={!geminiKey.trim()} href="https://aistudio.google.com/apikey" linkLabel={t('settings.openGeminiPage')}>
                  <li>{t('settings.geminiStep1')}</li>
                  <li>{t('settings.geminiStep2')}</li>
                  <li>{t('settings.geminiStep3')}</li>
                  <li>{t('settings.geminiStep4')}</li>
                </HowTo>
                <Field label={t('settings.geminiApiKeyLabel')}>
                  <SecretInput value={geminiKey} onChange={setGeminiKey} placeholder={t('settings.geminiApiKeyPlaceholder')} className={inputCls} visible={showGemini} onToggleVisible={() => setShowGemini(v => !v)} />
                </Field>
                <Field label={t('settings.geminiModel')} hint={t('settings.geminiModelDesc')}>
                  <select value={model} onChange={e => setModel(e.target.value as GeminiModel)} className={`${selectCls} w-full`}>
                    {Object.entries(GEMINI_MODELS).map(([value, label]) => (
                      <option key={value} value={value}>{label}</option>
                    ))}
                  </select>
                </Field>
              </div>
            )}

            {/* Other sources: the key only powers photo naming, so it is optional. */}
            {aiSource !== 'official' && (
              <details className="group mt-5 pt-4 border-t border-gray-200 dark:border-zinc-700/50" open={false}>
                <summary className="list-none [&::-webkit-details-marker]:hidden cursor-pointer select-none flex items-center gap-2 text-xs font-medium text-zinc-600 dark:text-zinc-300">
                  <span className="flex-1">{t('settings.geminiKeyOptional')}</span>
                  {geminiKey.trim() && <span className="text-[11px] text-emerald-600 dark:text-emerald-400">{t('settings.configured')}</span>}
                  <svg className="w-3.5 h-3.5 text-zinc-400 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2.5}><path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" /></svg>
                </summary>
                <div className="pt-3">
                  <Field label={t('settings.geminiApiKeyLabel')} hint={t('settings.geminiKeyOptionalDesc')}>
                    <SecretInput value={geminiKey} onChange={setGeminiKey} placeholder={t('settings.geminiApiKeyPlaceholder')} className={inputCls} visible={showGemini} onToggleVisible={() => setShowGemini(v => !v)} />
                  </Field>
                </div>
              </details>
            )}
          </Card>

          {/* Vercel Token */}
          <Card
            title={t('settings.vercelToken')}
            description={t('settings.vercelDesc')}
            icon={<svg className="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3l10 18H2L12 3z" /></svg>}
            badge={<StatusBadge configured={!!hasVercel} />}
          >
            <HowTo title={t('settings.howToVercel')} defaultOpen={!hasVercel} href="https://vercel.com/account/tokens" linkLabel={t('settings.openVercelPage')}>
              <li>{t('settings.vercelStep1')}</li>
              <li>{t('settings.vercelStep2')}</li>
              <li>{t('settings.vercelStep3')}</li>
              <li>{t('settings.vercelStep4')}</li>
            </HowTo>
            <SecretInput value={vercelToken} onChange={setVercelToken} placeholder={t('settings.vercelPlaceholder')} className={inputCls} visible={showVercel} onToggleVisible={() => setShowVercel(v => !v)} />
          </Card>

          {/* Filebase Keys */}
          <Card
            id="filebase-key-card"
            title={t('settings.filebaseKeys')}
            description={t('settings.filebaseDesc')}
            icon={<svg className="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>}
            badge={<StatusBadge configured={!!hasFilebase} />}
          >
            <HowTo title={t('settings.howToFilebase')} defaultOpen={!hasFilebase} href="https://console.filebase.com/keys" linkLabel={t('settings.openFilebasePage')}>
              <li><Trans i18nKey="settings.filebaseStep1">Create a free account at <strong>console.filebase.com</strong></Trans></li>
              <li><Trans i18nKey="settings.filebaseStep2">Go to Buckets and click <strong>Create Bucket</strong>. Choose <strong>IPFS</strong> as the storage type.</Trans></li>
              <li>{t('settings.filebaseStep3')}</li>
              <li><Trans i18nKey="settings.filebaseStep4">Go to <strong>Access Keys</strong> on the sidebar to find your Access Key and Secret Key.</Trans></li>
            </HowTo>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input value={filebaseBucket} onChange={e => setFilebaseBucket(e.target.value)} placeholder={t('settings.filebaseBucketPlaceholder')} className={inputCls} />
              <input value={filebaseAccessKey} onChange={e => setFilebaseAccessKey(e.target.value)} placeholder={t('settings.filebaseAccessPlaceholder')} className={inputCls} />
              <div className="sm:col-span-2">
                <SecretInput value={filebaseSecretKey} onChange={setFilebaseSecretKey} placeholder={t('settings.filebaseSecretPlaceholder')} className={inputCls} visible={showFilebaseSecret} onToggleVisible={() => setShowFilebaseSecret(v => !v)} />
              </div>
            </div>
          </Card>
        </div>
        {(isDirty || savedAll) && <div className="h-24" aria-hidden />}
      </main>

      {(isDirty || savedAll) && (
        <div className="fixed bottom-0 inset-x-0 z-40 flex justify-center px-4 pb-4 pointer-events-none">
          <div className="pointer-events-auto flex items-center gap-3 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-2xl shadow-2xl px-4 py-3">
            <span className="text-sm text-zinc-600 dark:text-zinc-300">
              {savedAll ? t('settings.saved') : t('settings.unsavedChanges')}
            </span>
            {isDirty && (
              <>
                <button
                  onClick={discardChanges}
                  disabled={savingAll}
                  className="px-3 py-2 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white bg-gray-100 dark:bg-zinc-700/60 rounded-xl hover:bg-gray-200 dark:hover:bg-zinc-700 disabled:opacity-40 transition-all"
                >
                  {t('settings.discardChanges')}
                </button>
                <button
                  onClick={saveAll}
                  disabled={savingAll}
                  className="px-4 py-2 text-sm font-medium text-white bg-emerald-600 rounded-xl hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-sm shadow-emerald-600/20 active:scale-[0.98]"
                >
                  {savingAll ? (
                    <svg className="animate-spin w-4 h-4" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                  ) : t('settings.saveAll')}
                </button>
              </>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
