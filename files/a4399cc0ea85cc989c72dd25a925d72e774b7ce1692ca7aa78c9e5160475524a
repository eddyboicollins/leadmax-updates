export interface ScrapedImage {
  id: string;
  url: string;
  width?: number;
  height?: number;
}

export interface BusinessData {
  id: string;
  name: string;
  rating: number;
  ratingCount: number;
  address: string;
  phone: string;
  website: string;
  category: string;
  reviews: { author: string; text: string; rating: number; date: string; avatar?: string }[];
  latitude: number;
  longitude: number;
  placeId: string;
  googleUrl: string;
  hours: string[];
  scrapedImages?: ScrapedImage[];
  scrapedAt: string;
}

export type LeadStatus = 'pending' | 'contacted' | 'negotiating' | 'not_interested';

export interface Lead {
  id: string;
  business: BusinessData;
  status: LeadStatus;
  notes: string;
  deleted?: boolean;
  deletedAt?: string;
  deploymentName?: string;
  landingPage?: LeadLandingPage;
  images?: LeadImage[];
  deployment?: LeadDeployment;
  deploymentHistory?: DeploymentEntry[];
  createdAt: string;
  updatedAt: string;
}

export interface LeadLandingPage {
  tsx: string;
  generatedAt: string;
  version: number;
  sections: LandingPageSection[];
}

export interface LeadImage {
  id: string;
  url: string;
  alt: string;
  width?: number;
  height?: number;
  deleteUrl?: string;
}

export interface LeadDeployment {
  provider: 'vercel' | 'ftp';
  url: string;
  deployedAt: string;
  projectName?: string;
}

export interface DeploymentEntry {
  id: string;
  vercelDeploymentId: string;
  url: string;
  aliasUrl: string;
  deployedAt: string;
  userPrompt?: string;
  isMain: boolean;
  comingSoon?: boolean;
  tsx: string;
}

export interface LandingPageSection {
  id: string;
  type: string;
  sortOrder: number;
  content: Record<string, unknown>;
  styles: Record<string, string>;
}

export interface CampaignRegion {
  keyword: string;
  location: string;
  minRating?: number;
  maxRating?: number;
  minReviews?: number;
}

export interface Campaign {
  id: string;
  keyword: string;
  location: string;
  displayName: string;
  leads: Lead[];
  minRating?: number;
  maxRating?: number;
  minReviews?: number;
  regions?: CampaignRegion[];
  createdAt: string;
  updatedAt: string;
}

export interface ScrapeJob {
  id: string;
  campaignId: string;
  status: 'running' | 'completed' | 'failed';
  progress: number;
  message: string;
  createdAt: string;
}

export interface LeadGeneration {
  id: string;
  leadId: string;
  campaignId: string;
  landingPageCode?: string;
  deploymentUrl?: string;
  projectName?: string;
  createdAt: string;
}

export interface GlobalSettings {
  vercelToken?: string;
  imgbbKey?: string;
  geminiApiKey?: string;
  geminiModel: string;
  geminiSource?: 'proxy' | 'api';
  systemPrompt: string;
  assistantSystemPrompt?: string;
  wizardCompleted?: boolean;
}

export interface ChatMessage {
  id: string;
  role: 'user' | 'assistant';
  content: string;
  createdAt: string;
}

export interface BusinessProfile {
  name: string;
  category: string;
  address: string;
  rating: number;
  ratingCount: number;
  website?: string | null;
  websiteInsight?: string | null;
}

export interface Chat {
  id: string;
  title: string;
  profile?: BusinessProfile;
  ended?: boolean;
  createdAt: string;
  updatedAt: string;
}
