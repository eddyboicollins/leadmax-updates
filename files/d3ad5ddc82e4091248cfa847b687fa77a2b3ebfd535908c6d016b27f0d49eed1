'use client';

import { useState, useEffect } from 'react';
import { useQueryClient } from '@tanstack/react-query';
import { useTranslation } from 'react-i18next';
import { SetNavbar } from '@/components/AppShell';
import { useToast } from '@/components/Toast';
import { verifyVercelToken, verifyImgxxKey } from '@/lib/verify-tokens';


function StatusBadge({ configured }: { configured: boolean }) {
  const { t } = useTranslation();
  return (
    <span className={`px-2.5 py-1 text-xs font-medium rounded-lg ${configured ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' : 'bg-amber-500/10 text-amber-600 dark:text-amber-400'}`}>
      {configured ? t('settings.configured') : t('settings.notConfigured')}
    </span>
  );
}



function Card({ title, badge, className, id, children }: { title: string; badge?: React.ReactNode; className?: string; id?: string; children: React.ReactNode }) {
  return (
    <section id={id} className={`bg-white dark:bg-zinc-800/40 border border-gray-200 dark:border-zinc-700/50 rounded-xl p-5 ${className || ''}`}>
      <div className="flex items-center justify-between mb-3 gap-2">
        <h2 className="text-sm font-semibold text-gray-900 dark:text-white">{title}</h2>
        {badge}
      </div>
      {children}
    </section>
  );
}

function SecretInput({ value, onChange, placeholder, className, visible, onToggleVisible }: {
  value: string;
  onChange: (v: string) => void;
  placeholder: string;
  className: string;
  visible: boolean;
  onToggleVisible: () => void;
}) {
  const { t } = useTranslation();
  return (
    <div className="relative w-full">
      <input
        type={visible ? 'text' : 'password'}
        value={value}
        onChange={e => onChange(e.target.value)}
        placeholder={placeholder}
        className={`${className} w-full pr-10`}
      />
      <button
        type="button"
        onClick={onToggleVisible}
        tabIndex={-1}
        title={visible ? t('settings.hideKey') : t('settings.showKey')}
        className="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 rounded-lg transition-colors"
      >
        {visible ? (
          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
          </svg>
        ) : (
          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
            <path strokeLinecap="round" strokeLinejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path strokeLinecap="round" strokeLinejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        )}
      </button>
    </div>
  );
}

export default function SettingsPage() {
  const { t } = useTranslation();
  const { toast } = useToast();
  const queryClient = useQueryClient();

  const [hasVercel, setHasVercel] = useState(false);
  const [hasImgbb, setHasImgbb] = useState(false);
  const [assistantPrompt, setAssistantPrompt] = useState('');
  const [generationInstructions, setGenerationInstructions] = useState('');
  const [psid, setPsid] = useState('');
  const [psidts, setPsidts] = useState('');
  const [showPsid, setShowPsid] = useState(false);
  const [showPsidts, setShowPsidts] = useState(false);
  const [hasVisionCookies, setHasVisionCookies] = useState(false);
  const [tutorialOpen, setTutorialOpen] = useState(false);
  const [visionTesting, setVisionTesting] = useState(false);
  const [visionTestResult, setVisionTestResult] = useState<'ok' | 'error' | null>(null);
  const [visionTestError, setVisionTestError] = useState('');
  const [browserLogin, setBrowserLogin] = useState<'idle' | 'waiting' | 'ready' | 'failed'>('idle');
  const [browserError, setBrowserError] = useState('');

  const [vercelToken, setVercelToken] = useState('');
  const [imgbbKey, setImgbbKey] = useState('');
  const [showVercel, setShowVercel] = useState(false);
  const [showImgbb, setShowImgbb] = useState(false);

  type SettingsSnapshot = {
    vercelToken: string; imgbbKey: string;
    assistantPrompt: string;
    generationInstructions: string;
    psid: string; psidts: string;
  };
  const [initial, setInitial] = useState<SettingsSnapshot | null>(null);
  const [savingAll, setSavingAll] = useState(false);
  const [savedAll, setSavedAll] = useState(false);

  useEffect(() => {
    let mounted = true;
    fetch('/api/settings')
      .then(r => r.json())
      .then(data => {
        if (!mounted) return;
        setHasVercel(!!data.hasVercelToken);
        setHasImgbb(!!data.hasImgbbKey);
        setVercelToken(data.vercelToken || '');
        setImgbbKey(data.imgbbKey || '');
        setAssistantPrompt(data.assistantSystemPrompt || '');
        setGenerationInstructions(data.generationInstructions || '');
        setPsid(data.gemini1PSID || '');
        setPsidts(data.gemini1PSIDTS || '');
        setHasVisionCookies(!!data.hasVisionCookies);
        setInitial({
          vercelToken: data.vercelToken || '',
          imgbbKey: data.imgbbKey || '',
          assistantPrompt: data.assistantSystemPrompt || '',
          generationInstructions: data.generationInstructions || '',
          psid: data.gemini1PSID || '',
          psidts: data.gemini1PSIDTS || '',
        });
      })
      .catch(() => {});
    return () => {
      mounted = false;
    };
  }, []);

  // Highlight a settings card in green when arriving via a ?focus= link.
  useEffect(() => {
    if (typeof window === 'undefined') return;
    const params = new URLSearchParams(window.location.search);
    const focus = params.get('focus');
    const targetId = focus === 'imgxxKey' ? 'imgxx-key-card' : focus === 'vision' || focus === 'geminiKey' ? 'vision-card' : null;
    if (!targetId) return;
    let attempts = 0;
    const tick = () => {
      const el = document.getElementById(targetId);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
        el.classList.add('gen-highlight');
        setTimeout(() => el.classList.remove('gen-highlight'), 4000);
        const url = new URL(window.location.href);
        url.searchParams.delete('focus');
        window.history.replaceState({}, '', url.toString());
      } else if (attempts++ < 60) {
        setTimeout(tick, 200);
      }
    };
    tick();
  }, []);

  const isDirty = !!initial && (
    vercelToken.trim() !== initial.vercelToken ||
    imgbbKey.trim() !== initial.imgbbKey ||
    assistantPrompt.trim() !== initial.assistantPrompt ||
    generationInstructions.trim() !== initial.generationInstructions ||
    psid.trim() !== initial.psid ||
    psidts.trim() !== initial.psidts
  );

  async function testVision() {
    if (visionTesting) return;
    setVisionTesting(true);
    setVisionTestResult(null);
    setVisionTestError('');
    try {
      const res = await fetch('/api/settings/test-vision', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ psid: psid.trim(), psidts: psidts.trim() }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Vision test failed');
      setVisionTestResult('ok');
    } catch (err) {
      setVisionTestResult('error');
      setVisionTestError(err instanceof Error ? err.message : String(err));
    } finally {
      setVisionTesting(false);
    }
  }

  async function startBrowserLogin() {
    if (browserLogin === 'waiting') return;
    setBrowserLogin('waiting');
    setBrowserError('');
    try {
      const res = await fetch('/api/settings/browser-login', { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Could not open browser');
      pollBrowserLogin();
    } catch (err) {
      setBrowserLogin('failed');
      setBrowserError(err instanceof Error ? err.message : String(err));
    }
  }

  async function pollBrowserLogin() {
    try {
      const res = await fetch('/api/settings/browser-login');
      const data = await res.json().catch(() => ({}));
      if (data.status === 'ready') {
        setBrowserLogin('ready');
        queryClient.invalidateQueries({ queryKey: ['settings'] });
        const fresh = await fetch('/api/settings').then(r => r.json()).catch(() => null);
        if (fresh) {
          setPsid(fresh.gemini1PSID || '');
          setPsidts(fresh.gemini1PSIDTS || '');
          setHasVisionCookies(!!fresh.hasVisionCookies);
          setInitial(prev => (prev ? { ...prev, psid: fresh.gemini1PSID || '', psidts: fresh.gemini1PSIDTS || '' } : prev));
        }
        return;
      }
      if (data.status === 'failed' || !res.ok) {
        setBrowserLogin('failed');
        setBrowserError(data.error || 'Sign-in not completed.');
        return;
      }
      setTimeout(pollBrowserLogin, 3000);
    } catch {
      setTimeout(pollBrowserLogin, 3000);
    }
  }

  async function put(body: Record<string, unknown>) {
    const res = await fetch('/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    if (!res.ok) throw new Error((await res.json()).error);
  }

  function discardChanges() {
    if (!initial) return;
    setVercelToken(initial.vercelToken);
    setImgbbKey(initial.imgbbKey);
    setAssistantPrompt(initial.assistantPrompt);
    setGenerationInstructions(initial.generationInstructions);
    setPsid(initial.psid);
    setPsidts(initial.psidts);
  }

  async function saveAll() {
    if (savingAll || !isDirty) return;
    setSavingAll(true);
    try {
      const trimmedVercel = vercelToken.trim();
      const trimmedImgbb = imgbbKey.trim();
      const trimmedAssistant = assistantPrompt.trim();
      const trimmedGeneration = generationInstructions.trim();
      const trimmedPsid = psid.trim();
      const trimmedPsidts = psidts.trim();

      if (trimmedVercel && trimmedVercel !== initial?.vercelToken) {
        const vResult = await verifyVercelToken(trimmedVercel);
        if (!vResult.valid) {
          toast(vResult.error, 'error');
          return;
        }
      }
      if (trimmedImgbb && trimmedImgbb !== initial?.imgbbKey) {
        const iResult = await verifyImgxxKey(trimmedImgbb);
        if (!iResult.valid) {
          toast(iResult.error, 'error');
          return;
        }
      }

      await put({
        vercelToken: trimmedVercel,
        imgbbKey: trimmedImgbb,
        assistantSystemPrompt: trimmedAssistant,
        generationInstructions: trimmedGeneration,
        gemini1PSID: trimmedPsid,
        gemini1PSIDTS: trimmedPsidts,
      });

      setHasVercel(!!trimmedVercel);
      setHasImgbb(!!trimmedImgbb);
      setHasVisionCookies(!!(trimmedPsid && trimmedPsidts));
      setInitial({
        vercelToken: trimmedVercel,
        imgbbKey: trimmedImgbb,
        assistantPrompt: trimmedAssistant,
        generationInstructions: trimmedGeneration,
        psid: trimmedPsid,
        psidts: trimmedPsidts,
      });
      // Push the fresh cookie state to every useSettings() reader so no page
      // refresh is needed to pick up the new session.
      queryClient.invalidateQueries({ queryKey: ['settings'] });
      setSavedAll(true);
      setTimeout(() => setSavedAll(false), 2500);
    } catch (err) {
      toast(err instanceof Error ? err.message : String(err), 'error');
    } finally {
      setSavingAll(false);
    }
  }

  const inputCls =
    'px-4 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all font-mono text-sm';

  return (
    <div className="flex-1 bg-gradient-to-br from-gray-100 via-white to-gray-50 dark:from-zinc-900 dark:via-zinc-800 dark:to-zinc-900 transition-colors flex flex-col">
      <SetNavbar title={t('settings.title')} subtitle={t('settings.subtitle')} />

      <main className="app-page flex-1 pb-24">
        <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
          {/* Vercel Token */}
          <Card title={t('settings.vercelToken')} badge={<StatusBadge configured={hasVercel} />}>
            <div className="bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-700/30 rounded-xl p-4 mb-3">
              <h3 className="text-xs font-semibold text-zinc-600 dark:text-zinc-300 mb-3 flex items-center gap-2">
                <svg className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {t('settings.howToVercel')}
              </h3>
              <ol className="space-y-2 text-xs text-zinc-500 dark:text-zinc-400 list-decimal list-inside">
                <li>{t('settings.vercelStep1')}</li>
                <li>{t('settings.vercelStep2')}</li>
                <li>{t('settings.vercelStep3')}</li>
                <li>{t('settings.vercelStep4')}</li>
              </ol>
              <a href="https://vercel.com/account/tokens" target="_blank" rel="noopener noreferrer" className="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">
                <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                {t('settings.openVercelPage')}
              </a>
            </div>
            <SecretInput value={vercelToken} onChange={setVercelToken} placeholder={t('settings.vercelPlaceholder')} className={inputCls} visible={showVercel} onToggleVisible={() => setShowVercel(v => !v)} />
          </Card>

          {/* ImgBB Key */}
          <Card id="imgxx-key-card" title={t('settings.imgbbKey')} badge={<StatusBadge configured={hasImgbb} />}>
            <div className="bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-700/30 rounded-xl p-4 mb-3">
              <h3 className="text-xs font-semibold text-zinc-600 dark:text-zinc-300 mb-3 flex items-center gap-2">
                <svg className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {t('settings.howToImgbb')}
              </h3>
              <ol className="space-y-2 text-xs text-zinc-500 dark:text-zinc-400 list-decimal list-inside">
                <li>{t('settings.imgbbStep1')}</li>
                <li>{t('settings.imgbbStep2')}</li>
                <li>{t('settings.imgbbStep3')}</li>
              </ol>
              <a href="https://leadmaximguploadmechanism.vercel.app" target="_blank" rel="noopener noreferrer" className="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">
                <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                {t('settings.openImgbbPage')}
              </a>
            </div>
            <SecretInput value={imgbbKey} onChange={setImgbbKey} placeholder={t('settings.imgbbPlaceholder')} className={inputCls} visible={showImgbb} onToggleVisible={() => setShowImgbb(v => !v)} />
          </Card>

          {/* AI Vision (all AI runs through the Gemini session below) */}
          <Card id="vision-card" title={t('settings.visionTitle')} badge={<StatusBadge configured={hasVisionCookies} />}>
            <p className="text-xs text-zinc-500 dark:text-zinc-400 mb-4">{t('settings.visionDesc')}</p>
            <div className="bg-zinc-100/60 dark:bg-zinc-900/60 border border-zinc-200/60 dark:border-zinc-700/30 rounded-xl p-4 mb-4">
              <h3 className="text-xs font-semibold text-zinc-600 dark:text-zinc-300 mb-3 flex items-center gap-2">
                <svg className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {t('settings.visionHowTo')}
              </h3>
              <ol className="space-y-2 text-xs text-zinc-500 dark:text-zinc-400 list-decimal list-inside">
                <li>{t('settings.visionStep1')}</li>
                <li>{t('settings.visionStep2')}</li>
                <li>{t('settings.visionStep3')}</li>
              </ol>
              <a href="https://gemini.google.com/app" target="_blank" rel="noopener noreferrer" className="mt-2 inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-300 transition-colors">
                <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                {t('settings.openVisionPage')}
              </a>
            </div>
            <button
              onClick={() => setTutorialOpen(v => !v)}
              className="w-full mb-4 px-4 py-2.5 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-300 hover:border-emerald-500/60 hover:text-zinc-900 dark:hover:text-white transition-all flex items-center justify-center gap-2"
            >
              <svg className={`w-4 h-4 transition-transform duration-200 ${tutorialOpen ? 'rotate-180' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2} strokeLinecap="round" strokeLinejoin="round"><path d="M19 9l-7 7-7-7" /></svg>
              {tutorialOpen ? t('wizard.tutorialHide') : t('wizard.tutorialShow')}
            </button>
            {tutorialOpen && (
              <div className="mb-4 overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-700">
                <iframe
                  src="https://www.youtube.com/embed/kwcj2vXQF8A"
                  title="Gemini session tutorial"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowFullScreen
                  loading="lazy"
                  className="w-full aspect-video"
                />
              </div>
            )}
            <div>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <h3 className="text-xs font-mono text-zinc-600 dark:text-zinc-300 mb-1.5">__Secure-1PSID</h3>
                  <SecretInput value={psid} onChange={v => { setPsid(v); setVisionTestResult(null); }} placeholder="__Secure-1PSID" className={inputCls} visible={showPsid} onToggleVisible={() => setShowPsid(v => !v)} />
                </div>
                <div>
                  <h3 className="text-xs font-mono text-zinc-600 dark:text-zinc-300 mb-1.5">__Secure-1PSIDTS</h3>
                  <SecretInput value={psidts} onChange={v => { setPsidts(v); setVisionTestResult(null); }} placeholder="__Secure-1PSIDTS" className={inputCls} visible={showPsidts} onToggleVisible={() => setShowPsidts(v => !v)} />
                </div>
              </div>
              <div className="mt-4 flex items-center gap-2 flex-wrap">
                <button
                  onClick={testVision}
                  disabled={visionTesting || !psid.trim() || !psidts.trim()}
                  className="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-200 bg-zinc-200 dark:bg-zinc-700/60 rounded-xl hover:bg-zinc-300 dark:hover:bg-zinc-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all"
                >
                  {visionTesting ? (
                    <svg className="animate-spin w-3.5 h-3.5" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                  ) : (
                    <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                  )}
                  {visionTesting ? t('settings.visionTesting') : t('settings.visionTest')}
                </button>
                {visionTestResult === 'ok' && (
                  <span className="inline-flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" /></svg>
                    {t('settings.visionTestOk')}
                  </span>
                )}
                {visionTestResult === 'error' && (
                  <span className="text-xs text-red-600 dark:text-red-400">{visionTestError}</span>
                )}
                <button
                  onClick={startBrowserLogin}
                  disabled={browserLogin === 'waiting'}
                  className="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-white bg-gradient-to-r from-emerald-500 to-teal-600 rounded-xl hover:from-emerald-400 hover:to-teal-500 disabled:opacity-40 disabled:cursor-wait transition-all shadow-sm shadow-emerald-500/20"
                >
                  {browserLogin === 'waiting' ? (
                    <svg className="animate-spin w-3.5 h-3.5" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                  ) : (
                    <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" /></svg>
                  )}
                  {browserLogin === 'waiting' ? t('settings.visionBrowserWaiting') : t('settings.visionBrowserLogin')}
                </button>
                {browserLogin === 'ready' && (
                  <span className="inline-flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" /></svg>
                    {t('settings.visionBrowserReady')}
                  </span>
                )}
                {browserLogin === 'failed' && (
                  <span className="text-xs text-red-600 dark:text-red-400">{browserError}</span>
                )}
              </div>
            </div>
          </Card>

          <div className="space-y-6">
            {/* Assistant System Prompt */}
            <Card title={t('settings.assistantSystemPrompt')}>
              <textarea
                value={assistantPrompt}
                onChange={e => setAssistantPrompt(e.target.value)}
                rows={4}
                placeholder={t('settings.assistantSystemPromptPlaceholder')}
                className="w-full px-4 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm resize-y"
              />
              <p className="mt-1.5 text-[11px] text-zinc-500 dark:text-zinc-400">{t('settings.assistantSystemPromptDesc')}</p>
            </Card>

            {/* Generation Instructions (extra system prompt for generate/regenerate) */}
            <Card title={t('settings.generationInstructions')}>
              <textarea
                value={generationInstructions}
                onChange={e => setGenerationInstructions(e.target.value)}
                rows={4}
                placeholder={t('settings.generationInstructionsPlaceholder')}
                className="w-full px-4 py-2.5 bg-gray-50 dark:bg-zinc-900 border border-gray-200 dark:border-zinc-700 rounded-xl text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm resize-y"
              />
              <p className="mt-1.5 text-[11px] text-zinc-500 dark:text-zinc-400">{t('settings.generationInstructionsDesc')}</p>
            </Card>
          </div>
        </div>
      </main>

      {(isDirty || savedAll) && (
        <div className="fixed bottom-0 inset-x-0 z-40 flex justify-center px-4 pb-4 pointer-events-none">
          <div className="pointer-events-auto flex items-center gap-3 bg-white dark:bg-zinc-800 border border-gray-200 dark:border-zinc-700 rounded-2xl shadow-2xl px-4 py-3">
            <span className="text-sm text-zinc-600 dark:text-zinc-300">
              {savedAll ? t('settings.saved') : t('settings.unsavedChanges')}
            </span>
            {isDirty && (
              <>
                <button
                  onClick={discardChanges}
                  disabled={savingAll}
                  className="px-3 py-2 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white bg-gray-100 dark:bg-zinc-700/60 rounded-xl hover:bg-gray-200 dark:hover:bg-zinc-700 disabled:opacity-40 transition-all"
                >
                  {t('settings.discardChanges')}
                </button>
                <button
                  onClick={saveAll}
                  disabled={savingAll}
                  className="px-4 py-2 text-sm font-medium text-white bg-gradient-to-r from-emerald-500 to-emerald-600 rounded-xl hover:from-emerald-400 hover:to-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-lg shadow-emerald-500/20 active:scale-[0.98]"
                >
                  {savingAll ? (
                    <svg className="animate-spin w-4 h-4" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                  ) : t('settings.saveAll')}
                </button>
              </>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
