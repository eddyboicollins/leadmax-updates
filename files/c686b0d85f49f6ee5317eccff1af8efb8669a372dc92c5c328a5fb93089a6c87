'use client';

import { useRouter, usePathname } from 'next/navigation';
import { useState, useMemo, useEffect } from 'react';
import { useTranslation } from 'react-i18next';
import { useTheme } from './ThemeProvider';
import AboutModal from './AboutModal';
import { useCampaigns, useGenerations } from '@/lib/query/useCampaigns';
import { requestGenerationFocus, requestGenerationsScroll, requestCampaignsScroll } from '@/lib/generationFocus';
import { useLocalStoragePref } from '@/lib/useLocalStoragePref';
import { useLastVisitedCampaign } from '@/lib/lastVisitedCampaign';
import i18n from '@/lib/i18n';

interface SidebarProps {
  open: boolean;
  onClose: () => void;
}

export default function Sidebar({ open, onClose }: SidebarProps) {
  const router = useRouter();
  const pathname = usePathname();
  const { t } = useTranslation();
  const { theme, toggle: toggleTheme } = useTheme();
  const [aboutOpen, setAboutOpen] = useState(false);
  const [campaignsOpen, setCampaignsOpen] = useLocalStoragePref('lm_campaigns_open');
  const [generationsOpen, setGenerationsOpen] = useLocalStoragePref('lm_generations_open');
  const { data: campaignsData } = useCampaigns();
  const { data: generationsData } = useGenerations();
  const lastVisitedCampaignId = useLastVisitedCampaign();
  const currentLang = i18n.language?.startsWith('en') ? 'en' : 'fr';
  const [homeSection, setHomeSection] = useState<'campaigns' | 'generations' | null>(null);

  useEffect(() => {
    if (pathname !== '/') return;
    let raf = 0;
    const update = () => {
      const campaignsEl = document.getElementById('home-section-campaigns');
      const generationsEl = document.getElementById('home-section-generations');
      if (!campaignsEl && !generationsEl) return;
      const threshold = 90;
      const genTop = generationsEl ? generationsEl.getBoundingClientRect().top : Infinity;
      setHomeSection(generationsEl && genTop <= threshold ? 'generations' : 'campaigns');
    };
    const onScroll = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    };
  }, [pathname, campaignsData, generationsData]);

  const recentCampaigns = useMemo(
    () =>
      (campaignsData?.campaigns ?? [])
        .slice()
        .sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)))
        .slice(0, 10),
    [campaignsData],
  );

  const recentGenerations = useMemo(
    () =>
      (generationsData ?? [])
        .slice()
        .sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)))
        .slice(0, 10),
    [generationsData],
  );

  function switchLang(lng: string) {
    i18n.changeLanguage(lng);
    localStorage.setItem('i18nextLng', lng);
  }

  function go(href: string) {
    router.push(href);
  }

  function goHome() {
    if (pathname !== '/') go('/');
  }

  function goToCampaigns() {
    if (pathname !== '/') go('/');
    requestCampaignsScroll();
  }

  function goToGeneration(id: string) {
    if (pathname !== '/') go('/');
    requestGenerationFocus(id);
  }

  function goToGenerations() {
    if (pathname !== '/') go('/');
    requestGenerationsScroll();
  }

  const links = [
    {
      href: '/',
      label: t('home.myCampaigns'),
      icon: (
        <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M3 7a2 2 0 012-2h4a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2V7zm10 0a2 2 0 012-2h4a2 2 0 012 2v4a2 2 0 01-2 2h-4a2 2 0 01-2-2V7zM3 17a2 2 0 012-2h4a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4zm10 0a2 2 0 012-2h4a2 2 0 012 2v4a2 2 0 01-2 2h-4a2 2 0 01-2-2v-4z" /></svg>
      ),
    },
  ];

  const isActive = (href: string) =>
    href === '/' ? pathname === '/' : pathname?.startsWith(href);

  const inCampaign = !!pathname?.startsWith('/campaign');
  const campaignsActive = inCampaign || (pathname === '/' && homeSection === 'campaigns');
  const generationsActive = pathname === '/' && homeSection === 'generations';

  return (
    <>
      <AboutModal open={aboutOpen} onClose={() => setAboutOpen(false)} />

      {/* Docked rail */}
      <aside
        className={`fixed left-0 top-0 h-full w-72 max-w-[85vw] z-[105] bg-white dark:bg-zinc-900 border-r border-gray-200 dark:border-zinc-800 shadow-xl transition-transform duration-300 flex flex-col ${open ? 'translate-x-0' : '-translate-x-full pointer-events-none'}`}
      >
        <div className="flex items-center justify-between px-4 sm:px-6 h-[58px] sm:h-[62px] border-b border-gray-200 dark:border-zinc-800">
          <button onClick={goHome} className="flex items-center gap-2 sm:gap-2.5 hover:opacity-90 transition-opacity cursor-pointer">
            <div className="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white font-bold text-sm sm:text-lg shadow-lg shadow-emerald-500/20">
              LM
            </div>
            <span className="font-bold text-gray-900 dark:text-white tracking-tight text-base sm:text-xl">LeadMax 2.0</span>
          </button>
          <button onClick={onClose} className="p-1.5 text-zinc-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-zinc-800 rounded-lg transition-all">
            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>

        <nav className="flex-1 overflow-y-auto px-3 py-4 space-y-1">
          {links.map(link =>
            link.href === '/' ? (
              <div key={link.href}>
                <div className={`flex items-center rounded-xl transition-all ${campaignsActive ? 'bg-emerald-500/10 text-emerald-500' : 'text-gray-600 dark:text-zinc-300 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white'}`}>
              <button onClick={goToCampaigns} className="flex-1 min-w-0 flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-left">
                    {link.icon}
                    <span className="truncate">{link.label}</span>
                  </button>
                  <button
                    onClick={() => setCampaignsOpen(!campaignsOpen)}
                    className="p-2 mr-1 text-zinc-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-zinc-800 rounded-lg transition-all shrink-0"
                    title={campaignsOpen ? 'Collapse' : 'Expand'}
                  >
                    <svg className={`w-4 h-4 transition-transform duration-200 ${campaignsOpen ? 'rotate-90' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M9 5l7 7-7 7" /></svg>
                  </button>
                </div>
                {campaignsOpen && (
                  <div className="mt-1 space-y-0.5 pl-5 ml-5 border-l border-gray-200 dark:border-zinc-800">
                    {recentCampaigns.length === 0 ? (
                      <p className="px-3 py-2 text-xs text-zinc-400">{t('home.noCampaigns')}</p>
                    ) : (
                      recentCampaigns.map(campaign => (
                        <button
                          key={campaign.id}
                          onClick={() => go(`/campaign/${campaign.id}`)}
                          className={`w-full flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm transition-all ${pathname === `/campaign/${campaign.id}` ? 'bg-emerald-500/10 text-emerald-500' : 'text-gray-500 dark:text-zinc-400 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white'}`}
                        >
                          <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0" />
                          <span className="truncate">{campaign.displayName || campaign.keyword}</span>
                          {lastVisitedCampaignId !== campaign.id && (
                            <span className="ml-auto shrink-0 text-xs text-zinc-400">({campaign.leads?.filter((l: any) => !l.deleted)?.length ?? 0})</span>
                          )}
                          {lastVisitedCampaignId === campaign.id && (
                            <span className="ml-auto shrink-0 text-[9px] font-medium uppercase tracking-wide text-emerald-400 bg-zinc-700/50 rounded px-1 py-0.5">{t('home.lastVisited')}</span>
                          )}
                        </button>
                      ))
                    )}
                  </div>
                )}
              </div>
            ) : (
              <button
                key={link.href}
                onClick={() => go(link.href)}
                className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all ${isActive(link.href) ? 'bg-emerald-500/10 text-emerald-500' : 'text-gray-600 dark:text-zinc-300 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white'}`}
              >
                {link.icon}
                {link.label}
              </button>
            ),
          )}

          <div key="generations">
            <div className={`flex items-center rounded-xl transition-all ${generationsActive ? 'bg-emerald-500/10 text-emerald-500' : 'text-gray-600 dark:text-zinc-300 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white'}`}>
              <button onClick={goToGenerations} className="flex-1 min-w-0 flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-left">
                <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                <span className="truncate">{t('home.myGenerations')}</span>
              </button>
              <button
                onClick={() => setGenerationsOpen(!generationsOpen)}
                className="p-2 mr-1 text-zinc-400 hover:text-gray-900 dark:hover:text-white hover:bg-gray-200 dark:hover:bg-zinc-800 rounded-lg transition-all shrink-0"
                title={generationsOpen ? 'Collapse' : 'Expand'}
              >
                <svg className={`w-4 h-4 transition-transform duration-200 ${generationsOpen ? 'rotate-90' : ''}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M9 5l7 7-7 7" /></svg>
              </button>
            </div>
            {generationsOpen && (
              <div className="mt-1 space-y-0.5 pl-5 ml-5 border-l border-gray-200 dark:border-zinc-800">
                {recentGenerations.length === 0 ? (
                  <p className="px-3 py-2 text-xs text-zinc-400">{t('home.noGenerations')}</p>
                ) : (
                  recentGenerations.map(gen => (
                    <button
                      key={gen.id}
                      onClick={() => goToGeneration(gen.id)}
                      className="w-full flex items-center gap-2 px-3 py-1.5 rounded-lg text-sm transition-all text-gray-500 dark:text-zinc-400 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white"
                    >
                      <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0" />
                      <span className="truncate">{gen.businessName || gen.campaignName}</span>
                    </button>
                  ))
                )}
              </div>
            )}
          </div>

          <button
            onClick={() => go('/assistant')}
            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all ${isActive('/assistant') ? 'bg-emerald-500/10 text-emerald-500' : 'text-gray-600 dark:text-zinc-300 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white'}`}
          >
            <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
            {t('assistant.title')}
          </button>

        </nav>

        <div className="px-3 py-4 border-t border-gray-200 dark:border-zinc-800 space-y-1">
          <button onClick={() => go('/settings')} className="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-zinc-300 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white transition-all">
            <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            {t('settings.title')}
          </button>
          <button onClick={() => setAboutOpen(true)} className="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-zinc-300 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white transition-all">
            <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {t('about.title')}
          </button>
          <button onClick={toggleTheme} className="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-zinc-300 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white transition-all">
            {theme === 'dark' ? (
              <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            ) : (
              <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
            )}
            {t('settings.theme')}
          </button>
          <button onClick={() => switchLang(currentLang === 'en' ? 'fr' : 'en')} className="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium text-gray-600 dark:text-zinc-300 hover:bg-gray-100 dark:hover:bg-zinc-800 hover:text-gray-900 dark:hover:text-white transition-all">
            <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {currentLang === 'en' ? 'Français' : 'English'}
          </button>
        </div>
      </aside>
    </>
  );
}
