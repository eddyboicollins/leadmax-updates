'use client';

import { useState, useCallback } from 'react';
import { useTranslation, Trans } from 'react-i18next';
import { useRouter } from 'next/navigation';
import { useQueryClient } from '@tanstack/react-query';
import { useToast } from '@/components/Toast';
import { verifyVercelToken, verifyImgbbKey } from '@/lib/verify-tokens';
import { useLockBodyScroll } from '@/lib/useLockBodyScroll';

const STEPS = 7;

interface Props {
  onComplete: () => void;
}

export default function OnboardingWizard({ onComplete }: Props) {
  const { t } = useTranslation();
  const router = useRouter();
  const { toast } = useToast();
  const queryClient = useQueryClient();
  useLockBodyScroll(true);
  const [step, setStep] = useState(1);
  const [direction, setDirection] = useState<'next' | 'prev'>('next');
  const [vercelToken, setVercelToken] = useState('');
  const [vercelSaving, setVercelSaving] = useState(false);
  const [vercelDone, setVercelDone] = useState(false);
  const [vercelError, setVercelError] = useState('');
  const [imgbbKey, setImgbbKey] = useState('');
  const [imgbbSaving, setImgbbSaving] = useState(false);
  const [imgbbDone, setImgbbDone] = useState(false);
  const [imgbbError, setImgbbError] = useState('');
  const [keyword, setKeyword] = useState('dentist');
  const [location, setLocation] = useState('Monastir, Tunisia');
  const [campaignCreating, setCampaignCreating] = useState(false);
  const [campaignDone, setCampaignDone] = useState(false);
  const [migrateSource, setMigrateSource] = useState('');
  const [migrateState, setMigrateState] = useState<'idle' | 'detecting' | 'found' | 'migrating' | 'done' | 'error'>('idle');
  const [migrateDone, setMigrateDone] = useState(false);
  const [migrateBusy, setMigrateBusy] = useState(false);
  const [migrateDetection, setMigrateDetection] = useState<{ found: boolean; dataDir: string | null; summary: { campaigns: number; leads: number; generations: number; chats: number; scrapedImages: number } | null } | null>(null);
  const [migrateError, setMigrateError] = useState('');

  const selectMigrateFolder = async () => {
    const api = (window as unknown as { leadmax?: { selectFolder?: () => Promise<string | null> } }).leadmax;
    let picked: string | null = null;
    if (api?.selectFolder) {
      picked = await api.selectFolder();
    } else {
      picked = window.prompt('Enter the path of your previous LeadMax folder:') ?? null;
    }
    if (!picked) return;
    setMigrateSource(picked);
    await detectMigrateFolder(picked);
  };

  const detectMigrateFolder = async (pathValue: string) => {
    setMigrateState('detecting');
    setMigrateError('');
    setMigrateDetection(null);
    setMigrateDone(false);
    setMigrateBusy(true);
    try {
      const res = await fetch(`/api/migrate?path=${encodeURIComponent(pathValue)}`);
      const data = await res.json();
      setMigrateDetection(data);
      setMigrateState(data.found ? 'found' : 'error');
      if (!data.found) setMigrateError(data.error || 'No LeadMax data found in that folder');
    } catch {
      setMigrateState('error');
      setMigrateError('Could not scan that folder');
    }
    setMigrateBusy(false);
  };

  const runMigrate = async () => {
    if (!migrateSource) return;
    setMigrateState('migrating');
    setMigrateError('');
    setMigrateBusy(true);
    try {
      const res = await fetch('/api/migrate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ source: migrateSource, dataDir: migrateDetection?.dataDir || undefined }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) {
        setMigrateState('error');
        setMigrateError(data.error || 'Migration failed');
        return;
      }
      setMigrateState('done');
      setMigrateDone(true);
      queryClient.invalidateQueries({ queryKey: ['campaigns'] });
      queryClient.invalidateQueries({ queryKey: ['generations'] });
    } catch {
      setMigrateState('error');
      setMigrateError('Migration failed');
    }
    setMigrateBusy(false);
  };

  const goTo = useCallback((s: number) => {
    setDirection(s > step ? 'next' : 'prev');
    setStep(s);
  }, [step]);

  async function saveVercelToken() {
    if (!vercelToken.trim()) return;
    setVercelSaving(true);
    setVercelError('');
    const vResult = await verifyVercelToken(vercelToken.trim());
    if (!vResult.valid) { setVercelError(vResult.error); setVercelSaving(false); return; }
    try {
      const res = await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ vercelToken: vercelToken.trim() }),
      });
      if (!res.ok) throw new Error(await res.text());
      setVercelDone(true);
      goTo(4);
    } catch { setVercelError('Failed to save Vercel token'); }
    setVercelSaving(false);
  }

  async function saveImgbbKey() {
    if (!imgbbKey.trim()) return;
    setImgbbSaving(true);
    setImgbbError('');
    const iResult = await verifyImgbbKey(imgbbKey.trim());
    if (!iResult.valid) { setImgbbError(iResult.error); setImgbbSaving(false); return; }
    try {
      const res = await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ imgbbKey: imgbbKey.trim() }),
      });
      if (!res.ok) throw new Error(await res.text());
      setImgbbDone(true);
      goTo(5);
    } catch { setImgbbError('Failed to save ImgBB key'); }
    setImgbbSaving(false);
  }

  async function createCampaign() {
    if (!keyword.trim() || !location.trim()) return;
    setCampaignCreating(true);
    try {
      const res = await fetch('/api/campaigns', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ keyword: keyword.trim(), location: location.trim() }),
      });
      if (!res.ok) throw new Error((await res.json()).error);
      setCampaignDone(true);
      goTo(6);
    } catch (err: any) { toast(err.message, 'error'); }
    setCampaignCreating(false);
  }

  async function completeWizard() {
    try {
      await fetch('/api/settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ wizardCompleted: true }),
      });
    } catch { /* best-effort */ }
    onComplete();
  }

  const animClass = direction === 'next'
    ? 'animate-[fadeInSlideRight_0.3s_ease-out]'
    : 'animate-[fadeInSlideLeft_0.3s_ease-out]';

  return (
    <div className="fixed inset-0 z-[120] bg-black/80 backdrop-blur-xl flex items-center justify-center p-4">
      <style>{`
        @keyframes fadeInSlideRight { from { opacity:0; transform:translateX(24px); } to { opacity:1; transform:translateX(0); } }
        @keyframes fadeInSlideLeft { from { opacity:0; transform:translateX(-24px); } to { opacity:1; transform:translateX(0); } }
      `}</style>
      <div className="bg-zinc-800 border border-zinc-700 rounded-2xl w-full max-w-xl max-h-[90vh] overflow-y-auto shadow-2xl">
        {/* Header with progress dots */}
        <div className="px-6 pt-6 pb-4 border-b border-zinc-700">
          <div className="flex items-center justify-between mb-3">
            <div className="flex items-center gap-2">
              <div className="w-7 h-7 rounded-lg bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-white font-bold text-xs shadow-lg shadow-emerald-500/20">
                LM
              </div>
              <span className="text-[11px] text-zinc-500 font-medium uppercase tracking-wider">{t('wizard.step', { current: step, total: STEPS })}</span>
            </div>
          </div>
          <div className="flex items-center gap-1.5">
            {Array.from({ length: STEPS }, (_, i) => (
              <div key={i} className={`h-1 flex-1 rounded-full transition-all duration-300 ${i + 1 <= step ? step === i + 1 && step < STEPS ? 'bg-emerald-500' : 'bg-emerald-500' : 'bg-zinc-700'}`} />
            ))}
          </div>
        </div>

        {/* Step content */}
        <div className="p-6 min-h-[240px]">
          {/* Step 1: Welcome */}
          {step === 1 && (
            <div className={animClass}>
              <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-600 flex items-center justify-center mx-auto mb-5 shadow-lg shadow-emerald-500/20">
                <svg className="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              </div>
              <h2 className="text-xl font-bold text-white text-center mb-2">{t('wizard.step1Title')}</h2>
              <p className="text-sm text-zinc-400 text-center leading-relaxed max-w-md mx-auto">{t('wizard.step1Desc')}</p>
              <div className="mt-5 bg-zinc-900/40 border border-zinc-700/30 rounded-xl p-4 space-y-2">
                <p className="text-xs text-zinc-400 leading-relaxed">
                  <Trans i18nKey="wizard.step1Credit" components={[<span key="0" className="text-emerald-400 font-medium" />, <span key="1" className="text-emerald-400 font-medium" />]} />
                </p>
                <div className="flex items-center gap-2 pt-1">
                  {[{l:'Facebook',u:'https://www.facebook.com/motezhadjsalem'},{l:'Instagram',u:'https://www.instagram.com/motezhadjsalem/'},{l:'TikTok',u:'https://www.tiktok.com/@motez.hadjsalem'}].map(s => (
                    <a key={s.l} href={s.u} target="_blank" rel="noopener noreferrer" className="text-[11px] text-zinc-500 hover:text-emerald-400 transition-colors underline underline-offset-2 decoration-zinc-700/50">{s.l}</a>
                  ))}
                </div>
              </div>
            </div>
          )}

          {/* Step 2: Migrate data */}
          {step === 2 && (
            <div className={animClass}>
              <div className="w-12 h-12 rounded-xl bg-zinc-700/50 flex items-center justify-center mb-4">
                <svg className="w-6 h-6 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
              </div>
              <h2 className="text-lg font-bold text-white mb-1">{t('wizard.migrateTitle')}</h2>
              <p className="text-sm text-zinc-400 mb-5">{t('wizard.migrateDesc')}</p>

              <button
                onClick={selectMigrateFolder}
                disabled={migrateBusy}
                className="w-full px-4 py-3 bg-zinc-900 border border-zinc-700 rounded-xl text-sm text-white hover:border-emerald-500/60 hover:bg-zinc-800 disabled:opacity-40 disabled:cursor-not-allowed transition-all flex items-center justify-center gap-2"
              >
                {migrateBusy ? (
                  <svg className="animate-spin w-4 h-4" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                ) : (
                  <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
                )}
                {migrateBusy ? t('wizard.migrateDetecting') : t('wizard.migratePick')}
              </button>
              {migrateSource && (
                <p className="mt-2 text-[11px] text-zinc-500 truncate" title={migrateSource}>{migrateSource}</p>
              )}

              {migrateState === 'found' && migrateDetection?.found && (
                <div className="mt-4 bg-zinc-900/40 border border-zinc-700/30 rounded-xl p-4 space-y-2">
                  <div className="flex items-center gap-2 text-sm text-emerald-400">
                    <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
                    <span className="font-medium">{t('wizard.migrateFound')}</span>
                  </div>
                  <div className="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs">
                    <div className="bg-zinc-800/60 rounded-lg px-3 py-2"><span className="text-zinc-400 block">{t('wizard.migrateCampaigns')}</span><span className="text-white font-semibold">{migrateDetection.summary?.campaigns ?? 0}</span></div>
                    <div className="bg-zinc-800/60 rounded-lg px-3 py-2"><span className="text-zinc-400 block">{t('wizard.migrateLeads')}</span><span className="text-white font-semibold">{migrateDetection.summary?.leads ?? 0}</span></div>
                    <div className="bg-zinc-800/60 rounded-lg px-3 py-2"><span className="text-zinc-400 block">{t('wizard.migrateGenerations')}</span><span className="text-white font-semibold">{migrateDetection.summary?.generations ?? 0}</span></div>
                    <div className="bg-zinc-800/60 rounded-lg px-3 py-2"><span className="text-zinc-400 block">{t('wizard.migrateChats')}</span><span className="text-white font-semibold">{migrateDetection.summary?.chats ?? 0}</span></div>
                    <div className="bg-zinc-800/60 rounded-lg px-3 py-2"><span className="text-zinc-400 block">{t('wizard.migrateImages')}</span><span className="text-white font-semibold">{migrateDetection.summary?.scrapedImages ?? 0}</span></div>
                  </div>
                  {migrateDone ? (
                    <div className="flex items-center gap-2 text-sm text-emerald-400 mt-1">
                      <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
                      <span>{t('wizard.migrateDone')}</span>
                    </div>
                  ) : (
                    <button
                      onClick={runMigrate}
                      disabled={migrateBusy}
                      className="w-full mt-2 py-3 text-sm font-medium bg-emerald-600 text-white rounded-xl hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all flex items-center justify-center gap-2"
                    >
                      {migrateBusy ? (
                        <><svg className="animate-spin w-4 h-4" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>{t('wizard.migrating')}</>
                      ) : t('wizard.migrateImport')}
                    </button>
                  )}
                </div>
              )}

              {migrateState === 'error' && migrateError && (
                <p className="mt-4 text-xs text-red-400 bg-red-500/10 border border-red-500/30 rounded-xl px-4 py-3">{migrateError}</p>
              )}

              <p className="mt-5 text-xs text-zinc-500">{t('wizard.migrateSkipHint')}</p>
            </div>
          )}

          {/* Step 3: Vercel Token */}
          {step === 3 && (
            <div className={animClass}>
              <div className="w-12 h-12 rounded-xl bg-zinc-700/50 flex items-center justify-center mb-4">
                <svg className="w-6 h-6 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>
              </div>
              <h2 className="text-lg font-bold text-white mb-1">{t('wizard.step2Title')}</h2>
              <p className="text-sm text-zinc-400 mb-5">{t('wizard.step2Desc')}</p>
              <div className="bg-zinc-900/60 border border-zinc-700/50 rounded-xl p-4 mb-5 space-y-2 text-sm">
                <p className="text-zinc-300">1. {t('wizard.vercelStep1')}</p>
                <p className="text-zinc-300">2. {t('wizard.vercelStep2')}</p>
                <p className="text-zinc-300">3. {t('wizard.vercelStep3')}</p>
                <p className="text-zinc-300">4. {t('wizard.vercelStep4')}</p>
                <a href="https://vercel.com/account/tokens" target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1.5 mt-2 text-sm text-emerald-400 hover:text-emerald-300 underline underline-offset-2 decoration-emerald-500/30">
                  <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  {t('wizard.openVercelPage')}
                </a>
              </div>
              <div className="flex gap-2">
                <input
                  value={vercelToken}
                  onChange={e => setVercelToken(e.target.value)}
                  type="password"
                  placeholder={t('wizard.vercelPlaceholder')}
                  className="flex-1 px-4 py-2.5 bg-zinc-900 border border-zinc-700 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm"
                />
                <button
                  onClick={saveVercelToken}
                  disabled={vercelSaving || !vercelToken.trim()}
                  className="px-5 py-2.5 text-sm font-medium bg-emerald-600 text-white rounded-xl hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all shrink-0"
                >
                  {vercelSaving ? (
                    <svg className="animate-spin w-4 h-4" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                  ) : vercelDone ? (
                    <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
                  ) : t('wizard.next')}
                </button>
              </div>
              {vercelError && <p className="text-xs text-red-400 mt-2">{vercelError}</p>}
            </div>
          )}

          {/* Step 4: ImgBB Key */}
          {step === 4 && (
            <div className={animClass}>
              <div className="w-12 h-12 rounded-xl bg-zinc-700/50 flex items-center justify-center mb-4">
                <svg className="w-6 h-6 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
              </div>
              <h2 className="text-lg font-bold text-white mb-1">{t('wizard.step3Title')}</h2>
              <p className="text-sm text-zinc-400 mb-5">{t('wizard.step3Desc')}</p>
              <div className="bg-zinc-900/60 border border-zinc-700/50 rounded-xl p-4 mb-5 space-y-2 text-sm">
                <p className="text-zinc-300">1. {t('wizard.imgbbStep1')}</p>
                <p className="text-zinc-300">2. {t('wizard.imgbbStep2')}</p>
                <p className="text-zinc-300">3. {t('wizard.imgbbStep3')}</p>
                <a href="https://api.imgbb.com" target="_blank" rel="noopener noreferrer" className="inline-flex items-center gap-1.5 mt-2 text-sm text-emerald-400 hover:text-emerald-300 underline underline-offset-2 decoration-emerald-500/30">
                  <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                  {t('wizard.openImgbbPage')}
                </a>
              </div>
              <div className="flex gap-2">
                <input
                  value={imgbbKey}
                  onChange={e => setImgbbKey(e.target.value)}
                  type="password"
                  placeholder={t('wizard.imgbbPlaceholder')}
                  className="flex-1 px-4 py-2.5 bg-zinc-900 border border-zinc-700 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm"
                />
                <button
                  onClick={saveImgbbKey}
                  disabled={imgbbSaving || !imgbbKey.trim()}
                  className="px-5 py-2.5 text-sm font-medium bg-emerald-600 text-white rounded-xl hover:bg-emerald-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all shrink-0"
                >
                  {imgbbSaving ? (
                    <svg className="animate-spin w-4 h-4" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>
                  ) : imgbbDone ? (
                    <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
                  ) : t('wizard.next')}
                </button>
              </div>
              {imgbbError && <p className="text-xs text-red-400 mt-2">{imgbbError}</p>}
            </div>
          )}

          {/* Step 5: Create Campaign */}
          {step === 5 && (
            <div className={animClass}>
              <div className="w-12 h-12 rounded-xl bg-zinc-700/50 flex items-center justify-center mb-4">
                <svg className="w-6 h-6 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
              </div>
              <h2 className="text-lg font-bold text-white mb-1">{t('wizard.step4Title')}</h2>
              <p className="text-sm text-zinc-400 mb-5">{t('wizard.step4Desc')}</p>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                <div>
                  <label className="block text-xs font-medium text-zinc-400 mb-1.5 uppercase tracking-wider">{t('wizard.keywordLabel')}</label>
                  <input
                    value={keyword}
                    onChange={e => setKeyword(e.target.value)}
                    placeholder={t('wizard.keywordPlaceholder')}
                    className="w-full px-4 py-2.5 bg-zinc-900 border border-zinc-700 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm"
                  />
                </div>
                <div>
                  <label className="block text-xs font-medium text-zinc-400 mb-1.5 uppercase tracking-wider">{t('wizard.locationLabel')}</label>
                  <input
                    value={location}
                    onChange={e => setLocation(e.target.value)}
                    placeholder={t('wizard.locationPlaceholder')}
                    className="w-full px-4 py-2.5 bg-zinc-900 border border-zinc-700 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 transition-all text-sm"
                  />
                </div>
              </div>
              <p className="text-xs text-zinc-500 mb-5 flex items-center gap-1.5">
                <svg className="w-3.5 h-3.5 text-zinc-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                {t('wizard.campaignHint')}
              </p>
              <button
                onClick={createCampaign}
                disabled={campaignCreating || !keyword.trim() || !location.trim()}
                className="w-full py-3 text-sm font-medium bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-xl hover:from-emerald-400 hover:to-teal-500 disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-lg shadow-emerald-500/20 active:scale-[0.98] flex items-center justify-center gap-2"
              >
                {campaignCreating ? (
                  <><svg className="animate-spin w-4 h-4" viewBox="0 0 24 24"><circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" /><path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" /></svg>{t('wizard.creatingCampaign')}</>
                ) : campaignDone ? (
                  <><svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>{t('wizard.campaignCreated')}</>
                ) : t('wizard.createCampaign')}
              </button>
            </div>
          )}

          {/* Step 6: Sales Script */}
          {step === 6 && (
            <div className={animClass}>
              <div className="w-12 h-12 rounded-xl bg-zinc-700/50 flex items-center justify-center mb-4">
                <svg className="w-6 h-6 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <h2 className="text-lg font-bold text-white mb-1">{t('wizard.step5Title')}</h2>
              <p className="text-sm text-zinc-400 mb-5">{t('wizard.step5Desc')}</p>
              <div className="space-y-5">
                <div className="bg-zinc-900/40 border border-zinc-700/30 rounded-xl p-4">
                  <h3 className="text-sm font-semibold text-emerald-400 mb-2">{t('wizard.step5Step1Title')}</h3>
                  <p className="text-sm text-zinc-300 leading-relaxed">{t('wizard.step5Step1Desc')}</p>
                </div>
                <div className="bg-zinc-900/40 border border-zinc-700/30 rounded-xl p-4">
                  <h3 className="text-sm font-semibold text-emerald-400 mb-2">{t('wizard.step5Step2Title')}</h3>
                  <p className="text-sm text-zinc-300 leading-relaxed">{t('wizard.step5Step2Desc')}</p>
                </div>
                <div className="bg-zinc-900/40 border border-zinc-700/30 rounded-xl p-4">
                  <h3 className="text-sm font-semibold text-emerald-400 mb-2">{t('wizard.step5Step3Title')}</h3>
                  <p className="text-sm text-zinc-300 leading-relaxed">{t('wizard.step5Step3Desc')}</p>
                </div>
                <div className="bg-amber-500/5 border border-amber-500/20 rounded-xl p-4">
                  <p className="text-xs text-amber-300/90 leading-relaxed">{t('wizard.step5Note')}</p>
                </div>
              </div>
            </div>
          )}

          {/* Step 7: Complete */}
          {step === 7 && (
            <div className={animClass}>
              <div className="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center mx-auto mb-5 shadow-lg shadow-emerald-500/20">
                <svg className="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <h2 className="text-xl font-bold text-white text-center mb-2">{t('wizard.step6Title')}</h2>
              <p className="text-sm text-zinc-400 text-center mb-6 max-w-md mx-auto">{t('wizard.step6Desc')}</p>
              <div className="bg-zinc-900/40 border border-zinc-700/30 rounded-xl p-4 mb-6 space-y-3">
                <div className="flex items-center gap-3 text-sm">
                  <svg className="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
                  <span className="text-zinc-300">{t('wizard.step6Summary1')}</span>
                </div>
                <div className="flex items-center gap-3 text-sm">
                  <svg className="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
                  <span className="text-zinc-300">{t('wizard.step6Summary2')}</span>
                </div>
                <div className="flex items-center gap-3 text-sm">
                  <svg className="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" /></svg>
                  <span className="text-zinc-300">{t('wizard.step6Summary3')}</span>
                </div>
              </div>
              <button
                onClick={completeWizard}
                className="w-full py-3 text-sm font-bold bg-gradient-to-r from-emerald-500 to-teal-600 text-white rounded-xl hover:from-emerald-400 hover:to-teal-500 transition-all shadow-lg shadow-emerald-500/20 active:scale-[0.98]"
              >
                {t('wizard.step6Cta')}
              </button>
            </div>
          )}
        </div>

        {/* Footer navigation */}
        <div className="flex items-center justify-between px-6 py-4 border-t border-zinc-700 bg-zinc-800/50">
          <button
            onClick={() => goTo(step - 1)}
            disabled={step === 1}
            className="px-4 py-2 text-xs font-medium text-zinc-400 hover:text-white bg-zinc-700 rounded-lg hover:bg-zinc-600 disabled:opacity-30 disabled:cursor-not-allowed transition-all"
          >
            {t('wizard.back')}
          </button>
          {step === 1 && (
            <button onClick={() => goTo(2)} className="px-5 py-2 text-xs font-medium bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 transition-all shadow-sm shadow-emerald-500/20">
              {t('wizard.step1Cta')}
            </button>
          )}
          {step === 2 && (
            <button onClick={() => goTo(3)} className="px-5 py-2 text-xs font-medium bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 transition-all shadow-sm shadow-emerald-500/20">
              {t('wizard.next')}
            </button>
          )}
          {step === 6 && (
            <button onClick={() => goTo(7)} className="px-5 py-2 text-xs font-medium bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 transition-all shadow-sm shadow-emerald-500/20">
              {t('wizard.next')}
            </button>
          )}
        </div>
      </div>
    </div>
  );
}