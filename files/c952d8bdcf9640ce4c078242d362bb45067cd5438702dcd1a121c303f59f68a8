'use client';

import { useState } from 'react';
import { useTranslation } from 'react-i18next';
import SafeImg from '@/components/SafeImg';
import { cleanAddress } from '@/lib/address';

type Status = 'pending' | 'contacted' | 'negotiating' | 'not_interested' | 'sold';

export interface DetailLead {
  id: string;
  status: Status;
  deleted?: boolean;
  landingPage?: unknown;
  business: {
    name: string;
    category?: string;
    address?: string;
    rating?: number;
    ratingCount?: number;
    phone?: string;
    website?: string;
    googleUrl?: string;
    placeId?: string;
    hours?: string[];
    enrichedEmail?: string;
    enrichedSocials?: Partial<Record<'instagram' | 'facebook' | 'linkedin' | 'twitter' | 'tiktok' | 'youtube', string>>;
  };
}

interface Props {
  lead: DetailLead;
  statuses: { key: Status; label: string }[];
  /** Discovered photos first, then uploaded ones. */
  photos: string[];
  uploadedCount: number;
  /** Live main domain when the site is online. */
  siteUrl: string | null;
  canUnpublish: boolean;
  jobText: string | null;
  onOpenJob: () => void;
  onStatus: (s: Status) => void;
  onGenerate: () => void;
  onOpenStudio: () => void;
  onRegenerate: () => void;
  onImages: () => void;
  onUnpublish: () => void;
  onDelete: () => void;
  onRestore: () => void;
  onViewImage: (url: string) => void;
  onPrev?: () => void;
  onNext?: () => void;
  onClose: () => void;
}

const isWebUrl = (u?: string) => !!u && /^https?:\/\//i.test(u.trim());
const handle = (v: string) => v.replace(/^@/, '').split('/').pop()?.split('?')[0] || v;

/** "Tuesday10 AM–4 PM" → today's opening hours. */
function todayHours(hours?: string[]): { today: string | null; all: string } {
  if (!hours?.length) return { today: null, all: '' };
  const day = new Date().toLocaleDateString('en-US', { weekday: 'long' });
  const row = hours.find(h => h.toLowerCase().startsWith(day.toLowerCase()));
  const pretty = (h: string) => h.replace(/^([A-Za-z]+)(?=\S)/, '$1 ');
  return { today: row ? row.slice(day.length).trim() : null, all: hours.map(pretty).join('\n') };
}

function Row({ icon, label, children }: { icon: React.ReactNode; label: string; children: React.ReactNode }) {
  return (
    <div className="flex items-center gap-3 py-2.5 border-b border-zinc-200/70 dark:border-zinc-700/50 last:border-0">
      <span className="w-4 h-4 shrink-0 text-zinc-400 dark:text-zinc-500">{icon}</span>
      <span className="text-[13px] text-zinc-500 dark:text-zinc-400 shrink-0">{label}</span>
      <span className="ms-auto min-w-0 text-[13px] text-end text-zinc-900 dark:text-zinc-100 truncate">{children}</span>
    </div>
  );
}

