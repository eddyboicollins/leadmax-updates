.lm-map { background: #e4e4e7; }
.dark .lm-map { background: #18181b; }
/* Dark mode: invert the OSM tiles to a neutral dark grey with a faint emerald cast */
.dark .lm-map .leaflet-tile-pane { filter: invert(1) hue-rotate(180deg) grayscale(1) brightness(0.8) contrast(0.95) sepia(0.12) hue-rotate(95deg) saturate(1.6); }
.lm-map .leaflet-control-zoom { border: none !important; box-shadow: 0 4px 14px rgba(0,0,0,.25); border-radius: 12px; overflow: hidden; }
.lm-map .leaflet-control-zoom a { width: 34px; height: 34px; line-height: 34px; font-size: 18px; background: #fff; color: #27272a; border-color: #e4e4e7 !important; }
.dark .lm-map .leaflet-control-zoom a { background: #18181b; color: #e4e4e7; border-color: #27272a !important; }
.lm-map .leaflet-control-zoom a:hover { background: #f4f4f5; }
.dark .lm-map .leaflet-control-zoom a:hover { background: #27272a; }
.lm-map .leaflet-control-attribution { font-size: 9px; background: rgba(255,255,255,.7); color: #52525b; border-radius: 6px 0 0 0; }
.dark .lm-map .leaflet-control-attribution { background: rgba(9,9,11,.6); color: #a1a1aa; }
.dark .lm-map .leaflet-control-attribution a { color: #6ee7b7; }
.lm-pin { position: relative; width: 18px; height: 18px; cursor: pointer; }
.lm-pin-dot { position: absolute; inset: 2px; border-radius: 999px; border: 2px solid #09090b; box-shadow: 0 0 0 2px rgba(255,255,255,.08), 0 2px 6px rgba(0,0,0,.4); transition: transform .15s; }
.lm-pin:hover .lm-pin-dot { transform: scale(1.3); }
.lm-tone-new .lm-pin-dot { background: #34d399; }
.lm-tone-nosite .lm-pin-dot { background: #60a5fa; }
.lm-tone-nosite { animation: lm-bob 1.6s ease-in-out infinite; }
.lm-pin-sel-nosite .lm-pin-core { background: #60a5fa; border-color: #1e3a8a; box-shadow: 0 0 0 6px rgba(96,165,250,.25), 0 4px 14px rgba(0,0,0,.45); }
.lm-pin-sel-nosite .lm-pin-halo { background: radial-gradient(circle, rgba(96,165,250,.35) 0%, rgba(96,165,250,.12) 45%, transparent 70%); }
@media (prefers-reduced-motion: reduce) { .lm-tone-nosite { animation: none; } }
.lm-tone-site .lm-pin-dot { background: #ffffff; }
.lm-tone-worked .lm-pin-dot { background: #a1a1aa; }
.lm-tone-muted .lm-pin-dot { background: #52525b; }
html:not(.dark) .lm-pin-dot { border-color: #ffffff; box-shadow: 0 2px 6px rgba(0,0,0,.35); }
html:not(.dark) .lm-tone-site .lm-pin-dot { background: #18181b; }
.lm-pin-sel { width: 40px; height: 40px; z-index: 1000; }
.lm-pin-halo { position: absolute; inset: -14px; border-radius: 999px; background: radial-gradient(circle, rgba(52,211,153,.35) 0%, rgba(52,211,153,.12) 45%, transparent 70%); animation: lm-halo 2.4s ease-out infinite; }
.lm-pin-core { position: absolute; inset: 8px; border-radius: 999px; background: #34d399; border: 3px solid #064e3b; box-shadow: 0 0 0 6px rgba(52,211,153,.25), 0 4px 14px rgba(0,0,0,.45); }
.lm-pin-label { position: absolute; left: 50%; bottom: calc(100% + 10px); transform: translateX(-50%); display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 6px 10px; border-radius: 10px; background: #18181b; color: #fafafa; font: 600 12px/1 system-ui, sans-serif; border: 1px solid #3f3f46; box-shadow: 0 8px 22px rgba(0,0,0,.45); }
.lm-pin-label i { font-style: normal; color: #6ee7b7; font-weight: 600; }
html:not(.dark) .lm-pin-label { background: #ffffff; color: #18181b; border-color: #e4e4e7; }
html:not(.dark) .lm-pin-label i { color: #047857; }
@keyframes lm-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
