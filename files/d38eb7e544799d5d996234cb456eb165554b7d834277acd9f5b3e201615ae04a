/**
 * "ChatGPT Web (login)": the ChatGPT web UI used with the user's own account.
 *
 *  1. CONNECT (once): a visible Chrome opens chatgpt.com on its own profile
 *     (<data>/chatgpt-login-profile) and the user signs in there, any method
 *     (email, Google, Apple…). As soon as the page has a session, the window
 *     closes and the session is checked again in the hidden background browser
 *     (same executable, so the saved cookies decrypt). Only then is it saved
 *     as connected (<data>/chatgpt-login.json).
 *  2. ASK: the same page driving as the logged-out source (chatgptProxy.ts),
 *     in that profile, always in a TEMPORARY chat (no history, no memory).
 *     A lost session fails with a "reconnect" message and marks it disconnected.
 */
/* eslint-disable @typescript-eslint/no-explicit-any -- puppeteer pages */

import path from 'path';
import { promises as fs } from 'fs';
import type { ProxyStatus } from '@/lib/gemini';
import { dataDir } from '@/lib/aiProxy';
import { askChatGPTWith, checkChatGPTSession, closeChatGPTWith, readSession, type ChatGPTVariant } from '@/lib/chatgptProxy';
import { launchVisibleBrowser, waitForExit } from '@/lib/visibleBrowser';

const LOGIN_URL = 'https://chatgpt.com/auth/login';
const CONNECT_TIMEOUT_MS = 10 * 60_000;
const RECONNECT = 'Reconnect ChatGPT in Settings → AI source.';

const profileDir = () => path.join(dataDir(), 'chatgpt-login-profile');
const authPath = () => path.join(dataDir(), 'chatgpt-login.json');

interface ChatGPTLoginAuth {
  email: string;
  name: string;
  /** Browser the login ran in: the background browser must be the same one. */
  exe: string;
  connectedAt: string;
}

async function loadAuth(): Promise<ChatGPTLoginAuth | null> {
  try {
    const a = JSON.parse(await fs.readFile(authPath(), 'utf8'));
    return a && typeof a.connectedAt === 'string' ? a : null;
  } catch {
    return null;
  }
}

const ACCOUNT: ChatGPTVariant = {
  key: '__leadmaxChatgptLogin',
  log: 'chatgpt-login',
  profileDir,
  headless: () => process.env.CHATGPT_LOGIN_HEADLESS !== 'false',
  executablePath: async () => (await loadAuth())?.exe || undefined,
  account: { reconnectHint: RECONNECT },
};

// ── Connect state (shared across dev HMR reloads) ─────────────────────────

type ConnectState = 'idle' | 'waiting-login' | 'verifying' | 'error';

interface Shared {
  connect: ConnectState;
  connectError: string | null;
  connectBrowser: any | null;
  connectRun: Promise<void> | null;
  connectCancelled: boolean;
}

function shared(): Shared {
  const g = globalThis as unknown as { __leadmaxChatgptLoginConnect?: Shared };
  if (!g.__leadmaxChatgptLoginConnect) {
    g.__leadmaxChatgptLoginConnect = { connect: 'idle', connectError: null, connectBrowser: null, connectRun: null, connectCancelled: false };
  }
  return g.__leadmaxChatgptLoginConnect;
}

export interface ChatGPTLoginStatus {
  connected: boolean;
  connectedAt: string | null;
  email: string | null;
  connecting: ConnectState;
  error: string | null;
}

export async function getChatGPTLoginStatus(): Promise<ChatGPTLoginStatus> {
  const auth = await loadAuth();
  const s = shared();
  return {
    connected: !!auth,
    connectedAt: auth?.connectedAt ?? null,
    email: auth?.email || null,
    connecting: s.connect,
    error: s.connectError,
  };
}

const cancelledError = () => Object.assign(new Error('Login cancelled.'), { name: 'AbortError' });

async function runConnect(): Promise<void> {
  const s = shared();
  // The background browser holds the profile lock: release it for the window.
  await closeChatGPTWith(ACCOUNT);
  const { browser, exe, child } = await launchVisibleBrowser(profileDir(), LOGIN_URL, 'ChatGPT');
  s.connectBrowser = browser;
  let session: { email: string; name: string } | null = null;
  try {
    if (s.connectCancelled) throw cancelledError(); // cancelled while Chrome was starting
    const deadline = Date.now() + CONNECT_TIMEOUT_MS;
    while (Date.now() < deadline && !session) {
      if (s.connectCancelled) throw cancelledError();
      if (!browser.connected) throw new Error('The ChatGPT window was closed before the login finished.');
      // Sign-in may happen in another tab (Google / Apple): check every chatgpt.com tab.
      const pages = (await browser.pages().catch(() => [])) as any[];
      for (const page of pages) {
        if (!/^https:\/\/chatgpt\.com\//.test(page.url())) continue;
        session = await readSession(page);
        if (session) break;
      }
      if (!session) await new Promise(r => setTimeout(r, 1_500));
    }
    if (!session) throw new Error('Timed out waiting for the ChatGPT login (10 minutes).');
    s.connect = 'verifying';
    // Let the app finish writing its session cookies before the window closes.
    await new Promise(r => setTimeout(r, 2_500));
  } finally {
    s.connectBrowser = null;
    await browser.close().catch(() => {});
    await waitForExit(child);
  }

  // Same session in the hidden background browser, or it can't be used.
  await fs.mkdir(dataDir(), { recursive: true });
  const auth: ChatGPTLoginAuth = { email: session.email, name: session.name, exe, connectedAt: new Date().toISOString() };
  await fs.writeFile(authPath(), JSON.stringify(auth, null, 2));
  const check = await checkChatGPTSession(ACCOUNT).catch((err) => {
    console.log(`[chatgpt-login] background check failed: ${err instanceof Error ? err.message : err}`);
    return null;
  });
  if (!check) {
    await fs.rm(authPath(), { force: true });
    throw new Error('You logged in, but the hidden background browser could not reuse the session. Try Connect again; if it keeps failing, set CHATGPT_LOGIN_HEADLESS=false.');
  }
  console.log(`[chatgpt-login] connected as ${check.email || session.email}`);
}

/**
 * Open the login window and capture the session in the background (poll
 * getChatGPTLoginStatus() for the outcome). While it is open, Connect just
 * brings its window to the front.
 */
export function startChatGPTConnect(): void {
  const s = shared();
  s.connectCancelled = false;
  s.connectError = null;
  if (s.connectRun) {
    if (s.connect !== 'verifying') s.connect = 'waiting-login';
    void s.connectBrowser?.pages().then((pages: any[]) => pages[0]?.bringToFront()).catch(() => {});
    return;
  }
  s.connect = 'waiting-login';
  s.connectRun = runConnect()
    .then(() => { s.connect = 'idle'; })
    .catch(err => {
      if (s.connectCancelled) { s.connect = 'idle'; return; }
      s.connect = 'error';
      s.connectError = err instanceof Error ? err.message : String(err);
      console.log(`[chatgpt-login] connect failed: ${s.connectError}`);
    })
    .finally(() => { s.connectRun = null; });
}

/** Close the login window (also when Chrome is still starting). */
export async function cancelChatGPTConnect(): Promise<void> {
  const s = shared();
  s.connectCancelled = true;
  await s.connectBrowser?.close().catch(() => {});
  await s.connectRun;
  s.connect = 'idle';
  s.connectError = null;
}

/** Forget the account: saved state AND the profile's cookies (a real sign-out here). */
export async function disconnectChatGPT(): Promise<void> {
  await cancelChatGPTConnect();
  await closeChatGPTWith(ACCOUNT);
  await fs.rm(authPath(), { force: true });
  await fs.rm(profileDir(), { recursive: true, force: true }).catch(() => {});
}

/** Ask ChatGPT with the connected account. */
export async function askChatGPTLoginProxy(
  prompt: string,
  onChunk?: (text: string) => void,
  onStatus?: (event: ProxyStatus) => void,
  signal?: AbortSignal,
): Promise<string> {
  if (!(await loadAuth())) throw new Error(`ChatGPT (login) is not connected. ${RECONNECT.replace('Reconnect', 'Connect')}`);
  if (shared().connectRun) throw new Error('The ChatGPT login window is open — finish or cancel the login first.');
  try {
    return await askChatGPTWith(ACCOUNT, prompt, onChunk, onStatus, signal);
  } catch (err) {
    // Session gone: show it as disconnected so Settings offers Connect again.
    if (err instanceof Error && /not logged in anymore/.test(err.message)) await fs.rm(authPath(), { force: true });
    throw err;
  }
}
