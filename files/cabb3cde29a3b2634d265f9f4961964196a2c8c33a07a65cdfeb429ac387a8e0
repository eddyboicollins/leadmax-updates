import { NextRequest, NextResponse } from 'next/server';
import { getCampaign, getLead, appendLeadImage, updateLeadImages, getSettings } from '@/lib/store';
import sharp from 'sharp';
import { uploadToImgxx } from '@/lib/imgbb';

export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;
    const settings = await getSettings();
    const imgbbKey = settings.imgbbKey;
    if (!imgbbKey) {
      return NextResponse.json({ code: 'IMGXX_KEY_MISSING', error: 'ImgXX API key not configured. Set it in Settings.' }, { status: 400 });
    }

    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    // Soft-deleted photos don't count toward the limit — only active ones do.
    const activeCount = (lead.images || []).filter((i) => !i.deleted).length;
    if (activeCount >= 10) {
      return NextResponse.json({ error: 'Maximum 10 images allowed' }, { status: 400 });
    }

    const formData = await request.formData();
    const file = formData.get('file') as File | null;
    if (!file) return NextResponse.json({ error: 'No file provided' }, { status: 400 });

    const alt = (formData.get('alt') as string) || '';

    const arrayBuffer = await file.arrayBuffer();
    const inputBuffer = Buffer.from(arrayBuffer);

    let webpBuffer: Buffer;
    let metadata: { width?: number; height?: number };
    try {
      const transformer = sharp(inputBuffer);
      metadata = await transformer.metadata();
      webpBuffer = await transformer
        .webp({ quality: 80 })
        .toBuffer();
    } catch (err) {
      throw new Error(`Image conversion failed for "${file.name}": ${err instanceof Error ? err.message : String(err)}`);
    }

    const b64 = webpBuffer.toString('base64');
    let url: string;
    let delete_url: string | undefined;
    try {
      ({ url, delete_url } = await uploadToImgxx(b64, imgbbKey));
    } catch (err) {
      if (err instanceof Error && (err as Error & { code?: string }).code) throw err;
      throw new Error(`ImgXX hosting failed for "${file.name}": ${err instanceof Error ? err.message : String(err)}`);
    }

    const image = { id: crypto.randomUUID(), url, alt, width: metadata.width, height: metadata.height, deleteUrl: delete_url };
    await appendLeadImage(leadId, image);

    return NextResponse.json(image);
  } catch (err: any) {
    return NextResponse.json({ code: err.code, error: err.message || 'Upload failed' }, { status: 500 });
  }
}

export   async function DELETE(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;

    const { imageId } = await request.json();

    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    // Soft delete: hidden everywhere, restorable from the Deleted tab.
    const newImages = (lead.images || []).map((i) =>
      i.id === imageId ? { ...i, deleted: true, deletedAt: new Date().toISOString() } : i,
    );
    await updateLeadImages(leadId, newImages);

    return NextResponse.json({ success: true });
  } catch (err: any) {
    return NextResponse.json({ error: err.message || 'Delete failed' }, { status: 500 });
  }
}

export async function PATCH(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;
    const { imageId, alt } = await request.json();

    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    const newImages = (lead.images || []).map((i) => i.id === imageId ? { ...i, alt } : i);
    await updateLeadImages(leadId, newImages);

    return NextResponse.json({ success: true });
  } catch (err: any) {
    return NextResponse.json({ error: err.message || 'Update failed' }, { status: 500 });
  }
}
