/**
 * Targeted AI edits: instead of returning the whole component, the AI returns
 * only what changed, as SEARCH/REPLACE edit blocks:
 *
 *   <<<<<<< SEARCH
 *   (lines copied from the current component)
 *   =======
 *   (the lines that replace them)
 *   >>>>>>> REPLACE
 *
 * The SEARCH text is the anchor: it says exactly where the change goes, so no
 * markers are needed in the code and any kind of change (state, data arrays,
 * JSX, handlers, imports) can be expressed. Blocks are applied in order with
 * progressively more tolerant matching (exact → trailing spaces → indentation
 * → blank lines/inner spacing), but a match must always be UNIQUE: an anchor
 * that matches several places is refused rather than guessed.
 */

export interface EditBlock {
  search: string;
  replace: string;
}

export type EditReply =
  | { kind: 'edits'; blocks: EditBlock[] }
  | { kind: 'full'; code: string };

const SEARCH_RE = /^[ \t]*<{5,9}[ \t]*SEARCH[ \t]*$/i;
const DIVIDER_RE = /^[ \t]*={5,9}[ \t]*$/;
const REPLACE_RE = /^[ \t]*>{5,9}[ \t]*REPLACE[ \t]*$/i;
const FENCE_RE = /^[ \t]*```[\w+-]*[ \t]*$/;

/** True when the text contains at least one edit-block opener. */
export function hasEditBlocks(text: string): boolean {
  return /^[ \t]*<{5,9}[ \t]*SEARCH[ \t]*$/im.test(text);
}

/** Drop a markdown fence the AI put right inside a block section. */
function trimFences(lines: string[]): string[] {
  let a = 0;
  let b = lines.length;
  while (a < b && FENCE_RE.test(lines[a])) a++;
  while (b > a && FENCE_RE.test(lines[b - 1])) b--;
  return lines.slice(a, b);
}

/**
 * Parse an AI reply. Edit blocks win; text outside them (fences, notes) is
 * ignored. A reply with no blocks but a component is a full rewrite. Returns
 * null when the reply is neither.
 */
export function parseEditReply(raw: string): EditReply | null {
  const lines = raw.replace(/\r\n/g, '\n').split('\n');
  const blocks: EditBlock[] = [];
  let i = 0;
  while (i < lines.length) {
    if (!SEARCH_RE.test(lines[i])) { i++; continue; }
    const search: string[] = [];
    const replace: string[] = [];
    let j = i + 1;
    while (j < lines.length && !DIVIDER_RE.test(lines[j]) && !SEARCH_RE.test(lines[j])) search.push(lines[j++]);
    if (j >= lines.length || !DIVIDER_RE.test(lines[j])) { i = j; continue; } // malformed: no divider
    j++;
    while (j < lines.length && !REPLACE_RE.test(lines[j]) && !SEARCH_RE.test(lines[j])) replace.push(lines[j++]);
    // A missing REPLACE marker at the very end (reply cut short) is not trusted.
    if (j >= lines.length || !REPLACE_RE.test(lines[j])) { i = j; continue; }
    blocks.push({ search: trimFences(search).join('\n'), replace: trimFences(replace).join('\n') });
    i = j + 1;
  }
  if (blocks.length) return { kind: 'edits', blocks };
  if (/export\s+default/.test(raw)) return { kind: 'full', code: raw };
  return null;
}

// ── Applying ────────────────────────────────────────────────────────────

export interface FailedEdit {
  index: number; // 1-based position in the AI's list
  block: EditBlock;
  reason: 'empty' | 'not-found' | 'ambiguous';
  /** Where the code most resembles SEARCH (not-found) or every match (ambiguous). */
  hint?: string;
}

export interface ApplyResult {
  code: string;
  applied: number;
  failed: FailedEdit[];
  /** How each applied block was matched, for logs. */
  matches: string[];
}

interface Line { text: string; start: number; end: number } // end excludes '\n'

function splitLines(code: string): Line[] {
  const out: Line[] = [];
  let start = 0;
  for (const text of code.split('\n')) {
    out.push({ text, start, end: start + text.length });
    start += text.length + 1;
  }
  return out;
}

function trimBlankEdges(lines: string[]): string[] {
  let a = 0;
  let b = lines.length;
  while (a < b && !lines[a].trim()) a++;
  while (b > a && !lines[b - 1].trim()) b--;
  return lines.slice(a, b);
}

const leadingWs = (s: string) => s.match(/^[ \t]*/)![0];

/** Shift `text` so its indentation follows the code it replaces. */
function reindent(text: string, aiFirstLine: string, codeFirstLine: string): string {
  const from = leadingWs(aiFirstLine).replace(/\t/g, '  ').length;
  const to = leadingWs(codeFirstLine).replace(/\t/g, '  ').length;
  const delta = to - from;
  if (!delta) return text;
  return text.split('\n').map(l => {
    if (!l.trim()) return l;
    if (delta > 0) return ' '.repeat(delta) + l;
    const ws = leadingWs(l);
    return l.slice(Math.min(ws.length, -delta));
  }).join('\n');
}

type Norm = (s: string) => string;
interface Level { name: string; norm: Norm; skipBlank: boolean; reindent: boolean }

const LEVELS: Level[] = [
  { name: 'trailing-space', norm: s => s.trimEnd(), skipBlank: false, reindent: false },
  { name: 'indent', norm: s => s.trim(), skipBlank: false, reindent: true },
  { name: 'spacing', norm: s => s.trim().replace(/\s+/g, ' '), skipBlank: true, reindent: true },
];

/** Line ranges [first, last] of `code` whose normalized lines equal `want`. */
function lineMatches(lines: Line[], want: string[], level: Level): Array<[number, number]> {
  const norm = level.norm;
  const target = want.map(norm).filter(l => !level.skipBlank || l);
  if (!target.length) return [];
  const idx = level.skipBlank
    ? lines.map((l, i) => (norm(l.text) ? i : -1)).filter(i => i >= 0)
    : lines.map((_, i) => i);
  const normed = idx.map(i => norm(lines[i].text));
  const out: Array<[number, number]> = [];
  for (let s = 0; s + target.length <= idx.length; s++) {
    let ok = true;
    for (let k = 0; k < target.length; k++) {
      if (normed[s + k] !== target[k]) { ok = false; break; }
    }
    if (ok) out.push([idx[s], idx[s + target.length - 1]]);
  }
  return out;
}

function countExact(code: string, search: string): number[] {
  const at: number[] = [];
  let from = 0;
  for (;;) {
    const i = code.indexOf(search, from);
    if (i < 0) return at;
    at.push(i);
    from = i + 1;
  }
}

const lineNoAt = (code: string, offset: number) => code.slice(0, offset).split('\n').length;

/** Numbered excerpt of `code`, lines [from, to] (1-based, clamped). */
export function excerpt(code: string, from: number, to: number): string {
  const lines = code.split('\n');
  const a = Math.max(1, from);
  const b = Math.min(lines.length, to);
  const out: string[] = [];
  for (let n = a; n <= b; n++) out.push(`${String(n).padStart(4)}| ${lines[n - 1]}`);
  return out.join('\n');
}

/** The region of `code` that shares the most lines with SEARCH, as an excerpt. */
function closestRegion(code: string, search: string): string | undefined {
  const want = search.split('\n').map(s => s.trim()).filter(Boolean);
  if (!want.length) return undefined;
  const lines = code.split('\n').map(s => s.trim());
  const wantSet = new Set(want);
  const n = want.length;
  let best = -1;
  let bestScore = 0;
  for (let s = 0; s < lines.length; s++) {
    let score = 0;
    for (let k = 0; k < n && s + k < lines.length; k++) if (wantSet.has(lines[s + k])) score++;
    if (score > bestScore) { bestScore = score; best = s; }
  }
  // Nothing in common line-for-line: look for its longest distinctive line.
  if (best < 0) {
    const probe = [...want].sort((a, b) => b.length - a.length)[0].slice(0, 40);
    const hit = lines.findIndex(l => l.includes(probe));
    if (hit < 0) return undefined;
    best = hit;
  }
  return excerpt(code, best + 1 - 3, best + n + 3);
}

function applyOne(code: string, block: EditBlock, index: number): { code: string; how: string } | FailedEdit {
  if (!block.search.trim()) return { index, block, reason: 'empty' };

  // 1. Exact text (may be part of a line).
  const exact = countExact(code, block.search);
  if (exact.length === 1) {
    const at = exact[0];
    return { code: code.slice(0, at) + block.replace + code.slice(at + block.search.length), how: 'exact' };
  }
  if (exact.length > 1) {
    return {
      index, block, reason: 'ambiguous',
      hint: exact.slice(0, 5).map(at => { const n = lineNoAt(code, at); return excerpt(code, n - 1, n + 1); }).join('\n    ...\n'),
    };
  }

  // 2+. Whole lines, increasingly tolerant; the first level with a match decides.
  const lines = splitLines(code);
  const want = trimBlankEdges(block.search.split('\n'));
  const replaceLines = trimBlankEdges(block.replace.split('\n'));
  for (const level of LEVELS) {
    const hits = lineMatches(lines, want, level);
    if (hits.length > 1) {
      return {
        index, block, reason: 'ambiguous',
        hint: hits.slice(0, 5).map(([a, b]) => excerpt(code, a + 1, b + 1)).join('\n    ...\n'),
      };
    }
    if (hits.length === 1) {
      const [a, b] = hits[0];
      let text = replaceLines.join('\n');
      if (level.reindent) {
        const aiFirst = want.find(l => l.trim()) ?? '';
        text = reindent(text, aiFirst, lines[a].text);
      }
      return { code: code.slice(0, lines[a].start) + text + code.slice(lines[b].end), how: level.name };
    }
  }
  return { index, block, reason: 'not-found', hint: closestRegion(code, block.search) };
}

/** Apply blocks in order. Failed blocks are skipped and reported. */
export function applyEdits(code: string, blocks: EditBlock[]): ApplyResult {
  let out = code;
  const failed: FailedEdit[] = [];
  const matches: string[] = [];
  blocks.forEach((block, i) => {
    const r = applyOne(out, block, i + 1);
    if ('reason' in r) { failed.push(r); return; }
    out = r.code;
    matches.push(r.how);
  });
  return { code: out, applied: matches.length, failed, matches };
}

/** Render one block back in the wire format (for repair prompts). */
export function formatBlock(b: EditBlock): string {
  return `<<<<<<< SEARCH\n${b.search}\n=======\n${b.replace}\n>>>>>>> REPLACE`;
}
