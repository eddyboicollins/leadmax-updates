import { NextResponse } from 'next/server';
import { cancelChatGPTConnect, disconnectChatGPT, getChatGPTLoginStatus, startChatGPTConnect } from '@/lib/chatgptLogin';

/** ChatGPT (login) session state (connected / login window open / last error). */
export async function GET() {
  return NextResponse.json(await getChatGPTLoginStatus());
}

/**
 * POST { action: 'connect' }    — open the login window (poll GET for the outcome)
 *      { action: 'cancel' }     — close the login window
 *      { action: 'disconnect' } — sign out and forget the session
 */
export async function POST(request: Request) {
  try {
    const body = await request.json().catch(() => ({}));
    if (body?.action === 'connect') startChatGPTConnect();
    else if (body?.action === 'cancel') await cancelChatGPTConnect();
    else if (body?.action === 'disconnect') await disconnectChatGPT();
    else return NextResponse.json({ error: 'unknown action' }, { status: 400 });
    return NextResponse.json(await getChatGPTLoginStatus());
  } catch (err) {
    return NextResponse.json({ error: err instanceof Error ? err.message : 'ChatGPT action failed' }, { status: 500 });
  }
}
