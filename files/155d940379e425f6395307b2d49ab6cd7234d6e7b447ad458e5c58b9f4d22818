import { NextRequest, NextResponse } from 'next/server';
import { getCampaigns, saveCampaign, saveManualCampaign, addLeads, deleteCampaign } from '@/lib/store';
import { scrapePlaceLinks } from '@/lib/scrapePlaces';
import { v4 as uuidv4 } from 'uuid';

/** Multi-regional campaigns: one keyword, at most this many regions. */
const MAX_REGIONS = 10;

export const maxDuration = 300;

export async function GET(request: NextRequest) {
  const deletedParam = request.nextUrl.searchParams.get('deleted');
  const campaigns = await getCampaigns();
  if (deletedParam === 'all') {
    return NextResponse.json({ campaigns });
  }
  if (deletedParam === 'true') {
    return NextResponse.json({ campaigns: campaigns.filter(c => c.deleted) });
  }
  return NextResponse.json({ campaigns: campaigns.filter(c => !c.deleted) });
}

export async function POST(request: NextRequest) {
  try {
    const body = await request.json();
    const { keyword, location, regions, mode, displayName, entries } = body;

    // Manual mode: user's own clients. Each Maps link is scraped directly
    // (same extraction as the main scraper: reviews count, photos, …) — no AI.
    if (mode === 'manual') {
      const name = typeof displayName === 'string' ? displayName.trim() : '';
      const list = Array.isArray(entries)
        ? entries
            .filter((e: any) => e && typeof e.name === 'string' && e.name.trim() && typeof e.mapsUrl === 'string' && e.mapsUrl.trim())
            .map((e: any) => ({ name: e.name.trim(), mapsUrl: e.mapsUrl.trim() }))
        : [];
      if (!name) {
        return NextResponse.json({ error: 'campaign name required' }, { status: 400 });
      }
      if (list.length === 0) {
        return NextResponse.json({ error: 'at least one business with a Maps link required' }, { status: 400 });
      }
      const campaign = await saveManualCampaign(name);
      const scraped = await scrapePlaceLinks(list);
      const found = scraped.filter(r => r.ok && r.business);
      if (found.length) await addLeads(campaign.id, found.map(r => ({ leadId: uuidv4(), business: r.business! })));
      const results = scraped.map(r => ({ name: r.name, ok: r.ok, error: r.error }));
      return NextResponse.json({ ...campaign, resolveResults: results });
    }

    if (!keyword || !location) {
      return NextResponse.json({ error: 'keyword and location required' }, { status: 400 });
    }
    let regionList = regions;
    if (Array.isArray(regionList)) {
      // One keyword for every region; duplicate regions dropped; capped at MAX_REGIONS.
      const seen = new Set<string>();
      regionList = regionList
        .filter((r: any) => r && typeof r.location === 'string' && r.location.trim())
        .map((r: any) => ({ keyword, location: r.location.trim() }))
        .filter((r: { location: string }) => {
          const k = r.location.toLowerCase();
          if (seen.has(k)) return false;
          seen.add(k);
          return true;
        });
      if (regionList.length > MAX_REGIONS) {
        return NextResponse.json({ error: `At most ${MAX_REGIONS} regions per campaign` }, { status: 400 });
      }
    }
    const campaign = await saveCampaign(keyword, location, Array.isArray(regionList) && regionList.length > 0 ? regionList : undefined);
    return NextResponse.json(campaign);
  } catch (err: any) {
    return NextResponse.json({ error: err.message }, { status: 500 });
  }
}

export async function DELETE(request: NextRequest) {
  const id = request.nextUrl.searchParams.get('id');
  if (!id) {
    return NextResponse.json({ error: 'id required' }, { status: 400 });
  }
  await deleteCampaign(id);
  return NextResponse.json({ success: true });
}
