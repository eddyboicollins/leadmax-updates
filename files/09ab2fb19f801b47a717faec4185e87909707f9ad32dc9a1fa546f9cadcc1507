.lm-map .leaflet-control-zoom a { width: 34px; height: 34px; line-height: 34px; font-size: 18px; background: #fff; color: #27272a; border-color: #e4e4e7 !important; }
.dark .lm-map .leaflet-control-zoom a { background: #18181b; color: #e4e4e7; border-color: #27272a !important; }
.lm-map .leaflet-control-zoom a:hover { background: #f4f4f5; }
.dark .lm-map .leaflet-control-zoom a:hover { background: #27272a; }
.lm-map .leaflet-control-attribution { font-size: 9px; background: rgba(255,255,255,.7); color: #52525b; border-radius: 6px 0 0 0; }
