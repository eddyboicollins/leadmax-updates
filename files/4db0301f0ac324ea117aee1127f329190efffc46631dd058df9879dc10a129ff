import { askGemini, DEFAULT_GEMINI_MODEL, type GeminiModel, type GeminiSource } from '@/lib/gemini';

export const FORCED_BIZCARD_KEYWORD = 'real estate brokerage agency';

export interface GulfCheckResult {
  isGulf: boolean;
  country: string;
}

const GULF_COUNTRIES = [
  'united arab emirates',
  'saudi arabia',
  'qatar',
  'kuwait',
  'bahrain',
  'oman',
];

function buildGulfPrompt(location: string): string {
  return `Determine whether the following location is in the Gulf region (GCC).

LOCATION: ${location}

Gulf region means ONLY these 6 countries: United Arab Emirates, Saudi Arabia, Qatar, Kuwait, Bahrain, Oman.

Return ONLY raw JSON — no markdown, no explanation, no fences — with exactly these keys:
{"isGulf":true/false,"country":"country name or empty string"}

Rules:
- isGulf is true ONLY if the location is inside one of the 6 countries above.
- country is the detected country name (e.g. "United Arab Emirates"), or "" if unknown.
- Do NOT hallucinate. Base the answer on the location string.
- Return the JSON on a single line.`;
}

function parseGulfJson(raw: string): GulfCheckResult | null {
  const trimmed = raw.trim();
  const cleaned = trimmed
    .replace(/^```json\s*/i, '')
    .replace(/^```\s*/i, '')
    .replace(/```\s*$/i, '')
    .trim();
  const start = cleaned.indexOf('{');
  const end = cleaned.lastIndexOf('}');
  if (start === -1 || end === -1) return null;
  try {
    const obj = JSON.parse(cleaned.slice(start, end + 1));
    const isGulf = obj.isGulf === true;
    const country = typeof obj.country === 'string' ? obj.country.trim() : '';
    // Safety net: if AI says true but country is clearly non-Gulf, trust country list
    if (isGulf && country) {
      const norm = country.toLowerCase();
      const inList = GULF_COUNTRIES.some(c => norm.includes(c) || c.includes(norm));
      // keep AI answer but prefer strict list; if country unknown keep AI
      if (!inList && norm.length > 2) {
        // leave as AI said — country detection may use short names; do not override
      }
    }
    return { isGulf, country };
  } catch {
    return null;
  }
}

export async function checkGulfRegion(
  location: string,
  apiKey: string,
  model: GeminiModel = DEFAULT_GEMINI_MODEL,
  source: GeminiSource = 'proxy',
): Promise<GulfCheckResult> {
  const prompt = buildGulfPrompt(location);
  const raw = await askGemini(prompt, apiKey, model, source);
  const parsed = parseGulfJson(raw);
  if (!parsed) throw new Error('Gulf check returned invalid response');
  return parsed;
}
