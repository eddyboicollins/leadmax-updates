interface Business {
  id: string;
  name: string;
  rating: number;
  ratingCount: number;
  address: string;
  phone: string;
  website: string;
  category: string;
  reviews: { author: string; text: string; rating: number; date: string }[];
  latitude?: number;
  longitude?: number;
  placeId: string;
  googleUrl: string;
  hours?: string[];
  scrapedImages?: { id: string; url: string; width?: number; height?: number }[];
  scrapedAt?: string;
  enrichedEmail?: string;
  enrichedSocials?: { instagram?: string; facebook?: string; linkedin?: string; twitter?: string; tiktok?: string; youtube?: string };
  enrichmentDone?: boolean;
}

function activeImages<T extends { deleted?: boolean }>(imgs?: T[]): T[] {
  return (imgs || []).filter(i => !i.deleted);
}

/** Only absolute http(s) URLs may be used as link targets (never relative paths or markdown). */
function isWebUrl(u?: string): boolean {
  return !!u && /^https?:\/\//i.test(u.trim());
}

interface Lead {
  id: string;
  business: Business;
  status: 'pending' | 'contacted' | 'negotiating' | 'not_interested' | 'sold';
  deleted?: boolean;
  deletedAt?: string;
  notes: string;
  deploymentName?: string;
  landingPage?: { tsx: string; generatedAt: string; version: number };
  images?: { id: string; url: string; alt: string; aiCaption?: string; deleted?: boolean; deletedAt?: string }[];
  agentInfo?: { fullName: string; email: string; phone: string; [k: string]: any };
  agentCards?: any[];
  deployment?: { provider: string; url: string; deployedAt: string; projectName?: string };
  deploymentHistory?: { id: string; vercelDeploymentId: string; url: string; aliasUrl: string; deployedAt: string; userPrompt?: string; isMain: boolean; comingSoon?: boolean; tsx: string }[];
  createdAt: string;
  updatedAt?: string;
}

/** Agent tabs row for biz-card leads: one tab per agent + add/duplicate/main/delete. */
function LeadAgentTabs({ cards, activeId, onSelect, onAdd, onDuplicate, onSetMain, onDelete, onEdit }: {
  cards: any[];
  activeId: string | null;
  onSelect: (cardId: string) => void;
  onAdd: () => void;
  onDuplicate: (cardId: string) => void;
  onSetMain: (cardId: string) => void;
  onDelete: (cardId: string) => void;
  onEdit: (cardId: string) => void;
}) {
  const active = cards.find(c => c.id === activeId) || cards.find(c => c.isMain) || cards[0] || null;
  const label = (card: any, i: number) => {
    const first = String(card?.agentInfo?.fullName || '').trim().split(/\s+/)[0];
    return first || `Agent ${i + 1}`;
  };
  return (
    <div className="mb-2">
      <div className="flex flex-wrap items-center gap-1.5">
        {cards.map((c, i) => {
          const isActive = active?.id === c.id;
          return (
            <button
              key={c.id}
              onClick={() => onSelect(c.id)}
              title={c?.agentInfo?.fullName || `Agent ${i + 1}`}
              className={`inline-flex items-center gap-1 px-2.5 py-1 text-[11px] font-medium rounded-lg border transition-all max-w-[140px] ${isActive ? 'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/40' : 'bg-zinc-100 dark:bg-zinc-700/50 text-zinc-600 dark:text-zinc-400 border-transparent hover:border-emerald-500/30'}`}
            >
              {c.isMain && <span className="shrink-0" title="Main card">★</span>}
              <span className="truncate">{label(c, i)}</span>
              {c.tsx && <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0" title="Generated" />}
            </button>
          );
        })}
        <button
          onClick={onAdd}
          title="Add agent"
          className="inline-flex items-center gap-1 px-2 py-1 text-[11px] font-medium rounded-lg border border-dashed border-emerald-500/40 text-emerald-600 dark:text-emerald-400 hover:bg-emerald-500/10 transition-all"
        >
          <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M12 4v16m8-8H4" /></svg>
          Agent
        </button>
      </div>
      {active && cards.length > 0 && (
        <div className="flex flex-wrap items-center gap-1.5 mt-1.5">
          <button onClick={() => onEdit(active.id)} className="px-2 py-0.5 text-[10px] font-medium text-zinc-500 dark:text-zinc-400 hover:text-emerald-400 hover:bg-emerald-500/10 rounded-md transition-all">Edit info</button>
          <button onClick={() => onDuplicate(active.id)} className="px-2 py-0.5 text-[10px] font-medium text-zinc-500 dark:text-zinc-400 hover:text-emerald-400 hover:bg-emerald-500/10 rounded-md transition-all">Duplicate</button>
          {!active.isMain && (
            <button onClick={() => onSetMain(active.id)} className="px-2 py-0.5 text-[10px] font-medium text-zinc-500 dark:text-zinc-400 hover:text-emerald-400 hover:bg-emerald-500/10 rounded-md transition-all">Set as main</button>
          )}
          {cards.length > 1 && (
            <button onClick={() => onDelete(active.id)} className="px-2 py-0.5 text-[10px] font-medium text-zinc-500 dark:text-zinc-400 hover:text-red-400 hover:bg-red-500/10 rounded-md transition-all">Delete</button>
          )}
        </div>
      )}
    </div>
  );
}

export default function CampaignPage() {
  const params = useParams();
  const router = useRouter();
  const searchParams = useSearchParams();
  const id = params.id as string;

  const queryClient = useQueryClient();
  const { data: campaign, isLoading, refetch: refetchCampaign } = useCampaign(id);
  const updateStatusMutation = useUpdateLeadStatus();
  const deleteLeadMutation = useDeleteLead();
  const restoreLeadMutation = useRestoreLead();
  const { t } = useTranslation();
  const { toast, confirm } = useToast();
  const scrape = useScrape();
  const generation = useGeneration();
  const scraping = scrape.running && scrape.campaignId === id;
  const genJobForLead = (leadId: string) =>
    generation.jobs.find(j => j.leadId === leadId && j.phase !== 'done' && j.phase !== 'error');
  // New AI work is blocked while a job runs (toast instead of dead buttons,
  // so the studio and cards stay browsable mid-job).
  function blockIfBusy(): boolean {
    if (generation.activeJobs.length > 0) {
      toast(t('campaign.genBusy'), 'info');
      return true;
    }
    return false;
  }
  const isComingSoonActive = (lead: Lead) =>
    !!lead.deployment && !!lead.deploymentHistory?.some(e => e.isMain && e.comingSoon);

  const STATUSES: { key: Lead['status']; label: string }[] = [
    { key: 'pending', label: t('campaign.pending') },
    { key: 'contacted', label: t('campaign.contacted') },
    { key: 'negotiating', label: t('campaign.negotiating') },
    { key: 'not_interested', label: t('campaign.notInterested') },
    { key: 'sold', label: t('campaign.sold') },
  ];

  // Sorting-only filters (NOT lead statuses): site presence.
  const SITE_FILTERS: { key: string; label: string }[] = [
    { key: 'has_site', label: t('campaign.hasSite') },
    { key: 'no_website', label: t('campaign.noWebsite') },
  ];

  const filterLabel = (key: string) =>
    STATUSES.find(st => st.key === key)?.label ?? SITE_FILTERS.find(st => st.key === key)?.label ?? key;

  const [filterStatus, setFilterStatus] = useState<string>('all');
  const [genCounts, setGenCounts] = useState<Record<string, number>>({});
  const [studioLeadId, setStudioLeadId] = useState<string | null>(null);
  const [imagesLead, setImagesLead] = useState<Lead | null>(null);
  const [showImagesModal, setShowImagesModal] = useState(false);
  const [uploading, setUploading] = useState(false);
  const [imagesTab, setImagesTab] = useState<'uploaded' | 'discovered' | 'deleted'>('uploaded');
  const [selectedScraped, setSelectedScraped] = useState<Set<string>>(new Set());
  const [importedScrapedIds, setImportedScrapedIds] = useState<Set<string>>(new Set());
  const [importing, setImporting] = useState(false);
  const [viewImage, setViewImage] = useState<string | null>(null);
  const [generateLeadId, setGenerateLeadId] = useState<string | null>(null);
  const [generatePrompt, setGeneratePrompt] = useState('');
  const [showGenerateModal, setShowGenerateModal] = useState(false);
  const [showAddClients, setShowAddClients] = useState(false);
  const [manualRows, setManualRows] = useState([{ name: '', mapsUrl: '' }]);
  const [resolvingClients, setResolvingClients] = useState(false);
  const [showAgentModal, setShowAgentModal] = useState(false);
  const [agentLeadId, setAgentLeadId] = useState<string | null>(null);
  const [agentCardId, setAgentCardId] = useState<string | null>(null);
  const [pendingAgentGenerate, setPendingAgentGenerate] = useState<string | null>(null);
  const [pendingAgentCard, setPendingAgentCard] = useState<string | null>(null);
  const [generateCardId, setGenerateCardId] = useState<string | null>(null);
  const [domainCardId, setDomainCardId] = useState<string | null>(null);
  const [studioCardId, setStudioCardId] = useState<string | null>(null);
  const [activeCardId, setActiveCardId] = useState<Record<string, string>>({});
  const [interactiveMapOpen, setInteractiveMapOpen] = useState(false);

  const [statusMenuLeadId, setStatusMenuLeadId] = useState<string | null>(null);
  const statusMenuRefs = useRef<Record<string, HTMLDivElement | null>>({});
  const statusMenuOpenRef = useRef<string | null>(null);
  const [domainEditLeadId, setDomainEditLeadId] = useState<string | null>(null);
  const [domainDraft, setDomainDraft] = useState<Record<string, string>>({});
  const [domainAvailability, setDomainAvailability] = useState<Record<string, { checking: boolean; available?: boolean; error?: string }>>({});
  const domainCheckTimers = useRef<Record<string, ReturnType<typeof setTimeout>>>({});
  const [pendingGenerateLeadId, setPendingGenerateLeadId] = useState<string | null>(null);

  useEffect(() => {
    function onClick(e: MouseEvent) {
      const openId = statusMenuOpenRef.current;
      const el = openId ? statusMenuRefs.current[openId] : null;
      if (openId && el && !el.contains(e.target as Node)) {
        setStatusMenuLeadId(null);
        statusMenuOpenRef.current = null;
      }
    }
    document.addEventListener('mousedown', onClick);
    return () => document.removeEventListener('mousedown', onClick);
  }, []);

  useLockBodyScroll(
    !!viewImage || !!studioLeadId || !!domainEditLeadId || showGenerateModal || showImagesModal || showAgentModal || showAddClients,
  );

  useEffect(() => {
    if (isLoading || !campaign?.leads) return;
    fetch(`/api/generations/count?campaignId=${id}`)
      .then(r => r.ok ? r.json() : null)
      .then(data => { if (data) setGenCounts(data); })
      .catch(() => {});
  }, [isLoading, campaign?.leads, id]);

  useEffect(() => {
    if (!id) return;
    setLastVisitedCampaign(id);
  }, [id]);

  async function loadCampaign() {
    const c = await refetchCampaign();
    return c.data || null;
  }

  function handleImageUploadError(err: any, context?: string) {
    const reason = err?.message || 'Upload failed';
    toast(context ? `${context}: ${reason}` : reason, 'error');
    if (err?.code === 'IMGXX_KEY_MISSING' || err?.code === 'IMGXX_KEY_INVALID') {
      setTimeout(() => router.push('/settings?focus=imgxxKey'), 250);
    }
  }

  async function refreshImagesLead(leadId: string) {
    queryClient.invalidateQueries({ queryKey: ['campaign', id] });
    const fresh = await loadCampaign();
    const updated = fresh?.leads.find((l: any) => l.id === leadId);
    if (updated) setImagesLead(updated as Lead);
  }

  async function deleteLeadImage(leadId: string, imageId: string) {
    await fetch(`/api/campaigns/${id}/leads/${leadId}/images`, { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageId }) });
    await refreshImagesLead(leadId);
  }

  async function restoreLeadImage(leadId: string, imageId: string) {
    try {
      const res = await fetch(`/api/campaigns/${id}/leads/${leadId}/images/restore`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ imageId }) });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error || 'Restore failed');
      }
      await refreshImagesLead(leadId);
    } catch (err: any) {
      toast(err.message, 'error');
    }
  }

  // Runs async jobs with limited parallelism (3 at a time): fast uploads stay
  // fast without hammering imgbb / Gemini web into rate limits.
  async function eachLimit<T>(items: T[], limit: number, fn: (item: T) => Promise<void>) {
    const queue = [...items];
    await Promise.all(Array.from({ length: Math.min(limit, queue.length) }, async () => {
      while (queue.length > 0) {
        const item = queue.shift()!;
        await fn(item);
      }
    }));
  }

  async function uploadFilesForLead(lead: Lead, files: File[]) {
    if (files.length === 0) return;
    const leadId = lead.id;
    const remaining = 10 - activeImages(lead.images).length;
    if (files.length > remaining) { toast(t('campaign.maxImages', { count: remaining }), 'error'); return; }
    setUploading(true);
    try {
      await eachLimit(files, 3, async (file) => {
        try {
          const formData = new FormData();
          formData.append('file', file);
          formData.append('alt', file.name.replace(/\.[^/.]+$/, ''));
          const res = await fetch(`/api/campaigns/${id}/leads/${leadId}/images`, { method: 'POST', body: formData });
          if (!res.ok) {
            const err = await res.json().catch(() => ({ error: 'Upload failed' }));
            const error = new Error(err.error || t('campaign.uploadFailed', { status: res.status }));
            (error as any).code = err.code;
            throw error;
          }
          await res.json();
        } catch (err: any) {
          handleImageUploadError(err, `Upload of "${file.name}" failed`);
        }
      });
      await refreshImagesLead(leadId);
    } finally {
      setUploading(false);
    }
  }

  async function handleFileUpload(files: File[]) {
    if (!imagesLead) return;
    await uploadFilesForLead(imagesLead, files);
  }

  async function openImagesModal(lead: Lead) {
    const fresh = await loadCampaign();
    const updated = fresh?.leads.find((l: any) => l.id === lead.id);
    if (updated) {
      setImagesTab('uploaded');
      setSelectedScraped(new Set());
      setImportedScrapedIds(new Set());
      setViewImage(null);
      setImagesLead(updated as Lead);
      setShowImagesModal(true);
    }
  }

  async function importSelectedImages() {
    if (!imagesLead || selectedScraped.size === 0) return;
    const leadId = imagesLead.id;
    const remaining = 10 - activeImages(imagesLead.images).length;
    const scraped = imagesLead.business.scrapedImages || [];
    const toImport = scraped.filter(s => selectedScraped.has(s.id)).slice(0, remaining);
    if (toImport.length === 0) return;
    setImporting(true);
    let importedCount = 0;
    let failedCount = 0;
    let firstError = '';
    try {
      await eachLimit(toImport, 3, async (item) => {
        try {
          const res = await fetch(`/api/campaigns/${id}/leads/${leadId}/images/import`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ urls: [item.url] }),
          });
          if (!res.ok) {
            const err = await res.json().catch(() => ({ error: 'Import failed' }));
            const error = new Error(err.error || 'Import failed');
            (error as any).code = err.code;
            throw error;
          }
          const data = await res.json();
          const result = data.results?.[0];
          if (!result?.ok) throw new Error(result?.error || 'Import failed');
          importedCount++;
          setImportedScrapedIds(prev => { const next = new Set(prev); next.add(item.id); return next; });
        } catch (err: any) {
          failedCount++;
          if (!firstError) firstError = err?.message || 'Import failed';
        }
      });
      await refreshImagesLead(leadId);
      setSelectedScraped(new Set());
      if (failedCount > 0) toast(`${t('campaign.importPartial', { ok: importedCount, failed: failedCount })}${firstError ? ` — ${firstError}` : ''}`, 'success');
    } finally {
      setImporting(false);
    }
  }

  function leadFeaturedImage(lead: Lead): string | null {
    // Skip unreliable session-gated Google photo URLs (googleusercontent / google.com)
    const discovered = lead.business.scrapedImages?.find(s => !/googleusercontent|\.google\.com/.test(s.url))?.url;
    if (discovered) return discovered;
    const uploaded = activeImages(lead.images)[0]?.url;
    if (uploaded) return uploaded;
    if (lead.business.website) {
      try {
        const domain = new URL(lead.business.website).hostname;
        return `https://www.google.com/s2/favicons?domain=${domain}&sz=128`;
      } catch { /* ignore */ }
    }
    return null;
  }

  async function startScrape() {
    const regions: { keyword: string; location: string }[] =
      campaign?.regions && campaign.regions.length > 0
        ? campaign.regions.map(rg => ({
            keyword: rg.keyword,
            location: rg.location,
          }))
        : [{
            keyword: campaign!.keyword,
            location: campaign!.location,
          }];

    scrape.startScrape({
      campaignId: id,
      keyword: campaign!.keyword,
      location: campaign!.location,
      regions,
    });
  }

  async function updateLeadStatus(leadId: string, status: Lead['status']) {
    updateStatusMutation.mutate({ campaignId: id, leadId, status });
  }

  async function deleteLead(leadId: string) {
    if (!(await confirm({ message: t('campaign.deleteConfirm') }))) return;
    deleteLeadMutation.mutate({ campaignId: id, leadId });
  }

  async function restoreLead(leadId: string) {
    restoreLeadMutation.mutate({ campaignId: id, leadId });
  }

  async function doGenerate(leadId: string, extraInstructions?: string, cardId?: string | null) {
    if (blockIfBusy()) return;
    const lead = allLeads.find((l: any) => l.id === leadId);
    const isBiz = (campaign as any)?.assetType === 'bizcard';
    const card = isBiz ? (cardsOf(lead).find(c => c.id === (cardId || activeCardOf(lead)?.id)) || null) : null;
    if (isBiz) {
      const hasAgent = !!card?.agentInfo?.fullName && !!card?.agentInfo?.email && !!card?.agentInfo?.phone;
      if (!hasAgent) {
        toast('Set agent info for this card first', 'error');
        setAgentLeadId(leadId);
        setAgentCardId(card?.id || null);
        setPendingAgentGenerate(leadId);
        setPendingAgentCard(card?.id || null);
        setShowAgentModal(true);
        return;
      }
    }
    const hasDeployment = isBiz
      ? !!(card?.deploymentUrl || (card?.deploymentHistory?.length || 0) > 0)
      : (!!lead?.deployment?.url || (lead?.deploymentHistory?.length || 0) > 0);
    generation.startJob({
      campaignId: id,
      leadId,
      leadName: lead?.business?.name || 'Lead',
      kind: 'generate',
      userPrompt: extraInstructions,
      domain: lead ? effectiveDomain(lead, card) : undefined,
      hasDeployment,
      agentCardId: card?.id,
      enrichHint: leadNeedsEnrichment(lead),
    });
  }

  // True only when an enrichment request would actually run (fields still empty).
  function leadNeedsEnrichment(lead: any): boolean {
    const b = (lead as any)?.business;
    if (!b || b.enrichmentDone) return false;
    return !(
      b.enrichedEmail ||
      b.enrichedSocials?.instagram ||
      b.enrichedSocials?.linkedin ||
      b.enrichedSocials?.facebook ||
      b.enrichedSocials?.twitter ||
      b.enrichedSocials?.tiktok ||
      b.enrichedSocials?.youtube
    );
  }

  async function setMainDeployment(leadId: string, entryId: string, cardId?: string | null) {
    try {
      const res = await fetch(`/api/campaigns/${id}/leads/${leadId}/deploy/set-main`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cardId ? { entryId, agentCardId: cardId } : { entryId }),
      });
      if (!res.ok) throw new Error((await res.json()).error);
      await loadCampaign();
      queryClient.invalidateQueries({ queryKey: ['campaign'] });
      queryClient.invalidateQueries({ queryKey: ['campaigns'] });
    } catch (err: any) {
      toast(err.message, 'error');
    }
  }

  async function unpublishWebsite(lead: Lead, cardId?: string | null) {
    if (blockIfBusy()) return;
    if (!(await confirm({ message: t('campaign.unpublishConfirm') }))) return;
    generation.startJob({
      campaignId: id,
      leadId: lead.id,
      leadName: lead.business.name,
      kind: 'unpublish',
      hasDeployment: true,
      agentCardId: cardId || undefined,
    });
  }
  function slugifyDomain(input: string): string {
    return (input || '')
      .toLowerCase()
      .replace(/[^a-z0-9]/g, '-')
      .replace(/-+/g, '-')
      .slice(0, 30)
      .replace(/^-|-$/g, '');
  }

  function defaultDomain(lead: Lead): string {
    return `lp-${slugifyDomain(lead.business.name || 'lead')}` || 'lp-lead';
  }

  function effectiveDomain(lead: Lead, card?: any | null): string {
    return card?.deploymentName || lead.deploymentName || defaultDomain(lead);
  }

  // "View website" must open the stable main domain (<project>.vercel.app),
  // never the per-build deployment URL. deploymentName is the exact project
  // name sent to the Vercel API; stored deployment.url can be a unique build
  // URL when alias assignment failed or for entries written by older builds.
  function mainSiteUrl(lead: Lead): string {
    const project = lead.deploymentName || lead.deployment?.projectName || defaultDomain(lead);
    return `https://${project}.vercel.app`;
  }

  // ── Multi-agent cards (biz-card campaigns only; landing pages stay single) ──
  // Client mirror of store.getAgentCards: persisted cards win, otherwise a
  // single legacy card is synthesized from lead.agentInfo / lead.landingPage.
  function cardsOf(lead: any): any[] {
    if (Array.isArray(lead?.agentCards) && lead.agentCards.length > 0) return lead.agentCards;
    if (lead?.agentInfo || lead?.landingPage) {
      return [{
        id: 'legacy',
        agentInfo: lead.agentInfo || { fullName: '', title: '', agency: '', phone: '', email: '' },
        tsx: lead.landingPage?.tsx,
        version: lead.landingPage?.version || 0,
        generatedAt: lead.landingPage?.generatedAt,
        isMain: true,
        deploymentName: lead.deploymentName,
        deploymentUrl: lead.deployment?.url,
        projectName: lead.deployment?.projectName,
        deployedAt: lead.deployment?.deployedAt,
        deploymentHistory: lead.deploymentHistory || [],
      }];
    }
    return [];
  }

  function activeCardOf(lead: any): any | null {
    const cards = cardsOf(lead);
    if (cards.length === 0) return null;
    const sel = activeCardId[lead.id];
    return cards.find(c => c.id === sel) || cards.find(c => c.isMain) || cards[0];
  }

  function cardLabel(card: any, i: number): string {
    const first = String(card?.agentInfo?.fullName || '').trim().split(/\s+/)[0];
    return first || `Agent ${i + 1}`;
  }

  async function cardApi(leadId: string, action: string, extra: Record<string, unknown> = {}) {
    const res = await fetch(`/api/campaigns/${id}/leads/${leadId}/agent-cards`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, ...extra }),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Agent card action failed');
    await loadCampaign();
    queryClient.invalidateQueries({ queryKey: ['campaign', id] });
    queryClient.invalidateQueries({ queryKey: ['campaigns'] });
    return data;
  }

  function openAgentModalForLead(lead: any, cardId?: string | null) {
    setAgentLeadId(lead.id);
    // null cardId = legacy lead-level agent (landing campaigns)
    setAgentCardId(cardId === undefined ? (activeCardOf(lead)?.id || null) : cardId);
    setPendingAgentGenerate(null);
    setPendingAgentCard(null);
    setShowAgentModal(true);
  }

  async function checkDomainAvailability(leadId: string, name: string) {
    if (!name) {
      setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, error: 'Enter a domain name' } }));
      return;
    }
    setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: true } }));
    try {
      const res = await fetch(`/api/check-name?name=${encodeURIComponent(name)}`);
      const data = await res.json();
      if (!res.ok) {
        setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, error: data.error || 'Could not check availability' } }));
        return;
      }
      setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, available: data.available } }));
    } catch {
      setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, error: 'Availability check failed' } }));
    }
  }

  function onDomainDraftChange(leadId: string, raw: string) {
    // Clean as-you-type so the field can only ever contain what will actually
    // be checked and saved — no "garbage shown, slug checked" mismatch.
    const cleaned = raw
      .toLowerCase()
      .replace(/[^a-z0-9-]/g, '-')
      .replace(/-{2,}/g, '-')
      .slice(0, 30);
    setDomainDraft(prev => ({ ...prev, [leadId]: cleaned }));
    const slug = slugifyDomain(cleaned);
    if (domainCheckTimers.current[leadId]) clearTimeout(domainCheckTimers.current[leadId]);
    if (!slug) {
      setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: false, error: 'Enter a domain name' } }));
      return;
    }
    setDomainAvailability(prev => ({ ...prev, [leadId]: { checking: true } }));
    domainCheckTimers.current[leadId] = setTimeout(() => {
      checkDomainAvailability(leadId, slug);
    }, 500);
  }

  async function saveDomain(lead: Lead) {
    const draft = (domainDraft[lead.id] || '').trim();
    const next = slugifyDomain(draft);
    if (!next) { setDomainEditLeadId(null); setDomainCardId(null); return; }
    try {
      const res = await fetch(`/api/check-name?name=${encodeURIComponent(next)}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Failed to check domain availability');
      if (!data.available) {
        setDomainAvailability(prev => ({ ...prev, [lead.id]: { checking: false, available: false } }));
        toast(`"${next}.vercel.app" is already taken. Please choose a different name.`, 'error');
        return;
      }

      const patchRes = await fetch(`/api/campaigns/${id}/leads/${lead.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(domainCardId ? { deploymentName: next, agentCardId: domainCardId } : { deploymentName: next }),
      });
      if (!patchRes.ok) throw new Error((await patchRes.json()).error || 'Failed to save domain');
      setDomainEditLeadId(null);
      const savedCardId = domainCardId;
      setDomainCardId(null);
      await loadCampaign();
      queryClient.invalidateQueries({ queryKey: ['campaign'] });
      queryClient.invalidateQueries({ queryKey: ['campaigns'] });
      if (pendingGenerateLeadId === lead.id) {
        setPendingGenerateLeadId(null);
        setGenerateLeadId(lead.id);
        setGenerateCardId(savedCardId);
        setGeneratePrompt('');
        setShowGenerateModal(true);
      }
    } catch (err: any) {
      toast(err.message, 'error');
    }
  }

  function openGenerateModal(leadId: string, cardId?: string | null) {
    if (!leadId) {
      setShowGenerateModal(true);
      return;
    }
    const lead = allLeads.find((l: any) => l.id === leadId);
    // Biz-card: need real agent info before anything else (per active agent card)
    if ((campaign as any)?.assetType === 'bizcard') {
      const card = cardsOf(lead).find(c => c.id === (cardId || activeCardOf(lead)?.id)) || null;
      const hasAgent = !!card?.agentInfo?.fullName && !!card?.agentInfo?.email && !!card?.agentInfo?.phone;
      if (!hasAgent) {
        setAgentLeadId(leadId);
        setAgentCardId(card?.id || null);
        setPendingAgentGenerate(leadId);
        setPendingAgentCard(card?.id || null);
        setShowAgentModal(true);
        return;
      }
      setGenerateCardId(card?.id || null);
      setPendingGenerateLeadId(leadId);
      if (!lead) return;
      if (!card?.tsx) {
        setDomainCardId(card?.id || null);
        setDomainEditLeadId(lead.id);
        setDomainDraft(prev => ({ ...prev, [lead.id]: effectiveDomain(lead, card) }));
        setDomainAvailability(prev => ({ ...prev, [lead.id]: { checking: false } }));
        return;
      }
      setPendingGenerateLeadId(null);
      setGenerateLeadId(leadId);
      setGeneratePrompt('');
      setShowGenerateModal(true);
      return;
    }
    setGenerateCardId(null);
    setPendingGenerateLeadId(leadId);
    if (lead && !lead.landingPage) {
      setDomainCardId(null);
      setDomainEditLeadId(lead.id);
      setDomainDraft(prev => ({ ...prev, [lead.id]: effectiveDomain(lead) }));
      setDomainAvailability(prev => ({ ...prev, [lead.id]: { checking: false } }));
      return;
    }
    setPendingGenerateLeadId(null);
    setGenerateLeadId(leadId);
    setGeneratePrompt('');
    setShowGenerateModal(true);
  }

  function submitGenerate() {
    if (!generateLeadId) return;
    const extra = generatePrompt.trim() || undefined;
    setShowGenerateModal(false);
    doGenerate(generateLeadId, extra, generateCardId);
    setGenerateCardId(null);
  }

  function openModifyModal(lead: Lead, cardId?: string | null) {
    setStudioLeadId(lead.id);
    setStudioCardId(cardId ?? activeCardOf(lead)?.id ?? null);
  }

  function closeStudio() {
    const closedId = studioLeadId;
    setStudioLeadId(null);
    setStudioCardId(null);
    // Flash the lead card green so the user lands back on the site just previewed.
    if (closedId) router.replace(`/campaign/${id}?lead=${encodeURIComponent(closedId)}&focus=${Date.now()}`, { scroll: false });
  }

  function updateManualRow(i: number, patch: Partial<{ name: string; mapsUrl: string }>) {
    setManualRows(prev => prev.map((r, idx) => idx === i ? { ...r, ...patch } : r));
  }

  async function submitAddClients() {
    const valid = manualRows.filter(r => r.name.trim() && r.mapsUrl.trim());
    if (valid.length === 0) return;
    setResolvingClients(true);
    try {
      const res = await fetch(`/api/campaigns/${id}/leads/manual`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ entries: valid.map(r => ({ name: r.name.trim(), mapsUrl: r.mapsUrl.trim() })) }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Failed to add clients');
      if (data.failed > 0) {
        toast(t('campaign.manualAdded', { ok: data.added, failed: data.failed }), 'error');
      } else {
        toast(t('campaign.manualAdded', { ok: data.added, failed: 0 }), 'success');
      }
      setShowAddClients(false);
      setManualRows([{ name: '', mapsUrl: '' }]);
      await loadCampaign();
      queryClient.invalidateQueries({ queryKey: ['campaign'] });
      queryClient.invalidateQueries({ queryKey: ['campaigns'] });
    } catch (err: any) {
      toast(err.message, 'error');
    } finally {
      setResolvingClients(false);
    }
  }

  function sendStudioPrompt(userPrompt: string) {
    const studioLead = allLeads.find((l: any) => l.id === studioLeadId);
    if (!studioLead || !userPrompt.trim()) return;
    if (blockIfBusy()) return;
    // Clear any lingering error from a previous modify so it doesn't linger next to the new attempt.
    for (const j of generation.jobs) {
      if (j.leadId === studioLead.id && j.kind === 'modify' && j.phase === 'error') generation.dismissJob(j.id);
    }
    const isBizStudio = (campaign as any)?.assetType === 'bizcard' && studioCardId;
    generation.startJob({
      campaignId: id,
      leadId: studioLead.id,
      leadName: studioLead.business.name,
      kind: 'modify',
      userPrompt: userPrompt.trim(),
      hasDeployment: true,
      agentCardId: isBizStudio ? studioCardId : undefined,
    });
  }

  const allLeads = sortLeadsByRating([...new Map([...(scraping ? scrape.streamedLeads as any : []), ...(campaign?.leads || [])].map(l => [l.id, l])).values()] as any);
  const leadParam = searchParams.get('lead');
  const focusParam = searchParams.get('focus');
  const [consumedFocus, setConsumedFocus] = useState<string | null>(null);
  const highlightedLead = leadParam && focusParam && focusParam !== consumedFocus ? leadParam : null;
  const effectiveFilter = highlightedLead ? 'all' : filterStatus;
  const filteredLeads = allLeads.filter(l => {
    if (effectiveFilter === 'deleted') return !!l.deleted;
    if (l.deleted) return false;
    if (effectiveFilter === 'all') return true;
    if (effectiveFilter === 'has_site') return !!l.deployment?.url;
    if (effectiveFilter === 'no_website') return !(l.business.website || '').trim();
    return l.status === effectiveFilter;
  });

  // Soft-deleted photos are hidden everywhere; only active ones count for slots.
  const modalActiveImages = activeImages(imagesLead?.images);
  const modalDeletedImages = (imagesLead?.images || []).filter(i => !!i.deleted);

  useEffect(() => {
    if (!focusParam) return;
    const t = setTimeout(() => setConsumedFocus(focusParam), 4000);
    return () => clearTimeout(t);
  }, [focusParam]);

  useEffect(() => {
    if (!highlightedLead) return;
    let cancelled = false;
    let attempts = 0;
    const scroll = () => {
      if (cancelled) return;
      const el = document.getElementById(`lead-card-${highlightedLead}`);
      if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } else if (attempts < 50) {
        attempts++;
        setTimeout(scroll, 100);
      }
    };
    scroll();
    return () => { cancelled = true; };
  }, [highlightedLead, focusParam]);

  if (isLoading) return (
    <div className="flex-1 bg-gray-100 dark:bg-zinc-900 flex items-center justify-center transition-colors">
      <div className="animate-spin w-8 h-8 border-2 border-emerald-500 border-t-transparent rounded-full" />
    </div>
  );

  if (!campaign) return null;

  return (
    <div className="flex-1 bg-gray-100 dark:bg-zinc-900 transition-colors flex flex-col">
      <SetNavbar
        title={campaign.keyword}
        subtitle={campaign.location}
      />

      <div className="app-page flex-1 flex flex-col">
          <div className="sticky top-[var(--lm-navbar-h)] z-40 py-2 -mt-2 flex flex-col items-stretch gap-2 mb-4 sm:grid sm:grid-cols-[1fr_auto_1fr] sm:items-center">
            <div className="flex items-center gap-2 overflow-x-auto pb-0.5 sm:pb-0 -mx-3 sm:mx-0 px-3 sm:px-0">

              {allLeads.length === 0 && scrape.running && !scraping ? (
                <button
                  disabled
                  title={t('scrape.oneAtATime')}
                  className="px-3 sm:px-4 py-2 bg-zinc-200 dark:bg-zinc-700 text-zinc-500 dark:text-zinc-400 font-medium rounded-xl cursor-not-allowed text-xs sm:text-sm flex items-center gap-1.5 whitespace-nowrap shrink-0"
                >
                  <svg className="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                  {t('scrape.inProgress')}
                </button>
              ) : null}
            </div>

              <div className="flex items-center gap-1 bg-zinc-200/80 dark:bg-zinc-800/80 backdrop-blur-md rounded-lg p-1 shrink-0 mx-auto overflow-x-auto max-w-full shadow-lg shadow-black/10 dark:shadow-black/40">
                {['all', ...STATUSES.map(s => s.key), ...SITE_FILTERS.map(s => s.key), 'deleted'].map(s => {
                  const label = s === 'all' ? t('campaign.all') : s === 'deleted' ? t('campaign.deleted') : filterLabel(s);
                  return (
                    <button key={s} onClick={() => setFilterStatus(s)} className={`px-2 sm:px-3 py-1 text-[11px] sm:text-xs rounded-md font-medium transition-all whitespace-nowrap ${filterStatus === s ? 'bg-emerald-500/20 text-emerald-600 dark:text-emerald-400' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white'}`}>
                      {label}
                    </button>
                  );
                })}
              </div>

            <div className="hidden sm:block" aria-hidden />
          </div>

        {/* Scrape progress inline while scraping this campaign */}
        {scraping && <ScrapeProgressPanel campaignId={id} />}

        {/* Filter panel - visible to all */}
        {!scraping && filteredLeads.length === 0 && (
          <div className="min-h-[55vh] flex flex-col items-center justify-center text-center">
            <svg className="w-12 h-12 mb-4 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M21 21l-4.35-4.35m1.1-4.15a6.5 6.5 0 11-13 0 6.5 6.5 0 0113 0z" />
              <path strokeLinecap="round" strokeLinejoin="round" d="M12 10v3m0 3h.01" />
            </svg>
            <p className="text-zinc-500 dark:text-zinc-400">
              {filterStatus === 'all'
                ? t('campaign.noLeadsAll')
                : filterStatus === 'deleted'
                  ? t('campaign.noDeletedLeads')
                  : t('campaign.noLeadsStatus', { status: filterLabel(filterStatus) })}
            </p>
            {filterStatus === 'all' && campaign.source !== 'manual' && (
              <button onClick={startScrape} className="mt-6 px-4 sm:px-5 py-2 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white font-medium rounded-xl hover:from-emerald-400 hover:to-emerald-500 transition-all shadow-lg shadow-emerald-500/20 text-xs sm:text-sm flex items-center gap-1.5 whitespace-nowrap">
                <svg className="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                {t('campaign.findClients')}
              </button>
            )}
          </div>
        )}

        <div className={`grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3 ${scraping ? 'hidden' : ''}`}>
          {filteredLeads.map(lead => (
            <div key={lead.id} id={`lead-card-${lead.id}`} className={`bg-white dark:bg-zinc-800/40 border rounded-xl overflow-hidden flex flex-col transition-all group ${highlightedLead === lead.id ? 'border-emerald-400 ring-2 ring-emerald-400/60 shadow-lg shadow-emerald-500/20' : 'border-zinc-200 dark:border-zinc-700/50'}`}>
              <div className="relative h-32 sm:h-36 w-full bg-zinc-100 dark:bg-zinc-900">
                <SafeImg
                  src={leadFeaturedImage(lead)}
                  alt={lead.business.name}
                  className="block w-full h-full"
                  imgClassName="w-full h-full object-cover"
                  fallback={
                    <div className="w-full h-full flex items-center justify-center bg-gradient-to-br from-zinc-200 to-zinc-300 dark:from-zinc-700 dark:to-zinc-800 px-4 text-center">
                      <span className="text-sm font-semibold text-zinc-500 dark:text-zinc-300 line-clamp-2">{lead.business.name}</span>
                    </div>
                  }
                />
                {lead.deleted ? (
                  <button onClick={() => restoreLead(lead.id)} className="absolute top-2 right-2 w-7 h-7 bg-emerald-600/90 text-white rounded-full text-xs flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:bg-emerald-500" title={t('campaign.restore')}>
                    <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 9a9 9 0 1 0 3-6.7M3 4v5h5" /></svg>
                  </button>
                ) : (
                  <>
                    <div className="absolute top-2 left-2" ref={el => { statusMenuRefs.current[lead.id] = el; }}>
                      <button onClick={() => { const next = statusMenuLeadId === lead.id ? null : lead.id; setStatusMenuLeadId(next); statusMenuOpenRef.current = next; }} className="w-7 h-7 flex items-center justify-center rounded-full bg-white/80 dark:bg-zinc-900/80 text-zinc-600 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-600/40 opacity-0 group-hover:opacity-100 transition-opacity hover:text-zinc-900 dark:hover:text-white hover:bg-white dark:hover:bg-zinc-800" title={t('campaign.changeStatus')}>
                        <svg className="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="12" cy="19" r="1.5" /></svg>
                      </button>
                      {statusMenuLeadId === lead.id && (
                        <div className="absolute left-0 top-full mt-1 z-30 w-44 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl shadow-xl py-1">
                          {STATUSES.map(s => (
                            <button key={s.key} onClick={() => { updateLeadStatus(lead.id, s.key); setStatusMenuLeadId(null); statusMenuOpenRef.current = null; }} className={`w-full text-start px-3 py-1.5 text-[11px] font-medium transition-all ${lead.status === s.key ? 'text-emerald-600 dark:text-emerald-400 bg-emerald-500/10' : 'text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-700/50 hover:text-zinc-900 dark:hover:text-white'}`}>
                              {s.label}
                              {lead.status === s.key && <span className="float-right">✓</span>}
                            </button>
                          ))}
                        </div>
                      )}
                    </div>
                    <button onClick={() => deleteLead(lead.id)} className="absolute top-2 right-2 w-7 h-7 flex items-center justify-center rounded-full bg-white/80 dark:bg-zinc-900/80 text-zinc-600 dark:text-zinc-300 border border-zinc-300 dark:border-zinc-600/40 opacity-0 group-hover:opacity-100 transition-opacity hover:text-zinc-900 dark:hover:text-white hover:bg-white dark:hover:bg-zinc-800" title={t('campaign.delete')}>
                      <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                    </button>
                  </>
                )}
              </div>
              <div className="flex items-start justify-between gap-4 px-4 pt-4">
                <div className="flex-1 min-w-0">
                  <div className="flex items-center gap-1.5 mb-1">
                    <h3 className="font-semibold text-zinc-900 dark:text-white truncate">{lead.business.name}</h3>
                    <span className="flex items-center gap-0.5 text-amber-500 dark:text-amber-400 text-[10px] shrink-0">
                      <svg className="w-2.5 h-2.5 fill-current" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" /></svg>
                      {lead.business.rating}
                    </span>
                    <span className="text-[10px] text-zinc-500 dark:text-zinc-500 shrink-0">({lead.business.ratingCount})</span>
                  </div>
                  <div className="flex flex-col gap-0.5 text-[11px] text-zinc-600 dark:text-zinc-400 mb-2 min-w-0">
                    {lead.business.category && (
                      <span className="flex items-center gap-1 truncate">
                        <svg className="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        <span className="truncate">{lead.business.category}</span>
                      </span>
                    )}
                    {lead.business.address && (
                      isWebUrl(lead.business.googleUrl) ? (
                        <a href={lead.business.googleUrl} target="_blank" rel="noopener noreferrer" className="flex items-center gap-1 truncate hover:text-emerald-400 transition-colors" title={t('campaign.viewOnGoogleMaps')}>
                          <svg className="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                          <span className="truncate">{cleanAddress(lead.business.address)}</span>
                        </a>
                      ) : (
                        <span className="flex items-center gap-1 truncate">
                          <svg className="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                          <span className="truncate">{cleanAddress(lead.business.address)}</span>
                        </span>
                      )
                    )}
                    {isWebUrl(lead.business.website) && (
                      <a href={lead.business.website} target="_blank" rel="noopener noreferrer" className="flex items-center gap-1 truncate hover:text-emerald-400 transition-colors" title={lead.business.website}>
                        <svg className="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                        <span className="truncate">{lead.business.website}</span>
                      </a>
                    )}
                    {lead.business.phone && (
                      <a href={`tel:${lead.business.phone}`} className="flex items-center gap-1 truncate hover:text-emerald-400 transition-colors" title={lead.business.phone}>
                        <svg className="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                        <span className="truncate">{lead.business.phone}</span>
                      </a>
                    )}
