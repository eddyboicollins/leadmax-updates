import { NextRequest, NextResponse } from 'next/server';
import { MAX_LEAD_IMAGES } from '@/lib/limits';
import { getCampaign, getLead, appendLeadImage, getSettings, SCRAPED_DIR } from '@/lib/store';
import { processImageForUpload, uploadToFilebase } from '@/lib/filebase';
import { promises as fs } from 'fs';
import path from 'path';

const MAX_IMAGES = MAX_LEAD_IMAGES;
const BROWSER_UA =
  'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36';

async function readImage(url: string): Promise<Buffer> {
  // Locally stored scraped images are served by this app itself.
  if (url.startsWith('/api/scraped-images/')) {
    const file = url.replace(/^\/api\/scraped-images\//, '');
    if (!/^[a-z0-9-]+\.(jpg|jpeg|png|webp|gif)$/i.test(file)) throw new Error('Invalid local image path');
    return fs.readFile(path.join(SCRAPED_DIR, file));
  }
  const res = await fetch(url, {
    headers: {
      'User-Agent': BROWSER_UA,
      Referer: 'https://www.google.com/',
      Accept: 'image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8',
    },
  });
  if (!res.ok) throw new Error(`Failed to download image (${res.status})`);
  return Buffer.from(await res.arrayBuffer());
}

export async function POST(
  request: NextRequest,
  { params }: { params: Promise<{ id: string; leadId: string }> },
) {
  try {
    const { id, leadId } = await params;
    const settings = await getSettings();
    const filebaseAccessKey = settings.filebaseAccessKey;
    const filebaseSecretKey = settings.filebaseSecretKey;
    const filebaseBucket = settings.filebaseBucket;
    if (!filebaseAccessKey || !filebaseSecretKey || !filebaseBucket) {
      return NextResponse.json({ code: 'FILEBASE_KEY_MISSING', error: 'Filebase not configured in settings' }, { status: 400 });
    }

    const campaign = await getCampaign(id);
    if (!campaign) return NextResponse.json({ error: 'Campaign not found' }, { status: 404 });

    const lead = await getLead(leadId);
    if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });

    const { urls } = await request.json();
    if (!Array.isArray(urls) || urls.length === 0) {
      return NextResponse.json({ error: 'No image urls provided' }, { status: 400 });
    }

    // Soft-deleted photos don't count toward the limit — only active ones do.
    const remaining = MAX_IMAGES - (lead.images || []).filter((i) => !i.deleted).length;
    if (remaining <= 0) {
      return NextResponse.json({ error: `Maximum ${MAX_IMAGES} images allowed` }, { status: 400 });
    }

    const alt = lead.business?.name || '';
    const results: { url: string; ok: boolean; error?: string; imageId?: string }[] = [];

    for (const url of urls.slice(0, remaining)) {
      try {
        const inputBuffer = await readImage(url);
        const { buffer: webpBuffer, width, height } = await processImageForUpload(inputBuffer);
        const b64 = webpBuffer.toString('base64');
        const { url: uploadedUrl } = await uploadToFilebase(b64, filebaseAccessKey, filebaseSecretKey, filebaseBucket);

        const imageId = crypto.randomUUID();
        // Atomic append (inside the store lock) so parallel imports can't drop images.
        await appendLeadImage(leadId, {
          id: imageId,
          url: uploadedUrl,
          alt,
          width,
          height,
          
        });
        results.push({ url, ok: true, imageId });
      } catch (err: any) {
        results.push({ url, ok: false, error: err.message || 'Upload failed' });
      }
    }

    return NextResponse.json({ imported: results.filter(r => r.ok).length, failed: results.filter(r => !r.ok).length, results });
  } catch (err: any) {
    return NextResponse.json({ code: err.code, error: err.message || 'Import failed' }, { status: 500 });
  }
}
