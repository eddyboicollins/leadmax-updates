        {hero ? (
          <button type="button" onClick={() => p.onViewImage(hero)} className="block w-full h-full" title={t('campaign.viewFullSize')}>
            <SafeImg
              key={hero}
              src={hero}
              alt={b.name}
              className="block w-full h-full"
              imgClassName="w-full h-full object-cover"
              fallback={<div className="w-full h-full bg-gradient-to-br from-zinc-300 to-zinc-200 dark:from-zinc-800 dark:to-zinc-900" />}
            />
          </button>
        ) : (
          <div className="w-full h-full flex items-center justify-center bg-gradient-to-br from-emerald-900/40 via-zinc-200 to-zinc-300 dark:via-zinc-900 dark:to-zinc-950">
            <span className="text-5xl font-semibold text-zinc-400 dark:text-zinc-700">{(b.name || '?').slice(0, 1)}</span>
          </div>
        )}
        <div className="absolute top-3 start-3 flex gap-1.5">
          <button onClick={p.onPrev} disabled={!p.onPrev} className={iconBtn} title={t('campaign.prevLead')}>
            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M5 15l7-7 7 7" /></svg>
          </button>
          <button onClick={p.onNext} disabled={!p.onNext} className={iconBtn} title={t('campaign.nextLead')}>
            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </button>
        </div>
        <button onClick={p.onClose} className={`${iconBtn} absolute top-3 end-3`} title={t('campaign.hideDetails')}>
          <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M5 12h14" /></svg>
        </button>
        {p.photos.length > 0 && (
          <span className="absolute bottom-3 start-3 inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-black/60 text-white text-[11px] font-medium backdrop-blur-sm">
            <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg>
            {t('campaign.photoCounter', { n: idx + 1, total: p.photos.length })}
          </span>
        )}
        {thumbs.length > 0 && (
          <div className="absolute bottom-3 end-3 flex gap-1.5">
            {thumbs.map(th => (
              <button key={th.url} onClick={() => setPhotoIdx(th.i)} className="w-11 h-11 rounded-lg overflow-hidden ring-2 ring-white/70 hover:ring-emerald-400 transition-all">
                <SafeImg src={th.url} alt="" className="block w-full h-full" imgClassName="w-full h-full object-cover" fallback={<span className="block w-full h-full bg-zinc-700" />} />
