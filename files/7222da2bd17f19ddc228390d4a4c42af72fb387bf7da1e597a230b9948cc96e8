import { NextRequest, NextResponse } from 'next/server';
import { getLead, getSettings, setLeadV0Handover } from '@/lib/store';
import { buildHandoverPrompt, createV0HandoverChat, findExistingV0Handover, handoverSourceCode, inlineHandoverFiles } from '@/lib/v0Handover';

export const maxDuration = 120;

type Params = { params: Promise<{ id: string; leadId: string }> };

/** Whether a v0 key is set, plus the paste-by-hand prompt (code inlined) for the no-key path. */
export async function GET(_request: NextRequest, { params }: Params) {
  const { leadId } = await params;
  const lead = await getLead(leadId);
  if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });
  const tsx = await handoverSourceCode(lead);
  if (!tsx) return NextResponse.json({ error: 'This lead has no website yet.' }, { status: 400 });

  const settings = await getSettings();
  let handover = lead.v0Handover ?? null;
  let found = false;
  if (!handover && settings.v0ApiKey) {
    handover = await findExistingV0Handover(settings.v0ApiKey, lead);
    if (handover) { await setLeadV0Handover(leadId, handover); found = true; }
  }
  return NextResponse.json({
    hasV0Key: !!settings.v0ApiKey,
    handover,
    /** Just discovered on v0 (not yet known to the page). */
    found,
    prompt: buildHandoverPrompt(lead, { inlineFiles: inlineHandoverFiles(lead, tsx) }),
  });
}

/**
 * Creates the v0 chat (code imported, prompt sent) and remembers it on the lead.
 * A lead already handed over returns its existing chat unless `force` is set.
 */
export async function POST(request: NextRequest, { params }: Params) {
  const { leadId } = await params;
  const lead = await getLead(leadId);
  if (!lead) return NextResponse.json({ error: 'Lead not found' }, { status: 404 });
  const { force } = await request.json().catch(() => ({}));
  if (lead.v0Handover && !force) return NextResponse.json({ handover: lead.v0Handover, existing: true });
  const tsx = await handoverSourceCode(lead);
  if (!tsx) return NextResponse.json({ error: 'This lead has no website yet.' }, { status: 400 });

  const settings = await getSettings();
  if (!settings.v0ApiKey) return NextResponse.json({ error: 'No v0 API key configured.' }, { status: 400 });

  try {
    const handover = await createV0HandoverChat(settings.v0ApiKey, lead, tsx);
    await setLeadV0Handover(leadId, handover);
    return NextResponse.json({ handover });
  } catch (err) {
    return NextResponse.json({ error: err instanceof Error ? err.message : 'Could not create the v0 chat' }, { status: 502 });
  }
}
