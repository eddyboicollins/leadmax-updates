  const hasSite = !!lead.landingPage;

  const iconBtn = 'w-8 h-8 flex items-center justify-center rounded-lg bg-black/45 hover:bg-black/65 text-white backdrop-blur-sm transition-all disabled:opacity-30';

  return (
    <div className="h-full flex flex-col bg-white dark:bg-zinc-950">
      {/* Photo header — discovered photos first */}
