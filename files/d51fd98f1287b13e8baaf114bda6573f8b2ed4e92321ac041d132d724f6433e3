'use client';

import { useState, useEffect, useRef } from 'react';
import { useRouter } from 'next/navigation';
import { useQueryClient } from '@tanstack/react-query';
  import { useAllCampaigns, useCreateCampaign, useDeleteCampaign, useRestoreCampaign, usePurgeCampaign, useGenerations, type Generation } from '@/lib/query/useCampaigns';
import { SetNavbar } from '@/components/AppShell';
import { useToast } from '@/components/Toast';
import OnboardingWizard from '@/components/OnboardingWizard';
import CampaignExportModal from '@/components/CampaignExportModal';
import { useTranslation } from 'react-i18next';
import { useLockBodyScroll } from '@/lib/useLockBodyScroll';
import { useScrape } from '@/lib/scrape/ScrapeProvider';
import { useGeneration } from '@/lib/generate/GenerationProvider';
import { onGenerationFocus, consumePendingGenerationFocus, onGenerationsScroll, consumePendingGenerationsScroll, onCampaignsScroll, consumePendingCampaignsScroll } from '@/lib/generationFocus';

function focusGenerationCard(id: string) {
  let attempts = 0;
  const tick = () => {
    const el = document.querySelector(`[data-gen-id="${id}"]`);
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      el.classList.add('gen-highlight');
      setTimeout(() => el.classList.remove('gen-highlight'), 3500);
    } else if (attempts++ < 60) {
      setTimeout(tick, 200);
    }
  };
  tick();
}

function focusGenerationsSection() {
  let attempts = 0;
  const tick = () => {
    const el = document.getElementById('home-section-generations');
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (attempts++ < 60) {
      setTimeout(tick, 200);
    }
  };
  tick();
}

function focusCampaignsSection() {
  let attempts = 0;
  const tick = () => {
    const el = document.getElementById('home-section-campaigns');
    if (el) {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else if (attempts++ < 60) {
      setTimeout(tick, 200);
    }
  };
  tick();
}

function CampaignCard({ c, deleted, onDelete, onRestore, onErase }: { c: any; deleted?: boolean; onDelete: (id: string) => void; onRestore: (id: string) => void; onErase: (id: string) => void }) {
  const router = useRouter();
  const { t } = useTranslation();
  const scrape = useScrape();
  const [exportOpen, setExportOpen] = useState(false);
  const totalLeads = c.leads?.filter((l: any) => !l.deleted)?.length || 0;
  const regions = c.regions || [];
  const regionCount = regions.length;
  const extraCount = regionCount - 1;
  const isScraping = scrape.running && scrape.campaignId === c.id;
  const [showAllRegions, setShowAllRegions] = useState(false);
  const hasGeneratedSite = !!c.leads?.some((l: any) => l.landingPage || l.deployment);

  return (
    <div
      className="group bg-white dark:bg-zinc-800/40 border border-gray-200 dark:border-zinc-700/50 rounded-xl p-5 transition-all cursor-pointer hover:border-emerald-500/50 hover:bg-gray-50 dark:hover:bg-zinc-800/80 shadow-sm dark:shadow-none"
      onClick={() => router.push(`/campaign/${c.id}`)}
    >
      <div className="flex items-start justify-between mb-3">
        <div className="flex-1 min-w-0">
          <h3 className="font-semibold text-gray-900 dark:text-white truncate">{c.keyword}</h3>
          {regionCount > 1 ? (
            <div className="text-sm text-zinc-400 leading-snug">
              <span className="text-emerald-500 dark:text-emerald-400 font-medium">{regions[0].location}</span>
              {showAllRegions ? (
                <>
                  {regions.slice(1).map((r: { keyword: string; location: string }) => (
                    <span key={r.location}><span>, </span><span>{r.location}</span></span>
                  ))}
                  <span>, </span>
                  <span onClick={e => { e.stopPropagation(); setShowAllRegions(false); }} className="text-zinc-600 dark:text-zinc-400 hover:text-emerald-400 cursor-pointer">
                    {t('home.hideRegions')}
                  </span>
                </>
              ) : (
                <>
                  {' '}
                  <span onClick={e => { e.stopPropagation(); setShowAllRegions(true); }} className="text-zinc-600 dark:text-zinc-400 hover:text-emerald-400 cursor-pointer">
                    {t('home.andMoreRegions', { count: extraCount })}
                  </span>
                </>
              )}
            </div>
          ) : (
            <p className="text-sm text-zinc-400 truncate">{c.location}</p>
          )}
        </div>
        <div className="flex items-center gap-1 shrink-0">
          <button onClick={e => { e.stopPropagation(); setExportOpen(true); }} className="p-1.5 text-zinc-500 hover:text-emerald-400 hover:bg-emerald-500/10 rounded-lg transition-all" title={t('home.exportCampaign')}>
            <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
          </button>
          {deleted ? (
            <>
              <button onClick={e => { e.stopPropagation(); onRestore(c.id); }} className="p-1.5 text-emerald-500 hover:text-emerald-400 hover:bg-emerald-500/10 rounded-lg transition-all" title={t('home.restoreCampaign')}>
                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 9a9 9 0 1 0 3-6.7M3 4v5h5" /></svg>
              </button>
              <button onClick={e => { e.stopPropagation(); onErase(c.id); }} className="p-1.5 text-red-500 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-all" title={t('home.eraseCampaign')}>
                <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </>
          ) : !hasGeneratedSite && (
            <button onClick={e => { e.stopPropagation(); onDelete(c.id); }} className="p-1.5 text-zinc-500 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-all" title={t('home.deleteCampaign')}>
              <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            </button>
          )}
        </div>
      </div>
      <CampaignExportModal open={exportOpen} onClose={() => setExportOpen(false)} campaign={c} />
      <div className="flex items-center gap-3 text-sm">
        {isScraping && (
          <span className="inline-flex items-center gap-1.5 px-2 py-1 bg-red-500/10 text-red-400 border border-red-500/30 rounded-lg text-xs font-medium">
            <span className="relative flex h-2 w-2">
              <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75" />
              <span className="relative inline-flex rounded-full h-2 w-2 bg-red-500" />
            </span>
            {t('home.scrapingActive')}
          </span>
        )}
        {totalLeads > 0 && (
          <span className="flex items-center gap-1 text-zinc-300">
            <svg className="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            {t('home.leadsCount', { count: totalLeads })}
          </span>
        )}
      </div>
      <div className="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500">
        <span>{new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
      </div>
    </div>
  );
}

function GenerationCard({ g }: { g: Generation }) {
  const router = useRouter();
  const { t } = useTranslation();
  const goToCampaign = () => router.push(`/campaign/${g.campaignId}?lead=${encodeURIComponent(g.leadId)}&focus=${Date.now()}`);
  return (
    <div
      data-gen-id={g.id}
      className="group bg-white dark:bg-zinc-800/40 border border-gray-200 dark:border-zinc-700/50 rounded-xl p-5 transition-all cursor-pointer hover:border-emerald-500/50 hover:bg-gray-50 dark:hover:bg-zinc-800/80 shadow-sm dark:shadow-none"
      onClick={goToCampaign}
    >
      <div className="flex items-start justify-between mb-3">
        <div className="flex-1 min-w-0">
          <h3 className="font-semibold text-gray-900 dark:text-white truncate">{g.businessName}</h3>
          <p className="text-sm text-zinc-400 truncate mt-0.5">{g.campaignName}</p>
          {g.projectName && (
            <p className="text-xs text-zinc-500 truncate mt-1">{t('generations.project')}: {g.projectName}</p>
          )}
        </div>
        <div className="flex items-center gap-1 shrink-0">
          {g.deploymentUrl && (
            <a
              href={g.deploymentUrl}
              target="_blank"
              rel="noopener noreferrer"
              onClick={e => e.stopPropagation()}
              className="p-1.5 text-zinc-500 hover:text-emerald-400 hover:bg-emerald-500/10 rounded-lg transition-all"
              title={t('generations.liveSite')}
            >
              <svg className="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}><path strokeLinecap="round" strokeLinejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path strokeLinecap="round" strokeLinejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
